# CORBU AI 시스템 환경 변수 설정
# 이 파일을 .env로 복사하여 사용하세요

# ===== 애플리케이션 설정 =====
NODE_ENV=development
REACT_APP_API_URL=http://localhost:8000/api
REACT_APP_UMKS_BASE_URL=http://localhost:8001
REACT_APP_WS_URL=ws://localhost:8000/ws
REACT_APP_USE_MOCK_API=false

# ===== 백엔드 설정 =====
PYTHONPATH=/app
DATABASE_URL=sqlite:///./database.db
LOG_LEVEL=INFO
DEBUG=true

# ===== 데이터베이스 설정 =====
POSTGRES_DB=corbu_ai
POSTGRES_USER=corbu_user
POSTGRES_PASSWORD=corbu_password
POSTGRES_HOST=database
POSTGRES_PORT=5432

# ===== Redis 설정 =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== AI 서비스 설정 =====
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# ===== 보안 설정 =====
SECRET_KEY=your_secret_key_here
JWT_SECRET=your_jwt_secret_here
ENCRYPTION_KEY=your_encryption_key_here

# ===== 파일 업로드 설정 =====
MAX_FILE_SIZE=100MB
ALLOWED_FILE_TYPES=pdf,doc,docx,txt,jpg,jpeg,png,gif,mp4,avi,mov
UPLOAD_DIR=./uploads
TEMP_DIR=./temp

# ===== 성능 설정 =====
CHUNK_SIZE=1024
MAX_CONCURRENT_UPLOADS=5
CACHE_TTL=3600
SESSION_TIMEOUT=1800

# ===== 모니터링 설정 =====
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_ENABLED=false
GRAFANA_PORT=3001

# ===== 로깅 설정 =====
LOG_FILE=./logs/app.log
LOG_LEVEL=INFO
LOG_FORMAT=json

# ===== 개발 환경 설정 =====
DEV_SERVER_PORT=3000
API_SERVER_PORT=8000
WEBSOCKET_PORT=8001

# ===== 프로덕션 환경 설정 =====
PROD_DOMAIN=your-domain.com
SSL_CERT_PATH=/path/to/ssl/cert.pem
SSL_KEY_PATH=/path/to/ssl/key.pem 