# ===== 데이터베이스 설정 =====
POSTGRES_DB=corbu_ai
POSTGRES_USER=corbu_user
POSTGRES_PASSWORD=corbu_password
POSTGRES_HOST=database
POSTGRES_PORT=5432

# ===== Redis 설정 =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== AI 서비스 설정 =====
OPENAI_API_KEY=your_openai_api_key_here
# backend/llm_service.py OpenAI provider 전용 (LLM_MODEL 과 분리 — Ollama 기본 qwen 등과 충돌 방지)
# OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# backend/llm_service.py — Claude 모델 ID (기본 claude-3-5-sonnet-20241022)
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# ===== 보안 설정 =====
SECRET_KEY=your_secret_key_here
JWT_SECRET=your_jwt_secret_here
ENCRYPTION_KEY=your_encryption_key_here

# ===== 파일 업로드 설정 =====
MAX_FILE_SIZE=100MB
ALLOWED_FILE_TYPES=pdf,doc,docx,txt,jpg,jpeg,png,gif,mp4,avi,mov
UPLOAD_DIR=./uploads
TEMP_DIR=./temp

# ===== 성능 설정 =====
CHUNK_SIZE=1024
MAX_CONCURRENT_UPLOADS=5
CACHE_TTL=3600
SESSION_TIMEOUT=1800

# ===== 모니터링 설정 =====
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_ENABLED=false
GRAFANA_PORT=3001

# ===== 로깅 설정 =====
LOG_FILE=./logs/app.log
LOG_LEVEL=INFO
LOG_FORMAT=json

# ===== 개발 환경 설정 =====
DEV_SERVER_PORT=3000
# CRA 프론트 (.env.local) — REACT_APP_* 만 브라우저에 주입됨 (docs/PORTS.md, src/config/api.ts)
# REACT_APP_API_URL=http://localhost:5002
# 컴포저 다중 요청 순차 API (미설정 시 단일 호출). STREAM=true 시 SSE 항목별 순차
# REACT_APP_COMPOSER_SEQUENTIAL_MULTI_REQUEST=true
# REACT_APP_COMPOSER_SEQUENTIAL_MULTI_REQUEST_STREAM=true
# REACT_APP_COMPOSER_MULTI_STEP_MULTI_REQUEST=true
# REACT_APP_WS_URL=ws://localhost:5002
# REACT_APP_INTEGRATED_API_URL=http://localhost:5002
# REACT_APP_DEV_URL=http://localhost:3000
# 로컬 LLM (src/services/localLLMService.ts)
# REACT_APP_OLLAMA_BASE_URL=http://localhost:11434
# REACT_APP_LM_STUDIO_BASE_URL=http://localhost:1234
# 통합 main_server 기본 (restart-backend, main_server.py)
API_SERVER_PORT=5002
# WebSocket은 보통 API와 동일 호스트·포트(경로만 다름). 레거시 분리 시만 사용
WEBSOCKET_PORT=5002

# ===== 프로덕션 환경 설정 =====
PROD_DOMAIN=your-domain.com
SSL_CERT_PATH=/path/to/ssl/cert.pem
SSL_KEY_PATH=/path/to/ssl/key.pem

# ===== Docker (docker-entrypoint.sh) =====
# 기본: 통합 main_server. 레거시 UMKS만 쓸 때 CORBU_DOCKER_ENTRY=umks
# CORBU_DOCKER_ENTRY=main
# BACKEND_PORT=5002

# ===== 개발 서버 배포 (npm run deploy:dev) =====
# build/를 rsync 또는 scp로 원격 개발 서버에 올릴 때 사용
# DEPLOY_DEV_HOST=user@dev.example.com
# DEPLOY_DEV_PATH=/var/www/frontend
DEPLOY_DEV_HOST=
DEPLOY_DEV_PATH= 