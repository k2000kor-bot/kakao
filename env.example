# CORBU.AI 시스템 환경 변수 설정
# 이 파일을 .env로 복사하여 사용하세요

# ===== 애플리케이션 설정 =====
NODE_ENV=development
# 백엔드 API 주소. 미설정 시 개발 서버는 package.json proxy로 http://localhost:5002 에 전달됨.
# 서버 반영 후 대화·프로젝트·백업 등 출력이 되려면 백엔드를 5002에서 기동하고, 프로덕션 빌드 시에는 여기 설정.
REACT_APP_API_URL=http://localhost:5002
# REACT_APP_BACKUP_API_URL=  # 미설정 시 위 API와 동일 서버(/api/backup/*) 사용
# UMKS 등 미디어 지식 API — 통합 서버와 같이 쓰면 5002 (별도 프로세스면 해당 포트)
REACT_APP_UMKS_BASE_URL=http://localhost:5002
REACT_APP_WS_URL=ws://localhost:5002
REACT_APP_USE_MOCK_API=false

# ===== 백엔드 설정 =====
PYTHONPATH=/app
DATABASE_URL=sqlite:///./database.db
LOG_LEVEL=INFO
DEBUG=true
# CORS — 통합 main_server: 미설정 시 allow_origins=["*"]. 프로덕션에서는 아래에 실제 도메인만 나열 권장.
# 레거시/보조 FastAPI(app.py 등): 미설정 시 3000/3001 dev 기본. * = 전체(개발만 권장).
# CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001
# 별칭: CORS_ORIGINS
# intent_classifier 등 라우팅 메타 기본 오리진 (CORBU_MAIN_API_BASE 미설정 시 API_PORT/BACKEND_PORT, 기본 5002)
# CORBU_MAIN_API_BASE=http://localhost:5002
# 의도 분류 캐시 서버 (없으면 조회 실패만 로그). 미설정 시 CACHE_MANAGER_PORT(기본 8014)로 localhost URL 구성
# CORBU_INTENT_CACHE_BASE=http://localhost:8014
# 레거시 단독 서버: simple_api_server / unified_api_server
# SIMPLE_API_PORT=8003
# UNIFIED_API_LEGACY_PORT=8004
# advanced_api_server.py / intent_classifier.py 단독 실행 시
# ADVANCED_API_PORT=8000
# INTENT_CLASSIFIER_PORT=8000
# 레거시 멀티 프로세스 (start_all_services_final 등)
# COMPREHENSIVE_MESSAGE_PORT=8001
# CHATGPT_UNIFIED_SYSTEM_PORT=8001
# ADVANCED_MEDIA_ANALYSIS_PORT=8001
# start_fixed_ports_system / 멀티 프로세스용
# MESSAGE_GENERATION_PORT=8003
# MESSAGE_API_SERVER_PORT=8002
# CHAT_UPLOAD_SERVER_PORT=8004
# PERSISTENT_CHAT_SESSION_PORT=8001
# CHAT_ANALYSIS_MAIN_PORT=8002
# SIMPLIFIED_ADVANCED_API_PORT=8001
# 고정 포트 멀티 스텁 (start_fixed_ports_system.sh — 각 프로세스에 PORT= 가 전달됨)
# ANALYSIS_SERVER_PORT=8005
# CONTEXT_SERVER_PORT=8006
# MEDIA_STUB_SERVER_PORT=8007
# STRATEGY_SERVER_PORT=8008
# SIMULATION_SERVER_PORT=8009
# SYNC_SERVER_PORT=8010
# 루팅 수신·부동산 AI 멀티 서버
# ROOTED_KAKAO_PORT=8005
# APARTMENT_COMMUNITY_PORT=8005
# CONSTRUCTION_COMPANY_INFO_PORT=8006
# MARKET_ANALYSIS_ENGINE_PORT=8007
# DREAM_VISUALIZATION_PORT=8008
# 레거시 단독
# SIMPLE_SERVER_PORT=8000
# NLP_MASTER_SERVER_PORT=8000
# ADVANCED_API_BACKUP_PORT=8000
# 기타 레거시 마이크로서비스 (기본 포트는 PORTS.md / 각 .py 참고)
# CONTEXT_MANAGER_SERVICE_PORT=8003
# ANALYTICS_TRACKER_SERVICE_PORT=8004
# ADVANCED_CONVERSATIONAL_LLM_PORT=8004
# INTEGRATED_ANALYSIS_API_PORT=8006
# KAKAO_CHAT_API_PORT=8003
