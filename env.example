# WEBSOCKET_SERVER_PORT=8002
# SIMPLE_ULTIMATE_API_PORT=8004
# WEB_SCRAPER_SERVICE_PORT=8013
# chatgpt_unified_system.py → 스크래퍼 POST (기본 http://localhost:WEB_SCRAPER_SERVICE_PORT)
# CORBU_WEB_SCRAPER_BASE=http://localhost:8013
# ENHANCED_INTEGRATION_API_PORT=5003
# INTEGRATED_AUTO_LEARNING_API_PORT=5002
# INTEGRATED_CONVERSATION_SERVER_PORT=8003
