# CONVERSATIONAL_AI_API_PORT=8003
# VOICE_RECOGNITION_PORT=8001
# CONSTRUCTION_API_PORT=8002
# SEMANTIC_SEARCH_ENGINE_PORT=8002
# ADVANCED_IMAGE_ANALYSIS_PORT=8002
# CHAT_ANALYSIS_SERVER_PORT=8004
# CONVERSATION_MEMORY_SYSTEM_PORT=8004
# REALTIME_GENERATION_ENGINE_PORT=8003
# PREDICTIVE_ANALYSIS_SYSTEM_PORT=8003
# CONTEXTUAL_AI_ENGINE_PORT=8003
# NATURAL_LANGUAGE_COMMAND_SYSTEM_PORT=8005
# TEST_MARKET_SENTIMENT_SERVER_PORT=8001
# ADVANCED_ANALYTICS_SERVER_PORT=8005
# ADVANCED_DOCUMENT_PROCESSOR_PORT=8005
# ADVANCED_FILE_PROCESSOR_PORT=8006
# AI_CONVERSATION_INSIGHTS_PORT=8009
# DATA_VISUALIZATION_SERVER_PORT=8008
# AI_MESSAGE_RECOMMENDER_PORT=8007
# NOTIFICATION_SERVER_PORT=8006
# advanced_scheduler.py → 알림 HTTP POST 베이스 (미설정 시 localhost:NOTIFICATION_SERVER_PORT, 포트 기본 8004 레거시)
# CORBU_NOTIFICATION_API_BASE=http://localhost:8006
# 로컬 Ollama (llm_service, notebook_llm_integration, ollama_hybrid_engine 등)
# OLLAMA_BASE_URL=http://localhost:11434
# backend/test_main_kakao_system.py
# CORBU_MAIN_KAKAO_TEST_BASE=http://localhost:8004
# backend/test_backend_connection.py (레거시 integrated_api_server)
# CORBU_INTEGRATED_API_TEST_BASE=http://localhost:8095
# STRATEGY_OPTIMIZATION_SERVER_PORT=8009
# RESPONSE_GENERATION_SERVER_PORT=8007
# MEDIA_MANAGEMENT_SERVER_PORT=8006
# REDEVELOPMENT_MESSAGE_GENERATOR_PORT=8008
# SIMPLE_MESSAGE_GENERATOR_PORT=8007
# CONTEXTUAL_MESSAGE_GENERATOR_PORT=8007
# TEST_STUB_SERVER_PORT=8005
# backend/test_api.py 베이스 URL
# CORBU_TEST_API_BASE=http://localhost:5002
# intent_classifier — 컨텍스트/분석 트래킹(선택, 기본은 CORBU_MAIN_API_BASE 와 동일)
# CORBU_CONTEXT_MANAGER_BASE=http://localhost:5002
# CORBU_ANALYTICS_TRACKER_BASE=http://localhost:5002
# backend/test_integrated_api.py 호스트만 (경로 /api/integrated 는 스크립트가 붙임)
# CORBU_INTEGRATED_TEST_BASE=http://localhost:5002
# (호스트만 또는 이미 .../api/integrated 까지 포함해도 됨 — test_integrated_api.py가 정규화)
# 레거시 Flask 분석 서버 (기본 5001, GAEPO_ANALYSIS_PORT)
# GAEPO_ANALYSIS_PORT=5001
# auto_learning_api.py 단독 실행 시 (main_server·GAEPO와 포트 분리)
# AUTO_LEARNING_PORT=5012
# 캐시·모니터·보안·테스트 서버
# CACHE_MANAGER_PORT=8014
# PERFORMANCE_MONITOR_PORT=8013
# SECURITY_MANAGER_PORT=8015
# TEST_SERVER_PORT=5000
# 레거시 통합 API·카카오 DB·실데이터 API
# INTEGRATED_API_SERVER_PORT=8095
# REAL_KAKAO_API_PORT=8003
# CHAT_DATABASE_API_PORT=8002
# 고급 AI·메시지·확장성 (동시에 띄울 때는 PORT로 구분)
# ADVANCED_AI_FEATURES_PORT=8011
# ADVANCED_MESSAGE_GENERATION_PORT=8011
# AI_CONVERSATION_OPTIMIZER_PORT=8011
# SCALABILITY_MANAGER_PORT=8010
# LONG_TERM_PLANNING_PORT=8012
# AI_CONVERSATION_PATTERN_ANALYZER_PORT=8012
