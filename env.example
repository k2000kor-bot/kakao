# SIMPLE_UNIFIED_SERVER_PORT=8000
# UNIFIED_MESSAGE_SYSTEM_PORT=8000
# MAIN_KAKAO_SYSTEM_PORT=8004
# SIMPLE_API_TEST_PORT=8003
# ENHANCED_CONSTRUCTION_API_PORT=8002
# CLOUD_NATIVE_ORCHESTRATION_PORT=8005
