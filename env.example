# NLP_MASTER_SYSTEM_BASE_PORT=8001
# 공통 PORT 폴백 (많은 레거시 스크립트가 전용 변수 다음에 사용)
# UNIFIED_API_LEGACY_PORT=8004
# SIMPLE_API_PORT=8003
# SIMPLE_TEST_SERVER_PORT=8006
# ULTIMATE_INTEGRATED_SERVER_PORT=8000
