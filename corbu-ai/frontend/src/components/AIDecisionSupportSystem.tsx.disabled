const AIDecisionSupportSystem: React.FC = () => {
  const [decisionAnalysis, setDecisionAnalysis] = useState<DecisionAnalysis>(sampleDecisionAnalysis);
  const [selectedOption, setSelectedOption] = useState<DecisionOption | null>(null);
  const [showOptionDialog, setShowOptionDialog] = useState(false);
  const [showAnalysisDialog, setShowAnalysisDialog] = useState(false);
  const [activeTab, setActiveTab] = useState(0);

  // AI 추천 색상
  const getRecommendationColor = (recommendation: string) => {
    switch (recommendation) {
      case 'strongly_recommend': return 'success';
      case 'recommend': return 'primary';
      case 'neutral': return 'warning';
      case 'not_recommend': return 'error';
      case 'strongly_not_recommend': return 'error';
      default: return 'default';
    }
  };

  // 리스크 레벨 색상
  const getRiskColor = (risk: string) => {
    switch (risk) {
      case 'low': return 'success';
      case 'medium': return 'warning';
      case 'high': return 'error';
      default: return 'default';
    }
  };

  // 영향도 색상
  const getImpactColor = (impact: string) => {
    switch (impact) {
      case 'low': return 'info';
      case 'medium': return 'warning';
      case 'high': return 'error';
      default: return 'default';
    }
  };

  // AI 추천 텍스트
  const getRecommendationText = (recommendation: string) => {
    switch (recommendation) {
      case 'strongly_recommend': return '강력 추천';
      case 'recommend': return '추천';
      case 'neutral': return '중립';
      case 'not_recommend': return '비추천';
      case 'strongly_not_recommend': return '강력 비추천';
      default: return '알 수 없음';
    }
  };

  return (
    <Box sx={{ p: 3 }}>
      {/* 헤더 */}
      <Box sx={{ mb: 3, display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
        <Box>
          <Typography variant="h4" component="h1" gutterBottom sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
            <Psychology sx={{ fontSize: 32, color: 'primary.main' }} />
            AI 의사결정 지원 시스템
          </Typography>
          <Typography variant="body1" color="text.secondary">
            AI 기반 데이터 분석을 통한 최적의 의사결정 지원
          </Typography>
        </Box>
        <Box sx={{ display: 'flex', gap: 1 }}>
          <Button
            variant="outlined"
            startIcon={<Refresh />}
            onClick={() => window.location.reload()}
          >
            새로고침
          </Button>
          <Button
            variant="contained"
            startIcon={<AutoAwesome />}
            onClick={() => setShowAnalysisDialog(true)}
          >
            AI 분석 실행
          </Button>
        </Box>
      </Box>

      {/* 의사결정 개요 */}
      <Card sx={{ mb: 3, background: 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)', color: 'white' }}>
        <CardContent>
          <Typography variant="h5" component="h2" gutterBottom>
            {decisionAnalysis.title}
          </Typography>
          <Typography variant="body1" sx={{ mb: 2 }}>
            {decisionAnalysis.description}
          </Typography>
          <Box sx={{ display: 'flex', gap: 2, flexWrap: 'wrap' }}>
            <Chip
              label={`상태: ${decisionAnalysis.status}`}
              color="primary"
              variant="outlined"
            />
            <Chip
              label={`전체 리스크: ${decisionAnalysis.riskAssessment.overallRisk}`}
              color={getRiskColor(decisionAnalysis.riskAssessment.overallRisk) as any}
              variant="outlined"
            />
            <Chip
              label={`ROI: ${decisionAnalysis.costBenefitAnalysis.roi}%`}
              color="success"
              variant="outlined"
            />
            <Chip
              label={`회수 기간: ${decisionAnalysis.costBenefitAnalysis.paybackPeriod}개월`}
              color="info"
              variant="outlined"
            />
          </Box>
        </CardContent>
      </Card>

      {/* 의사결정 옵션 */}
      <Grid container spacing={3} sx={{ mb: 3 }}>
        <Grid item xs={12}>
          <Typography variant="h6" component="h2" gutterBottom>
            의사결정 옵션 분석
          </Typography>
        </Grid>
        
        {decisionAnalysis.options.map((option) => (
          <Grid item xs={12} md={4} key={option.id}>
            <Card sx={{ height: '100%', position: 'relative' }}>
              <CardContent>
                <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start', mb: 2 }}>
                  <Typography variant="h6" component="h3">
                    {option.title}
                  </Typography>
                  <Chip
                    label={getRecommendationText(option.aiRecommendation)}
                    color={getRecommendationColor(option.aiRecommendation) as any}
                    size="small"
                  />
                </Box>
                
                <Typography variant="body2" color="text.secondary" sx={{ mb: 2 }}>
                  {option.description}
                </Typography>
                
                <Box sx={{ display: 'flex', gap: 1, mb: 2, flexWrap: 'wrap' }}>
                  <Chip
                    label={`리스크: ${option.riskLevel}`}
                    color={getRiskColor(option.riskLevel) as any}
                    size="small"
                  />
                  <Chip
                    label={`영향도: ${option.impact}`}
                    color={getImpactColor(option.impact) as any}
                    size="small"
                  />
                  <Chip
                    label={`비용: $${option.cost.toLocaleString()}`}
                    color="primary"
                    size="small"
                  />
                  <Chip
                    label={`기간: ${option.timeToImplement}일`}
                    color="info"
                    size="small"
                  />
                </Box>
                
                <Box sx={{ mb: 2 }}>
                  <Typography variant="body2" color="text.secondary">
                    성공 확률: {option.successProbability}%
                  </Typography>
                  <LinearProgress
                    variant="determinate"
                    value={option.successProbability}
                    color={option.successProbability >= 80 ? 'success' : option.successProbability >= 60 ? 'warning' : 'error'}
                    sx={{ height: 8, borderRadius: 4 }}
                  />
                </Box>
                
                <Box sx={{ mb: 2 }}>
                  <Typography variant="body2" color="text.secondary">
                    AI 신뢰도: {option.aiConfidence}%
                  </Typography>
                  <LinearProgress
                    variant="determinate"
                    value={option.aiConfidence}
                    color="primary"
                    sx={{ height: 8, borderRadius: 4 }}
                  />
                </Box>
                
                <Button
                  variant="outlined"
                  fullWidth
                  onClick={() => {
                    setSelectedOption(option);
                    setShowOptionDialog(true);
                  }}
                >
                  상세 분석
                </Button>
              </CardContent>
            </Card>
          </Grid>
        ))}
      </Grid>

      {/* AI 인사이트 및 권장사항 */}
      <Grid container spacing={3} sx={{ mb: 3 }}>
        <Grid item xs={12} md={6}>
          <Card>
            <CardContent>
              <Typography variant="h6" component="h3" gutterBottom sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                <Lightbulb color="primary" />
                AI 인사이트
              </Typography>
              <List dense>
                {decisionAnalysis.aiInsights.map((insight, index) => (
                  <ListItem key={index} sx={{ px: 0 }}>
                    <ListItemIcon>
                      <Info color="info" />
                    </ListItemIcon>
                    <ListItemText primary={insight} />
                  </ListItem>
                ))}
              </List>
            </CardContent>
          </Card>
        </Grid>
        
        <Grid item xs={12} md={6}>
          <Card>
            <CardContent>
              <Typography variant="h6" component="h3" gutterBottom sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                <AutoAwesome color="primary" />
                AI 권장사항
              </Typography>
              <List dense>
                {decisionAnalysis.recommendations.map((recommendation, index) => (
                  <ListItem key={index} sx={{ px: 0 }}>
                    <ListItemIcon>
                      <CheckCircle color="success" />
                    </ListItemIcon>
                    <ListItemText primary={recommendation} />
                  </ListItem>
                ))}
              </List>
            </CardContent>
          </Card>
        </Grid>
      </Grid>

      {/* 리스크 평가 및 비용편익 분석 */}
      <Grid container spacing={3} sx={{ mb: 3 }}>
        <Grid item xs={12} md={6}>
          <Card>
            <CardContent>
              <Typography variant="h6" component="h3" gutterBottom sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                <Warning color="warning" />
                리스크 평가
              </Typography>
              
              <Box sx={{ mb: 2 }}>
                <Typography variant="body2" color="text.secondary">
                  전체 리스크 레벨: {decisionAnalysis.riskAssessment.overallRisk}
                </Typography>
                <Chip
                  label={decisionAnalysis.riskAssessment.overallRisk}
                  color={getRiskColor(decisionAnalysis.riskAssessment.overallRisk) as any}
                  sx={{ mb: 2 }}
                />
              </Box>
              
              <Typography variant="subtitle2" gutterBottom>
                주요 리스크 요인:
              </Typography>
              <List dense>
                {decisionAnalysis.riskAssessment.riskFactors.map((factor, index) => (
                  <ListItem key={index} sx={{ px: 0 }}>
                    <ListItemIcon>
                      <Error color="error" />
                    </ListItemIcon>
                    <ListItemText primary={factor} />
                  </ListItem>
                ))}
              </List>
              
              <Typography variant="subtitle2" gutterBottom sx={{ mt: 2 }}>
                완화 전략:
              </Typography>
              <List dense>
                {decisionAnalysis.riskAssessment.mitigationStrategies.map((strategy, index) => (
                  <ListItem key={index} sx={{ px: 0 }}>
                    <ListItemIcon>
                      <Security color="success" />
                    </ListItemIcon>
                    <ListItemText primary={strategy} />
                  </ListItem>
                ))}
              </List>
            </CardContent>
          </Card>
        </Grid>
        
        <Grid item xs={12} md={6}>
          <Card>
            <CardContent>
              <Typography variant="h6" component="h3" gutterBottom sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                <Analytics color="primary" />
                비용편익 분석
              </Typography>
              
              <TableContainer component={Paper} variant="outlined">
                <Table size="small">
                  <TableBody>
                    <TableRow>
                      <TableCell><strong>총 비용</strong></TableCell>
                      <TableCell>${decisionAnalysis.costBenefitAnalysis.totalCost.toLocaleString()}</TableCell>
                    </TableRow>
                    <TableRow>
                      <TableCell><strong>총 편익</strong></TableCell>
                      <TableCell>${decisionAnalysis.costBenefitAnalysis.totalBenefit.toLocaleString()}</TableCell>
                    </TableRow>
                    <TableRow>
                      <TableCell><strong>ROI</strong></TableCell>
                      <TableCell>
                        <Chip
                          label={`${decisionAnalysis.costBenefitAnalysis.roi}%`}
                          color="success"
                          size="small"
                        />
                      </TableCell>
                    </TableRow>
                    <TableRow>
                      <TableCell><strong>회수 기간</strong></TableCell>
                      <TableCell>{decisionAnalysis.costBenefitAnalysis.paybackPeriod}개월</TableCell>
                    </TableRow>
                  </TableBody>
                </Table>
              </TableContainer>
            </CardContent>
          </Card>
        </Grid>
      </Grid>

      {/* 옵션 상세 분석 다이얼로그 */}
      <Dialog
        open={showOptionDialog}
        onClose={() => setShowOptionDialog(false)}
        maxWidth="md"
        fullWidth
      >
        {selectedOption && (
          <>
            <DialogTitle>
              <Box sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                <Analytics color="primary" />
                {selectedOption.title} - 상세 분석
              </Box>
            </DialogTitle>
            <DialogContent>
              <Typography variant="body1" sx={{ mb: 2 }}>
                {selectedOption.description}
              </Typography>
              
              <Grid container spacing={2} sx={{ mb: 2 }}>
                <Grid item xs={12} md={6}>
                  <Typography variant="h6" gutterBottom>
                    장점
                  </Typography>
                  <List dense>
                    {selectedOption.pros.map((pro, index) => (
                      <ListItem key={index} sx={{ px: 0 }}>
                        <ListItemIcon>
                          <CheckCircle color="success" />
                        </ListItemIcon>
                        <ListItemText primary={pro} />
                      </ListItem>
                    ))}
                  </List>
                </Grid>
                <Grid item xs={12} md={6}>
                  <Typography variant="h6" gutterBottom>
                    단점
                  </Typography>
                  <List dense>
                    {selectedOption.cons.map((con, index) => (
                      <ListItem key={index} sx={{ px: 0 }}>
                        <ListItemIcon>
                          <Error color="error" />
                        </ListItemIcon>
                        <ListItemText primary={con} />
                      </ListItem>
                    ))}
                  </List>
                </Grid>
              </Grid>
              
              <Box sx={{ display: 'flex', gap: 2, mb: 2, flexWrap: 'wrap' }}>
                <Chip
                  label={`AI 추천: ${getRecommendationText(selectedOption.aiRecommendation)}`}
                  color={getRecommendationColor(selectedOption.aiRecommendation) as any}
                />
                <Chip
                  label={`AI 신뢰도: ${selectedOption.aiConfidence}%`}
                  color="primary"
                />
                <Chip
                  label={`성공 확률: ${selectedOption.successProbability}%`}
                  color={selectedOption.successProbability >= 80 ? 'success' : 'warning'}
                />
              </Box>
            </DialogContent>
            <DialogActions>
              <Button onClick={() => setShowOptionDialog(false)}>
                닫기
              </Button>
              <Button variant="contained" color="primary">
                이 옵션 선택
              </Button>
            </DialogActions>
          </>
        )}
      </Dialog>

      {/* AI 분석 실행 다이얼로그 */}
      <Dialog
        open={showAnalysisDialog}
        onClose={() => setShowAnalysisDialog(false)}
        maxWidth="lg"
        fullWidth
      >
        <DialogTitle>
          <Box sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
            <AutoAwesome color="primary" />
            AI 의사결정 분석 실행
          </Box>
        </DialogTitle>
        <DialogContent>
          <Alert severity="info" sx={{ mb: 2 }}>
            AI가 최신 데이터와 시장 트렌드를 분석하여 의사결정을 지원합니다.
          </Alert>
          
          <Typography variant="body1" sx={{ mb: 2 }}>
            분석이 완료되면 더 정확한 추천과 인사이트를 제공받을 수 있습니다.
          </Typography>
          
          <LinearProgress sx={{ mb: 2 }} />
          
          <Typography variant="body2" color="text.secondary">
            분석 진행 중... 잠시만 기다려주세요.
          </Typography>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setShowAnalysisDialog(false)}>
            취소
          </Button>
          <Button variant="contained" color="primary">
            분석 시작
          </Button>
        </DialogActions>
      </Dialog>
    </Box>
  );
};

export default AIDecisionSupportSystem;
