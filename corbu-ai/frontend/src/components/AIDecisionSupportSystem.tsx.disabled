// 의사결정 데이터 인터페이스
interface DecisionOption {
  id: string;
  title: string;
  description: string;
  pros: string[];
  cons: string[];
  riskLevel: 'low' | 'medium' | 'high';
  impact: 'low' | 'medium' | 'high';
  cost: number;
  timeToImplement: number; // days
  successProbability: number; // 0-100
  aiRecommendation: 'strongly_recommend' | 'recommend' | 'neutral' | 'not_recommend' | 'strongly_not_recommend';
  aiConfidence: number; // 0-100
  tags: string[];
  createdAt: Date;
  updatedAt: Date;
}

interface DecisionCriteria {
  id: string;
  name: string;
  weight: number; // 0-100
  type: 'cost' | 'benefit' | 'risk' | 'time' | 'quality';
  description: string;
}

interface DecisionAnalysis {
  id: string;
  title: string;
  description: string;
  options: DecisionOption[];
  criteria: DecisionCriteria[];
  aiInsights: string[];
  recommendations: string[];
  riskAssessment: {
    overallRisk: 'low' | 'medium' | 'high';
    riskFactors: string[];
    mitigationStrategies: string[];
  };
  costBenefitAnalysis: {
    totalCost: number;
    totalBenefit: number;
    roi: number;
    paybackPeriod: number;
  };
  timeline: {
    startDate: Date;
    endDate: Date;
    milestones: Array<{
      id: string;
      title: string;
      date: Date;
      status: 'pending' | 'in_progress' | 'completed' | 'delayed';
    }>;
  };
  stakeholders: Array<{
    id: string;
    name: string;
    role: string;
    influence: 'high' | 'medium' | 'low';
    support: 'support' | 'neutral' | 'oppose';
  }>;
  status: 'draft' | 'analysis' | 'review' | 'approved' | 'implemented' | 'cancelled';
  createdAt: Date;
  updatedAt: Date;
}

