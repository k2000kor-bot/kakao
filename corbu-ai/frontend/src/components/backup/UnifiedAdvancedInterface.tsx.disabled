import React, { useState, useEffect, useRef, useCallback } from 'react';
import { useSelector } from 'react-redux';
import {
    Send,
    Plus,
    Search,
    Share2,
    X,
    Bot,
    BarChart,
    Settings,
    Folder,
    ChevronDown,
    Lightbulb,
    Clock,
    MessageSquare,
    Paperclip,
    Mic
} from 'lucide-react';
import { AppDispatch, RootState } from '../store';
import { aiService, NLPAnalysis } from '../services/aiService';
import { simpleAdvancedAIService, SimpleAdvancedAIResponse } from '../services/simpleAdvancedAIService';
import { advancedQuestionAnalyzer, QuestionDecomposition, MultiLayerAnalysis, ResponseStrategy } from '../services/advancedQuestionAnalyzer';
import { knowledgeIntegrationService, IntegratedKnowledge } from '../services/knowledgeIntegrationService';
import { intelligentResponseEngine, QuestionContext, IntelligentResponse } from '../services/intelligentResponseEngine';
import { advancedConversationProcessor } from '../services/advancedConversationProcessor';
import NewsSearch from './News/NewsSearch';
import AdvancedAIPanel from './AdvancedAIPanel';

interface Message {
    id: string;
    type: 'user' | 'ai';
    content: string;
    timestamp: Date;
    projectId?: string;
    attachments?: Array<{
        id: string;
        name: string;
        type: string;
        size: number;
        url?: string;
    }>;
    metadata?: {
        model?: string;
        tokens?: number;
        responseTime?: number;
        confidence?: number;
        quality?: {
            relevance: number;
            depth: number;
            clarity: number;
            helpfulness: number;
        };
    };
}

interface Project {
    id: string;
    name: string;
    type: 'project' | 'chat';
    isSelected?: boolean;
    subItems?: string[];
}

const UnifiedAdvancedInterface: React.FC = () => {

    const { selectedAIModel } = useSelector((state: RootState) => state.ui);

    // 기본 상태 관리
    const [currentMode, setCurrentMode] = useState('chat');
    const [messages, setMessages] = useState<Message[]>([]);
    const [inputMessage, setInputMessage] = useState('');
    const [selectedProject, setSelectedProject] = useState<Project | null>(null);

    const [isSending, setIsSending] = useState(false);
    const [inputError, setInputError] = useState('');
    const [isDragOver, setIsDragOver] = useState(false);
    const [attachedFiles, setAttachedFiles] = useState<Array<{
        id: string;
        name: string;
        type: string;
        size: number;
        url?: string;
    }>>([]);
    const [inputStats, setInputStats] = useState({
        wordCount: 0,
        charCount: 0,
        readingTime: 0
    });
    const [inputQuality, setInputQuality] = useState({
        score: 0,
        suggestions: [] as string[],
        feedback: '분석 중...'
    });

    // 입력 분석 패널 상태
    const [showInputAnalysis, setShowInputAnalysis] = useState(false);

    // 뉴스 검색 상태
    const [showNewsSearch, setShowNewsSearch] = useState(false);
    const [newsAPIKey, setNewsAPIKey] = useState('');

    // 고급 NLP 분석 상태
    const [nlpAnalysis, setNlpAnalysis] = useState<NLPAnalysis | null>(null);
    const [showNLPAnalysis, setShowNLPAnalysis] = useState(false);
    const [autoAnalysisEnabled] = useState(true);

    // 고도화된 질문 분석 상태
    const [questionDecomposition, setQuestionDecomposition] = useState<QuestionDecomposition | null>(null);
    const [multiLayerAnalysis, setMultiLayerAnalysis] = useState<MultiLayerAnalysis | null>(null);
    const [responseStrategy, setResponseStrategy] = useState<ResponseStrategy | null>(null);
    const [integratedKnowledge, setIntegratedKnowledge] = useState<IntegratedKnowledge | null>(null);
    const [showAdvancedAnalysis, setShowAdvancedAnalysis] = useState(false);
    const [isPerformingAdvancedAnalysis, setIsPerformingAdvancedAnalysis] = useState(false);

    // 지능형 응답 엔진 상태
    const [questionContext, setQuestionContext] = useState<QuestionContext | null>(null);
    const [intelligentResponse, setIntelligentResponse] = useState<IntelligentResponse | null>(null);
    const [showIntelligentAnalysis, setShowIntelligentAnalysis] = useState(false);
    const [isGeneratingIntelligentResponse, setIsGeneratingIntelligentResponse] = useState(false);

    // 고급 AI 시스템 상태
    const [advancedAIResponse, setAdvancedAIResponse] = useState<SimpleAdvancedAIResponse | null>(null);
    const [showAdvancedAI, setShowAdvancedAI] = useState(false);
    const [userProfile, setUserProfile] = useState<{
        expertise: string[];
        interests: string[];
        communicationStyle: string;
        responsePreference: string;
        totalInteractions: number;
    } | null>(null);
    const [learningProgress, setLearningProgress] = useState({
        totalInteractions: 0,
        learningScore: 0,
        adaptationLevel: 0,
        confidence: 0
    });

    // 분석 모드
    const [analysisMode] = useState<'basic' | 'advanced' | 'ai-powered'>('ai-powered');

    // 프로젝트 데이터
    const [projects] = useState<Project[]>([
        { id: '1', name: 'AI 개발 프로젝트', type: 'project', subItems: ['프론트엔드', '백엔드', 'AI 모델'] },
        { id: '2', name: '뉴스 분석', type: 'project', subItems: ['키워드 분석', '감정 분석', '트렌드 분석'] },
        { id: '3', name: '일반 대화', type: 'chat' }
    ]);

    // API 키 관리
    const [apiKeys] = useState({
        gemini: '',
        openai: '',
        anthropic: ''
    });

    const messagesEndRef = useRef<HTMLDivElement>(null);
    const inputRef = useRef<HTMLTextAreaElement>(null);

    // 자동 스크롤
    useEffect(() => {
        messagesEndRef.current?.scrollIntoView({ behavior: 'smooth' });
    }, [messages]);

    // 입력 통계 계산
    useEffect(() => {
        if (inputMessage) {
            const words = inputMessage.trim().split(/\s+/).length;
            const chars = inputMessage.length;
            const readingTime = Math.ceil(words / 200); // 분당 200단어 기준

            setInputStats({
                wordCount: words,
                charCount: chars,
                readingTime
            });

            // 입력 품질 점수 계산
            const qualityScore = Math.min(100, Math.max(0,
                (chars > 10 ? 20 : 0) +
                (words > 2 ? 30 : 0) +
                (inputMessage.includes('?') ? 20 : 0) +
                (inputMessage.length < 1000 ? 30 : 0)
            ));

            setInputQuality({
                score: qualityScore,
                suggestions: [],
                feedback: qualityScore > 80 ? '우수한 입력' : qualityScore > 60 ? '양호한 입력' : '개선 필요'
            });
        }
    }, [inputMessage]);

    // 고급 NLP 분석 실행
    const performNLPAnalysis = useCallback(async (message: string) => {
        if (!autoAnalysisEnabled || !message.trim()) return null;

        try {
            const analysis = await aiService.analyzeWithNLP(message, selectedAIModel);
            setNlpAnalysis(analysis);
            setShowNLPAnalysis(true);
            return analysis;
        } catch (error) {
            console.error('NLP 분석 실패:', error);
            return null;
        }
    }, [autoAnalysisEnabled, selectedAIModel]);

    // 고도화된 질문 분석 수행
    const performAdvancedQuestionAnalysis = useCallback(async (message: string) => {
        if (!message.trim()) return null;

        setIsPerformingAdvancedAnalysis(true);
        try {
            // 1. 질문 분해 분석
            const decomposition = await advancedQuestionAnalyzer.decomposeQuestion(message);
            setQuestionDecomposition(decomposition);

            // 2. 다층적 분석
            const multiLayer = await advancedQuestionAnalyzer.performMultiLayerAnalysis(message);
            setMultiLayerAnalysis(multiLayer);

            // 3. 응답 전략 생성
            const strategy = await advancedQuestionAnalyzer.generateResponseStrategy(decomposition, multiLayer);
            setResponseStrategy(strategy);

            // 4. 지식 통합 (웹 검색 결과와 함께)
            const conversationHistory = messages.map(m => m.content);
            const integrated = await knowledgeIntegrationService.integrateKnowledge(
                message,
                {
                    questionType: 'explanatory', // 기본값, 실제로는 decomposition에서 추출
                    complexity: 'moderate',
                    context: { domain: [], timeframe: null, scope: 'general', background: [] },
                    intent: { primary: 'information_seeking', secondary: [], implicitNeeds: [], expectedDepth: 'detailed' },
                    logicalStructure: { premises: [], conclusions: [], relationships: [], gaps: [] },
                    requirements: { informationTypes: [], evidenceNeeded: [], formatPreferences: [], constraints: [] }
                },
                [], // 웹 검색 결과 (추후 연동)
                [], // 뉴스 결과 (추후 연동)
                conversationHistory
            );
            setIntegratedKnowledge(integrated);

            setShowAdvancedAnalysis(true);
            return { decomposition, multiLayer, strategy, integrated };
        } catch (error) {
            console.error('고도화된 질문 분석 실패:', error);
            return null;
        } finally {
            setIsPerformingAdvancedAnalysis(false);
        }
    }, [messages]);

    // 🚀 지능형 응답 생성 수행
    const performIntelligentResponseGeneration = useCallback(async (message: string) => {
        if (!message.trim()) return null;

        setIsGeneratingIntelligentResponse(true);
        try {
            // 1. 질문 컨텍스트 분석
            const context = await intelligentResponseEngine.analyzeQuestionContext(message);
            setQuestionContext(context);

            // 2. 응답 전략 생성
            const strategy = await intelligentResponseEngine.generateResponseStrategy(context);

            // 3. 지능형 응답 생성
            const response = await intelligentResponseEngine.generateIntelligentResponse(context, strategy, {
                newsResults: [], // 추후 뉴스 API 연동
                webSearchResults: [] // 추후 웹 검색 연동
            });
            setIntelligentResponse(response);

            setShowIntelligentAnalysis(true);
            return { context, strategy, response };
        } catch (error) {
            console.error('지능형 응답 생성 실패:', error);
            return null;
        } finally {
            setIsGeneratingIntelligentResponse(false);
        }
    }, []);

    // 고급 AI 응답 생성
    const generateAdvancedAIResponse = useCallback(async (message: string, baseResponse: string, nlpAnalysis: NLPAnalysis) => {
        try {
            const userId = 'current-user';
            const advancedResponse = await simpleAdvancedAIService.generateAdvancedResponse(
                message,
                userId,
                baseResponse,
                nlpAnalysis
            );

            setAdvancedAIResponse(advancedResponse);
            setShowAdvancedAI(true);

            // 사용자 프로필 업데이트
            const profile = simpleAdvancedAIService.getUserProfile(userId);
            setUserProfile(profile);

            // 학습 진행률 업데이트
            setLearningProgress({
                totalInteractions: profile?.totalInteractions || 0,
                learningScore: advancedResponse.learningScore,
                adaptationLevel: advancedResponse.adaptationLevel,
                confidence: advancedResponse.confidence
            });

            return advancedResponse;
        } catch (error) {
            console.error('고급 AI 응답 생성 실패:', error);
            return null;
        }
    }, []);

    // 키워드 기반 자동 분석 및 응답 생성
    const generateKeywordBasedResponse = useCallback(async (message: string, analysis: NLPAnalysis) => {
        const lowerMessage = message.toLowerCase();

        // 원베일리 관련 자동 분석
        if (lowerMessage.includes('원베일리')) {
            return `🏢 **원베일리 아파트 하자 문제 종합 분석**

📊 **분석 결과 요약**
${analysis.summary}

🔍 **주요 키워드**
${analysis.keywords.slice(0, 5).map(keyword => `• ${keyword}`).join('\n')}

📈 **감정 분석**
• 전반적 감정: ${analysis.sentiment === 'positive' ? '긍정적' : analysis.sentiment === 'negative' ? '부정적' : '중립적'}

🏗️ **관련 주제**
${analysis.topics.map(topic => `• ${topic}`).join('\n')}

💡 **추천사항**
${analysis.recommendations.slice(0, 3).map(rec => `• ${rec}`).join('\n')}

🔗 **관련 정보**
• 뉴스 검색을 통해 최신 기사 확인 가능
• 댓글 분석으로 여론 동향 파악 가능
• 전문가 의견 및 해결책 제시

📰 **최신 뉴스 확인**
뉴스 검색 기능을 사용하여 "원베일리 하자" 관련 최신 기사를 확인하실 수 있습니다.`;
        }

        return null;
    }, []);

    // 🚀 고도화된 메시지 전송 및 복합 요구사항 처리
    const handleSendMessage = useCallback(async () => {
        if (!inputMessage.trim() || isSending) return;

        const userMessage: Message = {
            id: Date.now().toString(),
            type: 'user',
            content: inputMessage,
            timestamp: new Date(),
            projectId: selectedProject?.id,
            attachments: attachedFiles.length > 0 ? attachedFiles : undefined
        };

        setMessages(prev => [...prev, userMessage]);

        setInputMessage('');
        setAttachedFiles([]); // 첨부파일 초기화
        setIsSending(true);

        try {
            // API 키 설정
            if (apiKeys.gemini) {
                aiService.setAPIKey('gemini-pro', apiKeys.gemini);
            }

            // 🧠 새로운 고도화된 대화 처리 시스템 사용
            console.log('🚀 고도화된 대화 처리 시작:', inputMessage);
            const sessionId = selectedProject?.id || 'default-session';

            const enhancedResponse = await advancedConversationProcessor.processComplexUserInput(
                inputMessage,
                sessionId,
                {
                    previousMessages: messages,
                    attachedFiles: attachedFiles,
                    userPreferences: {
                        responseStyle: 'detailed',
                        includeExamples: true,
                        preferredLength: 'comprehensive'
                    }
                }
            );

            console.log('✨ 고도화된 응답 생성 완료:', enhancedResponse);

            // 🚀 기존 분석들도 병렬로 수행 (호환성 유지)
            const [advancedAnalysis, intelligentAnalysis, nlpAnalysis] = await Promise.all([
                performAdvancedQuestionAnalysis(inputMessage),
                performIntelligentResponseGeneration(inputMessage),
                performNLPAnalysis(inputMessage)
            ]);

            // 키워드 기반 자동 기능 활성화
            const lowerMessage = inputMessage.toLowerCase();
            let autoActivatedFeatures: string[] = [];
            let keywordResponse: string | null = null;

            // 원베일리 관련 자동 처리
            if (lowerMessage.includes('원베일리')) {
                autoActivatedFeatures.push('뉴스 검색', '댓글 분석', '시장 분석');
                setShowNewsSearch(true);

                if (nlpAnalysis) {
                    keywordResponse = await generateKeywordBasedResponse(inputMessage, nlpAnalysis);
                }


            }

            // 고급 AI 응답 생성 (NLP 분석 결과 포함)
            const userId = 'current-user';
            const enhancedContext = `
현재 모드: ${currentMode}
분석 모드: ${analysisMode}
NLP 분석: ${nlpAnalysis ? '완료' : '미완료'}
자동 활성화 기능: ${autoActivatedFeatures.join(', ')}
키워드: ${nlpAnalysis?.keywords.slice(0, 5).join(', ') || '없음'}
감정: ${nlpAnalysis?.sentiment || '분석 중'}
주제: ${nlpAnalysis?.topics.join(', ') || '분석 중'}
            `.trim();

            const response = await aiService.generateResponse(
                inputMessage,
                selectedAIModel,
                userId,
                enhancedContext
            );

            // 🎯 고도화된 AI 응답 생성 (새로운 복합 처리 시스템 통합)
            let finalContent = enhancedResponse.mainResponse;

            // 🚀 복합 요구사항 처리 결과 통합
            if (enhancedResponse.requirementResponses.size > 0) {
                const requirementDetails = Array.from(enhancedResponse.requirementResponses.entries())
                    .map(([id, reqResponse]) => {
                        return `
🎯 **요구사항 ${id}**
${reqResponse.response}
• 신뢰도: ${Math.round(reqResponse.confidence * 100)}%
• 처리 방법: ${reqResponse.processingMethod}
• 품질 지표: 완성도 ${Math.round(reqResponse.qualityMetrics.completeness * 100)}%, 정확성 ${Math.round(reqResponse.qualityMetrics.accuracy * 100)}%
                        `.trim();
                    }).join('\n\n');

                finalContent = `${finalContent}\n\n---\n\n${requirementDetails}`;
            }

            // 🔗 맥락적 연결 정보 추가
            if (enhancedResponse.contextualConnections.length > 0) {
                const connections = enhancedResponse.contextualConnections
                    .map(conn => `• ${conn.explanation} (연결 강도: ${Math.round(conn.strength * 100)}%)`)
                    .join('\n');

                finalContent = `${finalContent}\n\n🔗 **요구사항 간 연결**\n${connections}`;
            }

            // 💡 후속 제안 추가
            if (enhancedResponse.followUpSuggestions.length > 0) {
                const suggestions = enhancedResponse.followUpSuggestions
                    .slice(0, 3)
                    .map(sugg => `• ${sugg.suggestion} (관련도: ${Math.round(sugg.relevance * 100)}%)`)
                    .join('\n');

                finalContent = `${finalContent}\n\n💡 **추천 후속 질문**\n${suggestions}`;
            }

            // 📊 전체 신뢰도 메트릭 추가
            const confidenceInfo = `
📊 **응답 신뢰도 분석**
• 전체 신뢰도: ${Math.round(enhancedResponse.confidenceMetrics.overallConfidence * 100)}%
• 요구사항 이해도: ${Math.round(enhancedResponse.confidenceMetrics.requirementUnderstanding * 100)}%
• 맥락 정확도: ${Math.round(enhancedResponse.confidenceMetrics.contextualAccuracy * 100)}%
• 응답 완성도: ${Math.round(enhancedResponse.confidenceMetrics.responseCompleteness * 100)}%
• 사용자 만족도 예측: ${Math.round(enhancedResponse.confidenceMetrics.userSatisfactionPrediction * 100)}%
            `.trim();

            finalContent = `${finalContent}\n\n${confidenceInfo}`;

            // 🚀 강화된 AI 응답 생성
            const enhancedPrompt = `
사용자 질문: "${inputMessage}"

이전 대화 맥락: ${messages.slice(-3).map(m => `${m.type}: ${m.content}`).join('\n')}

첨부파일: ${attachedFiles.length > 0 ? attachedFiles.map(f => f.name).join(', ') : '없음'}

요구사항:
1. 정확하고 상세한 답변을 제공하세요
2. 사용자의 질문 의도를 정확히 파악하세요
3. 필요한 경우 예시나 설명을 포함하세요
4. 전문적이면서도 이해하기 쉽게 작성하세요
5. 한국어로 자연스럽게 답변하세요

답변 형식:
- 명확한 구조화된 답변
- 필요한 경우 단계별 설명
- 관련 예시나 참고사항 포함
- 사용자가 추가 질문할 수 있도록 마무리
            `;

            const aiGeneratedResponse = await aiService.generateResponse(
                enhancedPrompt,
                selectedAIModel,
                userId,
                enhancedContext
            );

            // 키워드 기반 응답이 있으면 통합
            if (keywordResponse) {
                finalContent = `${finalContent}\n\n---\n\n**🔍 키워드 기반 분석**\n${keywordResponse}`;
            }

            // 강화된 AI 응답 통합
            finalContent = `${finalContent}\n\n---\n\n**🤖 AI 답변**\n${aiGeneratedResponse.content}`;

            // 고급 AI 응답 생성
            let advancedResponse = null;
            if (nlpAnalysis) {
                advancedResponse = await generateAdvancedAIResponse(inputMessage, finalContent, nlpAnalysis);
            }

            // 고도화된 분석 결과가 있으면 추가 정보 포함
            if (advancedAnalysis && questionDecomposition) {
                const advancedInfo = `
🔍 **고도화된 질문 분석**
• 질문 복잡도: ${questionDecomposition.overallComplexity}/10
• 구성 요소: ${questionDecomposition.components.length}개
• 예상 응답 길이: ${questionDecomposition.estimatedResponseLength}
• 필요 역량: ${questionDecomposition.requiredCapabilities.slice(0, 3).join(', ')}

📋 **질문 구성 요소**
${questionDecomposition.components.slice(0, 3).map((comp, idx) =>
                    `${idx + 1}. [${comp.type}] ${comp.content.substring(0, 50)}... (우선순위: ${comp.priority})`
                ).join('\n')}

🎯 **응답 전략**
${responseStrategy ? `• 톤: ${responseStrategy.tone}\n• 깊이: ${responseStrategy.depth}` : '• 분석 중...'}
            `.trim();

                finalContent = `${finalContent}\n\n${advancedInfo}`;
            }

            // 🚀 지능형 응답 결과가 있으면 추가 정보 포함
            if (intelligentAnalysis && intelligentResponse) {
                const intelligentInfo = `
🤖 **지능형 응답 분석**
• 질문 유형: ${questionContext?.questionType || '분석 중'}
• 복잡도: ${questionContext?.complexity || 0}/10
• 도메인: ${questionContext?.domain.join(', ') || '일반'}
• 의도: ${questionContext?.intent.primary || '분석 중'}

📊 **응답 품질 지표**
• 관련성: ${Math.round(intelligentResponse.qualityMetrics.relevance * 100)}%
• 완성도: ${Math.round(intelligentResponse.qualityMetrics.completeness * 100)}%
• 정확성: ${Math.round(intelligentResponse.qualityMetrics.accuracy * 100)}%
• 명확성: ${Math.round(intelligentResponse.qualityMetrics.clarity * 100)}%
• 유용성: ${Math.round(intelligentResponse.qualityMetrics.usefulness * 100)}%

💡 **추천 후속 질문**
${intelligentResponse.followUpSuggestions.slice(0, 2).map(suggestion => `• ${suggestion}`).join('\n')}
            `.trim();

                finalContent = `${finalContent}\n\n${intelligentInfo}`;
            }

            // NLP 분석 결과가 있으면 추가 정보 포함
            if (nlpAnalysis) {
                const nlpAnalysisInfo = `
📊 **NLP 분석 결과**
• 감정: ${nlpAnalysis.sentiment === 'positive' ? '😊 긍정적' : nlpAnalysis.sentiment === 'negative' ? '😔 부정적' : '😐 중립적'}
• 주요 키워드: ${nlpAnalysis.keywords.slice(0, 3).join(', ')}
• 관련 주제: ${nlpAnalysis.topics.join(', ')}
• 자동 활성화 기능: ${autoActivatedFeatures.join(', ')}

💡 **추천사항**
${nlpAnalysis.recommendations.slice(0, 2).map(rec => `• ${rec}`).join('\n')}
            `.trim();

                finalContent = `${finalContent}\n\n${nlpAnalysisInfo}`;
            }

            // 고급 AI 분석 결과가 있으면 추가
            if (advancedResponse) {
                const advancedInfo = `
🤖 **고급 AI 분석**
• 신뢰도: ${Math.round(advancedResponse.confidence * 100)}%
• 학습 점수: ${Math.round(advancedResponse.learningScore * 100)}%
• 적응 수준: ${Math.round(advancedResponse.adaptationLevel * 100)}%

🎯 **다음 액션**
${advancedResponse.nextActions.slice(0, 2).map(action => `• ${action}`).join('\n')}
                `.trim();

                finalContent = `${finalContent}\n\n${advancedInfo}`;
            }

            const aiMessage: Message = {
                id: (Date.now() + 1).toString(),
                type: 'ai',
                content: finalContent,
                timestamp: new Date(),
                projectId: selectedProject?.id,
                metadata: {
                    model: selectedAIModel,
                    tokens: aiGeneratedResponse.tokens || 0,
                    responseTime: aiGeneratedResponse.responseTime || 0,
                    confidence: enhancedResponse.confidenceMetrics.overallConfidence,
                    quality: {
                        relevance: enhancedResponse.confidenceMetrics.requirementUnderstanding,
                        depth: enhancedResponse.confidenceMetrics.contextualAccuracy,
                        clarity: enhancedResponse.confidenceMetrics.responseCompleteness,
                        helpfulness: enhancedResponse.confidenceMetrics.userSatisfactionPrediction
                    }
                }
            };

            setMessages(prev => [...prev, aiMessage]);

            // 🎉 고도화된 성공 알림 (NLP 분석 정보 포함)
            const qualityScore = Math.round(response.quality.helpfulness * 100);
            const nlpInfo = nlpAnalysis ? ` | NLP 분석 완료 (${nlpAnalysis.keywords.length}개 키워드, ${nlpAnalysis.sentiment} 감정)` : '';
            const featureInfo = autoActivatedFeatures.length > 0 ? ` | 자동 활성화: ${autoActivatedFeatures.join(', ')}` : '';

            // setNotifications(prev => [...prev, {
            //     id: Date.now().toString(),
            //     type: 'success',
            //     message: `${selectedAIModel} 모델로 고품질 응답을 생성했습니다. (품질 점수: ${qualityScore}%)${nlpInfo}${featureInfo}`,
            //     timestamp: new Date().toLocaleTimeString(),
            //     read: false
            // }]);

        } catch (error) {
            console.error('메시지 전송 실패:', error);
            // setNotifications(prev => [...prev, {
            //     id: Date.now().toString(),
            //     type: 'error',
            //     message: `AI 응답 생성 실패: ${error instanceof Error ? error.message : '알 수 없는 오류'}`,
            //     timestamp: new Date().toLocaleTimeString(),
            //     read: false
            // }]);

            const errorMessage: Message = {
                id: (Date.now() + 1).toString(),
                type: 'ai',
                content: `죄송합니다. AI 응답을 생성하는 중에 오류가 발생했습니다. API 키가 올바르게 설정되어 있는지 확인해주세요.`,
                timestamp: new Date(),
                projectId: selectedProject?.id
            };
            setMessages(prev => [...prev, errorMessage]);
        } finally {
            setIsSending(false);
        }
    }, [inputMessage, isSending, selectedAIModel, selectedProject, currentMode, analysisMode, apiKeys.gemini, performNLPAnalysis, generateKeywordBasedResponse, generateAdvancedAIResponse, performAdvancedQuestionAnalysis, performIntelligentResponseGeneration]);

    // 입력 처리
    const handleInputChange = useCallback((e: React.ChangeEvent<HTMLTextAreaElement>) => {
        setInputMessage(e.target.value);
        setInputError('');
    }, []);

    const handleKeyPress = useCallback((e: React.KeyboardEvent) => {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            handleSendMessage();
        }
    }, [handleSendMessage]);

    // 드래그 앤 드롭
    const handleDragOver = useCallback((e: React.DragEvent) => {
        e.preventDefault();
        setIsDragOver(true);
    }, []);

    const handleDragLeave = useCallback((e: React.DragEvent) => {
        e.preventDefault();
        setIsDragOver(false);
    }, []);

    const handleDrop = useCallback((e: React.DragEvent) => {
        e.preventDefault();
        setIsDragOver(false);

        const files = Array.from(e.dataTransfer.files);

        // 지원되는 파일 형식 필터링
        const supportedFiles = files.filter(file => {
            const extension = file.name.split('.').pop()?.toLowerCase();
            const supportedTypes = [
                'txt', 'pdf', 'doc', 'docx', 'xls', 'xlsx', 'ppt', 'pptx',
                'jpg', 'jpeg', 'png', 'gif', 'bmp', 'webp',
                'mp4', 'avi', 'mov', 'wmv', 'mp3', 'wav', 'flac', 'aac'
            ];
            return supportedTypes.includes(extension || '') || file.type.startsWith('image/') || file.type.startsWith('video/') || file.type.startsWith('audio/');
        });

        if (supportedFiles.length === 0) {
            alert('지원되지 않는 파일 형식입니다. 문서, 이미지, 미디어 파일만 첨부 가능합니다.');
            return;
        }

        const newAttachments = supportedFiles.map((file, index) => ({
            id: `file-${Date.now()}-${index}`,
            name: file.name,
            type: file.type,
            size: file.size,
            url: URL.createObjectURL(file)
        }));

        setAttachedFiles(prev => [...prev, ...newAttachments]);

        // 성공 메시지 (선택적)
        if (supportedFiles.length > 0) {
            console.log(`${supportedFiles.length}개 파일이 성공적으로 첨부되었습니다.`);
        }
    }, []);

    return (
        <div className="flex h-screen bg-gray-50" data-component="UnifiedAdvancedInterface">
            {/* 컴포넌트 식별자 - 개발용 */}
            <div className="fixed top-0 right-0 bg-blue-500 text-white px-2 py-1 text-xs z-50">
                UnifiedAdvancedInterface 컴포넌트
            </div>
            {/* 사이드바 */}
            <div className="w-80 bg-white border-r border-gray-200 flex flex-col">
                {/* 헤더 */}
                <div className="p-4 border-b border-gray-200">
                    <div className="flex items-center space-x-3">
                        <Bot className="h-8 w-8 text-purple-600" />
                        <div>
                            <h1 className="text-lg font-bold text-gray-900">CORBU.AI</h1>
                            <p className="text-sm text-gray-500">통합 고도화 시스템</p>
                        </div>
                    </div>
                </div>

                {/* 네비게이션 */}
                <div className="flex-1 overflow-y-auto p-4">
                    {/* 모드 선택 */}
                    <div className="mb-6">
                        <h3 className="text-sm font-medium text-gray-700 mb-3">모드</h3>
                        <div className="space-y-2">
                            {[
                                { id: 'chat', name: '대화', icon: MessageSquare, color: 'text-blue-600' },
                                { id: 'analytics', name: '분석', icon: BarChart, color: 'text-green-600' },
                                { id: 'monitoring', name: '모니터링', icon: Clock, color: 'text-purple-600' },
                                { id: 'news', name: '뉴스 검색', icon: Search, color: 'text-orange-600' }
                            ].map((mode) => {
                                const IconComponent = mode.icon;
                                return (
                                    <button
                                        key={mode.id}
                                        onClick={() => setCurrentMode(mode.id)}
                                        className={`w-full flex items-center space-x-3 p-3 rounded-lg transition-colors ${currentMode === mode.id
                                            ? 'bg-purple-50 text-purple-700 border border-purple-200'
                                            : 'hover:bg-gray-50 text-gray-700'
                                            }`}
                                    >
                                        <IconComponent className={`h-5 w-5 ${mode.color}`} />
                                        <span className="font-medium">{mode.name}</span>
                                    </button>
                                );
                            })}
                        </div>
                    </div>

                    {/* 프로젝트 */}
                    <div className="mb-6">
                        <div className="flex items-center justify-between mb-3">
                            <h3 className="text-sm font-medium text-gray-700">프로젝트</h3>
                            <button
                                onClick={() => {/* setShowNewProjectModal(true) */ }}
                                className="p-1 hover:bg-gray-100 rounded"
                            >
                                <Plus className="h-4 w-4 text-gray-500" />
                            </button>
                        </div>
                        <div className="space-y-1">
                            {projects.map((project) => (
                                <div key={project.id}>
                                    <button
                                        onClick={() => setSelectedProject(project)}
                                        className={`w-full flex items-center space-x-3 p-2 rounded-lg transition-colors ${selectedProject?.id === project.id
                                            ? 'bg-blue-50 text-blue-700 border border-blue-200'
                                            : 'hover:bg-gray-50 text-gray-700'
                                            }`}
                                    >
                                        <Folder className="h-4 w-4" />
                                        <span className="font-medium">{project.name}</span>
                                        {project.subItems && (
                                            <ChevronDown className="h-4 w-4 ml-auto" />
                                        )}
                                    </button>
                                </div>
                            ))}
                        </div>
                    </div>
                </div>
            </div>

            {/* 메인 콘텐츠 */}
            <div className="flex-1 flex flex-col">
                {/* 헤더 */}
                <div className="bg-white border-b border-gray-200 p-4">
                    <div className="flex items-center justify-between">
                        <div className="flex items-center space-x-4">
                            <h2 className="text-xl font-semibold text-gray-900">
                                {currentMode === 'chat' && '대화'}
                                {currentMode === 'analytics' && '대화 분석'}
                                {currentMode === 'monitoring' && '시스템 모니터링'}
                                {currentMode === 'news' && '뉴스 검색'}
                            </h2>
                            {selectedProject && (
                                <span className="px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-sm">
                                    {selectedProject.name}
                                </span>
                            )}
                        </div>
                        <div className="flex items-center space-x-2">


                            <button
                                onClick={() => setShowNewsSearch(!showNewsSearch)}
                                className={`p-2 rounded-lg transition-colors ${showNewsSearch ? 'bg-blue-100 text-blue-600' : 'hover:bg-gray-100 text-gray-500'}`}
                                title="뉴스 검색 및 댓글 분석"
                            >
                                <Search className="h-5 w-5" />
                            </button>
                            <button
                                onClick={() => setShowNLPAnalysis(!showNLPAnalysis)}
                                className={`p-2 rounded-lg transition-colors ${showNLPAnalysis ? 'bg-purple-100 text-purple-600' : 'hover:bg-gray-100 text-gray-500'}`}
                                title="NLP 분석 결과"
                                disabled={!nlpAnalysis}
                            >
                                <Assessment className="h-5 w-5" />
                            </button>
                            <button
                                onClick={() => setShowAdvancedAI(!showAdvancedAI)}
                                className={`p-2 rounded-lg transition-colors ${showAdvancedAI ? 'bg-green-100 text-green-600' : 'hover:bg-gray-100 text-gray-500'}`}
                                title="고급 AI 분석"
                                disabled={!advancedAIResponse}
                            >
                                <Bot className="h-5 w-5" />
                            </button>
                            <button
                                onClick={() => setShowAdvancedAnalysis(!showAdvancedAnalysis)}
                                className={`p-2 rounded-lg transition-colors ${showAdvancedAnalysis ? 'bg-blue-100 text-blue-600' : 'hover:bg-gray-100 text-gray-500'} relative`}
                                title="고도화된 질문 분석"
                                disabled={!questionDecomposition}
                            >
                                <Lightbulb className="h-5 w-5" />
                                {isPerformingAdvancedAnalysis && (
                                    <div className="absolute -top-1 -right-1 w-3 h-3 bg-blue-500 rounded-full animate-pulse" />
                                )}
                            </button>
                            <button
                                onClick={() => setShowIntelligentAnalysis(!showIntelligentAnalysis)}
                                className={`p-2 rounded-lg transition-colors ${showIntelligentAnalysis ? 'bg-green-100 text-green-600' : 'hover:bg-gray-100 text-gray-500'} relative`}
                                title="지능형 응답 분석"
                                disabled={!intelligentResponse}
                            >
                                <Bot className="h-5 w-5" />
                                {isGeneratingIntelligentResponse && (
                                    <div className="absolute -top-1 -right-1 w-3 h-3 bg-green-500 rounded-full animate-pulse" />
                                )}
                            </button>
                            <button className="p-2 hover:bg-gray-100 rounded-lg">
                                <Share2 className="h-5 w-5 text-gray-500" />
                            </button>
                            <button
                                onClick={() => {/* 설정 모달 */ }}
                                className="p-2 hover:bg-gray-100 rounded-lg"
                            >
                                <Settings className="h-5 w-5 text-gray-500" />
                            </button>
                        </div>
                    </div>
                </div>

                {/* 콘텐츠 영역 */}
                <div className="flex-1 overflow-y-auto">
                    {currentMode === 'chat' && (
                        <div className="p-4">
                            <div className="max-w-4xl mx-auto space-y-4">
                                {messages.map((message) => (
                                    <div key={message.id} className={`flex ${message.type === 'user' ? 'justify-end' : 'justify-start'}`}>
                                        <div className={`flex items-start space-x-3 max-w-3xl ${message.type === 'user' ? 'flex-row-reverse space-x-reverse' : ''}`}>
                                            <div className={`flex-shrink-0 w-8 h-8 rounded-full flex items-center justify-center ${message.type === 'user' ? 'bg-blue-500' : 'bg-gray-200'}`}>
                                                {message.type === 'user' ? (
                                                    <div className="text-white text-sm">👤</div>
                                                ) : (
                                                    <div className="text-gray-600 text-sm">🤖</div>
                                                )}
                                            </div>
                                            <div className={`flex-1 ${message.type === 'user' ? 'text-right' : 'text-left'}`}>
                                                <div className={`inline-block px-4 py-3 rounded-2xl max-w-full ${message.type === 'user'
                                                    ? 'bg-blue-500 text-white'
                                                    : 'bg-gray-100 text-gray-900'
                                                    }`}>
                                                    <div className="whitespace-pre-wrap break-words">
                                                        {message.content}
                                                    </div>
                                                </div>
                                                {/* 질문글 아래 첨부파일 처리 (왼쪽 정렬) */}
                                                {message.type === 'user' && message.attachments && message.attachments.length > 0 && (
                                                    <div className="flex justify-start mt-2">
                                                        <div className="flex flex-col space-y-1">
                                                            <div className="flex items-center space-x-2 text-xs text-gray-500">
                                                                <span>{message.timestamp.toLocaleTimeString()}</span>
                                                                <span className="px-2 py-1 bg-blue-100 text-blue-700 rounded-full text-xs">
                                                                    📎 첨부파일 ({message.attachments.length}개)
                                                                </span>
                                                            </div>
                                                            {/* 첨부파일 목록 */}
                                                            <div className="flex flex-wrap gap-1">
                                                                {message.attachments.map((file, index) => (
                                                                    <div key={file.id} className="flex items-center space-x-1 px-2 py-1 bg-gray-50 rounded-md text-xs">
                                                                        <span className="text-gray-600">📄 {file.name}</span>
                                                                        <span className="text-gray-400">({(file.size / 1024).toFixed(1)}KB)</span>
                                                                    </div>
                                                                ))}
                                                            </div>
                                                        </div>
                                                    </div>
                                                )}

                                                {/* 답변글 아래 아이콘 박스 (왼쪽 정렬) */}
                                                {message.type === 'ai' && (
                                                    <div className="flex justify-start mt-3">
                                                        <div className="bg-white border border-gray-200 rounded-lg p-2 shadow-sm">
                                                            <div className="flex items-center space-x-3">
                                                                <button
                                                                    onClick={() => setShowNLPAnalysis(!showNLPAnalysis)}
                                                                    className="p-1.5 rounded-md hover:bg-gray-100 text-gray-600 transition-colors"
                                                                    title="NLP 분석 결과"
                                                                    disabled={!nlpAnalysis}
                                                                >
                                                                    <Assessment className="h-4 w-4" />
                                                                </button>
                                                                <button
                                                                    onClick={() => setShowAdvancedAI(!showAdvancedAI)}
                                                                    className="p-1.5 rounded-md hover:bg-gray-100 text-gray-600 transition-colors"
                                                                    title="고급 AI 분석"
                                                                    disabled={!advancedAIResponse}
                                                                >
                                                                    <Bot className="h-4 w-4" />
                                                                </button>
                                                                <button
                                                                    onClick={() => setShowAdvancedAnalysis(!showAdvancedAnalysis)}
                                                                    className="p-1.5 rounded-md hover:bg-gray-100 text-gray-600 transition-colors"
                                                                    title="고도화된 질문 분석"
                                                                    disabled={!questionDecomposition}
                                                                >
                                                                    <Lightbulb className="h-4 w-4" />
                                                                </button>
                                                                <button
                                                                    onClick={() => setShowIntelligentAnalysis(!showIntelligentAnalysis)}
                                                                    className="p-1.5 rounded-md hover:bg-gray-100 text-gray-600 transition-colors"
                                                                    title="지능형 응답 분석"
                                                                    disabled={!intelligentResponse}
                                                                >
                                                                    <Bot className="h-4 w-4" />
                                                                </button>
                                                            </div>
                                                        </div>
                                                        <div className="flex items-center space-x-2 ml-3 text-xs text-gray-500">
                                                            <span>{message.timestamp.toLocaleTimeString()}</span>
                                                            {message.metadata?.quality && (
                                                                <div className="flex items-center space-x-1">
                                                                    <span className="px-2 py-1 bg-green-100 text-green-700 rounded-full">
                                                                        품질: {Math.round(message.metadata.quality.helpfulness * 100)}%
                                                                    </span>
                                                                </div>
                                                            )}
                                                        </div>
                                                    </div>
                                                )}
                                            </div>
                                        </div>
                                    </div>
                                ))}
                                {isSending && (
                                    <div className="flex items-center space-x-2 p-4 text-gray-500">
                                        <div className="flex space-x-1">
                                            <div className="w-2 h-2 bg-gray-400 rounded-full animate-bounce"></div>
                                            <div className="w-2 h-2 bg-gray-400 rounded-full animate-bounce" style={{ animationDelay: '0.1s' }}></div>
                                            <div className="w-2 h-2 bg-gray-400 rounded-full animate-bounce" style={{ animationDelay: '0.2s' }}></div>
                                        </div>
                                        <span className="text-sm">AI가 응답을 생성하고 있습니다...</span>
                                    </div>
                                )}
                                <div ref={messagesEndRef} />
                            </div>
                        </div>
                    )}

                    {/* 뉴스 검색 패널 */}
                    {showNewsSearch && (
                        <div className="absolute inset-0 bg-white z-50">
                            <div className="flex flex-col h-full">
                                <div className="flex items-center justify-between p-4 border-b border-gray-200">
                                    <div className="flex items-center space-x-3">
                                        <button
                                            onClick={() => setShowNewsSearch(false)}
                                            className="p-2 hover:bg-gray-100 rounded-lg transition-colors"
                                        >
                                            <X className="h-5 w-5 text-gray-500" />
                                        </button>
                                        <h2 className="text-lg font-semibold text-gray-900">뉴스 검색 및 댓글 분석</h2>
                                    </div>
                                    <div className="flex items-center space-x-2">
                                        <input
                                            type="text"
                                            placeholder="NewsAPI 키 (선택사항)"
                                            value={newsAPIKey}
                                            onChange={(e) => setNewsAPIKey(e.target.value)}
                                            className="px-3 py-1 text-sm border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                                        />
                                    </div>
                                </div>
                                <div className="flex-1 overflow-hidden">
                                    <NewsSearch
                                        apiKey={newsAPIKey}
                                        onArticleSelect={(article) => {
                                            console.log('선택된 기사:', article);
                                        }}
                                    />
                                </div>
                            </div>
                        </div>
                    )}

                    {/* 🚀 지능형 응답 분석 패널 */}
                    {showIntelligentAnalysis && intelligentResponse && questionContext && (
                        <div className="absolute inset-0 bg-white z-50">
                            <div className="flex flex-col h-full">
                                {/* 헤더 */}
                                <div className="flex items-center justify-between p-4 border-b border-gray-200">
                                    <div className="flex items-center space-x-3">
                                        <button
                                            onClick={() => setShowIntelligentAnalysis(false)}
                                            className="p-2 hover:bg-gray-100 rounded-lg transition-colors"
                                        >
                                            <X className="h-5 w-5 text-gray-500" />
                                        </button>
                                        <h2 className="text-lg font-semibold text-gray-900">🤖 지능형 응답 분석</h2>
                                        <div className="flex items-center space-x-2">
                                            <div className="w-3 h-3 bg-green-500 rounded-full animate-pulse" />
                                            <span className="text-sm text-gray-600">지능형 분석 완료</span>
                                        </div>
                                    </div>
                                    <div className="text-sm text-gray-600">
                                        신뢰도: {Math.round(intelligentResponse.confidence * 100)}%
                                    </div>
                                </div>

                                {/* 분석 결과 */}
                                <div className="flex-1 overflow-y-auto p-6">
                                    {/* 질문 컨텍스트 */}
                                    <div className="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
                                        <div className="bg-green-50 rounded-lg p-4">
                                            <h3 className="text-lg font-semibold text-green-900 mb-3">📋 질문 컨텍스트</h3>
                                            <div className="space-y-3">
                                                <div className="bg-white rounded-lg p-3 border border-green-200">
                                                    <h4 className="font-medium text-green-800 mb-2">기본 정보</h4>
                                                    <div className="text-sm space-y-2">
                                                        <div>
                                                            <span className="text-gray-600">질문 유형:</span>
                                                            <span className="ml-2 font-medium">{questionContext.questionType}</span>
                                                        </div>
                                                        <div>
                                                            <span className="text-gray-600">복잡도:</span>
                                                            <span className="ml-2 font-medium">{questionContext.complexity}/10</span>
                                                        </div>
                                                        <div>
                                                            <span className="text-gray-600">도메인:</span>
                                                            <span className="ml-2 font-medium">{questionContext.domain.join(', ')}</span>
                                                        </div>
                                                        <div>
                                                            <span className="text-gray-600">응답 형식:</span>
                                                            <span className="ml-2 font-medium">{questionContext.expectedResponseFormat}</span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div className="bg-blue-50 rounded-lg p-4">
                                            <h3 className="text-lg font-semibold text-blue-900 mb-3">🎯 응답 품질</h3>
                                            <div className="space-y-3">
                                                <div className="bg-white rounded-lg p-3 border border-blue-200">
                                                    <h4 className="font-medium text-blue-800 mb-2">품질 지표</h4>
                                                    <div className="space-y-2">
                                                        {Object.entries(intelligentResponse.qualityMetrics).map(([metric, score]) => (
                                                            <div key={metric} className="flex items-center justify-between">
                                                                <span className="text-sm text-gray-600 capitalize">{metric}:</span>
                                                                <div className="flex items-center space-x-2">
                                                                    <div className="w-20 bg-gray-200 rounded-full h-2">
                                                                        <div
                                                                            className="bg-blue-500 h-2 rounded-full"
                                                                            style={{ width: `${score * 100}%` }}
                                                                        />
                                                                    </div>
                                                                    <span className="text-sm font-medium">{Math.round(score * 100)}%</span>
                                                                </div>
                                                            </div>
                                                        ))}
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    {/* 응답 내용 */}
                                    <div className="bg-white rounded-lg p-4 border border-gray-200 mb-6">
                                        <h3 className="text-lg font-semibold text-gray-900 mb-3">📝 생성된 응답</h3>
                                        <div className="prose max-w-none">
                                            <div className="whitespace-pre-wrap text-gray-700">
                                                {intelligentResponse.content}
                                            </div>
                                        </div>
                                    </div>

                                    {/* 메타데이터 */}
                                    <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                                        <div className="bg-purple-50 rounded-lg p-4">
                                            <h3 className="text-lg font-semibold text-purple-900 mb-3">🔍 분석 정보</h3>
                                            <div className="space-y-2 text-sm">
                                                <div>
                                                    <span className="text-gray-600">신뢰도:</span>
                                                    <span className="ml-2 font-medium">{Math.round(intelligentResponse.confidence * 100)}%</span>
                                                </div>
                                                <div>
                                                    <span className="text-gray-600">출처:</span>
                                                    <span className="ml-2 font-medium">{intelligentResponse.sources.join(', ')}</span>
                                                </div>
                                                <div>
                                                    <span className="text-gray-600">추론 과정:</span>
                                                    <p className="mt-1 text-gray-700">{intelligentResponse.reasoning}</p>
                                                </div>
                                            </div>
                                        </div>

                                        <div className="bg-orange-50 rounded-lg p-4">
                                            <h3 className="text-lg font-semibold text-orange-900 mb-3">💡 후속 제안</h3>
                                            <div className="space-y-2">
                                                <h4 className="font-medium text-orange-800">추천 질문</h4>
                                                <ul className="text-sm space-y-1">
                                                    {intelligentResponse.followUpSuggestions.map((suggestion, idx) => (
                                                        <li key={idx} className="flex items-center space-x-2">
                                                            <span className="w-2 h-2 bg-orange-400 rounded-full" />
                                                            <span className="text-gray-700">{suggestion}</span>
                                                        </li>
                                                    ))}
                                                </ul>
                                                <h4 className="font-medium text-orange-800 mt-3">관련 주제</h4>
                                                <div className="flex flex-wrap gap-2">
                                                    {intelligentResponse.relatedTopics.map((topic, idx) => (
                                                        <span key={idx} className="px-2 py-1 bg-orange-100 text-orange-700 rounded-full text-xs">
                                                            {topic}
                                                        </span>
                                                    ))}
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    )}

                    {/* 고급 AI 분석 패널 */}
                    <AdvancedAIPanel
                        isOpen={showAdvancedAI}
                        onClose={() => setShowAdvancedAI(false)}
                        advancedAIResponse={advancedAIResponse}
                        userProfile={userProfile}
                        learningProgress={learningProgress}
                    />

                    {/* 고도화된 질문 분석 패널 */}
                    {showAdvancedAnalysis && questionDecomposition && (
                        <div className="absolute inset-0 bg-white z-50">
                            <div className="flex flex-col h-full">
                                {/* 헤더 */}
                                <div className="flex items-center justify-between p-4 border-b border-gray-200">
                                    <div className="flex items-center space-x-3">
                                        <button
                                            onClick={() => setShowAdvancedAnalysis(false)}
                                            className="p-2 hover:bg-gray-100 rounded-lg transition-colors"
                                        >
                                            <X className="h-5 w-5 text-gray-500" />
                                        </button>
                                        <h2 className="text-lg font-semibold text-gray-900">🔍 고도화된 질문 분석</h2>
                                        <div className="flex items-center space-x-2">
                                            <div className="w-3 h-3 bg-blue-500 rounded-full animate-pulse" />
                                            <span className="text-sm text-gray-600">실시간 분석 완료</span>
                                        </div>
                                    </div>
                                    <div className="text-sm text-gray-600">
                                        복잡도: {questionDecomposition.overallComplexity}/10
                                    </div>
                                </div>

                                {/* 분석 결과 */}
                                <div className="flex-1 overflow-y-auto p-6">
                                    {/* 질문 분해 결과 */}
                                    <div className="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
                                        <div className="bg-blue-50 rounded-lg p-4">
                                            <h3 className="text-lg font-semibold text-blue-900 mb-3">📋 질문 구성 요소</h3>
                                            <div className="space-y-3">
                                                {questionDecomposition.components.map((component, index) => (
                                                    <div key={component.id} className="bg-white rounded-lg p-3 border border-blue-200">
                                                        <div className="flex items-center justify-between mb-2">
                                                            <span className={`px-2 py-1 text-xs rounded-full ${component.type === 'primary' ? 'bg-red-100 text-red-700' :
                                                                component.type === 'secondary' ? 'bg-yellow-100 text-yellow-700' :
                                                                    component.type === 'implicit' ? 'bg-purple-100 text-purple-700' :
                                                                        'bg-gray-100 text-gray-700'
                                                                }`}>
                                                                {component.type}
                                                            </span>
                                                            <span className="text-sm font-medium text-gray-600">
                                                                우선순위: {component.priority}/10
                                                            </span>
                                                        </div>
                                                        <p className="text-sm text-gray-700 mb-2">{component.content}</p>
                                                        <div className="flex items-center space-x-2 text-xs text-gray-500">
                                                            <span>의도: {component.intent}</span>
                                                            <span>•</span>
                                                            <span>복잡도: {component.complexity}/10</span>
                                                            <span>•</span>
                                                            <span>범위: {component.scope}</span>
                                                        </div>
                                                    </div>
                                                ))}
                                            </div>
                                        </div>

                                        <div className="bg-green-50 rounded-lg p-4">
                                            <h3 className="text-lg font-semibold text-green-900 mb-3">🎯 응답 전략</h3>
                                            {responseStrategy ? (
                                                <div className="space-y-3">
                                                    <div className="bg-white rounded-lg p-3 border border-green-200">
                                                        <h4 className="font-medium text-green-800 mb-2">기본 전략</h4>
                                                        <div className="grid grid-cols-2 gap-2 text-sm">
                                                            <div>
                                                                <span className="text-gray-600">톤:</span>
                                                                <span className="ml-2 font-medium">{responseStrategy.tone}</span>
                                                            </div>
                                                            <div>
                                                                <span className="text-gray-600">깊이:</span>
                                                                <span className="ml-2 font-medium">{responseStrategy.depth}</span>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div className="bg-white rounded-lg p-3 border border-green-200">
                                                        <h4 className="font-medium text-green-800 mb-2">상호작용 요소</h4>
                                                        <div className="space-y-2 text-sm">
                                                            {responseStrategy.interactivity.clarificationQuestions.length > 0 && (
                                                                <div>
                                                                    <span className="text-gray-600">명확화 질문:</span>
                                                                    <ul className="ml-4 mt-1 space-y-1">
                                                                        {responseStrategy.interactivity.clarificationQuestions.slice(0, 2).map((q, idx) => (
                                                                            <li key={idx} className="text-gray-700">• {q}</li>
                                                                        ))}
                                                                    </ul>
                                                                </div>
                                                            )}
                                                        </div>
                                                    </div>
                                                </div>
                                            ) : (
                                                <div className="text-gray-500">응답 전략 분석 중...</div>
                                            )}
                                        </div>
                                    </div>

                                    {/* 다층적 분석 결과 */}
                                    {multiLayerAnalysis && (
                                        <div className="bg-purple-50 rounded-lg p-4 mb-6">
                                            <h3 className="text-lg font-semibold text-purple-900 mb-3">🧠 다층적 분석</h3>
                                            <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
                                                <div className="bg-white rounded-lg p-3 border border-purple-200">
                                                    <h4 className="font-medium text-purple-800 mb-2">표면 분석</h4>
                                                    <div className="text-sm space-y-1">
                                                        <div>
                                                            <span className="text-gray-600">명시적 의도:</span>
                                                            <p className="text-gray-700">{multiLayerAnalysis.surfaceLevel.obviousIntent}</p>
                                                        </div>
                                                        <div>
                                                            <span className="text-gray-600">직접 질문:</span>
                                                            <p className="text-gray-700">{multiLayerAnalysis.surfaceLevel.directQuestions.length}개</p>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div className="bg-white rounded-lg p-3 border border-purple-200">
                                                    <h4 className="font-medium text-purple-800 mb-2">심층 분석</h4>
                                                    <div className="text-sm space-y-1">
                                                        <div>
                                                            <span className="text-gray-600">감정 맥락:</span>
                                                            <p className="text-gray-700">{multiLayerAnalysis.deepLevel.emotionalContext}</p>
                                                        </div>
                                                        <div>
                                                            <span className="text-gray-600">암시적 요구:</span>
                                                            <p className="text-gray-700">{multiLayerAnalysis.deepLevel.implicitNeeds.length}개</p>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div className="bg-white rounded-lg p-3 border border-purple-200">
                                                    <h4 className="font-medium text-purple-800 mb-2">메타 분석</h4>
                                                    <div className="text-sm space-y-1">
                                                        <div>
                                                            <span className="text-gray-600">인지 부하:</span>
                                                            <p className="text-gray-700">{multiLayerAnalysis.metaLevel.cognitiveLoad}/10</p>
                                                        </div>
                                                        <div>
                                                            <span className="text-gray-600">질문 전략:</span>
                                                            <p className="text-gray-700">{multiLayerAnalysis.metaLevel.questioningStrategy}</p>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    )}

                                    {/* 통합 지식 결과 */}
                                    {integratedKnowledge && (
                                        <div className="bg-orange-50 rounded-lg p-4">
                                            <h3 className="text-lg font-semibold text-orange-900 mb-3">📚 통합 지식 분석</h3>
                                            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                                                <div className="bg-white rounded-lg p-3 border border-orange-200">
                                                    <h4 className="font-medium text-orange-800 mb-2">신뢰도 분석</h4>
                                                    <div className="flex items-center space-x-2 mb-2">
                                                        <span className="text-sm text-gray-600">전체 신뢰도:</span>
                                                        <div className="flex-1 bg-gray-200 rounded-full h-2">
                                                            <div
                                                                className="bg-orange-500 h-2 rounded-full"
                                                                style={{ width: `${integratedKnowledge.confidenceScore * 100}%` }}
                                                            />
                                                        </div>
                                                        <span className="text-sm font-medium">{Math.round(integratedKnowledge.confidenceScore * 100)}%</span>
                                                    </div>
                                                    <div className="text-sm text-gray-700">
                                                        <p>지원 증거: {integratedKnowledge.supportingEvidence.length}개</p>
                                                        <p>반박 증거: {integratedKnowledge.contradictingEvidence.length}개</p>
                                                    </div>
                                                </div>

                                                <div className="bg-white rounded-lg p-3 border border-orange-200">
                                                    <h4 className="font-medium text-orange-800 mb-2">지식 공백</h4>
                                                    {integratedKnowledge.gapsIdentified.length > 0 ? (
                                                        <ul className="text-sm text-gray-700 space-y-1">
                                                            {integratedKnowledge.gapsIdentified.map((gap, idx) => (
                                                                <li key={idx} className="flex items-center space-x-2">
                                                                    <span className="w-2 h-2 bg-orange-400 rounded-full" />
                                                                    <span>{gap}</span>
                                                                </li>
                                                            ))}
                                                        </ul>
                                                    ) : (
                                                        <p className="text-sm text-gray-500">식별된 지식 공백 없음</p>
                                                    )}
                                                </div>
                                            </div>
                                        </div>
                                    )}
                                </div>
                            </div>
                        </div>
                    )}
                </div>

                {/* 입력 영역 */}
                <div className="bg-white border-t border-gray-200 p-4">
                    <div className="max-w-4xl mx-auto">
                        {/* 입력 통계 */}
                        {inputMessage && (
                            <div className="mb-2">
                                <div className="flex items-center justify-between text-xs text-gray-500">
                                    <span>{inputMessage.length}/4000</span>
                                    <span>{inputStats.wordCount}단어</span>
                                    <span>읽기시간: {inputStats.readingTime}분</span>
                                    <div className="flex items-center space-x-2">
                                        <span>품질: {inputQuality.score}%</span>
                                        <div className="w-16 h-1 bg-gray-200 rounded-full overflow-hidden">
                                            <div
                                                className="h-full bg-gradient-to-r from-blue-500 to-purple-500 transition-all duration-300"
                                                style={{ width: `${inputQuality.score}%` }}
                                            />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        )}

                        {/* 입력 오류 */}
                        {inputError && (
                            <div className="mb-2">
                                <span className="text-red-500 text-sm">{inputError}</span>
                            </div>
                        )}



                        {/* 메인 입력 영역 */}
                        <div
                            className={`relative flex items-end space-x-6 p-4 border rounded-lg transition-all duration-200 ${isDragOver
                                ? 'border-blue-500 bg-blue-50 shadow-lg'
                                : 'border-gray-300 hover:border-gray-400'
                                }`}
                            onDragOver={handleDragOver}
                            onDragLeave={handleDragLeave}
                            onDrop={handleDrop}
                        >
                            {/* 파일 업로드 버튼 */}
                            <div className="relative flex-shrink-0">
                                <input
                                    type="file"
                                    multiple
                                    onChange={(e) => {
                                        const files = Array.from(e.target.files || []);
                                        const newAttachments = files.map((file, index) => ({
                                            id: `file-${Date.now()}-${index}`,
                                            name: file.name,
                                            type: file.type,
                                            size: file.size,
                                            url: URL.createObjectURL(file)
                                        }));
                                        setAttachedFiles(prev => [...prev, ...newAttachments]);
                                        e.target.value = '';
                                    }}
                                    className="hidden"
                                    id="file-upload"
                                    accept=".txt,.pdf,.doc,.docx,.jpg,.jpeg,.png,.gif,.mp4,.mp3"
                                />
                                <label
                                    htmlFor="file-upload"
                                    className="p-2 hover:bg-gray-100 rounded-lg cursor-pointer transition-colors group flex-shrink-0"
                                    title="파일 첨부 (여러 파일 선택 가능)"
                                >
                                    <Paperclip className="h-4 w-4 text-gray-600 group-hover:text-blue-600" />
                                </label>
                            </div>

                            {/* 고급 입력 분석 버튼 */}
                            <button
                                onClick={() => setShowInputAnalysis(!showInputAnalysis)}
                                className="p-2 hover:bg-gray-100 rounded-lg transition-colors group flex-shrink-0"
                                title="입력 분석"
                            >
                                <Assessment className="h-4 w-4 text-gray-600 group-hover:text-purple-600" />
                            </button>

                            {/* 메인 텍스트 입력 */}
                            <div className="flex-1 relative min-w-0">
                                <textarea
                                    ref={inputRef}
                                    value={inputMessage}
                                    onChange={handleInputChange}
                                    onKeyDown={handleKeyPress}
                                    onDragOver={handleDragOver}
                                    onDragLeave={handleDragLeave}
                                    onDrop={handleDrop}
                                    placeholder="무엇이든 물어보세요... (파일을 드래그하거나 첨부할 수 있습니다)"
                                    className="w-full resize-none border-none outline-none bg-transparent placeholder-gray-400 pr-8 pl-8"
                                    rows={1}
                                    style={{
                                        minHeight: '24px',
                                        maxHeight: '200px',
                                        paddingRight: '32px',
                                        paddingLeft: '32px',
                                        paddingTop: '8px',
                                        paddingBottom: '8px',
                                        marginRight: '8px',
                                        marginLeft: '8px'
                                    }}
                                />

                                {/* 드래그 오버 인디케이터 */}
                                {isDragOver && (
                                    <div className="absolute inset-0 bg-blue-100 bg-opacity-80 border-2 border-dashed border-blue-500 rounded-lg flex items-center justify-center z-10">
                                        <div className="text-center bg-white p-6 rounded-lg shadow-lg">
                                            <div className="text-4xl mb-3">📁</div>
                                            <div className="text-blue-700 font-bold text-lg mb-2">파일을 여기에 놓으세요</div>
                                            <div className="text-sm text-blue-600">지원 형식: 문서, 이미지, 미디어</div>
                                            <div className="text-xs text-blue-500 mt-1">드래그 앤 드롭으로 파일을 첨부할 수 있습니다</div>
                                        </div>
                                    </div>
                                )}
                            </div>

                            {/* 음성 입력 버튼 */}
                            <button
                                className="p-2 hover:bg-gray-100 rounded-lg transition-colors group flex-shrink-0"
                                title="음성 입력 (준비 중)"
                                disabled
                            >
                                <Mic className="h-4 w-4 text-gray-400" />
                            </button>

                            {/* 전송 버튼 */}
                            <button
                                onClick={handleSendMessage}
                                disabled={!inputMessage.trim() || isSending}
                                className={`p-2 rounded-lg transition-all duration-200 flex-shrink-0 ${inputMessage.trim() && !isSending
                                    ? 'bg-blue-500 text-white hover:bg-blue-600 shadow-md'
                                    : 'bg-gray-200 text-gray-400 cursor-not-allowed'
                                    }`}
                                title={isSending ? '응답 생성 중...' : '전송'}
                            >
                                {isSending ? (
                                    <div className="animate-spin rounded-full h-4 w-4 border-2 border-white border-t-transparent" />
                                ) : (
                                    <Send className="h-4 w-4" />
                                )}
                            </button>
                        </div>

                        {/* 첨부파일 미리보기 */}
                        {attachedFiles.length > 0 && (
                            <div className="mt-4 p-4 bg-gradient-to-r from-blue-50 to-indigo-50 rounded-xl border-2 border-blue-200 shadow-sm">
                                <div className="flex items-center justify-between mb-3">
                                    <div className="flex items-center space-x-2">
                                        <span className="text-lg">📎</span>
                                        <span className="text-sm font-semibold text-blue-900">첨부파일 ({attachedFiles.length}개)</span>
                                        <span className="text-xs text-blue-600 bg-blue-100 px-2 py-1 rounded-full">질문과 함께 전송됩니다</span>
                                    </div>
                                    <button
                                        onClick={() => setAttachedFiles([])}
                                        className="text-xs text-red-600 hover:text-red-800 bg-red-50 hover:bg-red-100 px-3 py-1 rounded-lg transition-colors font-medium"
                                    >
                                        모두 제거
                                    </button>
                                </div>
                                <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
                                    {attachedFiles.map((file, index) => {
                                        // 파일 타입별 아이콘 결정
                                        const getFileIcon = (fileName: string, fileType: string) => {
                                            const extension = fileName.split('.').pop()?.toLowerCase();
                                            if (fileType.startsWith('image/') || ['jpg', 'jpeg', 'png', 'gif', 'bmp', 'webp'].includes(extension || '')) {
                                                return '🖼️';
                                            } else if (fileType.startsWith('video/') || ['mp4', 'avi', 'mov', 'wmv'].includes(extension || '')) {
                                                return '🎥';
                                            } else if (fileType.startsWith('audio/') || ['mp3', 'wav', 'flac', 'aac'].includes(extension || '')) {
                                                return '🎵';
                                            } else if (['pdf'].includes(extension || '')) {
                                                return '📄';
                                            } else if (['doc', 'docx'].includes(extension || '')) {
                                                return '📝';
                                            } else if (['xls', 'xlsx'].includes(extension || '')) {
                                                return '📊';
                                            } else if (['ppt', 'pptx'].includes(extension || '')) {
                                                return '📋';
                                            } else if (['txt', 'md'].includes(extension || '')) {
                                                return '📄';
                                            } else {
                                                return '📁';
                                            }
                                        };

                                        const getFileTypeName = (fileName: string, fileType: string) => {
                                            const extension = fileName.split('.').pop()?.toLowerCase();
                                            if (fileType.startsWith('image/')) return '이미지';
                                            if (fileType.startsWith('video/')) return '비디오';
                                            if (fileType.startsWith('audio/')) return '오디오';
                                            if (extension === 'pdf') return 'PDF 문서';
                                            if (['doc', 'docx'].includes(extension || '')) return 'Word 문서';
                                            if (['xls', 'xlsx'].includes(extension || '')) return 'Excel 문서';
                                            if (['ppt', 'pptx'].includes(extension || '')) return 'PowerPoint';
                                            if (['txt', 'md'].includes(extension || '')) return '텍스트';
                                            return '파일';
                                        };

                                        const formatFileSize = (bytes: number) => {
                                            if (bytes < 1024) return `${bytes}B`;
                                            if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)}KB`;
                                            return `${(bytes / (1024 * 1024)).toFixed(1)}MB`;
                                        };

                                        return (
                                            <div key={file.id} className="bg-white rounded-lg border border-blue-200 shadow-sm hover:shadow-md transition-shadow p-3">
                                                <div className="flex items-start space-x-3">
                                                    <div className="flex-shrink-0">
                                                        <span className="text-2xl">{getFileIcon(file.name, file.type)}</span>
                                                    </div>
                                                    <div className="flex-1 min-w-0">
                                                        <div className="flex items-center justify-between mb-1">
                                                            <span className="text-sm font-medium text-gray-900 truncate">{file.name}</span>
                                                            <button
                                                                onClick={() => setAttachedFiles(prev => prev.filter((_, i) => i !== index))}
                                                                className="text-gray-400 hover:text-red-500 p-1 rounded hover:bg-red-50 transition-colors"
                                                                title="제거"
                                                            >
                                                                <X className="h-3 w-3" />
                                                            </button>
                                                        </div>
                                                        <div className="flex items-center space-x-2 text-xs text-gray-500">
                                                            <span className="bg-blue-100 text-blue-700 px-2 py-1 rounded-full font-medium">
                                                                {getFileTypeName(file.name, file.type)}
                                                            </span>
                                                            <span>{formatFileSize(file.size)}</span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        );
                                    })}
                                </div>
                            </div>
                        )}

                        {/* 입력 분석 패널 */}
                        {showInputAnalysis && inputMessage && (
                            <div className="mt-3 p-4 bg-gradient-to-r from-purple-50 to-blue-50 rounded-lg border border-purple-200">
                                <div className="flex items-center justify-between mb-3">
                                    <h3 className="text-sm font-semibold text-purple-900">🔍 입력 분석 결과</h3>
                                    <button
                                        onClick={() => setShowInputAnalysis(false)}
                                        className="text-purple-600 hover:text-purple-800"
                                    >
                                        <X className="h-4 w-4" />
                                    </button>
                                </div>
                                <div className="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
                                    <div className="bg-white rounded-lg p-3 border border-purple-200">
                                        <div className="text-purple-600 font-medium">📝 텍스트 품질</div>
                                        <div className="text-2xl font-bold text-purple-700">{inputQuality.score}%</div>
                                        <div className="text-xs text-gray-600">{inputQuality.feedback}</div>
                                    </div>
                                    <div className="bg-white rounded-lg p-3 border border-purple-200">
                                        <div className="text-purple-600 font-medium">🎯 의도 파악</div>
                                        <div className="text-lg font-semibold text-purple-700">
                                            {inputMessage.includes('?') ? '질문' :
                                                inputMessage.includes('!') ? '감정표현' : '진술'}
                                        </div>
                                        <div className="text-xs text-gray-600">자동 감지됨</div>
                                    </div>
                                    <div className="bg-white rounded-lg p-3 border border-purple-200">
                                        <div className="text-purple-600 font-medium">📊 복잡도</div>
                                        <div className="text-2xl font-bold text-purple-700">
                                            {inputMessage.length > 100 ? '높음' :
                                                inputMessage.length > 50 ? '보통' : '낮음'}
                                        </div>
                                        <div className="text-xs text-gray-600">{inputStats.wordCount}단어</div>
                                    </div>
                                    <div className="bg-white rounded-lg p-3 border border-purple-200">
                                        <div className="text-purple-600 font-medium">⚡ 추천 기능</div>
                                        <div className="text-sm font-semibold text-purple-700">
                                            {inputMessage.length > 200 ? '고급 분석' :
                                                inputMessage.includes('?') ? '질문 분석' : '일반 응답'}
                                        </div>
                                        <div className="text-xs text-gray-600">자동 활성화</div>
                                    </div>
                                </div>
                            </div>
                        )}
                    </div>
                </div>
            </div>
        </div>
    );
};

export default UnifiedAdvancedInterface;
