                                    전체 진행률: {roadmap.currentStep}/{roadmap.totalSteps} 단계
                                </Typography>
                                <LinearProgress
                                    variant="determinate"
                                    value={(roadmap.currentStep / roadmap.totalSteps) * 100}
                                    sx={{ height: 10, borderRadius: 5 }}
                                />
                            </Box>

                            <Typography variant="subtitle2" mb={2}>단계별 진행 상황</Typography>
                            {roadmap.steps.map((step, index) => (
                                <Box key={step.id} mb={2}>
                                    <Box display="flex" justifyContent="space-between" alignItems="center" mb={1}>
                                        <Typography variant="body2" fontWeight="medium">
                                            {index + 1}. {step.title}
                                        </Typography>
                                        <Chip
                                            label={step.completed ? '완료' : `${step.progress}%`}
                                            size="small"
                                            color={step.completed ? 'success' : 'primary'}
                                        />
                                    </Box>
                                    <Typography variant="body2" color="textSecondary" mb={1}>
                                        {step.description}
                                    </Typography>
                                    <Box display="flex" justifyContent="space-between" alignItems="center">
                                        <Typography variant="caption" color="textSecondary">
                                            예상 시간: {step.estimatedTime}개월 |
                                            예상 비용: {step.estimatedCost > 0 ? `${(step.estimatedCost / 100000000).toFixed(1)}억원` : '무료'}
                                        </Typography>
                                        {!step.completed && (
                                            <LinearProgress
                                                variant="determinate"
                                                value={step.progress}
                                                sx={{ width: 100, height: 6, borderRadius: 3 }}
                                            />
                                        )}
                                    </Box>
                                </Box>
                            ))}
                        </CardContent>
                    </Card>
                </Grid>
            ))}
        </Grid>
    );

    const renderFinancialPlan = () => (
        <Grid container spacing={3}>
            {financialPlans.map((plan) => (
                <Grid item xs={12} key={plan.id}>
                    <Card>
                        <CardContent>
                            <Typography variant="h6" mb={3}>재무 계획</Typography>

                            <Grid container spacing={3} mb={3}>
                                <Grid item xs={12} md={3}>
                                    <Box textAlign="center">
                                        <Typography variant="h4" color="primary">
                                            {(plan.currentSavings / 100000000).toFixed(1)}억원
                                        </Typography>
                                        <Typography variant="body2" color="textSecondary">
                                            현재 저축액
                                        </Typography>
                                    </Box>
                                </Grid>
                                <Grid item xs={12} md={3}>
                                    <Box textAlign="center">
                                        <Typography variant="h4" color="success.main">
                                            {(plan.targetAmount / 100000000).toFixed(1)}억원
                                        </Typography>
                                        <Typography variant="body2" color="textSecondary">
                                            목표 금액
                                        </Typography>
                                    </Box>
                                </Grid>
                                <Grid item xs={12} md={3}>
                                    <Box textAlign="center">
                                        <Typography variant="h4" color="warning.main">
                                            {(plan.monthlySaving / 10000).toFixed(0)}만원
                                        </Typography>
                                        <Typography variant="body2" color="textSecondary">
                                            월 저축액
                                        </Typography>
                                    </Box>
                                </Grid>
                                <Grid item xs={12} md={3}>
                                    <Box textAlign="center">
                                        <Typography variant="h4" color="info.main">
                                            {plan.timeline}개월
                                        </Typography>
                                        <Typography variant="body2" color="textSecondary">
                                            목표 기간
                                        </Typography>
                                    </Box>
                                </Grid>
                            </Grid>

                            <Typography variant="subtitle2" mb={2}>자금 조달 계획</Typography>
                            <Grid container spacing={2} mb={3}>
                                {plan.breakdown.map((item, index) => (
                                    <Grid item xs={12} md={4} key={index}>
                                        <Box display="flex" justifyContent="space-between" mb={1}>
                                            <Typography variant="body2">{item.category}</Typography>
                                            <Typography variant="body2" fontWeight="medium">
                                                {(item.amount / 100000000).toFixed(1)}억원
                                            </Typography>
                                        </Box>
                                        <LinearProgress
                                            variant="determinate"
                                            value={item.percentage}
                                            sx={{ height: 8, borderRadius: 4 }}
                                        />
                                    </Grid>
                                ))}
                            </Grid>

                            <Typography variant="subtitle2" mb={2}>월별 저축 예상</Typography>
                            <TableContainer>
                                <Table size="small">
                                    <TableHead>
                                        <TableRow>
                                            <TableCell>개월</TableCell>
                                            <TableCell>저축액</TableCell>
                                            <TableCell>투자 수익</TableCell>
                                            <TableCell>총액</TableCell>
                                        </TableRow>
                                    </TableHead>
                                    <TableBody>
                                        {plan.projections.map((projection, index) => (
                                            <TableRow key={index}>
                                                <TableCell>{projection.month}개월</TableCell>
                                                <TableCell>{(projection.savings / 100000000).toFixed(1)}억원</TableCell>
                                                <TableCell>{(projection.investment / 100000000).toFixed(1)}억원</TableCell>
                                                <TableCell>
                                                    <Typography variant="body2" fontWeight="medium">
                                                        {(projection.total / 100000000).toFixed(1)}억원
                                                    </Typography>
                                                </TableCell>
                                            </TableRow>
                                        ))}
                                    </TableBody>
                                </Table>
                            </TableContainer>
                        </CardContent>
                    </Card>
                </Grid>
            ))}
        </Grid>
    );

    const renderProgressTracking = () => (
        <Grid container spacing={3}>
            <Grid item xs={12} md={6}>
                <Card>
                    <CardContent>
                        <Typography variant="h6" mb={2}>전체 진행률</Typography>
                        <Box display="flex" justifyContent="space-around" alignItems="center" mb={3}>
                            <Box textAlign="center">
                                <Typography variant="h4" color="primary">25%</Typography>
                                <Typography variant="body2">전체 진행률</Typography>
                            </Box>
                            <Box textAlign="center">
                                <Typography variant="h4" color="success.main">2/8</Typography>
                                <Typography variant="body2">완료 단계</Typography>
                            </Box>
                            <Box textAlign="center">
                                <Typography variant="h4" color="warning.main">36개월</Typography>
                                <Typography variant="body2">남은 기간</Typography>
                            </Box>
                        </Box>
                        <LinearProgress
                            variant="determinate"
                            value={25}
                            sx={{ height: 12, borderRadius: 6 }}
                        />
                    </CardContent>
                </Card>
            </Grid>

            <Grid item xs={12} md={6}>
                <Card>
                    <CardContent>
                        <Typography variant="h6" mb={2}>다음 마일스톤</Typography>
                        <List>
                            <ListItem>
                                <ListItemIcon><Schedule /></ListItemIcon>
                                <ListItemText
                                    primary="대출 조건 확인 완료"
                                    secondary="2024년 7월 1일까지"
                                />
                                <Chip label="진행 중" color="warning" size="small" />
                            </ListItem>
                            <ListItem>
                                <ListItemIcon><Schedule /></ListItemIcon>
                                <ListItemText
                                    primary="저축 목표 달성 50%"
                                    secondary="2024년 12월 1일까지"
                                />
                                <Chip label="대기" color="default" size="small" />
                            </ListItem>
                        </List>
                    </CardContent>
                </Card>
            </Grid>
        </Grid>
    );

    const renderAIRecommendations = () => (
        <Grid container spacing={3}>
            <Grid item xs={12} md={6}>
                <Card>
                    <CardContent>
                        <Typography variant="h6" mb={2}>AI 추천 사항</Typography>
                        <List>
                            <ListItem>
                                <ListItemIcon><Lightbulb color="primary" /></ListItemIcon>
                                <ListItemText
                                    primary="투자 수익률 개선"
                                    secondary="현재 5%에서 7%로 개선 시 목표 달성 기간 단축 가능"
                                />
                            </ListItem>
                            <ListItem>
                                <ListItemIcon><AutoAwesome color="success" /></ListItemIcon>
                                <ListItemText
                                    primary="월 저축액 증가"
                                    secondary="현재 300만원에서 350만원으로 증가 시 6개월 단축"
                                />
                            </ListItem>
                            <ListItem>
                                <ListItemIcon><Psychology color="info" /></ListItemIcon>
                                <ListItemText
                                    primary="대출 조건 최적화"
                                    secondary="여러 은행 비교를 통한 최적 대출 조건 확보"
                                />
                            </ListItem>
                        </List>
                    </CardContent>
                </Card>
            </Grid>

            <Grid item xs={12} md={6}>
                <Card>
                    <CardContent>
                        <Typography variant="h6" mb={2}>위험 요소 및 대응 방안</Typography>
                        <List>
                            <ListItem>
                                <ListItemIcon><Warning color="error" /></ListItemIcon>
                                <ListItemText
                                    primary="금리 상승 리스크"
                                    secondary="대출 금리 상승 시 월 상환액 증가 가능성"
                                />
                            </ListItem>
                            <ListItem>
                                <ListItemIcon><Warning color="warning" /></ListItemIcon>
                                <ListItemText
                                    primary="시세 변동 리스크"
                                    secondary="부동산 시세 하락 시 목표 금액 조정 필요"
                                />
                            </ListItem>
                            <ListItem>
                                <ListItemIcon><Info color="info" /></ListItemIcon>
                                <ListItemText
                                    primary="정책 변화 리스크"
                                    secondary="부동산 정책 변화에 따른 대출 조건 변경 가능성"
                                />
                            </ListItem>
                        </List>
                    </CardContent>
                </Card>
            </Grid>
        </Grid>
    );

    const renderSettings = () => (
        <Card>
            <CardContent>
                <Typography variant="h6" mb={2}>꿈 시각화 설정</Typography>
                <List>
                    <ListItem>
                        <ListItemIcon><Notifications /></ListItemIcon>
                        <ListItemText
                            primary="마일스톤 알림"
                            secondary="중요한 마일스톤 달성 시 알림"
                        />
                        <Switch defaultChecked />
                    </ListItem>
                    <ListItem>
                        <ListItemIcon><AutoFixHigh /></ListItemIcon>
                        <ListItemText
                            primary="AI 추천 알림"
                            secondary="AI 기반 개선 사항 추천 알림"
                        />
                        <Switch defaultChecked />
                    </ListItem>
                    <ListItem>
                        <ListItemIcon><Refresh /></ListItemIcon>
                        <ListItemText
                            primary="자동 업데이트"
                            secondary="진행 상황 자동 업데이트"
                        />
                        <Switch defaultChecked />
                    </ListItem>
                </List>
            </CardContent>
        </Card>
    );

    const renderContent = () => {
        switch (selectedTab) {
            case 0: return renderDreamApartments();
            case 1: return renderHopeVisualization();
            case 2: return renderDreamRoadmap();
            case 3: return renderFinancialPlan();
            case 4: return renderProgressTracking();
            case 5: return renderAIRecommendations();
            case 6: return renderSettings();
            default: return renderDreamApartments();
        }
    };

    return (
        <Box sx={{ p: 3, height: '100vh', overflow: 'auto' }}>
            {/* 헤더 */}
            <Box display="flex" justifyContent="space-between" alignItems="center" mb={3}>
                <Box display="flex" alignItems="center">
                    <EmojiEmotions sx={{ mr: 1, fontSize: 32 }} color="primary" />
                    <Typography variant="h4">꿈 시각화 대시보드</Typography>
                </Box>
                <Box display="flex" alignItems="center" gap={1}>
                    <Typography variant="body2" color="textSecondary">
                        마지막 업데이트: {lastUpdate.toLocaleTimeString()}
                    </Typography>
                    <Tooltip title="전체화면">
                        <IconButton onClick={() => setFullscreen(!fullscreen)}>
                            {fullscreen ? <FullscreenExit /> : <Fullscreen />}
                        </IconButton>
                    </Tooltip>
                </Box>
            </Box>

            {/* 탭 네비게이션 */}
            <Paper sx={{ mb: 3 }}>
                <Box display="flex" overflow="auto">
                    {tabs.map((tab, index) => (
                        <Button
                            key={index}
                            variant={selectedTab === index ? "contained" : "text"}
                            startIcon={tab.icon}
                            onClick={() => setSelectedTab(index)}
                            sx={{
                                minWidth: 'auto',
                                px: 2,
                                py: 1.5,
                                borderRadius: 0,
                                borderBottom: selectedTab === index ? 2 : 0,
                                borderColor: 'primary.main'
                            }}
                        >
                            {tab.label}
                        </Button>
                    ))}
                </Box>
            </Paper>

            {/* 메인 콘텐츠 */}
            {renderContent()}

            {/* 꿈의 아파트 상세 다이얼로그 */}
            <Dialog
                open={dreamDialogOpen}
                onClose={() => setDreamDialogOpen(false)}
                maxWidth="md"
                fullWidth
            >
                <DialogTitle>
                    {selectedDream?.name} 상세 정보
                </DialogTitle>
                <DialogContent>
                    {selectedDream && (
                        <Box>
                            <Grid container spacing={3} mb={3}>
                                <Grid item xs={6}>
                                    <Typography variant="body2" color="textSecondary">위치</Typography>
                                    <Typography variant="body1">{selectedDream.location}</Typography>
                                </Grid>
                                <Grid item xs={6}>
                                    <Typography variant="body2" color="textSecondary">가격</Typography>
                                    <Typography variant="body1">{(selectedDream.price / 100000000).toFixed(1)}억원</Typography>
                                </Grid>
                                <Grid item xs={6}>
                                    <Typography variant="body2" color="textSecondary">면적</Typography>
                                    <Typography variant="body1">{selectedDream.size}㎡</Typography>
                                </Grid>
                                <Grid item xs={6}>
                                    <Typography variant="body2" color="textSecondary">구조</Typography>
                                    <Typography variant="body1">{selectedDream.rooms}룸 {selectedDream.bathrooms}욕</Typography>
                                </Grid>
                            </Grid>

                            <Typography variant="h6" mb={2}>주요 특징</Typography>
                            <Box mb={3}>
                                {selectedDream.features.map((feature, index) => (
                                    <Chip key={index} label={feature} sx={{ mr: 1, mb: 1 }} />
                                ))}
                            </Box>

                            <Typography variant="h6" mb={2}>편의시설</Typography>
                            <Box mb={3}>
                                {selectedDream.amenities.map((amenity, index) => (
                                    <Chip key={index} label={amenity} color="primary" sx={{ mr: 1, mb: 1 }} />
                                ))}
                            </Box>

                            <Typography variant="h6" mb={2}>평가</Typography>
                            <Grid container spacing={2} mb={3}>
                                <Grid item xs={6}>
                                    <Typography variant="body2" color="textSecondary">꿈 점수</Typography>
                                    <Box display="flex" alignItems="center">
                                        <Typography variant="h6" sx={{ mr: 1 }}>{selectedDream.dreamScore}</Typography>
                                        <Rating value={selectedDream.dreamScore / 20} readOnly />
                                    </Box>
                                </Grid>
                                <Grid item xs={6}>
                                    <Typography variant="body2" color="textSecondary">실현 가능성</Typography>
                                    <Box display="flex" alignItems="center">
                                        <Typography variant="h6" sx={{ mr: 1 }}>{selectedDream.feasibility}%</Typography>
                                        <LinearProgress
                                            variant="determinate"
                                            value={selectedDream.feasibility}
                                            sx={{ width: 100, height: 8, borderRadius: 4 }}
                                        />
                                    </Box>
                                </Grid>
                            </Grid>

                            <Typography variant="body2" color="textSecondary">
                                {selectedDream.notes}
                            </Typography>
                        </Box>
                    )}
                </DialogContent>
                <DialogActions>
                    <Button onClick={() => setDreamDialogOpen(false)}>닫기</Button>
                    <Button variant="contained">꿈 목록에 추가</Button>
                </DialogActions>
            </Dialog>

            {/* 희망 시각화 상세 다이얼로그 */}
            <Dialog
                open={hopeDialogOpen}
                onClose={() => setHopeDialogOpen(false)}
                maxWidth="md"
                fullWidth
            >
                <DialogTitle>
                    {selectedHope?.title} 상세 정보
                </DialogTitle>
                <DialogContent>
                    {selectedHope && (
                        <Box>
                            <Typography variant="h6" mb={2}>현재 상황</Typography>
                            <Typography variant="body1" mb={3}>{selectedHope.currentValue}</Typography>

                            <Typography variant="h6" mb={2}>목표</Typography>
                            <Typography variant="body1" mb={3}>{selectedHope.targetValue}</Typography>

                            <Typography variant="h6" mb={2}>진행률</Typography>
                            <Box display="flex" alignItems="center" mb={3}>
                                <Typography variant="h6" sx={{ mr: 2 }}>{selectedHope.progress}%</Typography>
                                <LinearProgress
                                    variant="determinate"
                                    value={selectedHope.progress}
                                    sx={{ flexGrow: 1, height: 10, borderRadius: 5 }}
                                />
                            </Box>

                            <Typography variant="h6" mb={2}>필요한 행동</Typography>
                            <List>
                                {selectedHope.actions.map((action, index) => (
                                    <ListItem key={index}>
                                        <ListItemIcon><CheckCircle /></ListItemIcon>
                                        <ListItemText primary={action} />
                                    </ListItem>
                                ))}
                            </List>

                            <Typography variant="h6" mb={2}>마일스톤</Typography>
                            {selectedHope.milestones.map((milestone) => (
                                <Box key={milestone.id} mb={2}>
                                    <Box display="flex" justifyContent="space-between" alignItems="center" mb={1}>
                                        <Typography variant="body1" fontWeight="medium">
                                            {milestone.title}
                                        </Typography>
                                        <Chip
                                            label={milestone.completed ? '완료' : `${milestone.progress}%`}
                                            color={milestone.completed ? 'success' : 'primary'}
                                            size="small"
                                        />
                                    </Box>
                                    <Typography variant="body2" color="textSecondary" mb={1}>
                                        {milestone.description}
                                    </Typography>
                                    <Typography variant="caption" color="textSecondary">
                                        목표일: {milestone.targetDate.toLocaleDateString()}
                                    </Typography>
                                </Box>
                            ))}
                        </Box>
                    )}
                </DialogContent>
                <DialogActions>
                    <Button onClick={() => setHopeDialogOpen(false)}>닫기</Button>
                    <Button variant="contained">진행 상황 업데이트</Button>
                </DialogActions>
            </Dialog>
        </Box>
    );
};

export default DreamVisualizationDashboard;
