    const getPriorityColor = (priority: string) => {
        switch (priority) {
            case 'high': return 'error';
            case 'medium': return 'warning';
            case 'low': return 'success';
            default: return 'default';
        }
    };

    const getStatusColor = (status: string) => {
        switch (status) {
            case 'dream': return 'default';
            case 'researching': return 'info';
            case 'saving': return 'warning';
            case 'ready': return 'success';
            case 'purchased': return 'success';
            default: return 'default';
        }
    };

    const getStatusText = (status: string) => {
        switch (status) {
            case 'dream': return '꿈';
            case 'researching': return '조사 중';
            case 'saving': return '저축 중';
            case 'ready': return '준비 완료';
            case 'purchased': return '구매 완료';
            default: return status;
        }
    };

