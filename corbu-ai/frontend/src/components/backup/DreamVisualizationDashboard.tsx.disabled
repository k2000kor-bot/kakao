interface DreamApartment {
    id: string;
    name: string;
    location: string;
    price: number;
    size: number;
    rooms: number;
    bathrooms: number;
    floor: number;
    totalFloors: number;
    yearBuilt: number;
    features: string[];
    amenities: string[];
    dreamScore: number;
    feasibility: number;
    timeline: number;
    priority: 'high' | 'medium' | 'low';
    status: 'dream' | 'researching' | 'saving' | 'ready' | 'purchased';
    notes: string;
    images: string[];
}

interface HopeVisualization {
    id: string;
    category: 'location' | 'size' | 'price' | 'amenities' | 'lifestyle';
    title: string;
    description: string;
    currentValue: string;
    targetValue: string;
    progress: number;
    timeline: number;
    priority: 'high' | 'medium' | 'low';
    actions: string[];
    milestones: {
        id: string;
        title: string;
        description: string;
        targetDate: Date;
        completed: boolean;
        progress: number;
    }[];
}

interface DreamRoadmap {
    id: string;
    title: string;
    description: string;
    currentStep: number;
    totalSteps: number;
    steps: {
        id: string;
        title: string;
        description: string;
        estimatedTime: number;
        estimatedCost: number;
        completed: boolean;
        progress: number;
        dependencies: string[];
        resources: string[];
    }[];
    estimatedTotalCost: number;
    estimatedTotalTime: number;
    completionRate: number;
}

interface FinancialPlan {
    id: string;
    currentSavings: number;
    targetAmount: number;
    monthlySaving: number;
    investmentReturn: number;
    timeline: number;
    breakdown: {
        category: string;
        amount: number;
        percentage: number;
    }[];
    projections: {
        month: number;
        savings: number;
        investment: number;
        total: number;
    }[];
}

