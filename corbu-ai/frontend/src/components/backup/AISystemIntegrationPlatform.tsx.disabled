                        </Table>
                    </TableContainer>
                </CardContent>
            </Card>

            {/* 차트 섹션 */}
            <Box sx={{ display: 'grid', gridTemplateColumns: { xs: '1fr', md: 'repeat(2, 1fr)' }, gap: 3, mb: 3 }}>
                <Card>
                    <CardContent>
                        <Typography variant="h6" gutterBottom>시스템 성능 및 부하</Typography>
                        <Line data={performanceData} options={{ responsive: true }} />
                    </CardContent>
                </Card>
                <Card>
                    <CardContent>
                        <Typography variant="h6" gutterBottom>리소스 사용률</Typography>
                        <Doughnut data={resourceData} options={{ responsive: true }} />
                    </CardContent>
                </Card>
            </Box>

            {/* 시스템 통합 */}
            <Card sx={{ mb: 3 }}>
                <CardContent>
                    <Typography variant="h6" gutterBottom sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                        <CloudSync />
                        시스템 통합 상태
                    </Typography>
                    <TableContainer>
                        <Table>
                            <TableHead>
                                <TableRow>
                                    <TableCell>소스 시스템</TableCell>
                                    <TableCell>대상 시스템</TableCell>
                                    <TableCell>통합 유형</TableCell>
                                    <TableCell>상태</TableCell>
                                    <TableCell>성능</TableCell>
                                    <TableCell>마지막 동기화</TableCell>
                                </TableRow>
                            </TableHead>
                            <TableBody>
                                {integrations.map((integration) => (
                                    <TableRow key={integration.id}>
                                        <TableCell>{integration.sourceSystem}</TableCell>
                                        <TableCell>{integration.targetSystem}</TableCell>
                                        <TableCell>
                                            <Chip
                                                label={integration.type}
                                                color={integration.type === 'data' ? 'primary' : 'secondary'}
                                                size="small"
                                            />
                                        </TableCell>
                                        <TableCell>
                                            <Chip
                                                icon={getStatusIcon(integration.status)}
                                                label={integration.status}
                                                color={getStatusColor(integration.status) as any}
                                                size="small"
                                            />
                                        </TableCell>
                                        <TableCell>
                                            <Box sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                                                <LinearProgress
                                                    variant="determinate"
                                                    value={integration.performance}
                                                    sx={{ width: 60, height: 8, borderRadius: 4 }}
                                                />
                                                <Typography variant="body2">{integration.performance}%</Typography>
                                            </Box>
                                        </TableCell>
                                        <TableCell>{integration.lastSync}</TableCell>
                                    </TableRow>
                                ))}
                            </TableBody>
                        </Table>
                    </TableContainer>
                </CardContent>
            </Card>

            {/* 조율 규칙 */}
            <Card sx={{ mb: 3 }}>
                <CardContent>
                    <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', mb: 2 }}>
                        <Typography variant="h6" sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                            <Settings />
