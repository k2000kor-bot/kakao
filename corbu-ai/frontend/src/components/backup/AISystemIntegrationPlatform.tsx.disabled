                        </Typography>
                        <Button
                            variant="contained"
                            onClick={() => setOrchestrationDialogOpen(true)}
                            startIcon={<AutoAwesome />}
                        >
                            조율 실행
                        </Button>
                    </Box>
                    <Box sx={{ display: 'grid', gridTemplateColumns: { xs: '1fr', md: 'repeat(2, 1fr)' }, gap: 2 }}>
                        {orchestrationRules.map((rule) => (
                            <Card variant="outlined" key={rule.id}>
                                <CardContent>
                                    <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', mb: 1 }}>
                                        <Typography variant="subtitle2">{rule.name}</Typography>
                                            <Chip
                                                label={rule.status}
                                                color={rule.status === 'active' ? 'success' : 'default'}
                                                size="small"
                                            />
                                        </Box>
                                        <Typography variant="body2" color="text.secondary" sx={{ mb: 1 }}>
                                            {rule.description}
                                        </Typography>
                                        <Box sx={{ display: 'flex', gap: 1, flexWrap: 'wrap' }}>
                                            <Chip label={`트리거: ${rule.trigger}`} size="small" variant="outlined" />
                                            <Chip label={`액션: ${rule.action}`} size="small" variant="outlined" />
                                            <Chip label={`우선순위: ${rule.priority}`} size="small" variant="outlined" />
                                        </Box>
                                    </CardContent>
                                </Card>
                        ))}
                    </Box>
                </CardContent>
            </Card>

            {/* 시스템 상세 정보 다이얼로그 */}
            <Dialog
                open={systemDetailOpen}
                onClose={() => setSystemDetailOpen(false)}
                maxWidth="md"
                fullWidth
            >
                <DialogTitle>
                    {selectedSystem?.name} 상세 정보
                </DialogTitle>
                <DialogContent>
                    {selectedSystem && (
                        <Box sx={{ display: 'grid', gridTemplateColumns: { xs: '1fr', md: 'repeat(2, 1fr)' }, gap: 3 }}>
                            <Box>
                                <Typography variant="h6" gutterBottom>기본 정보</Typography>
                                <Typography variant="body2" sx={{ mb: 1 }}>
                                    <strong>설명:</strong> {selectedSystem.description}
                                </Typography>
                                <Typography variant="body2" sx={{ mb: 1 }}>
                                    <strong>상태:</strong> {selectedSystem.status}
                                </Typography>
                                <Typography variant="body2" sx={{ mb: 1 }}>
                                    <strong>우선순위:</strong> {selectedSystem.priority}
                                </Typography>
                                <Typography variant="body2" sx={{ mb: 1 }}>
                                    <strong>마지막 업데이트:</strong> {selectedSystem.lastUpdated}
                                </Typography>
                            </Box>
                            <Box>
                                <Typography variant="h6" gutterBottom>의존성</Typography>
                                {selectedSystem.dependencies.length > 0 ? (
                                    selectedSystem.dependencies.map((dep) => (
                                        <Chip key={dep} label={dep} sx={{ mr: 1, mb: 1 }} />
                                    ))
                                ) : (
                                    <Typography variant="body2" color="text.secondary">
                                        의존성이 없습니다.
                                    </Typography>
                                )}
                            </Box>
                            <Box>
                                <Typography variant="h6" gutterBottom>리소스 사용률</Typography>
                                <Box sx={{ display: 'grid', gridTemplateColumns: { xs: 'repeat(2, 1fr)', md: 'repeat(4, 1fr)' }, gap: 2 }}>
                                    <Box>
                                        <Typography variant="body2">CPU: {selectedSystem.resources.cpu}%</Typography>
                                        <LinearProgress variant="determinate" value={selectedSystem.resources.cpu} />
                                    </Box>
                                    <Box>
                                        <Typography variant="body2">메모리: {selectedSystem.resources.memory}%</Typography>
                                        <LinearProgress variant="determinate" value={selectedSystem.resources.memory} />
                                    </Box>
                                    <Box>
                                        <Typography variant="body2">스토리지: {selectedSystem.resources.storage}%</Typography>
                                        <LinearProgress variant="determinate" value={selectedSystem.resources.storage} />
                                    </Box>
                                    <Box>
                                        <Typography variant="body2">네트워크: {selectedSystem.resources.network}%</Typography>
                                        <LinearProgress variant="determinate" value={selectedSystem.resources.network} />
                                    </Box>
                                </Box>
                            </Box>
                            <Box>
                                <Typography variant="h6" gutterBottom>성능 메트릭스</Typography>
                                <Box sx={{ display: 'grid', gridTemplateColumns: { xs: 'repeat(2, 1fr)', md: 'repeat(4, 1fr)' }, gap: 2 }}>
                                    <Box>
                                        <Typography variant="body2">정확도: {selectedSystem.metrics.accuracy}%</Typography>
                                        <LinearProgress variant="determinate" value={selectedSystem.metrics.accuracy} />
                                    </Box>
                                    <Box>
                                        <Typography variant="body2">지연시간: {selectedSystem.metrics.latency}ms</Typography>
                                        <LinearProgress variant="determinate" value={100 - selectedSystem.metrics.latency / 2} />
                                    </Box>
                                    <Box>
                                        <Typography variant="body2">처리량: {selectedSystem.metrics.throughput}/s</Typography>
                                        <LinearProgress variant="determinate" value={selectedSystem.metrics.throughput / 25} />
                                    </Box>
                                    <Box>
                                        <Typography variant="body2">신뢰성: {selectedSystem.metrics.reliability}%</Typography>
                                        <LinearProgress variant="determinate" value={selectedSystem.metrics.reliability} />
                                    </Box>
                                </Box>
                            </Box>
                        </Box>
                    )}
                </DialogContent>
                <DialogActions>
                    <Button onClick={() => setSystemDetailOpen(false)}>닫기</Button>
                </DialogActions>
            </Dialog>

            {/* 조율 실행 다이얼로그 */}
            <Dialog
                open={orchestrationDialogOpen}
                onClose={() => setOrchestrationDialogOpen(false)}
                maxWidth="sm"
                fullWidth
            >
                <DialogTitle>AI 시스템 조율 실행</DialogTitle>
                <DialogContent>
                    <Typography variant="body1" sx={{ mb: 3 }}>
                        모든 AI 시스템의 통합 조율을 실행하시겠습니까?
                    </Typography>
                    <Box sx={{ display: 'grid', gridTemplateColumns: '1fr', gap: 2 }}>
                        <Button
                            fullWidth
                            variant="contained"
                            color="primary"
                            onClick={() => handleOrchestrationAction('full_orchestration')}
                            startIcon={<AutoAwesome />}
                        >
                            전체 시스템 조율
                        </Button>
                        <Button
                            fullWidth
                            variant="outlined"
                            onClick={() => handleOrchestrationAction('performance_optimization')}
                            startIcon={<TrendingUp />}
                        >
                            성능 최적화
                        </Button>
                        <Button
                            fullWidth
                            variant="outlined"
                            onClick={() => handleOrchestrationAction('resource_balancing')}
                            startIcon={<Balance />}
                        >
                            리소스 밸런싱
                        </Button>
                        <Button
                            fullWidth
                            variant="outlined"
                            onClick={() => handleOrchestrationAction('integration_sync')}
                            startIcon={<Sync />}
                        >
                            통합 동기화
                        </Button>
                    </Box>
                </DialogContent>
                <DialogActions>
                    <Button onClick={() => setOrchestrationDialogOpen(false)}>취소</Button>
                </DialogActions>
            </Dialog>
        </Box>
    );
};

export default AISystemIntegrationPlatform;
