// 협업 세션 인터페이스
interface CollaborationSession {
  id: string;
  name: string;
  description: string;
  session_type: string;
  status: 'active' | 'inactive' | 'completed';
  participants: Array<{
    id: string;
    name: string;
    role: string;
    contribution_score: number;
  }>;
  settings: {
    ai_assistance_level: string;
    max_participants: number;
    collaboration_mode: string;
  };
  metrics: {
    total_interactions: number;
    average_engagement: number;
    knowledge_shared: number;
    collaboration_score: number;
  };
  created_at: Date;
  updated_at: Date;
}

// 그룹 인텔리전스 인터페이스
interface GroupIntelligence {
  id: string;
  session_id: string;
  collective_knowledge: number;
  problem_solving_ability: number;
  creativity_score: number;
  communication_efficiency: number;
  decision_making_quality: number;
  learning_rate: number;
  insights: string[];
  recommendations: string[];
  updated_at: Date;
}

// 협업 패턴 인터페이스
interface CollaborationPattern {
  id: string;
  pattern_type: string;
  description: string;
  effectiveness: number;
  frequency: number;
  participants: string[];
  characteristics: string[];
  recommendations: string[];
  created_at: Date;
}

// 샘플 데이터
const sampleSessions: CollaborationSession[] = [
  {
    id: 'session-001',
    name: 'AI 프로젝트 브레인스토밍',
    description: '새로운 AI 기능 개발을 위한 팀 브레인스토밍 세션',
    session_type: 'brainstorming',
    status: 'active',
