// 초고도화된 메시지 인터페이스
interface UltraAdvancedMessage {
    id: string;
    type: 'user' | 'ai' | 'system' | 'voice' | 'image' | 'video';
    content: string;
    timestamp: Date;
    analysis?: {
        type: 'text_analysis' | 'requirement_extraction' | 'system_info' | 'performance' | 'detailed_explanation' | 'emotion_analysis' | 'sentiment_analysis' | 'intent_recognition' | 'personalization' | 'multimodal_analysis';
        data: any;
        insights: string[];
        recommendations: string[];
        confidence: number;
        emotions?: {
            primary: string;
            intensity: number;
            secondary: string[];
        };
        sentiment?: {
            score: number;
            label: string;
            details: string;
        };
        intent?: {
            primary: string;
            confidence: number;
            entities: string[];
        };
    };
    systemInfo?: any[];
    userIntent?: string;
    responseType?: 'simple' | 'detailed' | 'analytical' | 'creative' | 'personalized' | 'multimodal';
    language?: 'korean' | 'english' | 'japanese' | 'chinese' | 'auto';
    tone?: 'formal' | 'casual' | 'professional' | 'friendly' | 'empathetic' | 'enthusiastic';
    length?: 'brief' | 'medium' | 'comprehensive' | 'extensive';
    personalization?: {
        userPreference: string;
        learningStyle: string;
        expertiseLevel: string;
        contextAwareness: boolean;
    };
    multimedia?: {
        images?: string[];
        videos?: string[];
        audio?: string;
        documents?: string[];
    };
}

// 사용자 프로필 인터페이스
interface UserProfile {
    id: string;
    name: string;
    preferences: {
        language: string;
        tone: string;
        responseLength: string;
        expertiseLevel: string;
        learningStyle: string;
        interests: string[];
    };
    interactionHistory: {
        totalInteractions: number;
        averageSessionLength: number;
        preferredTopics: string[];
        emotionalPatterns: any[];
    };
    learningProgress: {
        topicsLearned: string[];
        skillLevel: Record<string, number>;
        recommendations: string[];
    };
}

