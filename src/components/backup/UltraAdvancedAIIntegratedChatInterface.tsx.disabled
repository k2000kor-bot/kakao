import React, { useState, useEffect, useRef } from 'react';
import {
    Box,
    Card,
    CardContent,
    Typography,
    TextField,
    Button,
    IconButton,
    Paper,
    Grid,
    Chip,
    Dialog,
    DialogTitle,
    DialogContent,
    DialogActions,
    List,
    ListItem,
    ListItemText,
    ListItemIcon,
    Switch,
    FormControlLabel,
    Slider,
    Select,
    MenuItem,
    FormControl,
    InputLabel,
    Tabs,
    Tab,
    Divider,
    CircularProgress,
    Alert,
    Badge,
    Tooltip,
    Accordion,
    AccordionSummary,
    AccordionDetails
} from '@mui/material';
import {
    Send,
    Settings,
    Mic,
    MicOff,
    AttachFile,
    EmojiEmotions,
    SmartToy,
    Psychology,
    Analytics,
    AccountTree,
    Tune as Optimization,
    IntegrationInstructions,
    Chat,
    History,
    Delete,
    Refresh,
    PlayArrow,
    Pause,
    Stop,
    Visibility,
    ExpandMore,
    CheckCircle,
    Warning,
    Error,
    Info,
    Speed,
    Memory,
    Storage,
    NetworkCheck,
    TrendingUp,
    TrendingDown,
    TrendingFlat
} from '@mui/icons-material';
import ultraAdvancedAIIntegratedChatSystem, {
    IntegratedChatMessage,
    IntegratedChatSession,
    IntegratedChatSettings,
    IntegratedChatMetrics
} from '../services/ultraAdvancedAIIntegratedChatSystem';

interface ChatInterfaceState {
    messages: IntegratedChatMessage[];
    sessions: IntegratedChatSession[];
    currentSession: IntegratedChatSession | null;
    settings: IntegratedChatSettings;
    metrics: IntegratedChatMetrics;
    isTyping: boolean;
    isRecording: boolean;
    showSettings: boolean;
    showSessions: boolean;
    showMetrics: boolean;
    selectedMessage: IntegratedChatMessage | null;
}

const UltraAdvancedAIIntegratedChatInterface: React.FC = () => {
    const [state, setState] = useState<ChatInterfaceState>({
        messages: [],
        sessions: [],
        currentSession: null,
        settings: ultraAdvancedAIIntegratedChatSystem.getSettings(),
        metrics: ultraAdvancedAIIntegratedChatSystem.getMetrics(),
        isTyping: false,
        isRecording: false,
        showSettings: false,
        showSessions: false,
        showMetrics: false,
        selectedMessage: null
    });

    const [inputValue, setInputValue] = useState('');
    const [activeTab, setActiveTab] = useState(0);
    const messagesEndRef = useRef<HTMLDivElement>(null);

    useEffect(() => {
        // 초기 데이터 로드
        const loadInitialData = () => {
            const sessions = ultraAdvancedAIIntegratedChatSystem.getSessions();
            const currentSession = ultraAdvancedAIIntegratedChatSystem.getCurrentSession();

            setState(prev => ({
                ...prev,
                sessions,
                currentSession,
                messages: currentSession?.messages || []
            }));
        };

        loadInitialData();

        // 이벤트 리스너 등록
        const handleMessageProcessed = (message: IntegratedChatMessage, session: IntegratedChatSession) => {
            setState(prev => ({
                ...prev,
                messages: session.messages,
                currentSession: session,
                isTyping: false
            }));
        };

        const handleSessionCreated = (session: IntegratedChatSession) => {
            setState(prev => ({
                ...prev,
                sessions: [...prev.sessions, session],
                currentSession: session,
                messages: session.messages
            }));
        };

        const handleSessionChanged = (session: IntegratedChatSession) => {
            setState(prev => ({
                ...prev,
                currentSession: session,
                messages: session.messages
            }));
        };

        const handleSettingsUpdated = (settings: IntegratedChatSettings) => {
            setState(prev => ({
                ...prev,
                settings
            }));
        };

        const handleMetricsUpdated = (metrics: IntegratedChatMetrics) => {
            setState(prev => ({
                ...prev,
                metrics
            }));
        };

        const handleProcessingStarted = () => {
            setState(prev => ({
                ...prev,
                isTyping: true
            }));
        };

        const handleProcessingError = (error: any) => {
            console.error('메시지 처리 오류:', error);
            setState(prev => ({
                ...prev,
                isTyping: false
            }));
        };

        ultraAdvancedAIIntegratedChatSystem.on('message_processed', handleMessageProcessed);
        ultraAdvancedAIIntegratedChatSystem.on('session_created', handleSessionCreated);
        ultraAdvancedAIIntegratedChatSystem.on('session_changed', handleSessionChanged);
        ultraAdvancedAIIntegratedChatSystem.on('settings_updated', handleSettingsUpdated);
        ultraAdvancedAIIntegratedChatSystem.on('metrics_updated', handleMetricsUpdated);
        ultraAdvancedAIIntegratedChatSystem.on('processing_started', handleProcessingStarted);
        ultraAdvancedAIIntegratedChatSystem.on('processing_error', handleProcessingError);

        return () => {
            ultraAdvancedAIIntegratedChatSystem.off('message_processed', handleMessageProcessed);
            ultraAdvancedAIIntegratedChatSystem.off('session_created', handleSessionCreated);
            ultraAdvancedAIIntegratedChatSystem.off('session_changed', handleSessionChanged);
            ultraAdvancedAIIntegratedChatSystem.off('settings_updated', handleSettingsUpdated);
            ultraAdvancedAIIntegratedChatSystem.off('metrics_updated', handleMetricsUpdated);
            ultraAdvancedAIIntegratedChatSystem.off('processing_started', handleProcessingStarted);
            ultraAdvancedAIIntegratedChatSystem.off('processing_error', handleProcessingError);
        };
    }, []);

    useEffect(() => {
        // 메시지 목록이 업데이트되면 스크롤을 맨 아래로
        messagesEndRef.current?.scrollIntoView({ behavior: 'smooth' });
    }, [state.messages]);

    const handleSendMessage = async () => {
        if (!inputValue.trim() || state.isTyping) return;

        try {
            await ultraAdvancedAIIntegratedChatSystem.processMessage(inputValue);
            setInputValue('');
        } catch (error) {
            console.error('메시지 전송 실패:', error);
        }
    };

    const handleKeyPress = (event: React.KeyboardEvent) => {
        if (event.key === 'Enter' && !event.shiftKey) {
            event.preventDefault();
            handleSendMessage();
        }
    };

    const handleCreateSession = async () => {
        try {
            await ultraAdvancedAIIntegratedChatSystem.createSession(`새 세션 ${Date.now()}`);
        } catch (error) {
            console.error('세션 생성 실패:', error);
        }
    };

    const handleSwitchSession = (sessionId: string) => {
        ultraAdvancedAIIntegratedChatSystem.setCurrentSession(sessionId);
    };

    const handleDeleteSession = async (sessionId: string) => {
        try {
            await ultraAdvancedAIIntegratedChatSystem.deleteSession(sessionId);
            setState(prev => ({
                ...prev,
                sessions: ultraAdvancedAIIntegratedChatSystem.getSessions()
            }));
        } catch (error) {
            console.error('세션 삭제 실패:', error);
        }
    };

    const handleClearSession = async (sessionId: string) => {
        try {
            await ultraAdvancedAIIntegratedChatSystem.clearSession(sessionId);
            setState(prev => ({
                ...prev,
                messages: ultraAdvancedAIIntegratedChatSystem.getCurrentSession()?.messages || []
            }));
        } catch (error) {
            console.error('세션 초기화 실패:', error);
        }
    };

    const handleSettingsChange = (key: keyof IntegratedChatSettings, value: any) => {
        const newSettings = { ...state.settings, [key]: value };
        ultraAdvancedAIIntegratedChatSystem.updateSettings(newSettings);
    };

    const getMessageTypeIcon = (type: string) => {
        switch (type) {
            case 'user': return <Chat />;
            case 'ai': return <SmartToy />;
            case 'system': return <Info />;
            case 'integration': return <IntegrationInstructions />;
            case 'workflow': return <Workflow />;
            case 'analysis': return <Analytics />;
            default: return <Chat />;
        }
    };

    const getMessageTypeColor = (type: string) => {
        switch (type) {
            case 'user': return 'primary';
            case 'ai': return 'secondary';
            case 'system': return 'info';
            case 'integration': return 'success';
            case 'workflow': return 'warning';
            case 'analysis': return 'error';
            default: return 'default';
        }
    };

    const getSentimentColor = (sentiment: string) => {
        switch (sentiment) {
            case 'positive': return 'success';
            case 'negative': return 'error';
            case 'neutral': return 'default';
            default: return 'default';
        }
    };

    const formatTimestamp = (timestamp: Date) => {
        return timestamp.toLocaleTimeString('ko-KR', {
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit'
        });
    };

    return (
        <Box sx={{ height: '100vh', display: 'flex', flexDirection: 'column' }}>
            {/* 헤더 */}
            <Card sx={{ mb: 2 }}>
                <CardContent>
                    <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                        <Typography variant="h5" sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                            <SmartToy color="primary" />
                            고도화된 AI 통합 채팅
                        </Typography>
                        <Box sx={{ display: 'flex', gap: 1 }}>
                            <Button
                                variant="outlined"
                                startIcon={<History />}
                                onClick={() => setState(prev => ({ ...prev, showSessions: true }))}
                            >
                                세션 관리
                            </Button>
                            <Button
                                variant="outlined"
                                startIcon={<Analytics />}
                                onClick={() => setState(prev => ({ ...prev, showMetrics: true }))}
                            >
                                메트릭
                            </Button>
                            <IconButton
                                onClick={() => setState(prev => ({ ...prev, showSettings: true }))}
                            >
                                <Settings />
                            </IconButton>
                        </Box>
                    </Box>
                </CardContent>
            </Card>

            {/* 메인 채팅 영역 */}
            <Box sx={{ flexGrow: 1, display: 'flex', gap: 2 }}>
                {/* 메시지 목록 */}
                <Box sx={{ flexGrow: 1, display: 'flex', flexDirection: 'column' }}>
                    <Paper sx={{ flexGrow: 1, p: 2, overflow: 'auto', mb: 2 }}>
                        {state.messages.map((message) => (
                            <Box key={message.id} sx={{ mb: 2 }}>
                                <Card variant="outlined">
                                    <CardContent>
                                        <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start', mb: 1 }}>
                                            <Box sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                                                {getMessageTypeIcon(message.type)}
                                                <Typography variant="subtitle2" color="textSecondary">
                                                    {message.sender}
                                                </Typography>
                                                <Chip
                                                    label={message.type}
                                                    color={getMessageTypeColor(message.type) as any}
                                                    size="small"
                                                />
                                                <Chip
                                                    label={message.metadata.sentiment}
                                                    color={getSentimentColor(message.metadata.sentiment) as any}
                                                    size="small"
                                                />
                                            </Box>
                                            <Typography variant="caption" color="textSecondary">
                                                {formatTimestamp(message.timestamp)}
                                            </Typography>
                                        </Box>

                                        <Typography variant="body1" sx={{ mb: 1 }}>
                                            {message.content}
                                        </Typography>

                                        {/* 메시지 메타데이터 */}
                                        <Accordion>
                                            <AccordionSummary expandIcon={<ExpandMore />}>
                                                <Typography variant="caption">메타데이터</Typography>
                                            </AccordionSummary>
                                            <AccordionDetails>
                                                <Grid container spacing={1}>
                                                    <Grid item xs={6}>
                                                        <Typography variant="caption" display="block">
                                                            신뢰도: {(message.metadata.confidence * 100).toFixed(1)}%
                                                        </Typography>
                                                    </Grid>
                                                    <Grid item xs={6}>
                                                        <Typography variant="caption" display="block">
                                                            처리 시간: {message.metadata.processing_time}ms
                                                        </Typography>
                                                    </Grid>
                                                    <Grid item xs={6}>
                                                        <Typography variant="caption" display="block">
                                                            토큰 사용: {message.metadata.tokens_used}
                                                        </Typography>
                                                    </Grid>
                                                    <Grid item xs={6}>
                                                        <Typography variant="caption" display="block">
                                                            카테고리: {message.metadata.category}
                                                        </Typography>
                                                    </Grid>
                                                    {message.metadata.topics.length > 0 && (
                                                        <Grid item xs={12}>
                                                            <Typography variant="caption" display="block">
                                                                주제: {message.metadata.topics.join(', ')}
                                                            </Typography>
                                                        </Grid>
                                                    )}
                                                    {message.metadata.entities.length > 0 && (
                                                        <Grid item xs={12}>
                                                            <Typography variant="caption" display="block">
                                                                엔티티: {message.metadata.entities.join(', ')}
                                                            </Typography>
                                                        </Grid>
                                                    )}
                                                    {message.metadata.integration_data && (
                                                        <Grid item xs={12}>
                                                            <Typography variant="caption" display="block">
                                                                통합: {message.metadata.integration_data.integration_id} - {message.metadata.integration_data.status}
                                                            </Typography>
                                                        </Grid>
                                                    )}
                                                </Grid>
                                            </AccordionDetails>
                                        </Accordion>
                                    </CardContent>
                                </Card>
                            </Box>
                        ))}

                        {state.isTyping && (
                            <Box sx={{ display: 'flex', alignItems: 'center', gap: 1, p: 2 }}>
                                <CircularProgress size={20} />
                                <Typography variant="body2" color="textSecondary">
                                    AI가 응답을 생성하고 있습니다...
                                </Typography>
                            </Box>
                        )}

                        <div ref={messagesEndRef} />
                    </Paper>

                    {/* 입력 영역 */}
                    <Paper sx={{ p: 2 }}>
                        <Box sx={{ display: 'flex', gap: 1, alignItems: 'flex-end' }}>
                            <TextField
                                fullWidth
                                multiline
                                rows={2}
                                value={inputValue}
                                onChange={(e) => setInputValue(e.target.value)}
                                onKeyPress={handleKeyPress}
                                placeholder="메시지를 입력하세요..."
                                disabled={state.isTyping}
                            />
                            <Box sx={{ display: 'flex', flexDirection: 'column', gap: 1 }}>
                                <IconButton
                                    onClick={() => setState(prev => ({ ...prev, isRecording: !prev.isRecording }))}
                                    color={state.isRecording ? 'error' : 'default'}
                                >
                                    {state.isRecording ? <MicOff /> : <Mic />}
                                </IconButton>
                                <IconButton>
                                    <AttachFile />
                                </IconButton>
                                <IconButton>
                                    <EmojiEmotions />
                                </IconButton>
                                <IconButton
                                    onClick={handleSendMessage}
                                    disabled={!inputValue.trim() || state.isTyping}
                                    color="primary"
                                >
                                    <Send />
                                </IconButton>
                            </Box>
                        </Box>
                    </Paper>
                </Box>

                {/* 사이드바 */}
                <Box sx={{ width: 300 }}>
                    <Card>
                        <CardContent>
                            <Typography variant="h6" gutterBottom>
                                현재 세션
                            </Typography>
                            {state.currentSession && (
                                <Box>
                                    <Typography variant="subtitle1">
                                        {state.currentSession.title}
                                    </Typography>
                                    <Typography variant="body2" color="textSecondary">
                                        메시지: {state.currentSession.metrics.total_messages}
                                    </Typography>
                                    <Typography variant="body2" color="textSecondary">
                                        생성: {state.currentSession.created_at.toLocaleDateString()}
                                    </Typography>
                                </Box>
                            )}

                            <Divider sx={{ my: 2 }} />

                            <Typography variant="h6" gutterBottom>
                                시스템 상태
                            </Typography>
                            <Box sx={{ display: 'flex', flexDirection: 'column', gap: 1 }}>
                                <Box sx={{ display: 'flex', justifyContent: 'space-between' }}>
                                    <Typography variant="body2">CPU</Typography>
                                    <Typography variant="body2">
                                        {(state.metrics.system_health.cpu_usage * 100).toFixed(1)}%
                                    </Typography>
                                </Box>
                                <Box sx={{ display: 'flex', justifyContent: 'space-between' }}>
                                    <Typography variant="body2">메모리</Typography>
                                    <Typography variant="body2">
                                        {(state.metrics.system_health.memory_usage * 100).toFixed(1)}%
                                    </Typography>
                                </Box>
                                <Box sx={{ display: 'flex', justifyContent: 'space-between' }}>
                                    <Typography variant="body2">네트워크</Typography>
                                    <Typography variant="body2">
                                        {(state.metrics.system_health.network_usage * 100).toFixed(1)}%
                                    </Typography>
                                </Box>
                            </Box>
                        </CardContent>
                    </Card>
                </Box>
            </Box>

            {/* 세션 관리 다이얼로그 */}
            <Dialog open={state.showSessions} onClose={() => setState(prev => ({ ...prev, showSessions: false }))} maxWidth="md" fullWidth>
                <DialogTitle>
                    세션 관리
                </DialogTitle>
                <DialogContent>
                    <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', mb: 2 }}>
                        <Typography variant="h6">
                            세션 목록 ({state.sessions.length})
                        </Typography>
                        <Button
                            variant="contained"
                            onClick={handleCreateSession}
                        >
                            새 세션
                        </Button>
                    </Box>
                    <List>
                        {state.sessions.map((session) => (
                            <ListItem
                                key={session.id}
                                button
                                selected={state.currentSession?.id === session.id}
                                onClick={() => handleSwitchSession(session.id)}
                            >
                                <ListItemText
                                    primary={session.title}
                                    secondary={`${session.metrics.total_messages} 메시지 • ${session.created_at.toLocaleDateString()}`}
                                />
                                <Box sx={{ display: 'flex', gap: 1 }}>
                                    <IconButton
                                        size="small"
                                        onClick={(e) => {
                                            e.stopPropagation();
                                            handleClearSession(session.id);
                                        }}
                                    >
                                        <Refresh />
                                    </IconButton>
                                    <IconButton
                                        size="small"
                                        onClick={(e) => {
                                            e.stopPropagation();
                                            handleDeleteSession(session.id);
                                        }}
                                    >
                                        <Delete />
                                    </IconButton>
                                </Box>
                            </ListItem>
                        ))}
                    </List>
                </DialogContent>
                <DialogActions>
                    <Button onClick={() => setState(prev => ({ ...prev, showSessions: false }))}>
                        닫기
                    </Button>
                </DialogActions>
            </Dialog>

            {/* 메트릭 다이얼로그 */}
            <Dialog open={state.showMetrics} onClose={() => setState(prev => ({ ...prev, showMetrics: false }))} maxWidth="lg" fullWidth>
                <DialogTitle>
                    시스템 메트릭
                </DialogTitle>
                <DialogContent>
                    <Tabs value={activeTab} onChange={(e, newValue) => setActiveTab(newValue)} sx={{ mb: 2 }}>
                        <Tab label="일반" />
                        <Tab label="통합" />
                        <Tab label="워크플로우" />
                        <Tab label="시스템" />
                    </Tabs>

                    {activeTab === 0 && (
                        <Grid container spacing={2}>
                            <Grid item xs={6} md={3}>
                                <Card>
                                    <CardContent>
                                        <Typography color="textSecondary">총 세션</Typography>
                                        <Typography variant="h4">{state.metrics.total_sessions}</Typography>
                                    </CardContent>
                                </Card>
                            </Grid>
                            <Grid item xs={6} md={3}>
                                <Card>
                                    <CardContent>
                                        <Typography color="textSecondary">활성 세션</Typography>
                                        <Typography variant="h4">{state.metrics.active_sessions}</Typography>
                                    </CardContent>
                                </Card>
                            </Grid>
                            <Grid item xs={6} md={3}>
                                <Card>
                                    <CardContent>
                                        <Typography color="textSecondary">총 메시지</Typography>
                                        <Typography variant="h4">{state.metrics.total_messages}</Typography>
                                    </CardContent>
                                </Card>
                            </Grid>
                            <Grid item xs={6} md={3}>
                                <Card>
                                    <CardContent>
                                        <Typography color="textSecondary">평균 응답 시간</Typography>
                                        <Typography variant="h4">{state.metrics.average_response_time.toFixed(0)}ms</Typography>
                                    </CardContent>
                                </Card>
                            </Grid>
                        </Grid>
                    )}

                    {activeTab === 1 && (
                        <Grid container spacing={2}>
                            <Grid item xs={6} md={3}>
                                <Card>
                                    <CardContent>
                                        <Typography color="textSecondary">총 호출</Typography>
                                        <Typography variant="h4">{state.metrics.integration_usage.total_calls}</Typography>
                                    </CardContent>
                                </Card>
                            </Grid>
                            <Grid item xs={6} md={3}>
                                <Card>
                                    <CardContent>
                                        <Typography color="textSecondary">성공률</Typography>
                                        <Typography variant="h4">{(state.metrics.integration_usage.success_rate * 100).toFixed(1)}%</Typography>
                                    </CardContent>
                                </Card>
                            </Grid>
                            <Grid item xs={6} md={3}>
                                <Card>
                                    <CardContent>
                                        <Typography color="textSecondary">평균 처리 시간</Typography>
                                        <Typography variant="h4">{state.metrics.integration_usage.average_processing_time.toFixed(0)}ms</Typography>
                                    </CardContent>
                                </Card>
                            </Grid>
                        </Grid>
                    )}

                    {activeTab === 2 && (
                        <Grid container spacing={2}>
                            <Grid item xs={6} md={3}>
                                <Card>
                                    <CardContent>
                                        <Typography color="textSecondary">총 워크플로우</Typography>
                                        <Typography variant="h4">{state.metrics.workflow_performance.total_workflows}</Typography>
                                    </CardContent>
                                </Card>
                            </Grid>
                            <Grid item xs={6} md={3}>
                                <Card>
                                    <CardContent>
                                        <Typography color="textSecondary">완료된 워크플로우</Typography>
                                        <Typography variant="h4">{state.metrics.workflow_performance.completed_workflows}</Typography>
                                    </CardContent>
                                </Card>
                            </Grid>
                            <Grid item xs={6} md={3}>
                                <Card>
                                    <CardContent>
                                        <Typography color="textSecondary">평균 완료 시간</Typography>
                                        <Typography variant="h4">{state.metrics.workflow_performance.average_completion_time.toFixed(0)}ms</Typography>
                                    </CardContent>
                                </Card>
                            </Grid>
                        </Grid>
                    )}

                    {activeTab === 3 && (
                        <Grid container spacing={2}>
                            <Grid item xs={6} md={3}>
                                <Card>
                                    <CardContent>
                                        <Typography color="textSecondary">CPU 사용률</Typography>
                                        <Typography variant="h4">{(state.metrics.system_health.cpu_usage * 100).toFixed(1)}%</Typography>
                                    </CardContent>
                                </Card>
                            </Grid>
                            <Grid item xs={6} md={3}>
                                <Card>
                                    <CardContent>
                                        <Typography color="textSecondary">메모리 사용률</Typography>
                                        <Typography variant="h4">{(state.metrics.system_health.memory_usage * 100).toFixed(1)}%</Typography>
                                    </CardContent>
                                </Card>
                            </Grid>
                            <Grid item xs={6} md={3}>
                                <Card>
                                    <CardContent>
                                        <Typography color="textSecondary">네트워크 사용률</Typography>
                                        <Typography variant="h4">{(state.metrics.system_health.network_usage * 100).toFixed(1)}%</Typography>
                                    </CardContent>
                                </Card>
                            </Grid>
                            <Grid item xs={6} md={3}>
                                <Card>
                                    <CardContent>
                                        <Typography color="textSecondary">오류율</Typography>
                                        <Typography variant="h4">{(state.metrics.system_health.error_rate * 100).toFixed(2)}%</Typography>
                                    </CardContent>
                                </Card>
                            </Grid>
                        </Grid>
                    )}
                </DialogContent>
                <DialogActions>
                    <Button onClick={() => setState(prev => ({ ...prev, showMetrics: false }))}>
                        닫기
                    </Button>
                </DialogActions>
            </Dialog>

            {/* 설정 다이얼로그 */}
            <Dialog open={state.showSettings} onClose={() => setState(prev => ({ ...prev, showSettings: false }))} maxWidth="md" fullWidth>
                <DialogTitle>
                    채팅 설정
                </DialogTitle>
                <DialogContent>
                    <Grid container spacing={2}>
                        <Grid item xs={12} md={6}>
                            <FormControl fullWidth sx={{ mb: 2 }}>
                                <InputLabel>모델</InputLabel>
                                <Select
                                    value={state.settings.model}
                                    onChange={(e) => handleSettingsChange('model', e.target.value)}
                                >
                                    <MenuItem value="gpt-4">GPT-4</MenuItem>
                                    <MenuItem value="gpt-3.5-turbo">GPT-3.5 Turbo</MenuItem>
                                    <MenuItem value="claude-3">Claude-3</MenuItem>
                                </Select>
                            </FormControl>

                            <FormControl fullWidth sx={{ mb: 2 }}>
                                <InputLabel>언어</InputLabel>
                                <Select
                                    value={state.settings.language}
                                    onChange={(e) => handleSettingsChange('language', e.target.value)}
                                >
                                    <MenuItem value="ko">한국어</MenuItem>
                                    <MenuItem value="en">English</MenuItem>
                                    <MenuItem value="ja">日本語</MenuItem>
                                </Select>
                            </FormControl>

                            <FormControl fullWidth sx={{ mb: 2 }}>
                                <InputLabel>응답 스타일</InputLabel>
                                <Select
                                    value={state.settings.response_style}
                                    onChange={(e) => handleSettingsChange('response_style', e.target.value)}
                                >
                                    <MenuItem value="analytical">분석적</MenuItem>
                                    <MenuItem value="creative">창의적</MenuItem>
                                    <MenuItem value="concise">간결</MenuItem>
                                    <MenuItem value="detailed">상세</MenuItem>
                                    <MenuItem value="professional">전문적</MenuItem>
                                    <MenuItem value="casual">친근</MenuItem>
                                </Select>
                            </FormControl>

                            <Typography gutterBottom>온도</Typography>
                            <Slider
                                value={state.settings.temperature}
                                onChange={(e, value) => handleSettingsChange('temperature', value)}
                                min={0}
                                max={2}
                                step={0.1}
                                marks
                                valueLabelDisplay="auto"
                            />

                            <Typography gutterBottom>최대 토큰</Typography>
                            <Slider
                                value={state.settings.max_tokens}
                                onChange={(e, value) => handleSettingsChange('max_tokens', value)}
                                min={100}
                                max={4000}
                                step={100}
                                marks
                                valueLabelDisplay="auto"
                            />
                        </Grid>

                        <Grid item xs={12} md={6}>
                            <Typography variant="h6" gutterBottom>
                                고급 기능
                            </Typography>

                            <FormControlLabel
                                control={
                                    <Switch
                                        checked={state.settings.auto_analysis}
                                        onChange={(e) => handleSettingsChange('auto_analysis', e.target.checked)}
                                    />
                                }
                                label="자동 분석"
                            />

                            <FormControlLabel
                                control={
                                    <Switch
                                        checked={state.settings.real_time_optimization}
                                        onChange={(e) => handleSettingsChange('real_time_optimization', e.target.checked)}
                                    />
                                }
                                label="실시간 최적화"
                            />

                            <FormControlLabel
                                control={
                                    <Switch
                                        checked={state.settings.workflow_integration}
                                        onChange={(e) => handleSettingsChange('workflow_integration', e.target.checked)}
                                    />
                                }
                                label="워크플로우 통합"
                            />

                            <FormControlLabel
                                control={
                                    <Switch
                                        checked={state.settings.performance_monitoring}
                                        onChange={(e) => handleSettingsChange('performance_monitoring', e.target.checked)}
                                    />
                                }
                                label="성능 모니터링"
                            />

                            <FormControlLabel
                                control={
                                    <Switch
                                        checked={state.settings.multi_modal_support}
                                        onChange={(e) => handleSettingsChange('multi_modal_support', e.target.checked)}
                                    />
                                }
                                label="멀티모달 지원"
                            />

                            <FormControlLabel
                                control={
                                    <Switch
                                        checked={state.settings.integration_auto_select}
                                        onChange={(e) => handleSettingsChange('integration_auto_select', e.target.checked)}
                                    />
                                }
                                label="통합 자동 선택"
                            />
                        </Grid>
                    </Grid>
                </DialogContent>
                <DialogActions>
                    <Button onClick={() => setState(prev => ({ ...prev, showSettings: false }))}>
                        닫기
                    </Button>
                </DialogActions>
            </Dialog>
        </Box>
    );
};

export default UltraAdvancedAIIntegratedChatInterface;
