                                                            {module.name}
                                                        </Typography>
                                                        <Box sx={{ display: 'flex', gap: 1 }}>
                                                            <Chip
                                                                label={getStatusLabel(module.status)}
                                                                size="small"
                                                                color={getStatusColor(module.status) as any}
                                                            />
                                                            <Chip
                                                                label={getPriorityLabel(module.priority)}
                                                                size="small"
                                                                color={getPriorityColor(module.priority) as any}
                                                            />
                                                        </Box>
                                                    </Box>
                                                    <Typography variant="body2" color="text.secondary" paragraph>
                                                        {module.description}
                                                    </Typography>
                                                    <Box sx={{ mb: 2 }}>
                                                        <Typography variant="caption" color="text.secondary">
                                                            성능: {module.performance}%
                                                        </Typography>
                                                        <LinearProgress
                                                            variant="determinate"
                                                            value={module.performance}
                                                            sx={{ height: 6, borderRadius: 3, mt: 0.5 }}
                                                        />
                                                    </Box>
                                                    <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                                                        <Typography variant="caption" color="text.secondary">
                                                            CPU: {module.resources.cpu}%
                                                        </Typography>
                                                        <Typography variant="caption" color="text.secondary">
                                                            메모리: {module.resources.memory}%
                                                        </Typography>
                                                    </Box>
                                                </CardContent>
                                            </Card>
                                        </Grid>
                                    ))}
                                </Grid>
                            </Box>
                        )}

                        {/* 통합 워크플로우 탭 */}
                        {activeTab === 1 && (
                            <Box sx={{ mt: 3 }}>
                                <Typography variant="h6" gutterBottom>통합 워크플로우</Typography>
                                <Grid container spacing={3}>
                                    {integrationWorkflows.map((workflow) => (
                                        <Grid item xs={12} md={6} key={workflow.id}>
                                            <Card
                                                sx={{
                                                    cursor: 'pointer',
                                                    '&:hover': { bgcolor: 'action.hover' }
                                                }}
                                                onClick={() => handleWorkflowClick(workflow)}
                                            >
                                                <CardContent>
                                                    <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start', mb: 2 }}>
                                                        <Typography variant="h6" sx={{ flexGrow: 1 }}>
                                                            {workflow.name}
                                                        </Typography>
                                                        <Chip
                                                            label={getStatusLabel(workflow.status)}
                                                            size="small"
                                                            color={getStatusColor(workflow.status) as any}
                                                        />
                                                    </Box>
                                                    <Typography variant="body2" color="text.secondary" paragraph>
                                                        {workflow.description}
                                                    </Typography>
                                                    <Box sx={{ mb: 2 }}>
                                                        <Typography variant="caption" color="text.secondary">
                                                            진행률: {workflow.progress}%
                                                        </Typography>
                                                        <LinearProgress
                                                            variant="determinate"
                                                            value={workflow.progress}
                                                            sx={{ height: 6, borderRadius: 3, mt: 0.5 }}
                                                        />
                                                    </Box>
                                                    <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                                                        <Typography variant="caption" color="text.secondary">
                                                            우선순위: {getPriorityLabel(workflow.priority)}
                                                        </Typography>
                                                        <Typography variant="caption" color="text.secondary">
                                                            시작: {new Date(workflow.startTime).toLocaleDateString()}
                                                        </Typography>
                                                    </Box>
                                                </CardContent>
                                            </Card>
                                        </Grid>
                                    ))}
                                </Grid>
                            </Box>
                        )}

                        {/* 성능 모니터링 탭 */}
                        {activeTab === 2 && (
                            <Box sx={{ mt: 3 }}>
                                <Typography variant="h6" gutterBottom>실시간 성능 모니터링</Typography>
                                <Grid container spacing={3}>
                                    <Grid item xs={12} md={6}>
                                        <Card>
                                            <CardContent>
                                                <Typography variant="h6" gutterBottom>시스템 리소스 사용률</Typography>
                                                <Box sx={{ mb: 2 }}>
                                                    <Typography variant="body2">CPU 사용률</Typography>
                                                    <LinearProgress variant="determinate" value={85} sx={{ height: 8, borderRadius: 4 }} />
                                                    <Typography variant="caption" color="text.secondary">85%</Typography>
                                                </Box>
                                                <Box sx={{ mb: 2 }}>
                                                    <Typography variant="body2">메모리 사용률</Typography>
                                                    <LinearProgress variant="determinate" value={72} sx={{ height: 8, borderRadius: 4 }} />
                                                    <Typography variant="caption" color="text.secondary">72%</Typography>
                                                </Box>
                                                <Box sx={{ mb: 2 }}>
                                                    <Typography variant="body2">스토리지 사용률</Typography>
                                                    <LinearProgress variant="determinate" value={45} sx={{ height: 8, borderRadius: 4 }} />
                                                    <Typography variant="caption" color="text.secondary">45%</Typography>
                                                </Box>
                                                <Box>
                                                    <Typography variant="body2">네트워크 사용률</Typography>
                                                    <LinearProgress variant="determinate" value={68} sx={{ height: 8, borderRadius: 4 }} />
                                                    <Typography variant="caption" color="text.secondary">68%</Typography>
                                                </Box>
                                            </CardContent>
                                        </Card>
                                    </Grid>
                                    <Grid item xs={12} md={6}>
                                        <Card>
                                            <CardContent>
                                                <Typography variant="h6" gutterBottom>AI 모델 성능</Typography>
                                                <Box sx={{ mb: 2 }}>
                                                    <Typography variant="body2">정확도</Typography>
                                                    <LinearProgress variant="determinate" value={96} sx={{ height: 8, borderRadius: 4 }} />
                                                    <Typography variant="caption" color="text.secondary">96%</Typography>
                                                </Box>
                                                <Box sx={{ mb: 2 }}>
                                                    <Typography variant="body2">처리 속도</Typography>
                                                    <LinearProgress variant="determinate" value={94} sx={{ height: 8, borderRadius: 4 }} />
                                                    <Typography variant="caption" color="text.secondary">94%</Typography>
                                                </Box>
                                                <Box sx={{ mb: 2 }}>
                                                    <Typography variant="body2">안정성</Typography>
                                                    <LinearProgress variant="determinate" value={98} sx={{ height: 8, borderRadius: 4 }} />
                                                    <Typography variant="caption" color="text.secondary">98%</Typography>
                                                </Box>
                                                <Box>
                                                    <Typography variant="body2">효율성</Typography>
                                                    <LinearProgress variant="determinate" value={92} sx={{ height: 8, borderRadius: 4 }} />
                                                    <Typography variant="caption" color="text.secondary">92%</Typography>
                                                </Box>
                                            </CardContent>
                                        </Card>
                                    </Grid>
                                </Grid>
                            </Box>
                        )}

                        {/* 시스템 관리 탭 */}
                        {activeTab === 3 && (
                            <Box sx={{ mt: 3 }}>
                                <Typography variant="h6" gutterBottom>시스템 관리 도구</Typography>
                                <Grid container spacing={3}>
                                    <Grid item xs={12} md={6}>
                                        <Accordion>
                                            <AccordionSummary expandIcon={<ExpandMoreIcon />}>
                                                <Typography variant="h6">시스템 설정</Typography>
                                            </AccordionSummary>
                                            <AccordionDetails>
                                                <Typography variant="body2" color="text.secondary" paragraph>
                                                    전체 시스템 설정 및 구성 관리
                                                </Typography>
                                                <Button variant="contained" startIcon={<SettingsIcon />}>
                                                    설정 관리
                                                </Button>
                                            </AccordionDetails>
                                        </Accordion>
                                    </Grid>
                                    <Grid item xs={12} md={6}>
                                        <Accordion>
                                            <AccordionSummary expandIcon={<ExpandMoreIcon />}>
                                                <Typography variant="h6">백업 및 복구</Typography>
                                            </AccordionSummary>
                                            <AccordionDetails>
                                                <Typography variant="body2" color="text.secondary" paragraph>
                                                    시스템 백업 및 재해 복구 관리
                                                </Typography>
                                                <Button variant="contained" startIcon={<CloudUploadIcon />}>
                                                    백업 관리
                                                </Button>
                                            </AccordionDetails>
                                        </Accordion>
                                    </Grid>
                                    <Grid item xs={12} md={6}>
                                        <Accordion>
                                            <AccordionSummary expandIcon={<ExpandMoreIcon />}>
                                                <Typography variant="h6">보안 관리</Typography>
                                            </AccordionSummary>
                                            <AccordionDetails>
                                                <Typography variant="body2" color="text.secondary" paragraph>
                                                    보안 설정 및 접근 제어 관리
                                                </Typography>
                                                <Button variant="contained" startIcon={<SecurityIcon />}>
                                                    보안 관리
                                                </Button>
                                            </AccordionDetails>
                                        </Accordion>
                                    </Grid>
                                    <Grid item xs={12} md={6}>
                                        <Accordion>
                                            <AccordionSummary expandIcon={<ExpandMoreIcon />}>
                                                <Typography variant="h6">업데이트 관리</Typography>
                                            </AccordionSummary>
                                            <AccordionDetails>
                                                <Typography variant="body2" color="text.secondary" paragraph>
                                                    시스템 업데이트 및 패치 관리
                                                </Typography>
                                                <Button variant="contained" startIcon={<RefreshIcon />}>
                                                    업데이트 관리
                                                </Button>
                                            </AccordionDetails>
                                        </Accordion>
                                    </Grid>
                                </Grid>
                            </Box>
                        )}
                    </CardContent>
                </Card>

                {/* SpeedDial */}
                <SpeedDial
                    ariaLabel="통합 플랫폼 도구"
                    sx={{ position: 'fixed', bottom: 16, right: 16 }}
                    icon={<SpeedDialIcon />}
                >
                    {quickActions.map((action) => (
                        <SpeedDialAction
                            key={action.name}
                            icon={action.icon}
                            tooltipTitle={action.name}
                            onClick={action.action}
                        />
                    ))}
                </SpeedDial>

                {/* 모듈 상세 다이얼로그 */}
                <Dialog
                    open={showModuleDialog}
                    onClose={() => setShowModuleDialog(false)}
                    maxWidth="md"
                    fullWidth
                >
                    {selectedModule && (
                        <>
                            <DialogTitle>
                                <Box sx={{ display: 'flex', alignItems: 'center', gap: 2 }}>
                                    <Typography variant="h6">{selectedModule.name}</Typography>
                                    <Chip
                                        label={getStatusLabel(selectedModule.status)}
                                        color={getStatusColor(selectedModule.status) as any}
                                    />
                                    <Chip
                                        label={getPriorityLabel(selectedModule.priority)}
                                        color={getPriorityColor(selectedModule.priority) as any}
                                    />
                                </Box>
                            </DialogTitle>
                            <DialogContent>
                                <Typography variant="body1" paragraph>
                                    {selectedModule.description}
                                </Typography>

                                <Typography variant="h6" gutterBottom>리소스 사용률:</Typography>
                                <Grid container spacing={2} sx={{ mb: 2 }}>
                                    <Grid item xs={6}>
                                        <Typography variant="body2">CPU: {selectedModule.resources.cpu}%</Typography>
                                        <LinearProgress variant="determinate" value={selectedModule.resources.cpu} sx={{ height: 6, borderRadius: 3 }} />
                                    </Grid>
                                    <Grid item xs={6}>
                                        <Typography variant="body2">메모리: {selectedModule.resources.memory}%</Typography>
                                        <LinearProgress variant="determinate" value={selectedModule.resources.memory} sx={{ height: 6, borderRadius: 3 }} />
                                    </Grid>
                                    <Grid item xs={6}>
                                        <Typography variant="body2">스토리지: {selectedModule.resources.storage}%</Typography>
                                        <LinearProgress variant="determinate" value={selectedModule.resources.storage} sx={{ height: 6, borderRadius: 3 }} />
                                    </Grid>
                                    <Grid item xs={6}>
                                        <Typography variant="body2">네트워크: {selectedModule.resources.network}%</Typography>
                                        <LinearProgress variant="determinate" value={selectedModule.resources.network} sx={{ height: 6, borderRadius: 3 }} />
                                    </Grid>
                                </Grid>

                                <Typography variant="h6" gutterBottom>성능 지표:</Typography>
                                <Grid container spacing={2} sx={{ mb: 2 }}>
                                    <Grid item xs={6}>
                                        <Typography variant="body2">가동률: {selectedModule.metrics.uptime}%</Typography>
                                    </Grid>
                                    <Grid item xs={6}>
                                        <Typography variant="body2">응답시간: {selectedModule.metrics.responseTime}ms</Typography>
                                    </Grid>
                                    <Grid item xs={6}>
                                        <Typography variant="body2">처리량: {selectedModule.metrics.throughput.toLocaleString()}/초</Typography>
                                    </Grid>
                                    <Grid item xs={6}>
                                        <Typography variant="body2">오류율: {selectedModule.metrics.errorRate}%</Typography>
                                    </Grid>
                                </Grid>

                                <Typography variant="h6" gutterBottom>의존성:</Typography>
                                <Box sx={{ mb: 2 }}>
                                    {selectedModule.dependencies.map((dep, index) => (
                                        <Chip key={index} label={dep} sx={{ mr: 1, mb: 1 }} />
                                    ))}
                                </Box>
                            </DialogContent>
                            <DialogActions>
                                <Button onClick={() => setShowModuleDialog(false)}>닫기</Button>
                                <Button variant="contained" onClick={() => setShowModuleDialog(false)}>
                                    모듈 관리
                                </Button>
                            </DialogActions>
                        </>
                    )}
                </Dialog>

                {/* 워크플로우 상세 다이얼로그 */}
                <Dialog
                    open={showWorkflowDialog}
                    onClose={() => setShowWorkflowDialog(false)}
                    maxWidth="md"
                    fullWidth
                >
                    {selectedWorkflow && (
                        <>
                            <DialogTitle>
                                <Box sx={{ display: 'flex', alignItems: 'center', gap: 2 }}>
                                    <Typography variant="h6">{selectedWorkflow.name}</Typography>
                                    <Chip
                                        label={getStatusLabel(selectedWorkflow.status)}
                                        color={getStatusColor(selectedWorkflow.status) as any}
                                    />
                                </Box>
                            </DialogTitle>
                            <DialogContent>
                                <Typography variant="body1" paragraph>
                                    {selectedWorkflow.description}
                                </Typography>

                                <Typography variant="h6" gutterBottom>워크플로우 단계:</Typography>
                                <Stepper orientation="vertical">
                                    {selectedWorkflow.steps.map((step, index) => (
                                        <Step key={index} active={step.status === 'running'} completed={step.status === 'completed'}>
                                            <StepLabel>
                                                <Box sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                                                    <Typography variant="body2">{step.name}</Typography>
                                                    <Chip
                                                        label={getStatusLabel(step.status)}
                                                        size="small"
                                                        color={getStatusColor(step.status) as any}
                                                    />
                                                </Box>
                                            </StepLabel>
                                            <StepContent>
                                                <Typography variant="body2" color="text.secondary">
                                                    {step.description}
                                                </Typography>
                                            </StepContent>
                                        </Step>
                                    ))}
                                </Stepper>

                                <Box sx={{ mt: 2 }}>
                                    <Typography variant="body2" color="text.secondary">
                                        시작 시간: {new Date(selectedWorkflow.startTime).toLocaleString()}
                                    </Typography>
                                    {selectedWorkflow.endTime && (
                                        <Typography variant="body2" color="text.secondary">
                                            완료 시간: {new Date(selectedWorkflow.endTime).toLocaleString()}
                                        </Typography>
                                    )}
                                    <Typography variant="body2" color="text.secondary">
                                        우선순위: {getPriorityLabel(selectedWorkflow.priority)}
                                    </Typography>
                                </Box>
                            </DialogContent>
                            <DialogActions>
                                <Button onClick={() => setShowWorkflowDialog(false)}>닫기</Button>
                                <Button variant="contained" onClick={() => setShowWorkflowDialog(false)}>
                                    워크플로우 관리
                                </Button>
                            </DialogActions>
                        </>
                    )}
                </Dialog>

                {/* Snackbar */}
                <Snackbar
                    open={showSnackbar}
                    autoHideDuration={3000}
                    onClose={() => setShowSnackbar(false)}
                    message={snackbarMessage}
                />

                {/* 자식 컴포넌트 렌더링 */}
                {children}
            </Container>
        </Box>
    );
};

export default CORBUUltimateIntegrationPlatform;
