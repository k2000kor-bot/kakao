import React, { useState, useEffect } from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import {
    Monitor,
    Activity,
    Computer as Cpu,
    HardDrive,
    Wifi,
    Database,
    Server,
    Clock,
    AlertTriangle,
    CheckCircle,
    XCircle,
    Info,
    RefreshCw,
    TrendingUp,
    TrendingDown,
    Zap,
    Shield,
    Bell,
    Eye,
    EyeOff,
    Settings,
    Download,
    Upload,
    Play,
    Pause,
    Square,
    BarChart,
    LineChart,
    Gauge,
    Thermometer,
    Battery,
    Signal,
    Globe,
    Lock,
    Unlock,
    Key,
    User,
    Users,
    FileText,
    Folder,
    MessageSquare
} from 'lucide-react';

interface SystemMetric {
    id: string;
    name: string;
    value: number;
    unit: string;
    status: 'excellent' | 'good' | 'warning' | 'critical';
    trend: 'up' | 'down' | 'stable';
    threshold: {
        warning: number;
        critical: number;
    };
    history: Array<{
        timestamp: Date;
        value: number;
    }>;
}

interface SystemAlert {
    id: string;
    type: 'info' | 'warning' | 'error' | 'critical';
    title: string;
    message: string;
    timestamp: Date;
    isResolved: boolean;
    source: string;
    severity: 'low' | 'medium' | 'high' | 'critical';
}

interface SystemService {
    id: string;
    name: string;
    status: 'running' | 'stopped' | 'error' | 'maintenance';
    uptime: number;
    responseTime: number;
    errorRate: number;
    lastCheck: Date;
    health: 'excellent' | 'good' | 'warning' | 'critical';
}

interface SystemMonitoringProps {
    onAlertAction?: (alert: SystemAlert) => void;
    onServiceAction?: (action: string, service: SystemService) => void;
}

const SystemMonitoring: React.FC<SystemMonitoringProps> = ({ onAlertAction, onServiceAction }) => {
    const [metrics, setMetrics] = useState<SystemMetric[]>([]);
    const [alerts, setAlerts] = useState<SystemAlert[]>([]);
    const [services, setServices] = useState<SystemService[]>([]);
    const [isAutoRefresh, setIsAutoRefresh] = useState(true);
    const [refreshInterval, setRefreshInterval] = useState(30);
    const [selectedView, setSelectedView] = useState<'overview' | 'metrics' | 'alerts' | 'services'>('overview');
    const [isLoading, setIsLoading] = useState(false);

    // Mock 데이터 생성
    useEffect(() => {
        generateMonitoringData();

        if (isAutoRefresh) {
            const interval = setInterval(generateMonitoringData, refreshInterval * 1000);
            return () => clearInterval(interval);
        }
    }, [isAutoRefresh, refreshInterval]);

    const generateMonitoringData = () => {
        setIsLoading(true);

        // 시뮬레이션된 데이터 생성
        setTimeout(() => {
            const mockMetrics: SystemMetric[] = [
                {
                    id: 'cpu_usage',
                    name: 'CPU 사용률',
                    value: Math.random() * 30 + 20, // 20-50%
                    unit: '%',
                    status: 'good',
                    trend: 'stable',
                    threshold: { warning: 70, critical: 90 },
                    history: generateHistory(20, 50)
                },
                {
                    id: 'memory_usage',
                    name: '메모리 사용률',
                    value: Math.random() * 40 + 30, // 30-70%
                    unit: '%',
                    status: 'good',
                    trend: 'up',
                    threshold: { warning: 80, critical: 95 },
                    history: generateHistory(30, 70)
                },
                {
                    id: 'disk_usage',
                    name: '디스크 사용률',
                    value: Math.random() * 20 + 60, // 60-80%
                    unit: '%',
                    status: 'warning',
                    trend: 'up',
                    threshold: { warning: 75, critical: 90 },
                    history: generateHistory(60, 80)
                },
                {
                    id: 'network_usage',
                    name: '네트워크 사용률',
                    value: Math.random() * 50 + 10, // 10-60%
                    unit: '%',
                    status: 'excellent',
                    trend: 'stable',
                    threshold: { warning: 80, critical: 95 },
                    history: generateHistory(10, 60)
                },
                {
                    id: 'response_time',
                    name: '응답 시간',
                    value: Math.random() * 200 + 50, // 50-250ms
                    unit: 'ms',
                    status: 'good',
                    trend: 'down',
                    threshold: { warning: 500, critical: 1000 },
                    history: generateHistory(50, 250)
                },
                {
                    id: 'error_rate',
                    name: '오류율',
                    value: Math.random() * 2, // 0-2%
                    unit: '%',
                    status: 'excellent',
                    trend: 'stable',
                    threshold: { warning: 5, critical: 10 },
                    history: generateHistory(0, 2)
                }
            ];

            const mockAlerts: SystemAlert[] = [
                {
                    id: '1',
                    type: 'warning',
                    title: '디스크 사용률 높음',
                    message: '디스크 사용률이 75%를 초과했습니다. 정리 작업을 권장합니다.',
                    timestamp: new Date(Date.now() - 300000), // 5분 전
                    isResolved: false,
                    source: 'disk_monitor',
                    severity: 'medium'
                },
                {
                    id: '2',
                    type: 'info',
                    title: '백업 완료',
                    message: '일일 시스템 백업이 성공적으로 완료되었습니다.',
                    timestamp: new Date(Date.now() - 3600000), // 1시간 전
                    isResolved: true,
                    source: 'backup_service',
                    severity: 'low'
                },
                {
                    id: '3',
                    type: 'error',
                    title: '서비스 응답 지연',
                    message: '데이터베이스 서비스의 응답 시간이 증가하고 있습니다.',
                    timestamp: new Date(Date.now() - 600000), // 10분 전
                    isResolved: false,
                    source: 'database_monitor',
                    severity: 'high'
                }
            ];

            const mockServices: SystemService[] = [
                {
                    id: '1',
                    name: '웹 서버',
                    status: 'running',
                    uptime: 99.9,
                    responseTime: 120,
                    errorRate: 0.1,
                    lastCheck: new Date(),
                    health: 'excellent'
                },
                {
                    id: '2',
                    name: '데이터베이스',
                    status: 'running',
                    uptime: 99.8,
                    responseTime: 250,
                    errorRate: 0.5,
                    lastCheck: new Date(),
                    health: 'warning'
                },
                {
                    id: '3',
                    name: '캐시 서버',
                    status: 'running',
                    uptime: 99.7,
                    responseTime: 50,
                    errorRate: 0.0,
                    lastCheck: new Date(),
                    health: 'excellent'
                },
                {
                    id: '4',
                    name: '백업 서비스',
                    status: 'running',
                    uptime: 99.5,
                    responseTime: 5000,
                    errorRate: 0.0,
                    lastCheck: new Date(),
                    health: 'good'
                }
            ];

            setMetrics(mockMetrics);
            setAlerts(mockAlerts);
            setServices(mockServices);
            setIsLoading(false);
        }, 500);
    };

    const generateHistory = (min: number, max: number) => {
        const history = [];
        const now = new Date();
        for (let i = 23; i >= 0; i--) {
            history.push({
                timestamp: new Date(now.getTime() - i * 3600000), // 1시간 간격
                value: Math.random() * (max - min) + min
            });
        }
        return history;
    };

    const getStatusColor = (status: string) => {
        switch (status) {
            case 'excellent': return 'text-green-600 bg-green-100';
            case 'good': return 'text-blue-600 bg-blue-100';
            case 'warning': return 'text-yellow-600 bg-yellow-100';
            case 'critical': return 'text-red-600 bg-red-100';
            default: return 'text-gray-600 bg-gray-100';
        }
    };

    const getAlertColor = (type: string) => {
        switch (type) {
            case 'info': return 'text-blue-600 bg-blue-100';
            case 'warning': return 'text-yellow-600 bg-yellow-100';
            case 'error': return 'text-red-600 bg-red-100';
            case 'critical': return 'text-red-800 bg-red-200';
            default: return 'text-gray-600 bg-gray-100';
        }
    };

    const getSeverityColor = (severity: string) => {
        switch (severity) {
            case 'critical': return 'text-red-600';
            case 'high': return 'text-orange-600';
            case 'medium': return 'text-yellow-600';
            case 'low': return 'text-blue-600';
            default: return 'text-gray-600';
        }
    };

    const getTrendIcon = (trend: string) => {
        switch (trend) {
            case 'up': return TrendingUp;
            case 'down': return TrendingDown;
            default: return Activity;
        }
    };

    const formatUptime = (uptime: number) => {
        return `${uptime.toFixed(1)}%`;
    };

    const formatResponseTime = (time: number) => {
        return time < 1000 ? `${time}ms` : `${(time / 1000).toFixed(1)}s`;
    };

    return (
        <div className="space-y-6">
            {/* Header */}
            <div className="flex items-center justify-between">
                <div className="flex items-center space-x-3">
                    <div className="bg-purple-100 p-2 rounded-lg">
                        <Monitor className="h-6 w-6 text-purple-600" />
                    </div>
                    <div>
                        <h2 className="text-xl font-bold text-gray-900">시스템 모니터링</h2>
                        <p className="text-sm text-gray-600">실시간 시스템 성능 및 상태 모니터링</p>
                    </div>
                </div>
                <div className="flex items-center space-x-3">
                    <div className="flex items-center space-x-2">
                        <div className="flex items-center space-x-2">
                            <input
                                type="checkbox"
                                checked={isAutoRefresh}
                                onChange={(e) => setIsAutoRefresh(e.target.checked)}
                                className="h-4 w-4 text-purple-600 focus:ring-purple-500 border-gray-300 rounded"
                            />
                            <span className="text-sm text-gray-600">자동 새로고침</span>
                        </div>
                        <select
                            value={refreshInterval}
                            onChange={(e) => setRefreshInterval(parseInt(e.target.value))}
                            className="px-2 py-1 border border-gray-300 rounded-md text-sm"
                        >
                            <option value={10}>10초</option>
                            <option value={30}>30초</option>
                            <option value={60}>1분</option>
                            <option value={300}>5분</option>
                        </select>
                    </div>
                    <button
                        onClick={generateMonitoringData}
                        disabled={isLoading}
                        className="flex items-center px-3 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-md hover:bg-gray-200"
                    >
                        <RefreshCw className={`w-4 h-4 mr-2 ${isLoading ? 'animate-spin' : ''}`} />
                        새로고침
                    </button>
                </div>
            </div>

            {/* Navigation Tabs */}
            <div className="bg-white rounded-lg shadow-sm border border-gray-200">
                <div className="border-b border-gray-200">
                    <nav className="flex space-x-8 px-6">
                        {[
                            { id: 'overview', name: '개요', icon: Monitor },
                            { id: 'metrics', name: '메트릭', icon: BarChart },
                            { id: 'alerts', name: '알림', icon: Bell },
                            { id: 'services', name: '서비스', icon: Server }
                        ].map((tab) => (
                            <button
                                key={tab.id}
                                onClick={() => setSelectedView(tab.id as any)}
                                className={`flex items-center px-3 py-4 text-sm font-medium border-b-2 ${selectedView === tab.id
                                    ? 'border-purple-500 text-purple-600'
                                    : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'
                                    }`}
                            >
                                <tab.icon className="w-4 h-4 mr-2" />
                                {tab.name}
                            </button>
                        ))}
                    </nav>
                </div>

                {/* Content */}
                <div className="p-6">
                    <AnimatePresence mode="wait">
                        {selectedView === 'overview' && (
                            <motion.div
                                key="overview"
                                initial={{ opacity: 0, y: 20 }}
                                animate={{ opacity: 1, y: 0 }}
                                exit={{ opacity: 0, y: -20 }}
                                className="space-y-6"
                            >
                                {/* Key Metrics */}
                                <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                                    {metrics.slice(0, 6).map((metric) => {
                                        const TrendIcon = getTrendIcon(metric.trend);
                                        return (
                                            <div key={metric.id} className="bg-gray-50 rounded-lg p-6 border border-gray-200">
                                                <div className="flex items-center justify-between mb-4">
                                                    <h3 className="text-lg font-semibold text-gray-900">{metric.name}</h3>
                                                    <span className={`px-2 py-1 rounded-full text-xs font-medium ${getStatusColor(metric.status)}`}>
                                                        {metric.status === 'excellent' ? '우수' :
                                                            metric.status === 'good' ? '양호' :
                                                                metric.status === 'warning' ? '주의' : '위험'}
                                                    </span>
                                                </div>
                                                <div className="flex items-end justify-between">
                                                    <div>
                                                        <div className="text-3xl font-bold text-gray-900">
                                                            {metric.value.toFixed(1)}
                                                            <span className="text-lg text-gray-500 ml-1">{metric.unit}</span>
                                                        </div>
                                                        <div className="flex items-center mt-2 text-sm text-gray-600">
                                                            <TrendIcon className="w-4 h-4 mr-1" />
                                                            {metric.trend === 'up' ? '증가' :
                                                                metric.trend === 'down' ? '감소' : '안정'}
                                                        </div>
                                                    </div>
                                                    <div className="text-right">
                                                        <div className="text-sm text-gray-500">임계값</div>
                                                        <div className="text-xs text-gray-400">
                                                            경고: {metric.threshold.warning}{metric.unit}
                                                        </div>
                                                        <div className="text-xs text-gray-400">
                                                            위험: {metric.threshold.critical}{metric.unit}
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        );
                                    })}
                                </div>

                                {/* Recent Alerts */}
                                <div>
                                    <h3 className="text-lg font-semibold text-gray-900 mb-4">최근 알림</h3>
                                    <div className="space-y-3">
                                        {alerts.slice(0, 5).map((alert) => (
                                            <div key={alert.id} className="bg-white border border-gray-200 rounded-lg p-4">
                                                <div className="flex items-start justify-between">
                                                    <div className="flex items-start space-x-3">
                                                        <div className={`p-2 rounded-lg ${getAlertColor(alert.type)}`}>
                                                            {alert.type === 'info' ? <Info className="w-4 h-4" /> :
                                                                alert.type === 'warning' ? <AlertTriangle className="w-4 h-4" /> :
                                                                    alert.type === 'error' ? <XCircle className="w-4 h-4" /> :
                                                                        <AlertTriangle className="w-4 h-4" />}
                                                        </div>
                                                        <div className="flex-1">
                                                            <div className="flex items-center space-x-2 mb-1">
                                                                <h4 className="font-medium text-gray-900">{alert.title}</h4>
                                                                <span className={`text-xs font-medium ${getSeverityColor(alert.severity)}`}>
                                                                    {alert.severity === 'critical' ? '긴급' :
                                                                        alert.severity === 'high' ? '높음' :
                                                                            alert.severity === 'medium' ? '보통' : '낮음'}
                                                                </span>
                                                            </div>
                                                            <p className="text-sm text-gray-600 mb-2">{alert.message}</p>
                                                            <div className="flex items-center space-x-4 text-xs text-gray-500">
                                                                <span>{alert.timestamp.toLocaleString('ko-KR')}</span>
                                                                <span>출처: {alert.source}</span>
                                                                {alert.isResolved && (
                                                                    <span className="text-green-600">해결됨</span>
                                                                )}
                                                            </div>
                                                        </div>
                                                    </div>
                                                    {!alert.isResolved && (
                                                        <button
                                                            onClick={() => onAlertAction?.(alert)}
                                                            className="text-purple-600 hover:text-purple-700 text-sm font-medium"
                                                        >
                                                            처리
                                                        </button>
                                                    )}
                                                </div>
                                            </div>
                                        ))}
                                    </div>
                                </div>
                            </motion.div>
                        )}

                        {selectedView === 'metrics' && (
                            <motion.div
                                key="metrics"
                                initial={{ opacity: 0, y: 20 }}
                                animate={{ opacity: 1, y: 0 }}
                                exit={{ opacity: 0, y: -20 }}
                                className="space-y-6"
                            >
                                <div className="text-center py-12">
                                    <Assessment className="w-12 h-12 text-gray-400 mx-auto mb-4" />
                                    <h3 className="text-lg font-medium text-gray-900 mb-2">상세 메트릭</h3>
                                    <p className="text-gray-600">상세한 메트릭 차트 및 분석이 곧 추가됩니다.</p>
                                </div>
                            </motion.div>
                        )}

                        {selectedView === 'alerts' && (
                            <motion.div
                                key="alerts"
                                initial={{ opacity: 0, y: 20 }}
                                animate={{ opacity: 1, y: 0 }}
                                exit={{ opacity: 0, y: -20 }}
                                className="space-y-6"
                            >
                                <div className="text-center py-12">
                                    <Bell className="w-12 h-12 text-gray-400 mx-auto mb-4" />
                                    <h3 className="text-lg font-medium text-gray-900 mb-2">알림 관리</h3>
                                    <p className="text-gray-600">알림 설정 및 관리 기능이 곧 추가됩니다.</p>
                                </div>
                            </motion.div>
                        )}

                        {selectedView === 'services' && (
                            <motion.div
                                key="services"
                                initial={{ opacity: 0, y: 20 }}
                                animate={{ opacity: 1, y: 0 }}
                                exit={{ opacity: 0, y: -20 }}
                                className="space-y-6"
                            >
                                <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                                    {services.map((service) => (
                                        <div key={service.id} className="bg-gray-50 rounded-lg p-6 border border-gray-200">
                                            <div className="flex items-center justify-between mb-4">
                                                <div className="flex items-center space-x-3">
                                                    <div className={`p-2 rounded-lg ${getStatusColor(service.health)}`}>
                                                        <Server className="w-5 h-5" />
                                                    </div>
                                                    <div>
                                                        <h3 className="font-semibold text-gray-900">{service.name}</h3>
                                                        <span className={`px-2 py-1 rounded-full text-xs font-medium ${getStatusColor(service.status)}`}>
                                                            {service.status === 'running' ? '실행 중' :
                                                                service.status === 'stopped' ? '중지됨' :
                                                                    service.status === 'error' ? '오류' : '유지보수'}
                                                        </span>
                                                    </div>
                                                </div>
                                                <div className="text-right">
                                                    <div className="text-sm font-medium text-gray-900">
                                                        {formatUptime(service.uptime)}
                                                    </div>
                                                    <div className="text-xs text-gray-500">가동률</div>
                                                </div>
                                            </div>
                                            <div className="space-y-2">
                                                <div className="flex items-center justify-between text-sm">
                                                    <span className="text-gray-600">응답 시간</span>
                                                    <span className="text-gray-900">{formatResponseTime(service.responseTime)}</span>
                                                </div>
                                                <div className="flex items-center justify-between text-sm">
                                                    <span className="text-gray-600">오류율</span>
                                                    <span className="text-gray-900">{service.errorRate}%</span>
                                                </div>
                                                <div className="flex items-center justify-between text-sm">
                                                    <span className="text-gray-600">마지막 확인</span>
                                                    <span className="text-gray-900">
                                                        {service.lastCheck.toLocaleTimeString('ko-KR')}
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    ))}
                                </div>
                            </motion.div>
                        )}
                    </AnimatePresence>
                </div>
            </div>
        </div>
    );
};

export default SystemMonitoring;
