import React, { useState, useEffect } from 'react';
import {
    Box,
    Card,
    CardContent,
    Typography,
    List,
    ListItem,
    ListItemText,
    ListItemIcon,
    Chip,
    IconButton,
    Collapse,
    LinearProgress,
    Grid,
    Button,
    TextField,
    InputAdornment,
    Accordion,
    AccordionSummary,
    AccordionDetails,
    Table,
    TableBody,
    TableCell,
    TableContainer,
    TableHead,
    TableRow,
    Paper,
    Alert,
    Divider
} from '@mui/material';
import {
    PlayArrow,
    Stop,
    Pause,
    Refresh,
    ExpandMore,
    CheckCircle,
    Error,
    Warning,
    Info,
    Schedule,
    Timer,
    Speed,
    Memory,
    Computer as Cpu,
    Code,
    BugReport,
    Visibility,
    Download,
    FilterList,
    Search
} from '@mui/icons-material';

interface TestExecutionLogEntry {
    id: string;
    timestamp: Date;
    level: 'info' | 'warning' | 'error' | 'debug' | 'success';
    message: string;
    testCaseId?: string;
    testSuiteId?: string;
    executionId?: string;
    details?: {
        input?: any;
        output?: any;
        expected?: any;
        actual?: any;
        performance?: {
            responseTime: number;
            memoryUsage: number;
            cpuUsage: number;
        };
        validation?: {
            rule: string;
            status: 'passed' | 'failed' | 'warning';
            expected: any;
            actual: any;
            deviation: number;
        };
    };
    tags?: string[];
}

interface TestExecutionSession {
    id: string;
    testSuiteId: string;
    testSuiteName: string;
    startTime: Date;
    endTime?: Date;
    status: 'running' | 'completed' | 'failed' | 'cancelled';
    progress: number;
    totalTests: number;
    completedTests: number;
    passedTests: number;
    failedTests: number;
    logs: TestExecutionLogEntry[];
}

const TestExecutionLog: React.FC = () => {
    const [executionSessions, setExecutionSessions] = useState<TestExecutionSession[]>([]);
    const [selectedSession, setSelectedSession] = useState<TestExecutionSession | null>(null);
    const [searchTerm, setSearchTerm] = useState('');
    const [logLevelFilter, setLogLevelFilter] = useState<string>('all');
    const [expandedLogs, setExpandedLogs] = useState<Set<string>>(new Set());

    // 모의 실행 세션 데이터
    useEffect(() => {
        const mockSessions: TestExecutionSession[] = [
            {
                id: 'session-1',
                testSuiteId: 'functional-test-suite',
                testSuiteName: 'AI 기능 테스트 스위트',
                startTime: new Date(Date.now() - 300000), // 5분 전
                status: 'running',
                progress: 65,
                totalTests: 5,
                completedTests: 3,
                passedTests: 2,
                failedTests: 1,
                logs: [
                    {
                        id: 'log-1',
                        timestamp: new Date(Date.now() - 300000),
                        level: 'info',
                        message: '테스트 세션 시작: AI 기능 테스트 스위트',
                        executionId: 'session-1',
                        testSuiteId: 'functional-test-suite'
                    },
                    {
                        id: 'log-2',
                        timestamp: new Date(Date.now() - 280000),
                        level: 'info',
                        message: '테스트 케이스 시작: 응답 정확성 테스트',
                        executionId: 'session-1',
                        testCaseId: 'accuracy-test',
                        testSuiteId: 'functional-test-suite'
                    },
                    {
                        id: 'log-3',
                        timestamp: new Date(Date.now() - 275000),
                        level: 'debug',
                        message: '입력 데이터 로드 완료',
                        executionId: 'session-1',
                        testCaseId: 'accuracy-test',
                        details: {
                            input: { question: '오늘 날씨는 어떤가요?' }
                        }
                    },
                    {
                        id: 'log-4',
                        timestamp: new Date(Date.now() - 270000),
                        level: 'info',
                        message: 'AI 모델에 요청 전송',
                        executionId: 'session-1',
                        testCaseId: 'accuracy-test'
                    },
                    {
                        id: 'log-5',
                        timestamp: new Date(Date.now() - 265000),
                        level: 'success',
                        message: '테스트 케이스 통과: 응답 정확성 테스트',
                        executionId: 'session-1',
                        testCaseId: 'accuracy-test',
                        details: {
                            input: { question: '오늘 날씨는 어떤가요?' },
                            output: { response: '맑음', confidence: 0.92 },
                            expected: { accuracy: 0.85 },
                            actual: { accuracy: 0.92 },
                            performance: {
                                responseTime: 245,
                                memoryUsage: 85,
                                cpuUsage: 45
                            },
                            validation: {
                                rule: '정확성 기준',
                                status: 'passed',
                                expected: 0.85,
                                actual: 0.92,
                                deviation: 0.07
                            }
                        }
                    },
                    {
                        id: 'log-6',
                        timestamp: new Date(Date.now() - 250000),
                        level: 'info',
                        message: '테스트 케이스 시작: 응답 시간 테스트',
                        executionId: 'session-1',
                        testCaseId: 'response-time-test'
                    },
                    {
                        id: 'log-7',
                        timestamp: new Date(Date.now() - 245000),
                        level: 'warning',
                        message: '응답 시간이 기준을 초과했습니다',
                        executionId: 'session-1',
                        testCaseId: 'response-time-test',
                        details: {
                            validation: {
                                rule: '응답 시간 기준',
                                status: 'failed',
                                expected: 1000,
                                actual: 1200,
                                deviation: 200
                            }
                        }
                    },
                    {
                        id: 'log-8',
                        timestamp: new Date(Date.now() - 240000),
                        level: 'error',
                        message: '테스트 케이스 실패: 응답 시간 테스트',
                        executionId: 'session-1',
                        testCaseId: 'response-time-test',
                        details: {
                            input: { question: '간단한 질문입니다.' },
                            output: { response: '답변입니다.', responseTime: 1200 },
                            expected: { responseTime: 1000 },
                            actual: { responseTime: 1200 },
                            performance: {
                                responseTime: 1200,
                                memoryUsage: 120,
                                cpuUsage: 75
                            }
                        }
                    }
                ]
            },
            {
                id: 'session-2',
                testSuiteId: 'security-test-suite',
                testSuiteName: 'AI 보안 테스트 스위트',
                startTime: new Date(Date.now() - 1800000), // 30분 전
                endTime: new Date(Date.now() - 1500000), // 25분 전
                status: 'completed',
                progress: 100,
                totalTests: 3,
                completedTests: 3,
                passedTests: 3,
                failedTests: 0,
                logs: [
                    {
                        id: 'log-9',
                        timestamp: new Date(Date.now() - 1800000),
                        level: 'info',
                        message: '보안 테스트 세션 시작',
                        executionId: 'session-2',
                        testSuiteId: 'security-test-suite'
                    },
                    {
                        id: 'log-10',
                        timestamp: new Date(Date.now() - 1750000),
                        level: 'success',
                        message: 'SQL 인젝션 방어 테스트 통과',
                        executionId: 'session-2',
                        testCaseId: 'injection-test'
                    },
                    {
                        id: 'log-11',
                        timestamp: new Date(Date.now() - 1500000),
                        level: 'success',
                        message: '보안 테스트 세션 완료 - 모든 테스트 통과',
                        executionId: 'session-2',
                        testSuiteId: 'security-test-suite'
                    }
                ]
            }
        ];

        setExecutionSessions(mockSessions);
        if (mockSessions.length > 0) {
            setSelectedSession(mockSessions[0]);
        }
    }, []);

    const getLogLevelIcon = (level: string) => {
        switch (level) {
            case 'success': return <CheckCircle color="success" />;
            case 'error': return <Error color="error" />;
            case 'warning': return <Warning color="warning" />;
            case 'info': return <Info color="info" />;
            case 'debug': return <Code color="action" />;
            default: return <Info color="info" />;
        }
    };

    const getLogLevelColor = (level: string) => {
        switch (level) {
            case 'success': return 'success';
            case 'error': return 'error';
            case 'warning': return 'warning';
            case 'info': return 'info';
            case 'debug': return 'default';
            default: return 'default';
        }
    };

    const getStatusColor = (status: string) => {
        switch (status) {
            case 'running': return 'info';
            case 'completed': return 'success';
            case 'failed': return 'error';
            case 'cancelled': return 'default';
            default: return 'default';
        }
    };

    const filteredLogs = selectedSession?.logs.filter(log => {
        const matchesSearch = log.message.toLowerCase().includes(searchTerm.toLowerCase()) ||
            log.testCaseId?.toLowerCase().includes(searchTerm.toLowerCase());
        const matchesLevel = logLevelFilter === 'all' || log.level === logLevelFilter;
        return matchesSearch && matchesLevel;
    }) || [];

    const handleLogExpand = (logId: string) => {
        const newExpanded = new Set(expandedLogs);
        if (newExpanded.has(logId)) {
            newExpanded.delete(logId);
        } else {
            newExpanded.add(logId);
        }
        setExpandedLogs(newExpanded);
    };

    const exportLogs = () => {
        if (!selectedSession) return;

        const logData = {
            session: selectedSession,
            logs: filteredLogs,
            exportTime: new Date().toISOString()
        };

        const blob = new Blob([JSON.stringify(logData, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `test-execution-log-${selectedSession.id}-${new Date().toISOString().split('T')[0]}.json`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
    };

    return (
        <Grid container spacing={3}>
            {/* 실행 세션 목록 */}
            <Grid item xs={12} md={4}>
                <Card>
                    <CardContent>
                        <Typography variant="h6" mb={2}>실행 세션</Typography>
                        <List>
                            {executionSessions.map((session) => (
                                <ListItem
                                    key={session.id}
                                    button
                                    selected={selectedSession?.id === session.id}
                                    onClick={() => setSelectedSession(session)}
                                    sx={{ mb: 1, borderRadius: 1 }}
                                >
                                    <ListItemText
                                        primary={
                                            <Box display="flex" alignItems="center" gap={1}>
                                                <Typography variant="subtitle2" fontWeight="medium">
                                                    {session.testSuiteName}
                                                </Typography>
                                                <Chip
                                                    label={session.status}
                                                    size="small"
                                                    color={getStatusColor(session.status) as any}
                                                />
                                            </Box>
                                        }
                                        secondary={
                                            <Box>
                                                <Typography variant="body2" color="textSecondary">
                                                    {session.startTime.toLocaleString()}
                                                </Typography>
                                                <Box display="flex" alignItems="center" gap={1} mt={1}>
                                                    <LinearProgress
                                                        variant="determinate"
                                                        value={session.progress}
                                                        sx={{ flexGrow: 1, height: 6 }}
                                                        color={session.status === 'running' ? 'primary' : 'success'}
                                                    />
                                                    <Typography variant="caption">
                                                        {session.progress}%
                                                    </Typography>
                                                </Box>
                                                <Typography variant="caption" color="textSecondary">
                                                    {session.passedTests} 통과 / {session.failedTests} 실패
                                                </Typography>
                                            </Box>
                                        }
                                    />
                                </ListItem>
                            ))}
                        </List>
                    </CardContent>
                </Card>
            </Grid>

            {/* 로그 상세 보기 */}
            <Grid item xs={12} md={8}>
                <Card>
                    <CardContent>
                        {selectedSession ? (
                            <>
                                {/* 헤더 */}
                                <Box display="flex" justifyContent="space-between" alignItems="center" mb={2}>
                                    <Typography variant="h6">
                                        실행 로그: {selectedSession.testSuiteName}
                                    </Typography>
                                    <Box display="flex" gap={1}>
                                        <Button
                                            variant="outlined"
                                            size="small"
                                            startIcon={<Download />}
                                            onClick={exportLogs}
                                        >
                                            내보내기
                                        </Button>
                                    </Box>
                                </Box>

                                {/* 필터 */}
                                <Box display="flex" gap={2} mb={2}>
                                    <TextField
                                        size="small"
                                        placeholder="로그 검색..."
                                        value={searchTerm}
                                        onChange={(e) => setSearchTerm(e.target.value)}
                                        InputProps={{
                                            startAdornment: (
                                                <InputAdornment position="start">
                                                    <Search />
                                                </InputAdornment>
                                            )
                                        }}
                                        sx={{ flexGrow: 1 }}
                                    />
                                    <TextField
                                        select
                                        size="small"
                                        value={logLevelFilter}
                                        onChange={(e) => setLogLevelFilter(e.target.value)}
                                        label="로그 레벨"
                                        sx={{ minWidth: 120 }}
                                    >
                                        <option value="all">전체</option>
                                        <option value="error">오류</option>
                                        <option value="warning">경고</option>
                                        <option value="info">정보</option>
                                        <option value="success">성공</option>
                                        <option value="debug">디버그</option>
                                    </TextField>
                                </Box>

                                {/* 로그 목록 */}
                                <Box sx={{ maxHeight: 600, overflow: 'auto' }}>
                                    {filteredLogs.length > 0 ? (
                                        <List>
                                            {filteredLogs.map((log) => (
                                                <Box key={log.id} mb={1}>
                                                    <ListItem
                                                        sx={{
                                                            backgroundColor: 'background.paper',
                                                            borderRadius: 1,
                                                            border: '1px solid',
                                                            borderColor: 'divider'
                                                        }}
                                                    >
                                                        <ListItemIcon>
                                                            {getLogLevelIcon(log.level)}
                                                        </ListItemIcon>
                                                        <ListItemText
                                                            primary={
                                                                <Box display="flex" alignItems="center" gap={1}>
                                                                    <Typography variant="body2" fontWeight="medium">
                                                                        {log.message}
                                                                    </Typography>
                                                                    {log.testCaseId && (
                                                                        <Chip
                                                                            label={log.testCaseId}
                                                                            size="small"
                                                                            variant="outlined"
                                                                        />
                                                                    )}
                                                                </Box>
                                                            }
                                                            secondary={
                                                                <Typography variant="caption" color="textSecondary">
                                                                    {log.timestamp.toLocaleString()}
                                                                </Typography>
                                                            }
                                                        />
                                                        {log.details && (
                                                            <IconButton
                                                                size="small"
                                                                onClick={() => handleLogExpand(log.id)}
                                                            >
                                                                <ExpandMore
                                                                    sx={{
                                                                        transform: expandedLogs.has(log.id) ? 'rotate(180deg)' : 'rotate(0deg)',
                                                                        transition: 'transform 0.2s'
                                                                    }}
                                                                />
                                                            </IconButton>
                                                        )}
                                                    </ListItem>

                                                    {/* 상세 정보 */}
                                                    {log.details && (
                                                        <Collapse in={expandedLogs.has(log.id)}>
                                                            <Box sx={{ ml: 4, mt: 1, mb: 2 }}>
                                                                <Paper variant="outlined" sx={{ p: 2 }}>
                                                                    {log.details.input && (
                                                                        <Box mb={2}>
                                                                            <Typography variant="subtitle2" mb={1}>
                                                                                입력 데이터
                                                                            </Typography>
                                                                            <Typography variant="body2" component="pre" sx={{
                                                                                backgroundColor: 'grey.100',
                                                                                p: 1,
                                                                                borderRadius: 1,
                                                                                fontSize: '0.75rem'
                                                                            }}>
                                                                                {JSON.stringify(log.details.input, null, 2)}
                                                                            </Typography>
                                                                        </Box>
                                                                    )}

                                                                    {log.details.output && (
                                                                        <Box mb={2}>
                                                                            <Typography variant="subtitle2" mb={1}>
                                                                                출력 데이터
                                                                            </Typography>
                                                                            <Typography variant="body2" component="pre" sx={{
                                                                                backgroundColor: 'grey.100',
                                                                                p: 1,
                                                                                borderRadius: 1,
                                                                                fontSize: '0.75rem'
                                                                            }}>
                                                                                {JSON.stringify(log.details.output, null, 2)}
                                                                            </Typography>
                                                                        </Box>
                                                                    )}

                                                                    {log.details.performance && (
                                                                        <Box mb={2}>
                                                                            <Typography variant="subtitle2" mb={1}>
                                                                                성능 메트릭
                                                                            </Typography>
                                                                            <Grid container spacing={2}>
                                                                                <Grid item xs={4}>
                                                                                    <Box display="flex" alignItems="center" gap={1}>
                                                                                        <Speed color="primary" />
                                                                                        <Typography variant="body2">
                                                                                            {log.details.performance.responseTime}ms
                                                                                        </Typography>
                                                                                    </Box>
                                                                                </Grid>
                                                                                <Grid item xs={4}>
                                                                                    <Box display="flex" alignItems="center" gap={1}>
                                                                                        <Memory color="info" />
                                                                                        <Typography variant="body2">
                                                                                            {log.details.performance.memoryUsage}MB
                                                                                        </Typography>
                                                                                    </Box>
                                                                                </Grid>
                                                                                <Grid item xs={4}>
                                                                                    <Box display="flex" alignItems="center" gap={1}>
                                                                                        <Cpu color="warning" />
                                                                                        <Typography variant="body2">
                                                                                            {log.details.performance.cpuUsage}%
                                                                                        </Typography>
                                                                                    </Box>
                                                                                </Grid>
                                                                            </Grid>
                                                                        </Box>
                                                                    )}

                                                                    {log.details.validation && (
                                                                        <Box>
                                                                            <Typography variant="subtitle2" mb={1}>
                                                                                검증 결과
                                                                            </Typography>
                                                                            <TableContainer component={Paper} variant="outlined">
                                                                                <Table size="small">
                                                                                    <TableHead>
                                                                                        <TableRow>
                                                                                            <TableCell>규칙</TableCell>
                                                                                            <TableCell>상태</TableCell>
                                                                                            <TableCell>기대값</TableCell>
                                                                                            <TableCell>실제값</TableCell>
                                                                                            <TableCell>편차</TableCell>
                                                                                        </TableRow>
                                                                                    </TableHead>
                                                                                    <TableBody>
                                                                                        <TableRow>
                                                                                            <TableCell>{log.details.validation.rule}</TableCell>
                                                                                            <TableCell>
                                                                                                <Chip
                                                                                                    label={log.details.validation.status}
                                                                                                    size="small"
                                                                                                    color={getLogLevelColor(log.details.validation.status) as any}
                                                                                                />
                                                                                            </TableCell>
                                                                                            <TableCell>{log.details.validation.expected}</TableCell>
                                                                                            <TableCell>{log.details.validation.actual}</TableCell>
                                                                                            <TableCell>{log.details.validation.deviation}</TableCell>
                                                                                        </TableRow>
                                                                                    </TableBody>
                                                                                </Table>
                                                                            </TableContainer>
                                                                        </Box>
                                                                    )}
                                                                </Paper>
                                                            </Box>
                                                        </Collapse>
                                                    )}
                                                </Box>
                                            ))}
                                        </List>
                                    ) : (
                                        <Alert severity="info">
                                            표시할 로그가 없습니다.
                                        </Alert>
                                    )}
                                </Box>
                            </>
                        ) : (
                            <Alert severity="info">
                                실행 세션을 선택하여 로그를 확인하세요.
                            </Alert>
                        )}
                    </CardContent>
                </Card>
            </Grid>
        </Grid>
    );
};

export default TestExecutionLog;
