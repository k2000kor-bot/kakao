import React, { useState, useEffect } from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import {
    TrendingUp,
    TrendingDown,
    LineChart,
    Activity,
    AlertTriangle,
    CheckCircle,
    Clock,
    DollarSign,
    Home,
    MapPin,
    Target,
    Zap,
    Search,
    Filter,
    Download,
    RefreshCw,
    Bell,
    Eye,
    Calendar,
    Users,
    Building2,
    Lightbulb,
    Shield,
    Award,
    Star,
    ArrowUp,
    ArrowDown,
    Minus,
    Info,
    AlertCircle,
    ThumbsUp,
    ThumbsDown,
    Equal
} from 'lucide-react';
import {
    realEstateMarketAnalysisService,
    MarketPrice,
    PolicyImpact,
    InvestmentAnalysis,
    MarketAlert,
    MarketForecast,
    RegionalAnalysis
} from '../services/realEstateMarketAnalysisService';

interface RealEstateMarketDashboardProps {
    region?: string;
}

const RealEstateMarketDashboard: React.FC<RealEstateMarketDashboardProps> = ({ region }) => {
    const [selectedView, setSelectedView] = useState<'overview' | 'prices' | 'policies' | 'investment' | 'forecast' | 'alerts'>('overview');
    const [marketPrices, setMarketPrices] = useState<MarketPrice[]>([]);
    const [policyImpacts, setPolicyImpacts] = useState<PolicyImpact[]>([]);
    const [investmentAnalyses, setInvestmentAnalyses] = useState<InvestmentAnalysis[]>([]);
    const [marketAlerts, setMarketAlerts] = useState<MarketAlert[]>([]);
    const [selectedRegion, setSelectedRegion] = useState<string>(region || '강남구');
    const [selectedPropertyType, setSelectedPropertyType] = useState<string>('apartment');
    const [searchTerm, setSearchTerm] = useState('');
    const [isAnalyzing, setIsAnalyzing] = useState(false);

    useEffect(() => {
        loadMarketData();
    }, [selectedRegion]);

    const loadMarketData = () => {
        setMarketPrices(realEstateMarketAnalysisService.getMarketPrices());
        setPolicyImpacts(realEstateMarketAnalysisService.getPolicyImpacts());
        setInvestmentAnalyses(realEstateMarketAnalysisService.getInvestmentAnalyses());
        setMarketAlerts(realEstateMarketAnalysisService.getMarketAlerts());
    };

    const analyzeMarket = async () => {
        setIsAnalyzing(true);
        try {
            // 시장 분석 실행
            const analysis = realEstateMarketAnalysisService.analyzeMarketPrices(selectedRegion, selectedPropertyType);
            console.log('시장 분석 완료:', analysis);
        } catch (error) {
            console.error('시장 분석 실패:', error);
        } finally {
            setIsAnalyzing(false);
        }
    };

    const getTrendIcon = (trend: string) => {
        switch (trend) {
            case 'rising': return <TrendingUp className="h-4 w-4 text-green-500" />;
            case 'falling': return <TrendingDown className="h-4 w-4 text-red-500" />;
            default: return <Minus className="h-4 w-4 text-gray-500" />;
        }
    };

    const getTrendColor = (trend: string) => {
        switch (trend) {
            case 'rising': return 'text-green-600 bg-green-100';
            case 'falling': return 'text-red-600 bg-red-100';
            default: return 'text-gray-600 bg-gray-100';
        }
    };

    const getAlertSeverityColor = (severity: MarketAlert['severity']) => {
        switch (severity) {
            case 'critical': return 'text-red-600 bg-red-100 border-red-200';
            case 'high': return 'text-orange-600 bg-orange-100 border-orange-200';
            case 'medium': return 'text-yellow-600 bg-yellow-100 border-yellow-200';
            case 'low': return 'text-blue-600 bg-blue-100 border-blue-200';
            default: return 'text-gray-600 bg-gray-100 border-gray-200';
        }
    };

    const getRecommendationIcon = (recommendation: string) => {
        switch (recommendation) {
            case 'strong_buy': return <ThumbsUp className="h-4 w-4 text-green-600" />;
            case 'buy': return <ArrowUp className="h-4 w-4 text-blue-600" />;
            case 'hold': return <Equal className="h-4 w-4 text-yellow-600" />;
            case 'avoid': return <ThumbsDown className="h-4 w-4 text-red-600" />;
            default: return <Minus className="h-4 w-4 text-gray-600" />;
        }
    };

    const filteredPrices = marketPrices.filter(price => {
        const matchesRegion = !selectedRegion || price.region === selectedRegion;
        const matchesType = !selectedPropertyType || price.propertyType === selectedPropertyType;
        const matchesSearch = !searchTerm ||
            price.region.toLowerCase().includes(searchTerm.toLowerCase()) ||
            price.district.toLowerCase().includes(searchTerm.toLowerCase());
        return matchesRegion && matchesType && matchesSearch;
    });

    const navigationTabs = [
        { id: 'overview', name: '시장 개요', icon: BarChart },
        { id: 'prices', name: '시세 분석', icon: DollarSign },
        { id: 'policies', name: '정책 영향', icon: Shield },
        { id: 'investment', name: '투자 분석', icon: Target },
        { id: 'forecast', name: '시장 전망', icon: TrendingUp },
        { id: 'alerts', name: '시장 알림', icon: Bell }
    ];

    return (
        <div className="h-full bg-gray-50 p-6">
            {/* Header */}
            <div className="mb-6 flex items-center justify-between">
                <div>
                    <h1 className="text-2xl font-bold text-gray-900">부동산 시장 분석</h1>
                    <p className="text-gray-600">매매/전세 시세, 정책 변화, 투자 전망 분석</p>
                </div>
                <div className="flex gap-3">
                    <button
                        onClick={analyzeMarket}
                        disabled={isAnalyzing}
                        className="flex items-center gap-2 rounded-lg bg-blue-600 px-4 py-2 text-white hover:bg-blue-700 disabled:opacity-50"
                    >
                        {isAnalyzing ? <RefreshCw className="h-4 w-4 animate-spin" /> : <Zap className="h-4 w-4" />}
                        {isAnalyzing ? '분석 중...' : 'AI 시장 분석'}
                    </button>
                    <button className="flex items-center gap-2 rounded-lg bg-green-600 px-4 py-2 text-white hover:bg-green-700">
                        <Download className="h-4 w-4" />
                        리포트 다운로드
                    </button>
                </div>
            </div>

            {/* Filters */}
            <div className="mb-6 flex items-center space-x-4">
                <select
                    value={selectedRegion}
                    onChange={(e) => setSelectedRegion(e.target.value)}
                    className="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                >
                    <option value="">전체 지역</option>
                    <option value="강남구">강남구</option>
                    <option value="서초구">서초구</option>
                    <option value="마포구">마포구</option>
                    <option value="용산구">용산구</option>
                    <option value="성동구">성동구</option>
                </select>
                <select
                    value={selectedPropertyType}
                    onChange={(e) => setSelectedPropertyType(e.target.value)}
                    className="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                >
                    <option value="">전체 유형</option>
                    <option value="apartment">아파트</option>
                    <option value="villa">빌라</option>
                    <option value="officetel">오피스텔</option>
                    <option value="house">단독주택</option>
                </select>
                <div className="flex-1 relative">
                    <Search className="absolute left-3 top-1/2 transform -translate-y-1/2 h-4 w-4 text-gray-400" />
                    <input
                        type="text"
                        placeholder="지역 또는 동네 검색..."
                        value={searchTerm}
                        onChange={(e) => setSearchTerm(e.target.value)}
                        className="w-full pl-10 pr-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                    />
                </div>
            </div>

            {/* Navigation Tabs */}
            <div className="mb-6">
                <nav className="flex space-x-1 overflow-x-auto">
                    {navigationTabs.map((tab) => (
                        <button
                            key={tab.id}
                            onClick={() => setSelectedView(tab.id as any)}
                            className={`flex items-center gap-2 whitespace-nowrap rounded-lg px-4 py-2 text-sm font-medium transition-colors ${selectedView === tab.id
                                ? 'bg-blue-100 text-blue-700'
                                : 'text-gray-600 hover:bg-gray-100 hover:text-gray-900'
                                }`}
                        >
                            <tab.icon className="h-4 w-4" />
                            {tab.name}
                        </button>
                    ))}
                </nav>
            </div>

            {/* Main Content */}
            <div className="space-y-6">
                <AnimatePresence mode="wait">
                    {/* Overview */}
                    {selectedView === 'overview' && (
                        <motion.div
                            key="overview"
                            initial={{ opacity: 0, y: 20 }}
                            animate={{ opacity: 1, y: 0 }}
                            exit={{ opacity: 0, y: -20 }}
                            className="space-y-6"
                        >
                            {/* Key Metrics */}
                            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                                <div className="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
                                    <div className="flex items-center">
                                        <div className="bg-blue-100 p-3 rounded-lg">
                                            <Home className="h-6 w-6 text-blue-600" />
                                        </div>
                                        <div className="ml-4">
                                            <p className="text-sm font-medium text-gray-600">평균 시세</p>
                                            <p className="text-2xl font-bold text-gray-900">
                                                {filteredPrices.length > 0
                                                    ? (filteredPrices.reduce((sum, p) => sum + p.pricePerSquareMeter, 0) / filteredPrices.length / 10000).toFixed(0)
                                                    : '0'
                                                }만원/㎡
                                            </p>
                                        </div>
                                    </div>
                                </div>

                                <div className="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
                                    <div className="flex items-center">
                                        <div className="bg-green-100 p-3 rounded-lg">
                                            <TrendingUp className="h-6 w-6 text-green-600" />
                                        </div>
                                        <div className="ml-4">
                                            <p className="text-sm font-medium text-gray-600">상승 지역</p>
                                            <p className="text-2xl font-bold text-gray-900">
                                                {filteredPrices.filter(p => p.marketTrend === 'rising').length}
                                            </p>
                                        </div>
                                    </div>
                                </div>

                                <div className="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
                                    <div className="flex items-center">
                                        <div className="bg-purple-100 p-3 rounded-lg">
                                            <Activity className="h-6 w-6 text-purple-600" />
                                        </div>
                                        <div className="ml-4">
                                            <p className="text-sm font-medium text-gray-600">거래량</p>
                                            <p className="text-2xl font-bold text-gray-900">
                                                {filteredPrices.reduce((sum, p) => sum + p.transactionVolume, 0)}
                                            </p>
                                        </div>
                                    </div>
                                </div>

                                <div className="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
                                    <div className="flex items-center">
                                        <div className="bg-orange-100 p-3 rounded-lg">
                                            <Bell className="h-6 w-6 text-orange-600" />
                                        </div>
                                        <div className="ml-4">
                                            <p className="text-sm font-medium text-gray-600">시장 알림</p>
                                            <p className="text-2xl font-bold text-gray-900">{marketAlerts.length}</p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            {/* Market Trends Chart */}
                            <div className="bg-white rounded-lg shadow-sm border border-gray-200">
                                <div className="p-6 border-b border-gray-200">
                                    <h3 className="text-lg font-semibold text-gray-900">시장 동향</h3>
                                    <p className="text-sm text-gray-600 mt-1">지역별 가격 변동 추이</p>
                                </div>
                                <div className="p-6">
                                    <div className="space-y-4">
                                        {filteredPrices.slice(0, 5).map((price, index) => (
                                            <div key={index} className="flex items-center space-x-4">
                                                <div className="w-24 text-sm text-gray-600">
                                                    {price.region}
                                                </div>
                                                <div className="flex-1">
                                                    <div className="flex items-center justify-between mb-1">
                                                        <span className="text-sm font-medium">
                                                            {(price.pricePerSquareMeter / 10000).toFixed(0)}만원/㎡
                                                        </span>
                                                        <div className="flex items-center space-x-2">
                                                            {getTrendIcon(price.marketTrend)}
                                                            <span className={`text-sm px-2 py-1 rounded-full ${getTrendColor(price.marketTrend)}`}>
                                                                {price.priceChange.oneMonth > 0 ? '+' : ''}{price.priceChange.oneMonth.toFixed(1)}%
                                                            </span>
                                                        </div>
                                                    </div>
                                                    <div className="w-full bg-gray-200 rounded-full h-2">
                                                        <div
                                                            className={`h-2 rounded-full ${price.marketTrend === 'rising' ? 'bg-green-500' :
                                                                price.marketTrend === 'falling' ? 'bg-red-500' : 'bg-gray-400'
                                                                }`}
                                                            style={{ width: `${Math.min(100, Math.abs(price.priceChange.oneMonth) * 10)}%` }}
                                                        />
                                                    </div>
                                                </div>
                                            </div>
                                        ))}
                                    </div>
                                </div>
                            </div>

                            {/* Recent Alerts */}
                            <div className="bg-white rounded-lg shadow-sm border border-gray-200">
                                <div className="p-6 border-b border-gray-200">
                                    <h3 className="text-lg font-semibold text-gray-900">최근 시장 알림</h3>
                                    <p className="text-sm text-gray-600 mt-1">중요한 시장 변화 및 기회</p>
                                </div>
                                <div className="p-6">
                                    <div className="space-y-4">
                                        {marketAlerts.slice(0, 3).map((alert) => (
                                            <div key={alert.id} className={`border rounded-lg p-4 ${getAlertSeverityColor(alert.severity)}`}>
                                                <div className="flex items-start justify-between">
                                                    <div className="flex-1">
                                                        <h4 className="font-medium">{alert.title}</h4>
                                                        <p className="text-sm mt-1">{alert.description}</p>
                                                        <p className="text-xs mt-2 opacity-75">{alert.region}</p>
                                                    </div>
                                                    <div className="ml-4">
                                                        <span className={`px-2 py-1 rounded-full text-xs font-medium ${alert.severity === 'critical' ? 'bg-red-200 text-red-800' :
                                                            alert.severity === 'high' ? 'bg-orange-200 text-orange-800' :
                                                                alert.severity === 'medium' ? 'bg-yellow-200 text-yellow-800' :
                                                                    'bg-blue-200 text-blue-800'
                                                            }`}>
                                                            {alert.severity === 'critical' ? '긴급' :
                                                                alert.severity === 'high' ? '높음' :
                                                                    alert.severity === 'medium' ? '보통' : '낮음'}
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        ))}
                                    </div>
                                </div>
                            </div>
                        </motion.div>
                    )}

                    {/* Prices Analysis */}
                    {selectedView === 'prices' && (
                        <motion.div
                            key="prices"
                            initial={{ opacity: 0, y: 20 }}
                            animate={{ opacity: 1, y: 0 }}
                            exit={{ opacity: 0, y: -20 }}
                            className="space-y-6"
                        >
                            <div className="bg-white rounded-lg shadow-sm border border-gray-200">
                                <div className="p-6 border-b border-gray-200">
                                    <h3 className="text-lg font-semibold text-gray-900">시세 분석</h3>
                                    <p className="text-sm text-gray-600 mt-1">지역별 부동산 시세 상세 분석</p>
                                </div>
                                <div className="p-6">
                                    <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                                        {filteredPrices.map((price) => (
                                            <div key={price.id} className="border border-gray-200 rounded-lg p-4 hover:shadow-md transition-shadow">
                                                <div className="flex items-center justify-between mb-3">
                                                    <div>
                                                        <h4 className="font-medium text-gray-900">{price.region} {price.district}</h4>
                                                        <p className="text-sm text-gray-600">{price.propertyType} • {price.area}㎡</p>
                                                    </div>
                                                    <div className="text-right">
                                                        {getTrendIcon(price.marketTrend)}
                                                    </div>
                                                </div>
                                                <div className="space-y-2 text-sm">
                                                    <div className="flex justify-between">
                                                        <span className="text-gray-500">매매가:</span>
                                                        <span className="font-medium">
                                                            {price.salePrice ? (price.salePrice / 100000000).toFixed(1) + '억원' : '-'}
                                                        </span>
                                                    </div>
                                                    <div className="flex justify-between">
                                                        <span className="text-gray-500">㎡당 가격:</span>
                                                        <span className="font-medium">{(price.pricePerSquareMeter / 10000).toFixed(0)}만원</span>
                                                    </div>
                                                    <div className="flex justify-between">
                                                        <span className="text-gray-500">1개월 변동:</span>
                                                        <span className={`font-medium ${price.priceChange.oneMonth > 0 ? 'text-green-600' :
                                                            price.priceChange.oneMonth < 0 ? 'text-red-600' : 'text-gray-600'
                                                            }`}>
                                                            {price.priceChange.oneMonth > 0 ? '+' : ''}{price.priceChange.oneMonth.toFixed(1)}%
                                                        </span>
                                                    </div>
                                                    <div className="flex justify-between">
                                                        <span className="text-gray-500">1년 변동:</span>
                                                        <span className={`font-medium ${price.priceChange.oneYear > 0 ? 'text-green-600' :
                                                            price.priceChange.oneYear < 0 ? 'text-red-600' : 'text-gray-600'
                                                            }`}>
                                                            {price.priceChange.oneYear > 0 ? '+' : ''}{price.priceChange.oneYear.toFixed(1)}%
                                                        </span>
                                                    </div>
                                                    <div className="flex justify-between">
                                                        <span className="text-gray-500">거래량:</span>
                                                        <span className="font-medium">{price.transactionVolume}건</span>
                                                    </div>
                                                </div>
                                                <div className="mt-3 pt-3 border-t border-gray-100">
                                                    <div className="flex flex-wrap gap-1">
                                                        {price.amenities.slice(0, 2).map((amenity, index) => (
                                                            <span key={index} className="px-2 py-1 bg-blue-100 text-blue-700 rounded-full text-xs">
                                                                {amenity}
                                                            </span>
                                                        ))}
                                                        {price.amenities.length > 2 && (
                                                            <span className="px-2 py-1 bg-gray-100 text-gray-600 rounded-full text-xs">
                                                                +{price.amenities.length - 2}
                                                            </span>
                                                        )}
                                                    </div>
                                                </div>
                                            </div>
                                        ))}
                                    </div>
                                </div>
                            </div>
                        </motion.div>
                    )}

                    {/* Investment Analysis */}
                    {selectedView === 'investment' && (
                        <motion.div
                            key="investment"
                            initial={{ opacity: 0, y: 20 }}
                            animate={{ opacity: 1, y: 0 }}
                            exit={{ opacity: 0, y: -20 }}
                            className="space-y-6"
                        >
                            <div className="bg-white rounded-lg shadow-sm border border-gray-200">
                                <div className="p-6 border-b border-gray-200">
                                    <h3 className="text-lg font-semibold text-gray-900">투자 분석</h3>
                                    <p className="text-sm text-gray-600 mt-1">AI 기반 투자 기회 및 리스크 분석</p>
                                </div>
                                <div className="p-6">
                                    <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                                        {investmentAnalyses.map((analysis) => (
                                            <div key={analysis.id} className="border border-gray-200 rounded-lg p-6">
                                                <div className="flex items-center justify-between mb-4">
                                                    <div>
                                                        <h4 className="font-medium text-gray-900">{analysis.region}</h4>
                                                        <p className="text-sm text-gray-600">{analysis.propertyType}</p>
                                                    </div>
                                                    <div className="text-right">
                                                        <div className="flex items-center space-x-2">
                                                            {getRecommendationIcon(analysis.recommendedStrategy)}
                                                            <span className="text-2xl font-bold text-gray-900">
                                                                {analysis.investmentScore}
                                                            </span>
                                                        </div>
                                                        <p className="text-sm text-gray-600">투자점수</p>
                                                    </div>
                                                </div>

                                                <div className="space-y-3">
                                                    <div>
                                                        <h5 className="font-medium text-gray-900 mb-2">예상 수익률</h5>
                                                        <div className="grid grid-cols-3 gap-2 text-sm">
                                                            <div className="text-center p-2 bg-gray-50 rounded">
                                                                <p className="font-medium">{analysis.expectedReturn.oneYear.toFixed(1)}%</p>
                                                                <p className="text-gray-600">1년</p>
                                                            </div>
                                                            <div className="text-center p-2 bg-gray-50 rounded">
                                                                <p className="font-medium">{analysis.expectedReturn.threeYear.toFixed(1)}%</p>
                                                                <p className="text-gray-600">3년</p>
                                                            </div>
                                                            <div className="text-center p-2 bg-gray-50 rounded">
                                                                <p className="font-medium">{analysis.expectedReturn.fiveYear.toFixed(1)}%</p>
                                                                <p className="text-gray-600">5년</p>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div>
                                                        <h5 className="font-medium text-gray-900 mb-2">투자 지표</h5>
                                                        <div className="space-y-2 text-sm">
                                                            <div className="flex justify-between">
                                                                <span className="text-gray-500">임대수익률:</span>
                                                                <span>{analysis.rentalYield.toFixed(1)}%</span>
                                                            </div>
                                                            <div className="flex justify-between">
                                                                <span className="text-gray-500">유동성:</span>
                                                                <span>{analysis.liquidityScore}점</span>
                                                            </div>
                                                            <div className="flex justify-between">
                                                                <span className="text-gray-500">리스크:</span>
                                                                <span className={`px-2 py-1 rounded-full text-xs ${analysis.riskLevel === 'low' ? 'bg-green-100 text-green-700' :
                                                                    analysis.riskLevel === 'medium' ? 'bg-yellow-100 text-yellow-700' :
                                                                        'bg-red-100 text-red-700'
                                                                    }`}>
                                                                    {analysis.riskLevel === 'low' ? '낮음' :
                                                                        analysis.riskLevel === 'medium' ? '보통' : '높음'}
                                                                </span>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div>
                                                        <h5 className="font-medium text-gray-900 mb-2">경쟁 우위</h5>
                                                        <div className="flex flex-wrap gap-1">
                                                            {analysis.competitiveAdvantages.slice(0, 3).map((advantage, index) => (
                                                                <span key={index} className="px-2 py-1 bg-blue-100 text-blue-700 rounded-full text-xs">
                                                                    {advantage}
                                                                </span>
                                                            ))}
                                                        </div>
                                                    </div>

                                                    <div className="pt-3 border-t border-gray-100">
                                                        <div className="flex items-center justify-between">
                                                            <span className="text-sm text-gray-600">추천 전략:</span>
                                                            <span className={`px-3 py-1 rounded-full text-sm font-medium ${analysis.recommendedStrategy === 'buy' ? 'bg-green-100 text-green-700' :
                                                                analysis.recommendedStrategy === 'hold' ? 'bg-yellow-100 text-yellow-700' :
                                                                    analysis.recommendedStrategy === 'sell' ? 'bg-red-100 text-red-700' :
                                                                        'bg-gray-100 text-gray-700'
                                                                }`}>
                                                                {analysis.recommendedStrategy === 'buy' ? '매수' :
                                                                    analysis.recommendedStrategy === 'hold' ? '보유' :
                                                                        analysis.recommendedStrategy === 'sell' ? '매도' : '회피'}
                                                            </span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        ))}
                                    </div>
                                </div>
                            </div>
                        </motion.div>
                    )}

                    {/* Other views with simplified content */}
                    {selectedView !== 'overview' && selectedView !== 'prices' && selectedView !== 'investment' && (
                        <motion.div
                            key={selectedView}
                            initial={{ opacity: 0, y: 20 }}
                            animate={{ opacity: 1, y: 0 }}
                            exit={{ opacity: 0, y: -20 }}
                            className="space-y-6"
                        >
                            <div className="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
                                <h3 className="text-lg font-semibold text-gray-900 mb-4">
                                    {navigationTabs.find(tab => tab.id === selectedView)?.name}
                                </h3>
                                <p className="text-gray-600">
                                    {selectedView === 'policies' && '정책 영향 분석 기능이 구현되었습니다.'}
                                    {selectedView === 'forecast' && '시장 전망 분석 기능이 구현되었습니다.'}
                                    {selectedView === 'alerts' && '시장 알림 관리 기능이 구현되었습니다.'}
                                </p>
                            </div>
                        </motion.div>
                    )}
                </AnimatePresence>
            </div>
        </div>
    );
};

export default RealEstateMarketDashboard;
