const AIEnhancedBusinessIntelligence: React.FC = () => {
    const [metrics, setMetrics] = useState<BusinessMetric[]>(sampleMetrics);
    const [insights, setInsights] = useState<BusinessInsight[]>(sampleInsights);
    const [predictiveModels, setPredictiveModels] = useState<PredictiveModel[]>(samplePredictiveModels);
    const [processes, setProcesses] = useState<BusinessProcess[]>(sampleProcesses);
    const [selectedCategory, setSelectedCategory] = useState<string>('all');
    const [selectedInsightType, setSelectedInsightType] = useState<string>('all');
    const [showInsightDialog, setShowInsightDialog] = useState(false);
    const [selectedInsight, setSelectedInsight] = useState<BusinessInsight | null>(null);
    const [autoRefresh, setAutoRefresh] = useState(true);

    // 상태별 색상
    const getStatusColor = (status: string) => {
        switch (status) {
            case 'excellent': return 'success';
            case 'good': return 'primary';
            case 'warning': return 'warning';
            case 'critical': return 'error';
            default: return 'default';
        }
    };

    // 트렌드 아이콘
    const getTrendIcon = (trend: string) => {
        switch (trend) {
            case 'up': return <TrendingUp color="success" />;
            case 'down': return <TrendingDown color="error" />;
            case 'stable': return <TrendingFlat color="action" />;
            default: return <TrendingFlat color="action" />;
        }
    };

    // 인사이트 타입별 색상
    const getInsightTypeColor = (type: string) => {
        switch (type) {
            case 'opportunity': return 'success';
            case 'risk': return 'error';
            case 'trend': return 'info';
            case 'anomaly': return 'warning';
            case 'recommendation': return 'primary';
            default: return 'default';
        }
    };

    // 영향도별 색상
    const getImpactColor = (impact: string) => {
        switch (impact) {
            case 'high': return 'error';
            case 'medium': return 'warning';
            case 'low': return 'info';
            default: return 'default';
        }
    };

    // 실시간 데이터 업데이트
    useEffect(() => {
        if (!autoRefresh) return;

        const interval = setInterval(() => {
            setMetrics(prevMetrics =>
                prevMetrics.map(metric => ({
                    ...metric,
                    value: metric.value + (Math.random() - 0.5) * metric.value * 0.02,
                    lastUpdated: new Date()
                }))
            );

            setPredictiveModels(prevModels =>
                prevModels.map(model => ({
                    ...model,
                    accuracy: Math.max(80, Math.min(98, model.accuracy + (Math.random() - 0.5) * 2)),
                    confidence: Math.max(0.7, Math.min(0.95, model.confidence + (Math.random() - 0.5) * 0.1))
                }))
            );
        }, 30000); // 30초마다 업데이트

        return () => clearInterval(interval);
    }, [autoRefresh]);

    // 필터링된 데이터
    const filteredMetrics = selectedCategory === 'all'
        ? metrics
        : metrics.filter(metric => metric.category === selectedCategory);

    const filteredInsights = selectedInsightType === 'all'
        ? insights
        : insights.filter(insight => insight.type === selectedInsightType);

    // 성과 점수 계산
    const calculatePerformanceScore = () => {
        const totalMetrics = metrics.length;
        const excellentCount = metrics.filter(m => m.status === 'excellent').length;
        const goodCount = metrics.filter(m => m.status === 'good').length;

        return Math.round((excellentCount * 100 + goodCount * 75) / totalMetrics);
    };

    const performanceScore = calculatePerformanceScore();

    return (
        <Box sx={{ p: 3 }}>
            {/* 헤더 */}
            <Box sx={{ mb: 3, display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                <Box>
                    <Typography variant="h4" component="h1" gutterBottom sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                        <Business sx={{ fontSize: 32, color: 'primary.main' }} />
                        AI 강화 비즈니스 인텔리전스
                    </Typography>
                    <Typography variant="body1" color="text.secondary">
                        실시간 비즈니스 성과 분석 및 예측 인사이트
                    </Typography>
                </Box>
                <Box sx={{ display: 'flex', gap: 1 }}>
                    <Button
                        variant="outlined"
                        startIcon={<Refresh />}
                        onClick={() => window.location.reload()}
                    >
                        새로고침
                    </Button>
                    <Button
                        variant="outlined"
                        startIcon={<Download />}
                    >
                        보고서 다운로드
                    </Button>
                    <Button
                        variant="contained"
                        startIcon={<AutoAwesome />}
                    >
                        AI 분석 실행
                    </Button>
                </Box>
            </Box>

            {/* 전체 성과 요약 */}
            <Card sx={{ mb: 3, background: 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)', color: 'white' }}>
                <CardContent>
                    <Grid container spacing={3} alignItems="center">
                        <Grid item xs={12} md={3}>
                            <Typography variant="h3" component="div" sx={{ fontWeight: 'bold' }}>
                                {performanceScore}%
                            </Typography>
                            <Typography variant="body1">전체 성과 점수</Typography>
                        </Grid>
                        <Grid item xs={12} md={3}>
                            <Typography variant="h4" component="div">
                                {metrics.filter(m => m.status === 'excellent').length}
                            </Typography>
                            <Typography variant="body1">우수 지표</Typography>
                        </Grid>
                        <Grid item xs={12} md={3}>
                            <Typography variant="h4" component="div">
                                {insights.filter(i => i.impact === 'high').length}
                            </Typography>
                            <Typography variant="body1">고위험 인사이트</Typography>
                        </Grid>
                        <Grid item xs={12} md={3}>
                            <Typography variant="h4" component="div">
                                {predictiveModels.filter(m => m.status === 'active').length}
                            </Typography>
                            <Typography variant="body1">활성 예측 모델</Typography>
                        </Grid>
                    </Grid>
                </CardContent>
            </Card>

            {/* 메트릭 카드 */}
            <Grid container spacing={3} sx={{ mb: 3 }}>
                <Grid item xs={12}>
                    <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', mb: 2 }}>
                        <Typography variant="h6" component="h2">
                            핵심 비즈니스 메트릭
                        </Typography>
                        <FormControl size="small" sx={{ minWidth: 200 }}>
                            <InputLabel>카테고리 필터</InputLabel>
                            <Select
                                value={selectedCategory}
                                label="카테고리 필터"
                                onChange={(e) => setSelectedCategory(e.target.value)}
                            >
                                <MenuItem value="all">전체</MenuItem>
                                <MenuItem value="revenue">매출</MenuItem>
                                <MenuItem value="cost">비용</MenuItem>
                                <MenuItem value="efficiency">효율성</MenuItem>
                                <MenuItem value="quality">품질</MenuItem>
                                <MenuItem value="customer">고객</MenuItem>
                                <MenuItem value="employee">직원</MenuItem>
                            </Select>
                        </FormControl>
                    </Box>
                </Grid>

                {filteredMetrics.map((metric) => (
                    <Grid item xs={12} sm={6} md={4} key={metric.id}>
                        <Card sx={{ height: '100%', position: 'relative' }}>
                            <CardContent>
                                <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start', mb: 2 }}>
                                    <Typography variant="h6" component="h3" noWrap>
                                        {metric.name}
                                    </Typography>
                                    {getTrendIcon(metric.trend)}
                                </Box>

                                <Typography variant="h4" component="div" sx={{ mb: 1, fontWeight: 'bold' }}>
                                    {metric.value.toLocaleString()}{metric.unit}
                                </Typography>

                                <Box sx={{ display: 'flex', alignItems: 'center', gap: 1, mb: 2 }}>
                                    <Chip
                                        label={`${metric.change > 0 ? '+' : ''}${metric.change.toFixed(1)}%`}
                                        color={metric.change >= 0 ? 'success' : 'error'}
                                        size="small"
                                    />
                                    <Chip
                                        label={metric.status}
                                        color={getStatusColor(metric.status) as any}
                                        size="small"
                                    />
                                </Box>

                                <Box sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                                    <Typography variant="body2" color="text.secondary">
                                        목표: {metric.target.toLocaleString()}{metric.unit}
                                    </Typography>
                                    <LinearProgress
                                        variant="determinate"
                                        value={Math.min(100, (metric.value / metric.target) * 100)}
                                        sx={{ flexGrow: 1 }}
                                        color={getStatusColor(metric.status) as any}
                                    />
                                </Box>
                            </CardContent>
                        </Card>
                    </Grid>
                ))}
            </Grid>

            {/* 차트 섹션 */}
            <Grid container spacing={3} sx={{ mb: 3 }}>
                <Grid item xs={12} lg={8}>
                    <Card>
                        <CardContent>
                            <Typography variant="h6" component="h3" gutterBottom>
                                매출 트렌드 및 예측
                            </Typography>
                            <Line
                                data={chartData.revenue}
                                options={{
                                    responsive: true,
                                    plugins: {
                                        legend: { position: 'top' },
                                        title: { display: false }
                                    },
                                    scales: {
                                        y: {
                                            beginAtZero: true,
                                            ticks: {
                                                callback: function (value) {
                                                    return (Number(value) / 1000000).toFixed(1) + 'M';
                                                }
                                            }
                                        }
                                    }
                                }}
                            />
                        </CardContent>
                    </Card>
                </Grid>

                <Grid item xs={12} lg={4}>
                    <Card>
                        <CardContent>
                            <Typography variant="h6" component="h3" gutterBottom>
                                성과 레이더 차트
                            </Typography>
                            <Radar
                                data={chartData.efficiency}
                                options={{
                                    responsive: true,
                                    plugins: {
                                        legend: { display: false }
                                    },
                                    scales: {
                                        r: {
                                            beginAtZero: true,
                                            max: 100
                                        }
                                    }
                                }}
                            />
                        </CardContent>
                    </Card>
                </Grid>
            </Grid>

            {/* AI 인사이트 */}
            <Grid container spacing={3} sx={{ mb: 3 }}>
                <Grid item xs={12}>
                    <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', mb: 2 }}>
                        <Typography variant="h6" component="h2">
                            AI 생성 인사이트
                        </Typography>
                        <FormControl size="small" sx={{ minWidth: 200 }}>
                            <InputLabel>인사이트 타입</InputLabel>
                            <Select
                                value={selectedInsightType}
                                label="인사이트 타입"
                                onChange={(e) => setSelectedInsightType(e.target.value)}
                            >
                                <MenuItem value="all">전체</MenuItem>
                                <MenuItem value="opportunity">기회</MenuItem>
                                <MenuItem value="risk">위험</MenuItem>
                                <MenuItem value="trend">트렌드</MenuItem>
                                <MenuItem value="anomaly">이상</MenuItem>
                                <MenuItem value="recommendation">권장사항</MenuItem>
                            </Select>
                        </FormControl>
                    </Box>
                </Grid>

                {filteredInsights.map((insight) => (
                    <Grid item xs={12} md={6} lg={4} key={insight.id}>
                        <Card sx={{ height: '100%' }}>
                            <CardContent>
                                <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start', mb: 2 }}>
                                    <Chip
                                        label={insight.type}
                                        color={getInsightTypeColor(insight.type) as any}
                                        size="small"
                                    />
                                    <Chip
                                        label={`${(insight.confidence * 100).toFixed(0)}%`}
                                        color={getImpactColor(insight.impact) as any}
                                        size="small"
                                    />
                                </Box>

                                <Typography variant="h6" component="h3" gutterBottom>
                                    {insight.title}
                                </Typography>

                                <Typography variant="body2" color="text.secondary" sx={{ mb: 2 }}>
                                    {insight.description}
                                </Typography>

                                <Box sx={{ display: 'flex', gap: 1, flexWrap: 'wrap', mb: 2 }}>
                                    {insight.actions.slice(0, 2).map((action, index) => (
                                        <Chip
                                            key={index}
                                            label={action}
                                            size="small"
                                            variant="outlined"
                                        />
                                    ))}
                                    {insight.actions.length > 2 && (
                                        <Chip
                                            label={`+${insight.actions.length - 2}개 더`}
                                            size="small"
                                            variant="outlined"
                                        />
                                    )}
                                </Box>

                                <Button
                                    variant="outlined"
                                    size="small"
                                    fullWidth
                                    onClick={() => {
                                        setSelectedInsight(insight);
                                        setShowInsightDialog(true);
                                    }}
                                >
                                    상세 보기
                                </Button>
                            </CardContent>
                        </Card>
                    </Grid>
                ))}
            </Grid>

            {/* 예측 모델 및 프로세스 */}
            <Grid container spacing={3}>
                <Grid item xs={12} lg={6}>
                    <Card>
                        <CardContent>
                            <Typography variant="h6" component="h3" gutterBottom>
                                예측 모델 상태
                            </Typography>
                            <TableContainer>
                                <Table size="small">
                                    <TableHead>
                                        <TableRow>
                                            <TableCell>모델명</TableCell>
                                            <TableCell align="right">정확도</TableCell>
                                            <TableCell align="right">신뢰도</TableCell>
                                            <TableCell align="center">상태</TableCell>
                                        </TableRow>
                                    </TableHead>
                                    <TableBody>
                                        {predictiveModels.map((model) => (
                                            <TableRow key={model.id}>
                                                <TableCell>{model.name}</TableCell>
                                                <TableCell align="right">{model.accuracy.toFixed(1)}%</TableCell>
                                                <TableCell align="right">{(model.confidence * 100).toFixed(0)}%</TableCell>
                                                <TableCell align="center">
                                                    <Chip
                                                        label={model.status}
                                                        color={model.status === 'active' ? 'success' : 'warning'}
                                                        size="small"
                                                    />
                                                </TableCell>
                                            </TableRow>
                                        ))}
                                    </TableBody>
                                </Table>
                            </TableContainer>
                        </CardContent>
                    </Card>
                </Grid>

                <Grid item xs={12} lg={6}>
                    <Card>
                        <CardContent>
                            <Typography variant="h6" component="h3" gutterBottom>
                                비즈니스 프로세스 효율성
                            </Typography>
                            {processes.map((process) => (
                                <Box key={process.id} sx={{ mb: 2 }}>
                                    <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', mb: 1 }}>
                                        <Typography variant="body2" fontWeight="medium">
                                            {process.name}
                                        </Typography>
                                        <Chip
                                            label={`${process.efficiency}%`}
                                            color={process.status === 'optimal' ? 'success' : process.status === 'good' ? 'primary' : 'warning'}
                                            size="small"
                                        />
                                    </Box>
                                    <LinearProgress
                                        variant="determinate"
                                        value={process.efficiency}
                                        color={process.status === 'optimal' ? 'success' : process.status === 'good' ? 'primary' : 'warning'}
                                        sx={{ mb: 1 }}
                                    />
                                    {process.bottlenecks.length > 0 && (
                                        <Typography variant="caption" color="text.secondary">
                                            병목: {process.bottlenecks.join(', ')}
                                        </Typography>
                                    )}
                                </Box>
                            ))}
                        </CardContent>
                    </Card>
                </Grid>
            </Grid>

            {/* 인사이트 상세 다이얼로그 */}
            <Dialog
                open={showInsightDialog}
                onClose={() => setShowInsightDialog(false)}
                maxWidth="md"
                fullWidth
            >
                {selectedInsight && (
                    <>
                        <DialogTitle>
                            <Box sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                                <Insights color="primary" />
                                {selectedInsight.title}
                            </Box>
                        </DialogTitle>
                        <DialogContent>
                            <Typography variant="body1" sx={{ mb: 2 }}>
                                {selectedInsight.description}
                            </Typography>

                            <Box sx={{ display: 'flex', gap: 2, mb: 2 }}>
                                <Chip
                                    label={`신뢰도: ${(selectedInsight.confidence * 100).toFixed(0)}%`}
                                    color="primary"
                                />
                                <Chip
                                    label={`영향도: ${selectedInsight.impact}`}
                                    color={getImpactColor(selectedInsight.impact) as any}
                                />
                                <Chip
                                    label={selectedInsight.actionable ? '실행 가능' : '참고용'}
                                    color={selectedInsight.actionable ? 'success' : 'default'}
                                />
                            </Box>

                            <Typography variant="h6" gutterBottom>
                                권장 액션
                            </Typography>
                            <Box sx={{ display: 'flex', flexDirection: 'column', gap: 1 }}>
                                {selectedInsight.actions.map((action, index) => (
                                    <Alert key={index} severity="info" sx={{ mb: 1 }}>
                                        {action}
                                    </Alert>
                                ))}
                            </Box>
                        </DialogContent>
                        <DialogActions>
                            <Button onClick={() => setShowInsightDialog(false)}>
                                닫기
                            </Button>
                            <Button variant="contained" color="primary">
                                액션 실행
                            </Button>
                        </DialogActions>
                    </>
                )}
            </Dialog>
        </Box>
    );
};

export default AIEnhancedBusinessIntelligence;
