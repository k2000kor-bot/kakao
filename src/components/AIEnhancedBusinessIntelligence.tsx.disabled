import React, { useState, useEffect } from 'react';
import {
    Box,
    Card,
    CardContent,
    Typography,
    Grid,
    Chip,
    LinearProgress,
    IconButton,
    Button,
    Dialog,
    DialogTitle,
    DialogContent,
    DialogActions,
    TextField,
    Select,
    MenuItem,
    FormControl,
    InputLabel,
    Table,
    TableBody,
    TableCell,
    TableContainer,
    TableHead,
    TableRow,
    Paper,
    Alert,
    Divider,
    Tooltip,
    Badge
} from '@mui/material';
import {
    TrendingUp,
    TrendingDown,
    Analytics,
    Business,
    Assessment,
    Timeline,
    BarChart,
    Refresh,
    Download,
    Share,
    Settings,
    Warning,
    CheckCircle,
    Error,
    Info,
    Visibility,
    VisibilityOff,
    FilterList,
    Sort,
    Search,
    Add,
    Edit,
    Delete,
    Save,
    Cancel,
    PlayArrow,
    Pause,
    Stop,
    Speed,
    Memory,
    Storage,
    NetworkCheck,
    Security,
    Cloud,
    DataUsage,
    Insights,
    Psychology,
    AutoAwesome,
    RocketLaunch,
    Lightbulb,
    School,
    Work,
    Group,
    Person,
    LocationOn,
    Schedule,
    PriorityHigh,
    LowPriority,
    TrendingFlat
} from '@mui/icons-material';
import { Line, Bar, Doughnut, Radar } from 'react-chartjs-2';
import {
    Chart as ChartJS,
    CategoryScale,
    LinearScale,
    PointElement,
    LineElement,
    BarElement,
    ArcElement,
    RadialLinearScale,
    Title,
    Tooltip as ChartTooltip,
    Legend,
    Filler
} from 'chart.js';

ChartJS.register(
    CategoryScale,
    LinearScale,
    PointElement,
    LineElement,
    BarElement,
    ArcElement,
    RadialLinearScale,
    Title,
    ChartTooltip,
    Legend,
    Filler
);

// 비즈니스 인텔리전스 인터페이스
interface BusinessMetric {
    id: string;
    name: string;
    value: number;
    target: number;
    unit: string;
    trend: 'up' | 'down' | 'stable';
    change: number;
    status: 'excellent' | 'good' | 'warning' | 'critical';
    category: 'revenue' | 'cost' | 'efficiency' | 'quality' | 'customer' | 'employee';
    lastUpdated: Date;
}

interface BusinessInsight {
    id: string;
    title: string;
    description: string;
    type: 'opportunity' | 'risk' | 'trend' | 'anomaly' | 'recommendation';
    impact: 'high' | 'medium' | 'low';
    confidence: number;
    category: string;
    timestamp: Date;
    actionable: boolean;
    actions: string[];
}

interface PredictiveModel {
    id: string;
    name: string;
    accuracy: number;
    status: 'active' | 'training' | 'evaluating';
    lastPrediction: Date;
    predictions: number[];
    confidence: number;
}

interface BusinessProcess {
    id: string;
    name: string;
    efficiency: number;
    bottlenecks: string[];
    optimization: string[];
    status: 'optimal' | 'good' | 'needs_improvement' | 'critical';
}

