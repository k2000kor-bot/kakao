  const handleBackup = useCallback(() => {
    if (!isBackupRunning) {
      setIsBackupRunning(true);
      setBackupProgress(0);

      // 백업 진행률 시뮬레이션
      const interval = setInterval(() => {
        setBackupProgress(prev => {
          if (prev >= 100) {
            clearInterval(interval);
            setIsBackupRunning(false);
            addSystemMessage('백업이 완료되었습니다.', 'success');
            return 100;
          }
          return prev + 10;
        });
      }, 200);
    }
  }, [isBackupRunning, addSystemMessage]);

