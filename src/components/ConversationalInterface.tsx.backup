            <button
              onClick={handleHyperDimensionalTravelToggle}
              className={`p-2 rounded-lg ${isDarkMode ? 'bg-gray-700 hover:bg-gray-600' : 'bg-gray-100 hover:bg-gray-200'} transition ${isHyperDimensionalTravel ? 'bg-indigo-500 text-white' : ''}`}
              title="초차원 이동"
            >
              🌌
            </button>
            <button
              onClick={handleAbsoluteIntelligenceToggle}
              className={`p-2 rounded-lg ${isDarkMode ? 'bg-gray-700 hover:bg-gray-600' : 'bg-gray-100 hover:bg-gray-200'} transition ${isAbsoluteIntelligence ? 'bg-blue-500 text-white' : ''}`}
              title="절대 지능"
            >
              🧠
            </button>
            <button
              onClick={handleRealityManipulationToggle}
              className={`p-2 rounded-lg ${isDarkMode ? 'bg-gray-700 hover:bg-gray-600' : 'bg-gray-100 hover:bg-gray-200'} transition ${isRealityManipulation ? 'bg-green-500 text-white' : ''}`}
              title="현실 조작"
            >
              👁️
            </button>
            <button
              onClick={handleConsciousnessUploadToggle}
              className={`p-2 rounded-lg ${isDarkMode ? 'bg-gray-700 hover:bg-gray-600' : 'bg-gray-100 hover:bg-gray-200'} transition ${isConsciousnessUpload ? 'bg-purple-500 text-white' : ''}`}
              title="의식 업로드"
            >
              🧠
            </button>
            <button
              onClick={handleMultiUniverseConsciousnessToggle}
              className={`p-2 rounded-lg ${isDarkMode ? 'bg-gray-700 hover:bg-gray-600' : 'bg-gray-100 hover:bg-gray-200'} transition ${isMultiUniverseConsciousness ? 'bg-teal-500 text-white' : ''}`}
              title="다중 우주 의식"
            >
              🌌
            </button>
            <button
              onClick={handleTemporalParadoxResolutionToggle}
              className={`p-2 rounded-lg ${isDarkMode ? 'bg-gray-700 hover:bg-gray-600' : 'bg-gray-100 hover:bg-gray-200'} transition ${isTemporalParadoxResolution ? 'bg-pink-500 text-white' : ''}`}
              title="시간 역설 해결"
            >
              🔄
            </button>
            <button
              onClick={handleHyperDimensionalConsciousnessToggle}
              className={`p-2 rounded-lg ${isDarkMode ? 'bg-gray-700 hover:bg-gray-600' : 'bg-gray-100 hover:bg-gray-200'} transition ${isHyperDimensionalConsciousness ? 'bg-indigo-500 text-white' : ''}`}
              title="초차원 의식"
            >
              🌌
            </button>
            <button
              onClick={handleAbsoluteRealityToggle}
              className={`p-2 rounded-lg ${isDarkMode ? 'bg-gray-700 hover:bg-gray-600' : 'bg-gray-100 hover:bg-gray-200'} transition ${isAbsoluteReality ? 'bg-green-500 text-white' : ''}`}
              title="절대 현실"
            >
              🧠
            </button>
            <button
              onClick={handleOmniDimensionalTravelToggle}
              className={`p-2 rounded-lg ${isDarkMode ? 'bg-gray-700 hover:bg-gray-600' : 'bg-gray-100 hover:bg-gray-200'} transition ${isOmniDimensionalTravel ? 'bg-blue-500 text-white' : ''}`}
              title="전차원 이동"
            >
              🌌
            </button>
            <button
              onClick={handleConsciousnessFusionToggle}
              className={`p-2 rounded-lg ${isDarkMode ? 'bg-gray-700 hover:bg-gray-600' : 'bg-gray-100 hover:bg-gray-200'} transition ${isConsciousnessFusion ? 'bg-pink-500 text-white' : ''}`}
              title="의식 융합"
            >
