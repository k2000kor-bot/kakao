            <button
              onClick={handleInfiniteConsciousnessToggle}
              className={`p-2 rounded-lg ${isDarkMode ? 'bg-gray-700 hover:bg-gray-600' : 'bg-gray-100 hover:bg-gray-200'} transition ${isInfiniteConsciousness ? 'bg-purple-500 text-white' : ''}`}
              title="무한 의식"
            >
              ♾️
