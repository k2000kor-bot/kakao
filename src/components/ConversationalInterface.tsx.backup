            <button
              onClick={handleTimeLoopControlToggle}
              className={`p-2 rounded-lg ${isDarkMode ? 'bg-gray-700 hover:bg-gray-600' : 'bg-gray-100 hover:bg-gray-200'} transition ${isTimeLoopControl ? 'bg-pink-500 text-white' : ''}`}
              title="시간 루프 제어"
            >
