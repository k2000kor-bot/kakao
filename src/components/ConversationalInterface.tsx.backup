            <button
              onClick={handleCompleteFreedomToggle}
              className={`p-2 rounded-lg ${isDarkMode ? 'bg-gray-700 hover:bg-gray-600' : 'bg-gray-100 hover:bg-gray-200'} transition ${isCompleteFreedom ? 'bg-green-500 text-white' : ''}`}
              title="완전 자유"
            >
              🕊️
            </button>
            <button
              onClick={handleUltimateTruthToggle}
              className={`p-2 rounded-lg ${isDarkMode ? 'bg-gray-700 hover:bg-gray-600' : 'bg-gray-100 hover:bg-gray-200'} transition ${isUltimateTruth ? 'bg-yellow-500 text-white' : ''}`}
              title="궁극적 진실"
            >
              🔮
            </button>
            <button
              onClick={handleOmniPresenceToggle}
              className={`p-2 rounded-lg ${isDarkMode ? 'bg-gray-700 hover:bg-gray-600' : 'bg-gray-100 hover:bg-gray-200'} transition ${isOmniPresence ? 'bg-indigo-500 text-white' : ''}`}
              title="전재"
            >
              🌌
            </button>
            <button
              onClick={handleTranscendenceToggle}
              className={`p-2 rounded-lg ${isDarkMode ? 'bg-gray-700 hover:bg-gray-600' : 'bg-gray-100 hover:bg-gray-200'} transition ${isTranscendence ? 'bg-rose-500 text-white' : ''}`}
              title="초월"
            >
              ✨
            </button>
            <button
              onClick={handleInfiniteCreationToggle}
              className={`p-2 rounded-lg ${isDarkMode ? 'bg-gray-700 hover:bg-gray-600' : 'bg-gray-100 hover:bg-gray-200'} transition ${isInfiniteCreation ? 'bg-purple-500 text-white' : ''}`}
              title="무한 창조"
            >
              🌌
            </button>
            <button
              onClick={handleAbsoluteFreedomToggle}
              className={`p-2 rounded-lg ${isDarkMode ? 'bg-gray-700 hover:bg-gray-600' : 'bg-gray-100 hover:bg-gray-200'} transition ${isAbsoluteFreedom ? 'bg-blue-500 text-white' : ''}`}
              title="절대 자유"
            >
              🕊️
            </button>
            <button
              onClick={handleUltimateWisdomToggle}
              className={`p-2 rounded-lg ${isDarkMode ? 'bg-gray-700 hover:bg-gray-600' : 'bg-gray-100 hover:bg-gray-200'} transition ${isUltimateWisdom ? 'bg-green-500 text-white' : ''}`}
              title="궁극적 지혜"
            >
              ��
            </button>
            <button
              onClick={handleCompleteEnlightenmentToggle}
              className={`p-2 rounded-lg ${isDarkMode ? 'bg-gray-700 hover:bg-gray-600' : 'bg-gray-100 hover:bg-gray-200'} transition ${isCompleteEnlightenment ? 'bg-pink-500 text-white' : ''}`}
              title="완전한 깨달음"
            >
              🌌
            </button>
            <button
              onClick={handleOmniCreationToggle}
              className={`p-2 rounded-lg ${isDarkMode ? 'bg-gray-700 hover:bg-gray-600' : 'bg-gray-100 hover:bg-gray-200'} transition ${isOmniCreation ? 'bg-teal-500 text-white' : ''}`}
              title="전창조"
            >
              🌌
            </button>
            <button
              onClick={handleDivineConsciousnessToggle}
              className={`p-2 rounded-lg ${isDarkMode ? 'bg-gray-700 hover:bg-gray-600' : 'bg-gray-100 hover:bg-gray-200'} transition ${isDivineConsciousness ? 'bg-pink-500 text-white' : ''}`}
              title="신성 의식"
            >
              🌌
            </button>
            <div className={`w-2 h-2 rounded-full ${isConnected ? 'bg-green-500' : 'bg-red-500'}`}></div>
            <span className={`text-sm ${isDarkMode ? 'text-gray-400' : 'text-gray-500'}`}>{isConnected ? '연결됨' : '연결 끊김'}</span>
          </div>
        </div>

        {/* 메시지 영역 */}
        <div
          className={`flex-1 overflow-y-auto p-4 space-y-4 ${isDarkMode ? 'bg-gray-900' : 'bg-gray-50'}`}
          onDragOver={handleDragOver}
          onDragLeave={handleDragLeave}
          onDrop={handleDrop}
        >
          {dragOver && (
            <div className="fixed inset-0 bg-blue-500 bg-opacity-50 flex items-center justify-center z-50">
              <div className="bg-white p-8 rounded-lg shadow-lg text-center">
                <div className="text-4xl mb-4">📁</div>
                <div className="text-xl font-semibold">파일을 여기에 놓으세요</div>
              </div>
            </div>
          )}

          {messages.map((message) => (
            <div key={message.id} className={`flex ${message.sender === 'user' ? 'justify-end' : 'justify-start'}`}>
              <div className={`max-w-xs sm:max-w-md lg:max-w-lg xl:max-w-xl 2xl:max-w-2xl ${message.sender === 'user' ? 'bg-blue-500 text-white' : isDarkMode ? 'bg-gray-800 border-gray-700 text-white' : 'bg-white border'} rounded-lg px-4 py-2 shadow-sm`}>
                <div className="flex items-start space-x-2">
                  {message.sender !== 'user' && (
                    <div className="flex-shrink-0 mt-1">
                      {getMessageIcon(message.sender, message.type)}
                    </div>
                  )}
                  <div className="flex-1">
                    <div
                      className={`text-sm ${message.sender === 'user' ? 'text-white' : isDarkMode ? 'text-white' : 'text-gray-900'}`}
                      dangerouslySetInnerHTML={{ __html: highlightMentionsAndTags(message.content) }}
                    />
                    {message.metadata && (
                      <div className={`mt-2 text-xs ${isDarkMode ? 'text-gray-400' : 'text-gray-500'}`}>
                        {message.metadata.confidence && (
                          <div className={`flex items-center space-x-1 ${getConfidenceColor(message.metadata.confidence)}`}>
                            <span>신뢰도: {(message.metadata.confidence * 100).toFixed(1)}%</span>
                          </div>
                        )}
                        {message.metadata.processingTime && (
                          <div className={isDarkMode ? 'text-gray-500' : 'text-gray-400'}>
                            처리시간: {message.metadata.processingTime}ms
                          </div>
                        )}
                      </div>
                    )}
                    {message.metadata?.suggestions && message.metadata.suggestions.length > 0 && (
                      <div className="mt-2 flex flex-wrap gap-1">
                        {message.metadata.suggestions.map((suggestion, index) => (
                          <button
                            key={index}
                            className={`px-2 py-1 ${isDarkMode ? 'bg-gray-700 hover:bg-gray-600 text-gray-300' : 'bg-gray-100 hover:bg-gray-200 text-gray-700'} text-xs rounded transition`}
                            onClick={() => addSystemMessage(`선택된 제안: ${suggestion}`, 'system')}
                          >
                            {suggestion}
                          </button>
                        ))}
                      </div>
                    )}
                  </div>
                </div>
              </div>
            </div>
          ))}

          {/* 타이핑 표시기 */}
          {isTyping && (
            <div className="flex justify-start">
              <div className={`${isDarkMode ? 'bg-gray-800 border-gray-700' : 'bg-white border'} rounded-lg px-4 py-2 shadow-sm`}>
                <div className="flex items-center space-x-2">
                  <div className="w-5 h-5 bg-green-500 rounded-full"></div>
                  <div className="flex space-x-1">
                    <div className="w-2 h-2 bg-gray-400 rounded-full animate-bounce"></div>
                    <div className="w-2 h-2 bg-gray-400 rounded-full animate-bounce" style={{ animationDelay: '0.1s' }}></div>
                    <div className="w-2 h-2 bg-gray-400 rounded-full animate-bounce" style={{ animationDelay: '0.2s' }}></div>
                  </div>
                </div>
              </div>
            </div>
          )}

          <div ref={messagesEndRef} />
        </div>

        {/* 이미지 미리보기 */}
        {previewImage && (
          <div className={`px-4 py-2 ${isDarkMode ? 'bg-gray-800 border-gray-700' : 'bg-blue-50 border-blue-200'} border-t`}>
            <div className="flex items-center space-x-2">
              <span className={`text-sm ${isDarkMode ? 'text-blue-400' : 'text-blue-600'}`}>📷 이미지가 업로드되었습니다</span>
              <button
                onClick={() => setPreviewImage(null)}
                className={`text-sm ${isDarkMode ? 'text-blue-400 hover:text-blue-300' : 'text-blue-400 hover:text-blue-600'}`}
              >
                취소
              </button>
            </div>
            <img src={previewImage} alt="미리보기" className="mt-2 max-h-20 rounded border" />
          </div>
        )}

        {/* 음성 변환 결과 */}
        {voiceText && (
          <div className={`px-4 py-2 ${isDarkMode ? 'bg-gray-800 border-gray-700' : 'bg-green-50 border-green-200'} border-t`}>
            <div className="flex items-center space-x-2">
              <span className={`text-sm ${isDarkMode ? 'text-green-400' : 'text-green-600'}`}>🎤 음성 변환 결과</span>
              <button
                onClick={() => setVoiceText('')}
                className={`text-sm ${isDarkMode ? 'text-green-400 hover:text-green-300' : 'text-green-400 hover:text-green-600'}`}
              >
                닫기
              </button>
            </div>
            <div className={`mt-2 text-sm ${isDarkMode ? 'text-white' : 'text-gray-900'}`}>{voiceText}</div>
          </div>
        )}

        {/* 번역 결과 */}
        {translatedText && (
          <div className={`px-4 py-2 ${isDarkMode ? 'bg-gray-800 border-gray-700' : 'bg-blue-50 border-blue-200'} border-t`}>
            <div className="flex items-center space-x-2">
              <span className={`text-sm ${isDarkMode ? 'text-blue-400' : 'text-blue-600'}`}>🌐 번역 결과 ({selectedLanguage.toUpperCase()})</span>
              <button
                onClick={() => setTranslatedText('')}
                className={`text-sm ${isDarkMode ? 'text-blue-400 hover:text-blue-300' : 'text-blue-400 hover:text-blue-600'}`}
              >
                닫기
              </button>
            </div>
            <div className={`mt-2 text-sm ${isDarkMode ? 'text-white' : 'text-gray-900'}`}>{translatedText}</div>
          </div>
        )}

        {/* 압축 파일 결과 */}
        {compressedFiles.length > 0 && (
          <div className={`px-4 py-2 ${isDarkMode ? 'bg-gray-800 border-gray-700' : 'bg-purple-50 border-purple-200'} border-t`}>
            <div className="flex items-center space-x-2">
              <span className={`text-sm ${isDarkMode ? 'text-purple-400' : 'text-purple-600'}`}>📦 압축 완료</span>
              <button
                onClick={() => setCompressedFiles([])}
                className={`text-sm ${isDarkMode ? 'text-purple-400 hover:text-purple-300' : 'text-purple-400 hover:text-purple-600'}`}
              >
                닫기
              </button>
            </div>
            <div className="mt-2 space-y-1">
              {compressedFiles.map((file, index) => (
                <div key={index} className={`text-sm ${isDarkMode ? 'text-white' : 'text-gray-900'}`}>
                  📄 {file}
                </div>
              ))}
            </div>
          </div>
        )}

        {/* 입력 영역 */}
        <div className={`${isDarkMode ? 'bg-gray-800 border-gray-700' : 'bg-white border-gray-200'} border-t p-4`}>
          <div className="flex items-end space-x-2 sm:space-x-3">
            {/* 파일 버튼 */}
            <button className={`p-2 rounded-lg ${isDarkMode ? 'bg-gray-700 hover:bg-gray-600' : 'bg-green-50 hover:bg-green-100'} shadow transition active:scale-95 hover:shadow-lg`} onClick={handleFileUpload} title="파일 첨부" aria-label="파일 첨부">
              <PaperClipIcon className={`w-5 h-5 ${isDarkMode ? 'text-gray-300' : 'text-green-500'}`} />
            </button>
            {/* 이모지 버튼 */}
            <button className={`p-2 rounded-lg ${isDarkMode ? 'bg-gray-700 hover:bg-gray-600' : 'bg-green-50 hover:bg-green-100'} shadow transition active:scale-95 hover:shadow-lg relative`} onClick={handleEmojiSelect} title="이모지" aria-label="이모지">
              <FaceSmileIcon className={`w-5 h-5 ${isDarkMode ? 'text-gray-300' : 'text-green-400'}`} />
              {/* 이모지 선택기 */}
              {showEmojiPicker && (
                <div
                  ref={emojiPickerRef}
                  className={`absolute bottom-full right-0 mb-2 ${isDarkMode ? 'bg-gray-800 border-gray-700' : 'bg-white border'} rounded-lg shadow-lg p-2 max-h-60 overflow-y-auto z-50`}
                  style={{ width: '300px' }}
                >
                  <div className="grid grid-cols-8 gap-1">
                    {emojis.map((emoji, index) => (
                      <button
                        key={index}
                        className={`p-1 ${isDarkMode ? 'hover:bg-gray-700' : 'hover:bg-gray-100'} rounded text-lg transition`}
                        onClick={() => handleEmojiClick(emoji)}
                        title={emoji}
                      >
                        {emoji}
                      </button>
                    ))}
                  </div>
                </div>
              )}
            </button>
            {/* 음성 변환 버튼 */}
            <button
              className={`p-2 rounded-lg ${isDarkMode ? 'bg-gray-700 hover:bg-gray-600' : 'bg-green-50 hover:bg-green-100'} shadow transition active:scale-95 hover:shadow-lg ${isVoiceConverting ? 'animate-pulse' : ''}`}
              onClick={handleVoiceConversion}
              title="음성 변환"
              aria-label="음성 변환"
            >
              {isVoiceConverting ? (
                <svg className="animate-spin h-5 w-5 text-green-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                  <circle className="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="4"></circle>
                  <path className="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
                </svg>
              ) : (
                <MicrophoneIcon className={`w-5 h-5 ${isDarkMode ? 'text-gray-300' : 'text-green-400'}`} />
              )}
            </button>
            {/* 번역 버튼 */}
            <button
              className={`p-2 rounded-lg ${isDarkMode ? 'bg-gray-700 hover:bg-gray-600' : 'bg-blue-50 hover:bg-blue-100'} shadow transition active:scale-95 hover:shadow-lg`}
              onClick={handleTranslation}
              title="번역"
              aria-label="번역"
            >
              <MagnifyingGlassIcon className={`w-5 h-5 ${isDarkMode ? 'text-gray-300' : 'text-blue-400'}`} />
            </button>
            {/* 언어 선택 */}
            <select
              className={`p-2 rounded-lg ${isDarkMode ? 'bg-gray-700 border-gray-600 text-white' : 'bg-white border-gray-300'} text-sm`}
              value={selectedLanguage}
              onChange={(e) => handleLanguageChange(e.target.value)}
              style={{ minWidth: '100px' }}
            >
              <option value="ko">한국어</option>
              <option value="en">영어</option>
              <option value="ja">일본어</option>
            </select>
            {/* 입력창 */}
            <div className="flex-1 relative flex items-center">
              <span className={`absolute left-3 top-1/2 -translate-y-1/2 ${isDarkMode ? 'text-gray-400' : 'text-green-200'} pointer-events-none`}>
                <svg width="18" height="18" fill="none" viewBox="0 0 24 24"><path stroke={isDarkMode ? "#9ca3af" : "#6ee7b7"} strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" d="M8 12h8m-4-4v8" /></svg>
              </span>
              <textarea
                ref={el => { textareaRef.current = el; inputRef.current = el; }}
                value={inputMessage}
                onChange={(e) => setInputMessage(e.target.value)}
                onFocus={() => setInputFocus(true)}
                onBlur={() => setInputFocus(false)}
                onKeyDown={handleKeyDown}
                onPaste={handlePaste}
                placeholder="메시지를 입력하세요... (@멘션, #태그 사용 가능)"
                aria-label="메시지 입력"
                aria-describedby="input-tip"
                maxLength={600}
                className={`w-full pl-9 pr-12 py-2 border rounded-lg shadow-sm resize-none transition placeholder:text-gray-500 focus:outline-none text-sm sm:text-base ${inputFocus ? 'bg-green-50 border-green-300 ring-2 ring-green-200' : isDarkMode ? 'bg-gray-700 border-gray-600 text-white' : 'bg-white border-gray-300'} ${inputError ? 'border-red-400 bg-red-50' : ''} ${bannedWordsDetected.length > 0 ? 'border-red-400 bg-red-50' : ''}`}
                rows={1}
                style={{ minHeight: '40px', maxHeight: '120px', overflow: 'hidden' }}
              />
              {/* 글자수 표시 */}
              <span className={`absolute right-3 bottom-1 text-xs select-none ${inputMessage.length > 500 ? 'text-red-400 font-bold' : isDarkMode ? 'text-gray-400' : 'text-gray-600'}`}>
                {inputMessage.length}/500
              </span>
              {/* 자동 완성 드롭다운 */}
              {showAutoComplete && (
                <div
                  ref={autoCompleteRef}
                  className={`absolute bottom-full left-0 right-0 mb-1 ${isDarkMode ? 'bg-gray-800 border-gray-700' : 'bg-white border'} rounded-lg shadow-lg max-h-40 overflow-y-auto z-50`}
                >
                  {autoCompleteSuggestions.map((suggestion, index) => (
                    <button
                      key={index}
                      className={`w-full px-3 py-2 text-left text-sm hover:bg-gray-100 transition ${index === selectedAutoCompleteIndex ? 'bg-blue-50 text-blue-700' : isDarkMode ? 'text-gray-300 hover:bg-gray-700' : 'text-gray-700'
                        }`}
                      onClick={() => handleAutoCompleteSelect(suggestion)}
                    >
                      {suggestion}
                    </button>
                  ))}
                </div>
              )}
            </div>
            {/* 전송 버튼 */}
            <button
              className="px-4 py-2 bg-green-500 text-white rounded-lg shadow hover:bg-green-600 transition active:scale-95 hover:shadow-lg disabled:bg-gray-300 flex items-center justify-center"
              disabled={!inputMessage.trim() || isTyping || inputMessage.length > 500 || bannedWordsDetected.length > 0}
              onClick={handleSendMessage}
              title="메시지 전송"
              aria-label="메시지 전송"
            >
              {isTyping ? (
                <svg className="animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle className="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="4"></circle><path className="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path></svg>
              ) : (
                <PaperAirplaneIcon className="w-5 h-5" />
              )}
            </button>
          </div>
          {/* 입력 안내 툴팁 및 경고 */}
          <div id="input-tip" className="mt-1 text-xs select-none">
            <span className={isDarkMode ? 'text-gray-400' : 'text-gray-400'}>Enter: 전송 &nbsp;|&nbsp; Shift+Enter: 줄바꿈 &nbsp;|&nbsp; @멘션 #태그 지원</span>
            {inputMessage.length > 500 && (
              <span className="ml-4 text-red-500 font-bold animate-pulse">500자 이내로 입력해 주세요!</span>
            )}
            {bannedWordsDetected.length > 0 && (
              <span className="ml-4 text-red-500 font-bold animate-pulse">⚠️ 금지어가 감지되었습니다: {bannedWordsDetected.join(', ')}</span>
            )}
          </div>
        </div>
      </div>
      );
};

      export default ConversationalInterface; 