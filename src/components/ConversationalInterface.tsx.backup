    }
  }, [inputMessage]);

  // 외부 클릭 감지
  useEffect(() => {
    const handleClickOutside = (event: MouseEvent) => {
      if (emojiPickerRef.current && !emojiPickerRef.current.contains(event.target as Node)) {
        setShowEmojiPicker(false);
      }
      if (autoCompleteRef.current && !autoCompleteRef.current.contains(event.target as Node)) {
        setShowAutoComplete(false);
      }
    };

    document.addEventListener('mousedown', handleClickOutside);
    return () => document.removeEventListener('mousedown', handleClickOutside);
  }, []);

  // 스크롤을 맨 아래로
  const scrollToBottom = useCallback(() => {
    messagesEndRef.current?.scrollIntoView({ behavior: 'smooth' });
  }, []);

  useEffect(() => {
    scrollToBottom();
  }, [messages, scrollToBottom]);

  // 메시지 추가
  const addMessage = useCallback((content: string, sender: 'user' | 'ai' | 'system', type: 'text' | 'command' | 'system' | 'error' | 'success' = 'text', metadata?: any) => {
    const newMessage: Message = {
      id: Date.now().toString(),
      content,
      sender,
      timestamp: new Date(),
      type,
      metadata
    };
    setMessages(prev => [...prev, newMessage]);
  }, []);

  // 시스템 메시지 추가
  const addSystemMessage = useCallback((content: string, type: 'system' | 'error' | 'success' = 'system', metadata?: any) => {
    addMessage(content, 'system', type, metadata);
  }, [addMessage]);

  // @멘션과 #태그 하이라이트 처리
  const highlightMentionsAndTags = useCallback((text: string) => {
    return text
      .replace(/(@\w+)/g, '<span class="bg-blue-100 text-blue-700 px-1 rounded font-medium">$1</span>')
      .replace(/(#\w+)/g, '<span class="bg-green-100 text-green-700 px-1 rounded font-medium">$1</span>');
  }, []);

  // 이미지 붙여넣기 처리
  const handlePaste = useCallback((e: React.ClipboardEvent) => {
    const items = e.clipboardData.items;
    for (let i = 0; i < items.length; i++) {
      if (items[i].type.indexOf('image') !== -1) {
        const file = items[i].getAsFile();
        if (file) {
          const reader = new FileReader();
          reader.onload = (e) => {
            const result = e.target?.result as string;
            setPreviewImage(result);
            // 3초 후 미리보기 제거
            setTimeout(() => setPreviewImage(null), 3000);
          };
          reader.readAsDataURL(file);
        }
      }
    }
  }, []);

  // 이모지 선택 처리
  const handleEmojiSelect = useCallback(() => {
    setShowEmojiPicker(prev => !prev);
  }, []);

  // 이모지 클릭 처리
  const handleEmojiClick = useCallback((emoji: string) => {
    setInputMessage(prev => prev + emoji);
    setShowEmojiPicker(false);
  }, []);

  // 자동 완성 선택 처리
  const handleAutoCompleteSelect = useCallback((suggestion: string) => {
    setInputMessage(suggestion);
    setShowAutoComplete(false);
    textareaRef.current?.focus();
  }, []);

  // 메시지 전송 처리
  const handleSendMessage = useCallback(() => {
    if (!inputMessage.trim() || inputMessage.length > 500) return;

    // 금지어 감지 시 경고
    if (bannedWordsDetected.length > 0) {
      addSystemMessage(`⚠️ 금지어가 감지되었습니다: ${bannedWordsDetected.join(', ')}`, 'error');
      return;
    }

    const message = inputMessage.trim();
    addMessage(message, 'user', 'text');
    setInputMessage('');
    setShowAutoComplete(false);

    if (message.startsWith('/')) {
      const command = message.substring(1);
      if (command.includes(' ')) {
        const [mainCmd, subCmd] = command.split(' ');
        // 메인 명령어 처리
        const cmd = mainCmd.toLowerCase();
        switch (cmd) {
          case 'guide':
            addSystemMessage('📚 사용 가이드', 'system', {
              suggestions: ['union_activity', 'proposal'],
              actions: ['조합 활동 가이드', '제안서 작성 가이드']
            });
            break;
          case 'performance':
            addSystemMessage(`📊 시스템 성능\nCPU: ${systemStatus.cpu}% | 메모리: ${systemStatus.memory}% | 응답시간: ${systemStatus.responseTime}ms | 연결: ${systemStatus.activeConnections}개`, 'system', {
              suggestions: ['ai_model_status'],
              actions: ['AI 모델 상태 확인']
            });
            break;
          case 'upload':
            addSystemMessage('📁 파일 업로드', 'system', {
              suggestions: ['upload_kakao'],
              actions: ['카카오톡 대화 업로드']
            });
            break;
          case 'search':
            addSystemMessage('🔍 검색 기능', 'system', {
              suggestions: ['search_by_date'],
              actions: ['날짜별 검색']
            });
            break;
          case 'settings':
            addSystemMessage('⚙️ 설정', 'system', {
              suggestions: ['ai_model_settings', 'language_settings', 'notification_settings', 'theme_settings'],
              actions: ['AI 모델 설정', '언어 설정', '알림 설정', '테마 설정']
            });
            break;
          case 'message_guide':
          case 'msg_guide':
            addSystemMessage('📝 메시지 가이드 시스템', 'system', {
              suggestions: ['open_message_guidance'],
              actions: ['메시지 가이드 시스템 열기']
            });
            if (onCommand) {
              onCommand('open_message_guidance');
            }
            break;
          case 'help':
            addSystemMessage('❓ 도움말\n사용 가능한 명령어: /guide, /performance, /upload, /search, /settings, /message_guide, /clear, /status', 'system');
            break;
          case 'clear':
            setMessages([]);
            addSystemMessage('대화가 초기화되었습니다.', 'success');
            break;
          case 'status':
            addSystemMessage(`🖥️ 시스템 상태\nCPU: ${systemStatus.cpu}% | 메모리: ${systemStatus.memory}% | 응답시간: ${systemStatus.responseTime}ms | 활성 연결: ${systemStatus.activeConnections}개`, 'system');
            break;
          default:
            addSystemMessage(`알 수 없는 명령어: ${mainCmd}`, 'error');
        }

        // 하위 명령어 처리
        setTimeout(() => {
          const subCmdLower = subCmd.toLowerCase();
          switch (subCmdLower) {
            case 'union_activity':
              addSystemMessage('🏢 조합 활동 가이드\n• 조합원 권리와 의무\n• 조합 활동 참여 방법\n• 조합원 교육 프로그램', 'system');
              break;
            case 'proposal':
              addSystemMessage('📋 제안서 작성 가이드\n• 제안서 구조와 형식\n• 효과적인 제안 방법\n• 제안서 검토 프로세스', 'system');
              break;
            case 'ai_model_status':
              addSystemMessage('🤖 AI 모델 상태\n• 모델: GPT-4 (최신)\n• 응답 시간: 평균 1.2초\n• 정확도: 95%', 'system');
              break;
            case 'upload_kakao':
              addSystemMessage('📱 카카오톡 대화 업로드\n• 대화 파일 선택\n• 자동 분석 및 처리\n• 결과 확인', 'system');
              break;
            case 'search_by_date':
              addSystemMessage('📅 날짜별 검색\n• 기간 선택\n• 키워드 검색\n• 결과 필터링', 'system');
              break;
            case 'ai_model_settings':
              addSystemMessage('⚙️ AI 모델 설정\n• 모델 선택\n• 응답 속도 조정\n• 정확도 설정', 'system');
              break;
            case 'language_settings':
              addSystemMessage('🌐 언어 설정\n• 한국어 (기본)\n• 영어\n• 일본어', 'system');
              break;
            case 'notification_settings':
              addSystemMessage('🔔 알림 설정\n• 메시지 알림\n• 시스템 알림\n• 이메일 알림', 'system');
              break;
            case 'theme_settings':
              addSystemMessage('🎨 테마 설정\n• 라이트 모드\n• 다크 모드\n• 자동 모드', 'system');
              break;
            default:
              addSystemMessage(`알 수 없는 하위 명령어: ${subCmdLower}`, 'error');
          }
        }, 500);
      } else {
        // 단일 명령어 처리
        const cmd = command.toLowerCase();
        switch (cmd) {
          case 'guide':
            addSystemMessage('📚 사용 가이드', 'system', {
              suggestions: ['union_activity', 'proposal'],
              actions: ['조합 활동 가이드', '제안서 작성 가이드']
            });
            break;
          case 'performance':
            addSystemMessage(`📊 시스템 성능\nCPU: ${systemStatus.cpu}% | 메모리: ${systemStatus.memory}% | 응답시간: ${systemStatus.responseTime}ms | 연결: ${systemStatus.activeConnections}개`, 'system', {
              suggestions: ['ai_model_status'],
              actions: ['AI 모델 상태 확인']
            });
            break;
          case 'upload':
            addSystemMessage('📁 파일 업로드', 'system', {
              suggestions: ['upload_kakao'],
              actions: ['카카오톡 대화 업로드']
            });
            break;
          case 'search':
            addSystemMessage('🔍 검색 기능', 'system', {
              suggestions: ['search_by_date'],
              actions: ['날짜별 검색']
            });
            break;
          case 'settings':
            addSystemMessage('⚙️ 설정', 'system', {
              suggestions: ['ai_model_settings', 'language_settings', 'notification_settings', 'theme_settings'],
              actions: ['AI 모델 설정', '언어 설정', '알림 설정', '테마 설정']
            });
            break;
          case 'message_guide':
          case 'msg_guide':
            addSystemMessage('📝 메시지 가이드 시스템', 'system', {
              suggestions: ['open_message_guidance'],
              actions: ['메시지 가이드 시스템 열기']
            });
            if (onCommand) {
              onCommand('open_message_guidance');
            }
            break;
          case 'help':
            addSystemMessage('❓ 도움말\n사용 가능한 명령어: /guide, /performance, /upload, /search, /settings, /message_guide, /clear, /status', 'system');
            break;
          case 'clear':
            setMessages([]);
            addSystemMessage('대화가 초기화되었습니다.', 'success');
            break;
          case 'status':
            addSystemMessage(`🖥️ 시스템 상태\nCPU: ${systemStatus.cpu}% | 메모리: ${systemStatus.memory}% | 응답시간: ${systemStatus.responseTime}ms | 활성 연결: ${systemStatus.activeConnections}개`, 'system');
            break;
          default:
            addSystemMessage(`알 수 없는 명령어: ${command}`, 'error');
        }
      }
    } else {
      // 메시지 생성 처리 (인라인 구현)
      setIsTyping(true);
      setTimeout(async () => {
        const responses = [
          '네, 이해했습니다. 더 자세한 정보를 제공해 드릴게요.',
          '흥미로운 질문이네요. 이에 대해 분석해보겠습니다.',
          '좋은 지적입니다. 추가적인 관점에서 살펴보겠습니다.',
          '이 부분에 대해 더 구체적으로 설명드리겠습니다.',
          '제공해주신 정보를 바탕으로 추천사항을 제시하겠습니다.'
        ];
        const response = responses[Math.floor(Math.random() * responses.length)];
        addMessage(response, 'ai', 'text', {
          confidence: 0.85 + Math.random() * 0.1,
          processingTime: 1200 + Math.random() * 800,
          suggestions: ['더 자세히', '예시 보기', '관련 정보']
        });
        setIsTyping(false);
      }, 1000 + Math.random() * 2000);
    }

    if (onCommand) {
      onCommand(message);
    }
  }, [inputMessage, bannedWordsDetected, addMessage, systemStatus, onCommand]);

  // 키보드 네비게이션
  const handleKeyDown = useCallback((e: React.KeyboardEvent) => {
    if (showAutoComplete) {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        setSelectedAutoCompleteIndex(prev =>
          prev < autoCompleteSuggestions.length - 1 ? prev + 1 : 0
        );
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        setSelectedAutoCompleteIndex(prev =>
          prev > 0 ? prev - 1 : autoCompleteSuggestions.length - 1
        );
      } else if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        if (autoCompleteSuggestions.length > 0) {
          handleAutoCompleteSelect(autoCompleteSuggestions[selectedAutoCompleteIndex]);
        } else {
          handleSendMessage();
        }
      } else if (e.key === 'Escape') {
        setShowAutoComplete(false);
      }
    } else if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      handleSendMessage();
    }
  }, [showAutoComplete, autoCompleteSuggestions, selectedAutoCompleteIndex, handleAutoCompleteSelect, handleSendMessage]);

  // 초기 환영 메시지
  useEffect(() => {
    addSystemMessage('안녕하세요! CORBU AI 대화형 인터페이스입니다. 무엇을 도와드릴까요?', 'system', {
      suggestions: ['/guide - 사용 가이드', '/performance - 시스템 성능', '/upload - 파일 업로드', '/search - 검색 기능', '/settings - 설정', '/help - 도움말', '/clear - 대화 초기화', '/status - 시스템 상태'],
      actions: ['시작하기', '가이드 보기', '성능 확인']
    });
  }, [addSystemMessage]);

  // 시스템 상태 시뮬레이션
  useEffect(() => {
    const interval = setInterval(() => {
      setSystemStatus(prev => ({
        cpu: Math.max(20, Math.min(80, prev.cpu + (Math.random() - 0.5) * 10)),
        memory: Math.max(40, Math.min(90, prev.memory + (Math.random() - 0.5) * 5)),
        responseTime: Math.max(80, Math.min(200, prev.responseTime + (Math.random() - 0.5) * 20)),
        activeConnections: Math.max(5, Math.min(15, prev.activeConnections + (Math.random() > 0.7 ? 1 : -1)))
      }));
    }, 3000);
    return () => clearInterval(interval);
  }, []);

  // 음성 입력 처리
  const handleVoiceInput = useCallback(() => {
    setIsRecording(!isRecording);
    addSystemMessage(isRecording ? '음성 녹음이 중지되었습니다.' : '음성 녹음을 시작합니다...', 'system');
  }, [isRecording, addSystemMessage]);

  // 파일 업로드 처리
  const handleFileUpload = useCallback(() => {
    addSystemMessage('파일 업로드 기능이 준비 중입니다.', 'system');
  }, [addSystemMessage]);

  // 음성 변환 처리
  const handleVoiceConversion = useCallback(() => {
    if (!isVoiceConverting) {
      setIsVoiceConverting(true);
      setVoiceText('');

      // Web Speech API 시뮬레이션
      setTimeout(() => {
        const mockText = "안녕하세요, 음성 변환 테스트입니다.";
        setVoiceText(mockText);
        setInputMessage(prev => prev + mockText);
        setIsVoiceConverting(false);
        addSystemMessage('음성 변환이 완료되었습니다.', 'success');
      }, 2000);
    } else {
      setIsVoiceConverting(false);
      addSystemMessage('음성 변환이 중지되었습니다.', 'system');
    }
  }, [isVoiceConverting, addSystemMessage]);

  // 드래그 앤 드롭 처리
  const handleDragOver = useCallback((e: React.DragEvent) => {
    e.preventDefault();
    setDragOver(true);
  }, []);

  const handleDragLeave = useCallback((e: React.DragEvent) => {
    e.preventDefault();
    setDragOver(false);
  }, []);

  const handleDrop = useCallback((e: React.DragEvent) => {
    e.preventDefault();
    setDragOver(false);

    const files = Array.from(e.dataTransfer.files);
    if (files.length > 0) {
      const file = files[0];
      addSystemMessage(`파일이 업로드되었습니다: ${file.name}`, 'success');

      // 이미지 파일인 경우 미리보기
      if (file.type.startsWith('image/')) {
        const reader = new FileReader();
        reader.onload = (e) => {
          const result = e.target?.result as string;
          setPreviewImage(result);
          setTimeout(() => setPreviewImage(null), 3000);
        };
        reader.readAsDataURL(file);
      }
    }
  }, [addSystemMessage]);

  // 다크 모드 토글
  const toggleDarkMode = useCallback(() => {
    setIsDarkMode(prev => !prev);
    addSystemMessage(`다크 모드가 ${!isDarkMode ? '활성화' : '비활성화'}되었습니다.`, 'system');
  }, [isDarkMode, addSystemMessage]);

  // 실시간 번역 처리
  const handleTranslation = useCallback(() => {
    if (!isTranslating && inputMessage.trim()) {
      setIsTranslating(true);
      setTranslatedText('');

      // 번역 시뮬레이션
      setTimeout(() => {
        const mockTranslation = `[${selectedLanguage.toUpperCase()}] ${inputMessage}`;
        setTranslatedText(mockTranslation);
        setIsTranslating(false);
        addSystemMessage(`번역이 완료되었습니다. (${selectedLanguage.toUpperCase()})`, 'success');
      }, 1500);
    }
  }, [isTranslating, inputMessage, selectedLanguage, addSystemMessage]);

  // AI 채팅봇 토글
  const toggleAIChat = useCallback(() => {
    setIsAIChatActive(prev => !prev);
    if (!isAIChatActive) {
      addSystemMessage('AI 채팅봇이 활성화되었습니다. 자동 응답을 받을 수 있습니다.', 'system');
    } else {
      addSystemMessage('AI 채팅봇이 비활성화되었습니다.', 'system');
    }
  }, [isAIChatActive, addSystemMessage]);

  // 파일 압축 처리
  const handleFileCompression = useCallback(() => {
    if (!isCompressing) {
      setIsCompressing(true);
      setCompressedFiles([]);

      // 압축 시뮬레이션
      setTimeout(() => {
        const mockCompressedFiles = ['document.pdf', 'image.jpg', 'data.zip'];
        setCompressedFiles(mockCompressedFiles);
        setIsCompressing(false);
        addSystemMessage('파일 압축이 완료되었습니다.', 'success');
      }, 2000);
    }
  }, [isCompressing, addSystemMessage]);

  // 언어 선택 처리
  const handleLanguageChange = useCallback((language: string) => {
    setSelectedLanguage(language);
    addSystemMessage(`번역 언어가 ${language.toUpperCase()}로 변경되었습니다.`, 'system');
  }, [addSystemMessage]);

  // 화상회의 처리
  const handleVideoCall = useCallback(() => {
    if (!isVideoCallActive) {
      setIsVideoCallActive(true);
      setVideoCallParticipants(['사용자1', '사용자2', '사용자3']);
      addSystemMessage('화상회의가 시작되었습니다.', 'system');
    } else {
      setIsVideoCallActive(false);
      setVideoCallParticipants([]);
      addSystemMessage('화상회의가 종료되었습니다.', 'system');
    }
  }, [isVideoCallActive, addSystemMessage]);

  // 실시간 협업 처리
  const handleCollaboration = useCallback(() => {
    if (!isCollaborating) {
      setIsCollaborating(true);
      setCollaborationUsers(['협업자1', '협업자2']);
      addSystemMessage('실시간 협업이 시작되었습니다.', 'system');
    } else {
      setIsCollaborating(false);
      setCollaborationUsers([]);
      addSystemMessage('실시간 협업이 종료되었습니다.', 'system');
    }
  }, [isCollaborating, addSystemMessage]);

  // AI 이미지 생성 처리
  const handleImageGeneration = useCallback(() => {
    if (!isGeneratingImage && imagePrompt.trim()) {
      setIsGeneratingImage(true);
      setGeneratedImage(null);

      // 이미지 생성 시뮬레이션
      setTimeout(() => {
        const mockImageUrl = 'data:image/svg+xml;base64,';
        setGeneratedImage(mockImageUrl);
        setIsGeneratingImage(false);
        addSystemMessage('AI 이미지 생성이 완료되었습니다.', 'success');
      }, 3000);
    }
  }, [isGeneratingImage, imagePrompt, addSystemMessage]);

  // 이미지 프롬프트 설정
  const handleImagePromptChange = useCallback((prompt: string) => {
    setImagePrompt(prompt);
  }, []);

  // 고급 분석 처리
  const handleAdvancedAnalysis = useCallback(() => {
    if (!isAnalyzing) {
      setIsAnalyzing(true);
      setAnalysisResults(null);

      // 분석 시뮬레이션
      setTimeout(() => {
        const mockResults = {
          sentiment: '긍정적',
          keywords: ['AI', '혁신', '기술'],
          confidence: 0.92,
          recommendations: ['추가 연구 필요', '사용자 피드백 수집']
        };
        setAnalysisResults(mockResults);
        setIsAnalyzing(false);
        addSystemMessage('고급 분석이 완료되었습니다.', 'success');
      }, 2500);
    }
  }, [isAnalyzing, addSystemMessage]);

  // 보안 기능 처리
  const handleSecurityToggle = useCallback(() => {
