      setInputError(true);
      setTimeout(() => setInputError(false), 600);
    }
  }, [inputMessage]);

  // 금지어 감지
  useEffect(() => {
    const detected = bannedWords.filter(word =>
      inputMessage.toLowerCase().includes(word.toLowerCase())
    );
    setBannedWordsDetected(detected);
  }, [inputMessage]);

  // 자동 완성 처리
  useEffect(() => {
    if (inputMessage.length > 0) {
      const suggestions = autoCompleteKeywords.filter(keyword =>
        keyword.toLowerCase().startsWith(inputMessage.toLowerCase())
      );
      setAutoCompleteSuggestions(suggestions);
      setShowAutoComplete(suggestions.length > 0);
