            <button
              onClick={handleAbsoluteKnowledgeToggle}
              className={`p-2 rounded-lg ${isDarkMode ? 'bg-gray-700 hover:bg-gray-600' : 'bg-gray-100 hover:bg-gray-200'} transition ${isAbsoluteKnowledge ? 'bg-blue-500 text-white' : ''}`}
              title="절대 지식"
            >
              📚
