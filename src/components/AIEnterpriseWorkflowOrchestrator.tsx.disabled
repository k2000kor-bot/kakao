// 워크플로우 인터페이스
interface WorkflowStep {
    id: string;
    name: string;
    description: string;
    type: 'task' | 'decision' | 'approval' | 'integration' | 'notification';
    status: 'pending' | 'running' | 'completed' | 'failed' | 'skipped';
    priority: 'low' | 'medium' | 'high' | 'critical';
    assignedTo?: string;
    estimatedDuration: number; // minutes
    actualDuration?: number;
    dependencies: string[];
    conditions?: string[];
    actions: string[];
    startTime?: Date;
    endTime?: Date;
    progress: number;
    errorMessage?: string;
}

interface Workflow {
    id: string;
    name: string;
    description: string;
    version: string;
    status: 'draft' | 'active' | 'paused' | 'archived';
    priority: 'low' | 'medium' | 'high' | 'critical';
    category: 'sales' | 'marketing' | 'hr' | 'finance' | 'operations' | 'customer_service';
    steps: WorkflowStep[];
    triggers: string[];
    conditions: string[];
    estimatedTotalDuration: number;
    actualTotalDuration?: number;
    createdBy: string;
    createdAt: Date;
    updatedAt: Date;
    lastExecuted?: Date;
    executionCount: number;
    successRate: number;
    autoRetry: boolean;
    maxRetries: number;
    currentRetryCount: number;
    notifications: boolean;
    aiOptimization: boolean;
}

interface WorkflowExecution {
    id: string;
    workflowId: string;
    workflowName: string;
    status: 'running' | 'completed' | 'failed' | 'paused';
    startTime: Date;
    endTime?: Date;
    duration?: number;
    currentStep?: string;
    progress: number;
    errorMessage?: string;
    triggeredBy: string;
    triggeredByType: 'manual' | 'scheduled' | 'event' | 'ai';
    context: Record<string, any>;
    metrics: {
        stepsCompleted: number;
        stepsFailed: number;
        stepsSkipped: number;
        averageStepDuration: number;
        totalWaitTime: number;
        efficiency: number;
    };
}

interface AIOptimization {
    id: string;
    workflowId: string;
    type: 'performance' | 'efficiency' | 'resource' | 'cost';
    status: 'analyzing' | 'optimizing' | 'completed' | 'failed';
    recommendations: string[];
    improvements: {
        before: number;
        after: number;
        unit: string;
        percentage: number;
    };
    applied: boolean;
    appliedAt?: Date;
    confidence: number;
}

