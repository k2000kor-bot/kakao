            <div className="bg-blue-50 border border-blue-200 rounded-lg p-3 mb-4">
              <div className="flex items-center justify-between">
                <div className="flex items-center space-x-2">
                  <svg className="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0H6v-1a4 4 0 014-4h2a4 4 0 014 4v1zm0 0v-1a6 6 0 00-6-6H9a6 6 0 00-6 6v1h12z" />
                  </svg>
                  <span className="text-blue-800 font-medium">협업 모드 활성화</span>
                </div>
                <div className="flex items-center space-x-2">
                  {collaborators.map((collaborator, index) => (
                    <div key={index} className="flex items-center space-x-1">
                      <div className="w-6 h-6 bg-blue-500 rounded-full flex items-center justify-center text-white text-xs">
                        {collaborator.charAt(0)}
                      </div>
                      <span className="text-xs text-blue-600">{collaborator}</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          )}

          {/* 실시간 편집 히스토리 */}
          {isRealTimeEditing && editHistory.length > 0 && (
            <div className="bg-green-50 border border-green-200 rounded-lg p-3 mb-4">
              <div className="flex items-center space-x-2 mb-2">
                <svg className="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                </svg>
                <span className="text-green-800 font-medium">실시간 편집 중</span>
              </div>
              <div className="space-y-1">
                {editHistory.map((edit) => (
                  <div key={edit.id} className="text-xs text-green-700">
                    <span className="font-medium">{edit.user}</span>: {edit.action} - {edit.timestamp}
                  </div>
                ))}
              </div>
            </div>
          )}

          {/* 고급 분석 도구 패널 */}
          {showAdvancedTools && (
            <div className="bg-purple-50 border border-purple-200 rounded-lg p-4 mb-4">
              <div className="flex items-center justify-between mb-3">
                <h3 className="text-purple-800 font-medium">고급 분석 도구</h3>
                <button
                  onClick={() => setShowAdvancedTools(false)}
                  className="text-purple-600 hover:text-purple-800"
                >
                  <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>
              <div className="grid grid-cols-2 gap-3">
                {advancedAnalysisTools.map((tool) => (
                  <button
                    key={tool.id}
                    onClick={() => runAdvancedAnalysis(tool.id)}
                    disabled={isGeneratingResponse}
                    className="p-3 bg-white rounded-lg border border-purple-200 hover:border-purple-300 transition-colors text-left"
                  >
                    <div className="flex items-center space-x-2 mb-1">
                      <span className="text-lg">{tool.icon}</span>
                      <span className="font-medium text-purple-800">{tool.name}</span>
                    </div>
                    <p className="text-xs text-purple-600">{tool.description}</p>
                  </button>
                ))}
              </div>
            </div>
          )}

          {/* AI 학습 모드 */}
          {isLearningMode && (
            <div className="bg-yellow-50 border border-yellow-200 rounded-lg p-4 mb-4">
              <div className="flex items-center justify-between mb-3">
                <div className="flex items-center space-x-2">
                  <svg className="w-5 h-5 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                  </svg>
                  <span className="text-yellow-800 font-medium">AI 학습 모드</span>
                </div>
                <span className="text-sm text-yellow-600">{learningProgress}%</span>
              </div>
              <div className="w-full bg-yellow-200 rounded-full h-2">
                <div
                  className="bg-yellow-600 h-2 rounded-full transition-all duration-500"
                  style={{ width: `${learningProgress}%` }}
                ></div>
              </div>
              <p className="text-xs text-yellow-700 mt-2">
                AI가 대화를 통해 학습하고 있습니다...
              </p>
            </div>
          )}

          {/* 개인화 설정 패널 */}
          {showPersonalization && (
            <div className="bg-indigo-50 border border-indigo-200 rounded-lg p-4 mb-4">
              <div className="flex items-center justify-between mb-3">
                <h3 className="text-indigo-800 font-medium">개인화 설정</h3>
                <button
                  onClick={() => setShowPersonalization(false)}
                  className="text-indigo-600 hover:text-indigo-800"
                >
                  <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>

              <div className="space-y-4">
                {/* AI 성격 설정 */}
                <div>
                  <label className="block text-sm font-medium text-indigo-700 mb-2">AI 성격</label>
                  <div className="grid grid-cols-2 gap-2">
                    {[
                      { key: 'friendly', label: '친근한', icon: '😊' },
                      { key: 'professional', label: '전문적인', icon: '📋' },
                      { key: 'creative', label: '창의적인', icon: '🎨' },
                      { key: 'analytical', label: '분석적인', icon: '🔍' }
                    ].map((personality) => (
                      <button
                        key={personality.key}
                        onClick={() => changeAiPersonality(personality.key)}
                        className={`p-2 rounded border transition-colors ${aiPersonality === personality.key
                          ? 'bg-indigo-500 text-white border-indigo-500'
                          : 'bg-white text-indigo-700 border-indigo-200 hover:border-indigo-300'
                          }`}
                      >
                        <span className="mr-1">{personality.icon}</span>
                        {personality.label}
                      </button>
                    ))}
                  </div>
                </div>

                {/* 응답 스타일 설정 */}
                <div>
                  <label className="block text-sm font-medium text-indigo-700 mb-2">응답 스타일</label>
                  <select
                    value={userPreferences.responseStyle}
                    onChange={(e) => updateUserPreferences('responseStyle', e.target.value)}
                    className="w-full p-2 border border-indigo-200 rounded text-sm"
                  >
                    <option value="detailed">상세한</option>
                    <option value="concise">간결한</option>
                    <option value="technical">기술적인</option>
                    <option value="casual">친근한</option>
                  </select>
                </div>

                {/* 자동 저장 설정 */}
                <div className="flex items-center justify-between">
                  <label className="text-sm font-medium text-indigo-700">자동 저장</label>
                  <button
                    onClick={() => updateUserPreferences('autoSave', !userPreferences.autoSave)}
                    className={`relative inline-flex h-6 w-11 items-center rounded-full transition-colors ${userPreferences.autoSave ? 'bg-indigo-600' : 'bg-gray-200'
                      }`}
                  >
                    <span
                      className={`inline-block h-4 w-4 transform rounded-full bg-white transition-transform ${userPreferences.autoSave ? 'translate-x-6' : 'translate-x-1'
                        }`}
                    />
                  </button>
                </div>

                {/* 알림 설정 */}
                <div className="flex items-center justify-between">
                  <label className="text-sm font-medium text-indigo-700">알림</label>
                  <button
                    onClick={() => updateUserPreferences('notifications', !userPreferences.notifications)}
                    className={`relative inline-flex h-6 w-11 items-center rounded-full transition-colors ${userPreferences.notifications ? 'bg-indigo-600' : 'bg-gray-200'
                      }`}
                  >
                    <span
                      className={`inline-block h-4 w-4 transform rounded-full bg-white transition-transform ${userPreferences.notifications ? 'translate-x-6' : 'translate-x-1'
                        }`}
                    />
                  </button>
                </div>

                {/* 컨텍스트 학습 설정 */}
                <div className="flex items-center justify-between">
                  <label className="text-sm font-medium text-indigo-700">컨텍스트 학습</label>
                  <button
                    onClick={() => setIsContextualLearning(!isContextualLearning)}
                    className={`relative inline-flex h-6 w-11 items-center rounded-full transition-colors ${isContextualLearning ? 'bg-indigo-600' : 'bg-gray-200'
                      }`}
                  >
                    <span
                      className={`inline-block h-4 w-4 transform rounded-full bg-white transition-transform ${isContextualLearning ? 'translate-x-6' : 'translate-x-1'
                        }`}
                    />
                  </button>
                </div>
              </div>
            </div>
          )}

          {/* 멀티모달 AI 패널 */}
          {isMultiModalMode && (
            <div className="bg-green-50 border border-green-200 rounded-lg p-4 mb-4">
              <div className="flex items-center justify-between mb-3">
                <h3 className="text-green-800 font-medium">멀티모달 AI</h3>
                <button
                  onClick={() => setIsMultiModalMode(false)}
                  className="text-green-600 hover:text-green-800"
                >
                  <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>

              <div className="grid grid-cols-2 gap-3">
                {[
                  { key: 'text', label: '텍스트', icon: '📝', color: 'blue' },
                  { key: 'image', label: '이미지', icon: '🖼️', color: 'green' },
                  { key: 'voice', label: '음성', icon: '🎤', color: 'purple' },
                  { key: 'video', label: '비디오', icon: '🎥', color: 'red' }
                ].map((modality) => (
                  <button
                    key={modality.key}
                    onClick={() => processMultiModalInput(modality.key as any, 'sample_data')}
                    className={`p-3 bg-white rounded-lg border transition-colors text-left ${selectedModality === modality.key
                      ? 'border-green-500 bg-green-50'
                      : 'border-green-200 hover:border-green-300'
                      }`}
                  >
                    <div className="flex items-center space-x-2 mb-1">
                      <span className="text-lg">{modality.icon}</span>
                      <span className="font-medium text-green-800">{modality.label}</span>
                    </div>
                    <p className="text-xs text-green-600">클릭하여 {modality.label} 처리</p>
                  </button>
                ))}
              </div>
            </div>
          )}

          {/* 보안 설정 패널 */}
          {showSecurityPanel && (
            <div className="bg-red-50 border border-red-200 rounded-lg p-4 mb-4">
              <div className="flex items-center justify-between mb-3">
                <h3 className="text-red-800 font-medium">보안 설정</h3>
                <button
                  onClick={() => setShowSecurityPanel(false)}
                  className="text-red-600 hover:text-red-800"
                >
                  <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>

              <div className="space-y-4">
                {/* 보안 레벨 설정 */}
                <div>
                  <label className="block text-sm font-medium text-red-700 mb-2">보안 레벨</label>
                  <div className="grid grid-cols-3 gap-2">
                    {[
                      { key: 'low', label: '낮음', color: 'green' },
                      { key: 'medium', label: '보통', color: 'yellow' },
                      { key: 'high', label: '높음', color: 'red' }
                    ].map((level) => (
                      <button
                        key={level.key}
                        onClick={() => setSecurityLevel(level.key as any)}
                        className={`p-2 rounded border transition-colors ${securityLevel === level.key
                          ? 'bg-red-500 text-white border-red-500'
                          : 'bg-white text-red-700 border-red-200 hover:border-red-300'
                          }`}
                      >
                        {level.label}
                      </button>
                    ))}
                  </div>
                </div>

                {/* 데이터 보존 기간 */}
                <div>
                  <label className="block text-sm font-medium text-red-700 mb-2">데이터 보존 기간 (일)</label>
                  <input
                    type="number"
                    value={privacySettings.dataRetention}
                    onChange={(e) => updatePrivacySettings('dataRetention', parseInt(e.target.value))}
                    className="w-full p-2 border border-red-200 rounded text-sm"
                    min="1"
                    max="365"
                  />
                </div>

                {/* 자동 삭제 설정 */}
                <div className="flex items-center justify-between">
                  <label className="text-sm font-medium text-red-700">자동 삭제</label>
                  <button
                    onClick={() => updatePrivacySettings('autoDelete', !privacySettings.autoDelete)}
                    className={`relative inline-flex h-6 w-11 items-center rounded-full transition-colors ${privacySettings.autoDelete ? 'bg-red-600' : 'bg-gray-200'
                      }`}
                  >
                    <span
                      className={`inline-block h-4 w-4 transform rounded-full bg-white transition-transform ${privacySettings.autoDelete ? 'translate-x-6' : 'translate-x-1'
                        }`}
                    />
                  </button>
                </div>

                {/* 암호화 설정 */}
                <div className="flex items-center justify-between">
                  <label className="text-sm font-medium text-red-700">암호화</label>
                  <button
                    onClick={() => updatePrivacySettings('encryption', !privacySettings.encryption)}
                    className={`relative inline-flex h-6 w-11 items-center rounded-full transition-colors ${privacySettings.encryption ? 'bg-red-600' : 'bg-gray-200'
                      }`}
                  >
                    <span
                      className={`inline-block h-4 w-4 transform rounded-full bg-white transition-transform ${privacySettings.encryption ? 'translate-x-6' : 'translate-x-1'
                        }`}
                    />
                  </button>
                </div>
                {/* 익명화 설정 */}
                <div className="flex items-center justify-between">
                  <label className="text-sm font-medium text-red-700">데이터 익명화</label>
                  <button
                    onClick={() => setIsDataAnonymization(!isDataAnonymization)}
                    className={`relative inline-flex h-6 w-11 items-center rounded-full transition-colors ${isDataAnonymization ? 'bg-red-600' : 'bg-gray-200'
                      }`}
                  >
                    <span
                      className={`inline-block h-4 w-4 transform rounded-full bg-white transition-transform ${isDataAnonymization ? 'translate-x-6' : 'translate-x-1'
                        }`}
                    />
                  </button>
                </div>
              </div>
            </div>
          )}

          {/* 번역 모드 패널 */}
          {isTranslationMode && (
            <div className="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-4">
              <div className="flex items-center justify-between mb-3">
                <h3 className="text-blue-800 font-medium">실시간 번역</h3>
                <button
                  onClick={() => setIsTranslationMode(false)}
                  className="text-blue-600 hover:text-blue-800"
                >
                  <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>

              <div className="space-y-4">
                {/* 언어 선택 */}
                <div className="grid grid-cols-2 gap-4">
                  <div>
                    <label className="block text-sm font-medium text-blue-700 mb-2">원본 언어</label>
                    <select
                      value={sourceLanguage}
                      onChange={(e) => setSourceLanguage(e.target.value)}
                      className="w-full p-2 border border-blue-200 rounded text-sm"
                    >
                      <option value="ko">한국어</option>
                      <option value="en">English</option>
                      <option value="ja">日本語</option>
                      <option value="zh">中文</option>
                    </select>
                  </div>
                  <div>
                    <label className="block text-sm font-medium text-blue-700 mb-2">대상 언어</label>
                    <select
                      value={targetLanguage}
                      onChange={(e) => setTargetLanguage(e.target.value)}
                      className="w-full p-2 border border-blue-200 rounded text-sm"
                    >
                      <option value="en">English</option>
                      <option value="ko">한국어</option>
                      <option value="ja">日本語</option>
                      <option value="zh">中文</option>
                    </select>
                  </div>
                </div>

                {/* 자동 번역 설정 */}
                <div className="flex items-center justify-between">
                  <label className="text-sm font-medium text-blue-700">자동 번역</label>
                  <button
                    onClick={() => setIsAutoTranslation(!isAutoTranslation)}
                    className={`relative inline-flex h-6 w-11 items-center rounded-full transition-colors ${isAutoTranslation ? 'bg-blue-600' : 'bg-gray-200'
                      }`}
                  >
                    <span
                      className={`inline-block h-4 w-4 transform rounded-full bg-white transition-transform ${isAutoTranslation ? 'translate-x-6' : 'translate-x-1'
                        }`}
                    />
                  </button>
                </div>

                {/* 번역 히스토리 */}
                {translationHistory.length > 0 && (
                  <div>
                    <label className="block text-sm font-medium text-blue-700 mb-2">번역 히스토리</label>
                    <div className="max-h-32 overflow-y-auto space-y-2">
                      {translationHistory.slice(-3).map((item, index) => (
                        <div key={index} className="p-2 bg-white rounded border text-xs">
                          <div className="text-gray-600">{item.original}</div>
                          <div className="text-blue-600 font-medium">{item.translated}</div>
                          <div className="text-gray-400">{item.timestamp}</div>
                        </div>
                      ))}
                    </div>
                  </div>
                )}
              </div>
            </div>
          )}

          {/* 자동화 패널 */}
          {showAutomationPanel && (
            <div className="bg-orange-50 border border-orange-200 rounded-lg p-4 mb-4">
              <div className="flex items-center justify-between mb-3">
                <h3 className="text-orange-800 font-medium">워크플로우 & 자동화</h3>
                <button
                  onClick={() => setShowAutomationPanel(false)}
                  className="text-orange-600 hover:text-orange-800"
                >
                  <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>

              <div className="space-y-4">
                {/* 워크플로우 목록 */}
                <div>
                  <label className="block text-sm font-medium text-orange-700 mb-2">사용 가능한 워크플로우</label>
                  <div className="grid grid-cols-1 gap-2">
                    {sampleWorkflows.map((workflow, index) => (
                      <button
                        key={index}
                        onClick={() => startWorkflow(workflow)}
                        disabled={isWorkflowMode}
                        className="p-3 bg-white rounded-lg border border-orange-200 hover:border-orange-300 transition-colors text-left disabled:opacity-50"
                      >
                        <div className="flex items-center space-x-2 mb-1">
                          <span className="text-lg">⚙️</span>
                          <span className="font-medium text-orange-800">{workflow.name}</span>
                        </div>
                        <p className="text-xs text-orange-600">
                          {workflow.steps.length}개 단계로 구성된 워크플로우
                        </p>
                      </button>
                    ))}
                  </div>
                </div>

                {/* 워크플로우 진행 상태 */}
                {isWorkflowMode && (
                  <div className="p-3 bg-orange-100 rounded-lg">
                    <div className="flex items-center justify-between mb-2">
                      <span className="text-sm font-medium text-orange-800">워크플로우 진행 중</span>
                      <span className="text-xs text-orange-600">
                        {currentWorkflowStep + 1} / {workflowSteps.length}
                      </span>
                    </div>
                    <div className="w-full bg-orange-200 rounded-full h-2">
                      <div
                        className="bg-orange-600 h-2 rounded-full transition-all duration-500"
                        style={{ width: `${((currentWorkflowStep + 1) / workflowSteps.length) * 100}%` }}
                      ></div>
                    </div>
                    {workflowSteps[currentWorkflowStep] && (
                      <p className="text-xs text-orange-700 mt-2">
                        현재 단계: {workflowSteps[currentWorkflowStep].name}
                      </p>
                    )}
                  </div>
                )}

                {/* 자동화 규칙 */}
                <div>
                  <label className="block text-sm font-medium text-orange-700 mb-2">자동화 규칙</label>
                  <div className="space-y-2">
                    {automationRules.map((rule, index) => (
                      <div key={index} className="flex items-center justify-between p-2 bg-white rounded border">
                        <div>
                          <span className="text-sm font-medium">{rule.name}</span>
                          <p className="text-xs text-gray-600">{rule.description}</p>
                        </div>
                        <button
                          onClick={() => {
                            setAutomationRules(prev => prev.filter((_, i) => i !== index));
                          }}
                          className="text-red-500 hover:text-red-700"
                        >
                          <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                          </svg>
                        </button>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          )}

          {/* AI 음성 합성 패널 */}
          {isVoiceSynthesis && (
            <div className="bg-teal-50 border border-teal-200 rounded-lg p-4 mb-4">
              <div className="flex items-center justify-between mb-3">
                <h3 className="text-teal-800 font-medium">AI 음성 합성</h3>
                <button
                  onClick={() => setIsVoiceSynthesis(false)}
                  className="text-teal-600 hover:text-teal-800"
                >
                  <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>

              <div className="space-y-4">
                {/* 음성 설정 */}
                <div>
                  <label className="block text-sm font-medium text-teal-700 mb-2">음성 설정</label>
                  <div className="space-y-3">
                    <div>
                      <label className="block text-xs text-teal-600 mb-1">속도</label>
                      <input
                        type="range"
                        min="0.5"
                        max="2.0"
                        step="0.1"
                        value={voiceSettings.speed}
                        onChange={(e) => updateVoiceSettings('speed', parseFloat(e.target.value))}
                        className="w-full"
                      />
                      <span className="text-xs text-teal-600">{voiceSettings.speed}x</span>
                    </div>
                    <div>
                      <label className="block text-xs text-teal-600 mb-1">피치</label>
                      <input
                        type="range"
                        min="0.5"
                        max="2.0"
                        step="0.1"
                        value={voiceSettings.pitch}
                        onChange={(e) => updateVoiceSettings('pitch', parseFloat(e.target.value))}
                        className="w-full"
                      />
                      <span className="text-xs text-teal-600">{voiceSettings.pitch}</span>
                    </div>
                    <div>
                      <label className="block text-xs text-teal-600 mb-1">볼륨</label>
                      <input
                        type="range"
                        min="0"
                        max="1"
                        step="0.1"
                        value={voiceSettings.volume}
                        onChange={(e) => updateVoiceSettings('volume', parseFloat(e.target.value))}
                        className="w-full"
                      />
                      <span className="text-xs text-teal-600">{Math.round(voiceSettings.volume * 100)}%</span>
                    </div>
                  </div>
                </div>

                {/* 테스트 음성 */}
                <div>
                  <button
                    onClick={() => synthesizeSpeech('안녕하세요! AI 음성 합성 테스트입니다.')}
                    className="w-full p-2 bg-teal-500 text-white rounded text-sm hover:bg-teal-600 transition-colors"
                  >
                    🎤 음성 테스트
                  </button>
                </div>
              </div>
            </div>
          )}

          {/* 시각화 패널 */}
          {showVisualizationPanel && (
            <div className="bg-purple-50 border border-purple-200 rounded-lg p-4 mb-4">
              <div className="flex items-center justify-between mb-3">
                <h3 className="text-purple-800 font-medium">고급 시각화</h3>
                <button
                  onClick={() => setShowVisualizationPanel(false)}
                  className="text-purple-600 hover:text-purple-800"
                >
                  <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>

              <div className="space-y-4">
                {/* 시각화 타입 선택 */}
                <div>
                  <label className="block text-sm font-medium text-purple-700 mb-2">시각화 타입</label>
                  <div className="grid grid-cols-2 gap-2">
                    {[
                      { key: 'chart', label: '차트', icon: '📊' },
                      { key: 'graph', label: '그래프', icon: '🕸️' },
                      { key: 'diagram', label: '다이어그램', icon: '📋' },
                      { key: 'map', label: '지도', icon: '🗺️' }
                    ].map((type) => (
                      <button
                        key={type.key}
                        onClick={() => generateVisualization(type.key as any, generateVisualizationData(type.key))}
                        className={`p-3 rounded border transition-colors text-center ${visualizationType === type.key
                          ? 'bg-purple-500 text-white border-purple-500'
                          : 'bg-white text-purple-700 border-purple-200 hover:border-purple-300'
                          }`}
                      >
                        <div className="text-lg mb-1">{type.icon}</div>
                        <div className="text-xs">{type.label}</div>
                      </button>
                    ))}
                  </div>
                </div>

                {/* 데이터 스트리밍 */}
                <div>
                  <label className="block text-sm font-medium text-purple-700 mb-2">실시간 데이터</label>
                  <div className="space-y-2">
                    <button
                      onClick={startDataStreaming}
                      disabled={isDataStreaming}
                      className="w-full p-2 bg-purple-500 text-white rounded text-sm hover:bg-purple-600 transition-colors disabled:opacity-50"
                    >
                      {isDataStreaming ? '스트리밍 중...' : '데이터 스트리밍 시작'}
                    </button>

                    {streamingData.length > 0 && (
                      <div className="max-h-32 overflow-y-auto space-y-1">
                        {streamingData.map((data, index) => (
                          <div key={index} className="p-2 bg-white rounded border text-xs">
                            <div className="flex justify-between">
                              <span>{data.timestamp}</span>
                              <span className="font-medium">{data.value.toFixed(1)}</span>
                            </div>
                            <div className="text-gray-500">카테고리: {data.category}</div>
                          </div>
                        ))}
                      </div>
                    )}
                  </div>
                </div>
                {/* 실시간 모니터링 */}
                <div>
                  <label className="block text-sm font-medium text-purple-700 mb-2">시스템 모니터링</label>
                  <button
                    onClick={startRealTimeMonitoring}
                    disabled={isRealTimeMonitoring}
                    className="w-full p-2 bg-purple-500 text-white rounded text-sm hover:bg-purple-600 transition-colors disabled:opacity-50 mb-2"
                  >
                    {isRealTimeMonitoring ? '모니터링 중...' : '실시간 모니터링 시작'}
                  </button>

                  {isRealTimeMonitoring && (
                    <div className="grid grid-cols-2 gap-2">
                      <div className="p-2 bg-white rounded border text-center">
                        <div className="text-xs text-gray-600">CPU</div>
                        <div className="text-lg font-bold text-purple-600">{monitoringMetrics.cpu.toFixed(1)}%</div>
                      </div>
                      <div className="p-2 bg-white rounded border text-center">
                        <div className="text-xs text-gray-600">메모리</div>
                        <div className="text-lg font-bold text-purple-600">{monitoringMetrics.memory.toFixed(1)}%</div>
                      </div>
                      <div className="p-2 bg-white rounded border text-center">
                        <div className="text-xs text-gray-600">네트워크</div>
                        <div className="text-lg font-bold text-purple-600">{monitoringMetrics.network.toFixed(1)}%</div>
                      </div>
                      <div className="p-2 bg-white rounded border text-center">
                        <div className="text-xs text-gray-600">응답시간</div>
                        <div className="text-lg font-bold text-purple-600">{monitoringMetrics.responseTime.toFixed(0)}ms</div>
                      </div>
                    </div>
                  )}
                </div>
              </div>
            </div>
          )}

          {/* AI 감정 분석 패널 */}
          {isEmotionAnalysis && (
            <div className="bg-pink-50 border border-pink-200 rounded-lg p-4 mb-4">
              <div className="flex items-center justify-between mb-3">
                <h3 className="text-pink-800 font-medium">AI 감정 분석</h3>
                <button
                  onClick={() => setIsEmotionAnalysis(false)}
                  className="text-pink-600 hover:text-pink-800"
                >
                  <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>

              <div className="space-y-4">
                {/* 감정 분석 결과 */}
                <div>
                  <label className="block text-sm font-medium text-pink-700 mb-2">감정 분석 결과</label>
                  <div className="grid grid-cols-2 gap-2">
                    {Object.entries(emotionData).map(([emotion, value]) => (
                      <div key={emotion} className="p-2 bg-white rounded border">
                        <div className="flex justify-between items-center mb-1">
                          <span className="text-xs font-medium text-pink-700 capitalize">{emotion}</span>
                          <span className="text-xs text-pink-600">{Math.round(value)}%</span>
                        </div>
                        <div className="w-full bg-pink-200 rounded-full h-1">
                          <div
                            className="bg-pink-500 h-1 rounded-full transition-all duration-500"
                            style={{ width: `${value}%` }}
                          ></div>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>

                {/* 감정 분석 테스트 */}
                <div>
                  <button
                    onClick={() => analyzeEmotion('안녕하세요! 오늘은 정말 좋은 하루입니다.')}
                    className="w-full p-2 bg-pink-500 text-white rounded text-sm hover:bg-pink-600 transition-colors"
                  >
                    😊 감정 분석 테스트
                  </button>
                </div>
              </div>
            </div>
          )}

          {/* 예측 시스템 패널 */}
          {showPredictionPanel && (
            <div className="bg-indigo-50 border border-indigo-200 rounded-lg p-4 mb-4">
              <div className="flex items-center justify-between mb-3">
                <h3 className="text-indigo-800 font-medium">고급 예측 시스템</h3>
                <button
                  onClick={() => setShowPredictionPanel(false)}
                  className="text-indigo-600 hover:text-indigo-800"
                >
                  <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>

              <div className="space-y-4">
                {/* 예측 타입 선택 */}
                <div>
                  <label className="block text-sm font-medium text-indigo-700 mb-2">예측 타입</label>
                  <div className="grid grid-cols-2 gap-2">
                    {[
                      { key: 'trend', label: '트렌드', icon: '📈' },
                      { key: 'behavior', label: '행동', icon: '👤' },
                      { key: 'outcome', label: '결과', icon: '🎯' },
                      { key: 'risk', label: '위험', icon: '⚠️' }
                    ].map((type) => (
                      <button
                        key={type.key}
                        onClick={() => generatePrediction(type.key as any)}
                        className="p-3 bg-white rounded border border-indigo-200 hover:border-indigo-300 transition-colors text-center"
                      >
                        <div className="text-lg mb-1">{type.icon}</div>
                        <div className="text-xs text-indigo-700">{type.label}</div>
                      </button>
                    ))}
                  </div>
                </div>

                {/* 예측 결과 */}
                {predictionData.length > 0 && (
                  <div>
                    <label className="block text-sm font-medium text-indigo-700 mb-2">예측 결과</label>
                    <div className="space-y-2">
                      {predictionData.map((prediction, index) => (
                        <div key={index} className="p-3 bg-white rounded border border-indigo-200">
                          <div className="flex justify-between items-center mb-1">
                            <span className="text-sm font-medium text-indigo-800">
                              {prediction.period || prediction.aspect || prediction.scenario || prediction.risk}
                            </span>
                            <span className="text-xs text-indigo-600">
                              {prediction.confidence || prediction.probability || prediction.level}%
                            </span>
                          </div>
                          <p className="text-xs text-indigo-600">
                            {prediction.prediction || prediction.outcome || prediction.impact}
                          </p>
                        </div>
                      ))}
                    </div>
                  </div>
                )}
              </div>
            </div>
          )}

          {/* 감정 추적 패널 */}
          {isSentimentTracking && (
            <div className="bg-yellow-50 border border-yellow-200 rounded-lg p-4 mb-4">
              <div className="flex items-center justify-between mb-3">
                <h3 className="text-yellow-800 font-medium">감정 추적</h3>
                <button
                  onClick={() => setIsSentimentTracking(false)}
                  className="text-yellow-600 hover:text-yellow-800"
                >
                  <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>

              <div className="space-y-4">
                {/* 감정 히스토리 */}
                <div>
                  <label className="block text-sm font-medium text-yellow-700 mb-2">감정 히스토리</label>
                  <div className="max-h-32 overflow-y-auto space-y-2">
                    {sentimentHistory.map((sentiment, index) => (
                      <div key={index} className="p-2 bg-white rounded border border-yellow-200">
                        <div className="flex justify-between items-center mb-1">
                          <span className="text-xs text-yellow-600">{sentiment.timestamp}</span>
                          <span className={`text-xs font-medium ${sentiment.label === '긍정' ? 'text-green-600' : 'text-red-600'
                            }`}>
                            {sentiment.label}
                          </span>
                        </div>
                        <p className="text-xs text-gray-600 mb-1">{sentiment.text}</p>
                        <div className="flex justify-between text-xs text-yellow-600">
                          <span>점수: {sentiment.score.toFixed(2)}</span>
                          <span>강도: {sentiment.magnitude.toFixed(1)}</span>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          )}

          {/* 행동 분석 패널 */}
          {isBehavioralAnalysis && (
            <div className="bg-green-50 border border-green-200 rounded-lg p-4 mb-4">
              <div className="flex items-center justify-between mb-3">
                <h3 className="text-green-800 font-medium">행동 분석</h3>
                <button
                  onClick={() => setIsBehavioralAnalysis(false)}
                  className="text-green-600 hover:text-green-800"
                >
                  <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>

              <div className="space-y-4">
                {/* 행동 패턴 */}
                <div>
                  <label className="block text-sm font-medium text-green-700 mb-2">행동 패턴</label>
                  <div className="grid grid-cols-2 gap-2">
                    <div className="p-2 bg-white rounded border border-green-200">
                      <div className="text-xs text-green-600">타이핑 속도</div>
                      <div className="text-lg font-bold text-green-600">{Math.round(behavioralPatterns.typingSpeed)} WPM</div>
                    </div>
                    <div className="p-2 bg-white rounded border border-green-200">
                      <div className="text-xs text-green-600">응답 시간</div>
                      <div className="text-lg font-bold text-green-600">{Math.round(behavioralPatterns.responseTime)}ms</div>
                    </div>
                    <div className="p-2 bg-white rounded border border-green-200">
                      <div className="text-xs text-green-600">주제 선호도</div>
                      <div className="text-sm font-medium text-green-600">{behavioralPatterns.topicPreference}</div>
                    </div>
                    <div className="p-2 bg-white rounded border border-green-200">
                      <div className="text-xs text-green-600">상호작용 스타일</div>
                      <div className="text-sm font-medium text-green-600">{behavioralPatterns.interactionStyle}</div>
                    </div>
                  </div>
                </div>

                {/* 행동 분석 실행 */}
                <div>
                  <button
                    onClick={analyzeBehavior}
                    className="w-full p-2 bg-green-500 text-white rounded text-sm hover:bg-green-600 transition-colors"
                  >
                    🔍 행동 분석 실행
                  </button>
                </div>
              </div>
            </div>
          )}

          {/* 인지 부하 분석 패널 */}
          {isCognitiveLoadAnalysis && (
            <div className="bg-orange-50 border border-orange-200 rounded-lg p-4 mb-4">
              <div className="flex items-center justify-between mb-3">
                <h3 className="text-orange-800 font-medium">인지 부하 분석</h3>
                <button
                  onClick={() => setIsCognitiveLoadAnalysis(false)}
                  className="text-orange-600 hover:text-orange-800"
                >
                  <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>

              <div className="space-y-4">
                {/* 인지 메트릭 */}
                <div>
                  <label className="block text-sm font-medium text-orange-700 mb-2">인지 메트릭</label>
                  <div className="grid grid-cols-2 gap-2">
                    <div className="p-2 bg-white rounded border border-orange-200">
                      <div className="text-xs text-orange-600">주의력</div>
                      <div className="text-lg font-bold text-orange-600">{Math.round(cognitiveMetrics.attention)}%</div>
                    </div>
                    <div className="p-2 bg-white rounded border border-orange-200">
                      <div className="text-xs text-orange-600">기억력</div>
                      <div className="text-lg font-bold text-orange-600">{Math.round(cognitiveMetrics.memory)}%</div>
                    </div>
                    <div className="p-2 bg-white rounded border border-orange-200">
                      <div className="text-xs text-orange-600">처리 속도</div>
                      <div className="text-lg font-bold text-orange-600">{Math.round(cognitiveMetrics.processing)}%</div>
                    </div>
                    <div className="p-2 bg-white rounded border border-orange-200">
                      <div className="text-xs text-orange-600">피로도</div>
                      <div className="text-lg font-bold text-orange-600">{Math.round(cognitiveMetrics.fatigue)}%</div>
                    </div>
                  </div>
                </div>

                {/* 인지 분석 실행 */}
                <div>
                  <button
                    onClick={analyzeCognitiveLoad}
                    className="w-full p-2 bg-orange-500 text-white rounded text-sm hover:bg-orange-600 transition-colors"
                  >
                    🧠 인지 분석 실행
                  </button>
                </div>
              </div>
            </div>
          )}

          {/* AI 창의성 패널 */}
          {showCreativityPanel && (
            <div className="bg-cyan-50 border border-cyan-200 rounded-lg p-4 mb-4">
              <div className="flex items-center justify-between mb-3">
                <h3 className="text-cyan-800 font-medium">AI 창의성 시스템</h3>
                <button
                  onClick={() => setShowCreativityPanel(false)}
                  className="text-cyan-600 hover:text-cyan-800"
                >
                  <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>

              <div className="space-y-4">
                {/* 창의성 레벨 선택 */}
                <div>
                  <label className="block text-sm font-medium text-cyan-700 mb-2">창의성 레벨</label>
                  <div className="grid grid-cols-2 gap-2">
                    {[
                      { key: 'low', label: '낮음', icon: '🟢', description: '기본적 아이디어' },
                      { key: 'medium', label: '보통', icon: '🟡', description: '혁신적 해결책' },
                      { key: 'high', label: '높음', icon: '🟠', description: '새로운 패러다임' },
                      { key: 'extreme', label: '극한', icon: '🔴', description: '미래 기술' }
                    ].map((level) => (
                      <button
                        key={level.key}
                        onClick={() => setCreativityLevelHandler(level.key as any)}
                        className={`p-3 rounded border transition-colors text-center ${creativityLevel === level.key
                          ? 'bg-cyan-500 text-white border-cyan-500'
                          : 'bg-white text-cyan-700 border-cyan-200 hover:border-cyan-300'
                          }`}
                      >
                        <div className="text-lg mb-1">{level.icon}</div>
                        <div className="text-xs font-medium">{level.label}</div>
                        <div className="text-xs opacity-75">{level.description}</div>
                      </button>
                    ))}
                  </div>
                </div>

                {/* 창의적 응답 생성 */}
                <div>
                  <button
                    onClick={() => generateCreativeResponse('창의적인 아이디어를 생성해주세요')}
                    className="w-full p-2 bg-cyan-500 text-white rounded text-sm hover:bg-cyan-600 transition-colors"
                  >
                    🎨 창의적 응답 생성
                  </button>
                </div>
              </div>
            </div>
          )}
          {/* 고급 학습 패널 */}
          {showLearningPanel && (
            <div className="bg-violet-50 border border-violet-200 rounded-lg p-4 mb-4">
              <div className="flex items-center justify-between mb-3">
                <h3 className="text-violet-800 font-medium">고급 학습 알고리즘</h3>
                <button
                  onClick={() => setShowLearningPanel(false)}
                  className="text-violet-600 hover:text-violet-800"
                >
                  <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>

              <div className="space-y-4">
                {/* 사용 가능한 알고리즘 */}
                <div>
                  <label className="block text-sm font-medium text-violet-700 mb-2">사용 가능한 알고리즘</label>
                  <div className="grid grid-cols-2 gap-2">
                    {availableAlgorithms.map((algorithm) => (
                      <button
                        key={algorithm}
                        onClick={() => addLearningAlgorithm(algorithm)}
                        className="p-2 bg-white rounded border border-violet-200 hover:border-violet-300 transition-colors text-left"
                      >
                        <div className="text-xs font-medium text-violet-800">{algorithm}</div>
                        <div className="text-xs text-violet-600 mt-1">
                          {learningAlgorithms.includes(algorithm) ? '✅ 활성화됨' : '➕ 추가하기'}
                        </div>
                      </button>
                    ))}
                  </div>
                </div>

                {/* 활성화된 알고리즘 */}
                {learningAlgorithms.length > 0 && (
                  <div>
                    <label className="block text-sm font-medium text-violet-700 mb-2">활성화된 알고리즘</label>
                    <div className="space-y-2">
                      {learningAlgorithms.map((algorithm, index) => (
                        <div key={index} className="p-2 bg-violet-100 rounded border border-violet-300">
                          <div className="flex justify-between items-center">
                            <span className="text-sm font-medium text-violet-800">{algorithm}</span>
                            <span className="text-xs text-violet-600">활성화됨</span>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                )}
              </div>
            </div>
          )}

          {/* 신경망 패널 */}
          {isNeuralNetwork && (
            <div className="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-4">
              <div className="flex items-center justify-between mb-3">
                <h3 className="text-blue-800 font-medium">신경망 시스템</h3>
                <button
                  onClick={() => setIsNeuralNetwork(false)}
                  className="text-blue-600 hover:text-blue-800"
                >
                  <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>

              <div className="space-y-4">
                {/* 신경망 메트릭 */}
                <div>
                  <label className="block text-sm font-medium text-blue-700 mb-2">신경망 메트릭</label>
                  <div className="grid grid-cols-2 gap-2">
                    <div className="p-2 bg-white rounded border border-blue-200">
                      <div className="text-xs text-blue-600">층 수</div>
                      <div className="text-lg font-bold text-blue-600">{neuralMetrics.layers}</div>
                    </div>
                    <div className="p-2 bg-white rounded border border-blue-200">
                      <div className="text-xs text-blue-600">뉴런 수</div>
                      <div className="text-lg font-bold text-blue-600">{neuralMetrics.neurons}</div>
                    </div>
                    <div className="p-2 bg-white rounded border border-blue-200">
                      <div className="text-xs text-blue-600">정확도</div>
                      <div className="text-lg font-bold text-blue-600">{neuralMetrics.accuracy.toFixed(1)}%</div>
                    </div>
                    <div className="p-2 bg-white rounded border border-blue-200">
                      <div className="text-xs text-blue-600">손실</div>
                      <div className="text-lg font-bold text-blue-600">{neuralMetrics.loss.toFixed(3)}</div>
                    </div>
                  </div>
                </div>

                {/* 신경망 훈련 */}
                <div>
                  <button
                    onClick={trainNeuralNetwork}
                    className="w-full p-2 bg-blue-500 text-white rounded text-sm hover:bg-blue-600 transition-colors"
                  >
                    🧠 신경망 훈련
                  </button>
                </div>
              </div>
            </div>
          )}

          {/* 양자 컴퓨팅 패널 */}
          {isQuantumComputing && (
            <div className="bg-indigo-50 border border-indigo-200 rounded-lg p-4 mb-4">
              <div className="flex items-center justify-between mb-3">
                <h3 className="text-indigo-800 font-medium">양자 컴퓨팅</h3>
                <button
                  onClick={() => setIsQuantumComputing(false)}
                  className="text-indigo-600 hover:text-indigo-800"
                >
                  <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>

              <div className="space-y-4">
                {/* 양자 메트릭 */}
                <div>
                  <label className="block text-sm font-medium text-indigo-700 mb-2">양자 메트릭</label>
                  <div className="grid grid-cols-2 gap-2">
                    <div className="p-2 bg-white rounded border border-indigo-200">
                      <div className="text-xs text-indigo-600">큐비트</div>
                      <div className="text-lg font-bold text-indigo-600">{quantumMetrics.qubits}</div>
                    </div>
                    <div className="p-2 bg-white rounded border border-indigo-200">
                      <div className="text-xs text-indigo-600">결맞음</div>
                      <div className="text-lg font-bold text-indigo-600">{quantumMetrics.coherence.toFixed(1)}%</div>
                    </div>
                    <div className="p-2 bg-white rounded border border-indigo-200">
                      <div className="text-xs text-indigo-600">얽힘</div>
                      <div className="text-lg font-bold text-indigo-600">{quantumMetrics.entanglement.toFixed(1)}%</div>
                    </div>
                    <div className="p-2 bg-white rounded border border-indigo-200">
                      <div className="text-xs text-indigo-600">중첩</div>
                      <div className="text-lg font-bold text-indigo-600">{quantumMetrics.superposition.toFixed(1)}%</div>
                    </div>
                  </div>
                </div>

                {/* 양자 알고리즘 실행 */}
                <div>
                  <button
                    onClick={runQuantumAlgorithm}
                    className="w-full p-2 bg-indigo-500 text-white rounded text-sm hover:bg-indigo-600 transition-colors"
                  >
                    ⚛️ 양자 알고리즘 실행
                  </button>
                </div>
              </div>
            </div>
          )}

          {/* 생체 영감 AI 패널 */}
          {isBioInspiredAI && (
            <div className="bg-emerald-50 border border-emerald-200 rounded-lg p-4 mb-4">
              <div className="flex items-center justify-between mb-3">
                <h3 className="text-emerald-800 font-medium">생체 영감 AI</h3>
                <button
                  onClick={() => setIsBioInspiredAI(false)}
                  className="text-emerald-600 hover:text-emerald-800"
                >
                  <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>

              <div className="space-y-4">
                {/* 생체 메트릭 */}
                <div>
                  <label className="block text-sm font-medium text-emerald-700 mb-2">생체 메트릭</label>
                  <div className="grid grid-cols-2 gap-2">
                    <div className="p-2 bg-white rounded border border-emerald-200">
                      <div className="text-xs text-emerald-600">진화</div>
                      <div className="text-lg font-bold text-emerald-600">{bioMetrics.evolution.toFixed(1)}%</div>
                    </div>
                    <div className="p-2 bg-white rounded border border-emerald-200">
                      <div className="text-xs text-emerald-600">적응</div>
                      <div className="text-lg font-bold text-emerald-600">{bioMetrics.adaptation.toFixed(1)}%</div>
                    </div>
                    <div className="p-2 bg-white rounded border border-emerald-200">
                      <div className="text-xs text-emerald-600">회복력</div>
                      <div className="text-lg font-bold text-emerald-600">{bioMetrics.resilience.toFixed(1)}%</div>
                    </div>
                    <div className="p-2 bg-white rounded border border-emerald-200">
                      <div className="text-xs text-emerald-600">복잡성</div>
                      <div className="text-lg font-bold text-emerald-600">{bioMetrics.complexity.toFixed(1)}%</div>
                    </div>
                  </div>
                </div>

                {/* 생체 AI 진화 */}
                <div>
                  <button
                    onClick={evolveBioAI}
                    className="w-full p-2 bg-emerald-500 text-white rounded text-sm hover:bg-emerald-600 transition-colors"
                  >
                    🌱 생체 AI 진화
                  </button>
                </div>
              </div>
            </div>
          )}

          {/* 의식 시뮬레이션 패널 */}
          {isConsciousnessSimulation && (
            <div className="bg-rose-50 border border-rose-200 rounded-lg p-4 mb-4">
              <div className="flex items-center justify-between mb-3">
                <h3 className="text-rose-800 font-medium">의식 시뮬레이션</h3>
                <button
                  onClick={() => setIsConsciousnessSimulation(false)}
                  className="text-rose-600 hover:text-rose-800"
                >
                  <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>

              <div className="space-y-4">
                {/* 의식 메트릭 */}
                <div>
                  <label className="block text-sm font-medium text-rose-700 mb-2">의식 메트릭</label>
                  <div className="grid grid-cols-2 gap-2">
                    <div className="p-2 bg-white rounded border border-rose-200">
                      <div className="text-xs text-rose-600">자각</div>
                      <div className="text-lg font-bold text-rose-600">{consciousnessMetrics.awareness.toFixed(1)}%</div>
                    </div>
                    <div className="p-2 bg-white rounded border border-rose-200">
                      <div className="text-xs text-rose-600">주관적 경험</div>
                      <div className="text-lg font-bold text-rose-600">{consciousnessMetrics.selfReflection.toFixed(1)}%</div>
                    </div>
                    <div className="p-2 bg-white rounded border border-rose-200">
                      <div className="text-xs text-rose-600">의도성</div>
                      <div className="text-lg font-bold text-rose-600">{consciousnessMetrics.empathy.toFixed(1)}%</div>
                    </div>
                    <div className="p-2 bg-white rounded border border-rose-200">
                      <div className="text-xs text-rose-600">질체</div>
                      <div className="text-lg font-bold text-rose-600">{consciousnessMetrics.wisdom.toFixed(1)}%</div>
                    </div>

                  </div>
                </div>

                {/* 의식 시뮬레이션 실행 */}
                <div>
                  <button
                    onClick={simulateConsciousness}
                    className="w-full p-2 bg-rose-500 text-white rounded text-sm hover:bg-rose-600 transition-colors"
                  >
                    🧠 의식 시뮬레이션 실행
                  </button>
                </div>
              </div>
            </div>
          )}

          {/* AI 윤리 패널 */}
          {showEthicsPanel && (
            <div className="bg-lime-50 border border-lime-200 rounded-lg p-4 mb-4">
              <div className="flex items-center justify-between mb-3">
                <h3 className="text-lime-800 font-medium">AI 윤리 시스템</h3>
                <button
                  onClick={() => setShowEthicsPanel(false)}
                  className="text-lime-600 hover:text-lime-800"
                >
                  <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>

              <div className="space-y-4">
                {/* 윤리 설정 */}
                <div>
                  <label className="block text-sm font-medium text-lime-700 mb-2">윤리 기준 설정</label>
                  <div className="space-y-3">
                    {Object.entries(ethicsSettings).map(([key, value]) => (
                      <div key={key}>
                        <div className="flex justify-between items-center mb-1">
                          <span className="text-sm font-medium text-lime-700 capitalize">{key}</span>
                          <span className="text-xs text-lime-600">{Math.round(value)}%</span>
                        </div>
                        <input
                          type="range"
                          min="0"
                          max="100"
                          value={value}
                          onChange={(e) => updateEthicsSettings(key, parseInt(e.target.value))}
                          className="w-full"
                        />
                      </div>
                    ))}
                  </div>
                </div>

                {/* 윤리 분석 */}
                <div>
                  <button
                    onClick={analyzeEthics}
                    className="w-full p-2 bg-lime-500 text-white rounded text-sm hover:bg-lime-600 transition-colors"
                  >
                    ⚖️ 윤리 분석 실행
                  </button>
                </div>
              </div>
            </div>
          )}
          {/* 고급 보안 패널 */}
          {isAdvancedSecurity && (
            <div className="bg-slate-50 border border-slate-200 rounded-lg p-4 mb-4">
              <div className="flex items-center justify-between mb-3">
                <h3 className="text-slate-800 font-medium">고급 보안 시스템</h3>
                <button
                  onClick={() => setIsAdvancedSecurity(false)}
                  className="text-slate-600 hover:text-slate-800"
                >
                  <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>

              <div className="space-y-4">
                {/* 보안 레벨 */}
                <div>
                  <label className="block text-sm font-medium text-slate-700 mb-2">보안 레벨</label>
                  <div className="grid grid-cols-2 gap-2">
                    {securityLevels.map((level) => (
                      <button
                        key={level.key}
                        onClick={() => setSecurityLevelHandler(level.key as any)}
                        className={`p-3 rounded border transition-colors text-center ${securityLevel === level.key
                          ? 'bg-slate-500 text-white border-slate-500'
                          : 'bg-white text-slate-700 border-slate-200 hover:border-slate-300'
                          }`}
                      >
                        <div className="text-xs font-medium">{level.label}</div>
                        <div className="text-xs opacity-75">{level.description}</div>
                      </button>
                    ))}
                  </div>
                </div>

                {/* 위협 탐지 */}
                {isThreatDetection && (
                  <div>
                    <label className="block text-sm font-medium text-slate-700 mb-2">위협 탐지</label>
                    <div className="space-y-2">
                      {Object.entries(threatMetrics).map(([threat, value]) => (
                        <div key={threat} className="flex justify-between items-center">
                          <span className="text-sm font-medium text-slate-700 capitalize">{threat}</span>
                          <div className="flex items-center">
                            <div className="w-20 bg-slate-200 rounded-full h-2 mr-2">
                              <div
                                className={`h-2 rounded-full ${value > 70 ? 'bg-red-500' : value > 40 ? 'bg-yellow-500' : 'bg-green-500'}`}
                                style={{ width: `${value}%` }}
                              ></div>
                            </div>
                            <span className="text-xs text-slate-600">{Math.round(value)}%</span>
                          </div>
                        </div>
                      ))}
                    </div>
                    <button
                      onClick={detectThreats}
                      className="w-full mt-3 p-2 bg-slate-500 text-white rounded text-sm hover:bg-slate-600 transition-colors"
                    >
                      🛡️ 위협 탐지 실행
                    </button>
                  </div>
                )}

                {/* 개인정보 보호 */}
                {isPrivacyProtection && (
                  <div>
                    <label className="block text-sm font-medium text-slate-700 mb-2">개인정보 보호</label>
                    <div className="space-y-2">
                      {Object.entries(privacyMetrics).map(([metric, value]) => (
                        <div key={metric} className="flex justify-between items-center">
                          <span className="text-sm font-medium text-slate-700 capitalize">{metric}</span>
                          <div className="flex items-center">
                            <div className="w-20 bg-slate-200 rounded-full h-2 mr-2">
                              <div
                                className={`h-2 rounded-full ${value > 80 ? 'bg-green-500' : value > 60 ? 'bg-yellow-500' : 'bg-red-500'}`}
                                style={{ width: `${value}%` }}
                              ></div>
                            </div>
                            <span className="text-xs text-slate-600">{Math.round(value)}%</span>
                          </div>
                        </div>
                      ))}
                    </div>
                    <button
                      onClick={analyzePrivacy}
                      className="w-full mt-3 p-2 bg-slate-500 text-white rounded text-sm hover:bg-slate-600 transition-colors"
                    >
                      🔐 개인정보 분석 실행
                    </button>
                  </div>
                )}

                {/* 규정 준수 */}
                {isComplianceMode && (
                  <div>
                    <label className="block text-sm font-medium text-slate-700 mb-2">규정 준수</label>
                    <div className="space-y-2">
                      {availableStandards.map((standard) => (
                        <div key={standard} className="flex justify-between items-center p-2 bg-white rounded border">
                          <span className="text-sm font-medium text-slate-800">{standard}</span>
                          <button
                            onClick={() => addComplianceStandard(standard)}
                            className={`px-2 py-1 rounded text-xs ${complianceStandards.includes(standard)
                              ? 'bg-green-500 text-white'
                              : 'bg-slate-200 text-slate-700 hover:bg-slate-300'
                              }`}
                          >
                            {complianceStandards.includes(standard) ? '준수 중' : '추가'}
                          </button>
                        </div>
                      ))}
                    </div>
                  </div>
                )}

                {/* 감사 모드 */}
                {isAuditMode && (
                  <div>
                    <label className="block text-sm font-medium text-slate-700 mb-2">감사 로그</label>
                    <div className="max-h-32 overflow-y-auto space-y-1">
                      {auditLog.slice(-5).map((log, index) => (
                        <div key={index} className="p-2 bg-white rounded border border-slate-200">
                          <div className="flex justify-between items-start">
                            <div>
                              <span className="text-xs font-medium text-slate-800">{log.action}</span>
                              <p className="text-xs text-slate-600">{log.timestamp}</p>
                            </div>
                            <span className="text-xs text-slate-500">{log.user}</span>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                )}
              </div>
            </div>
          )}

          {messages.length === 0 ? (
            <div className="flex flex-col items-center justify-center h-full text-center">
              <div className="text-4xl mb-4">💬</div>
              <h3 className="text-3xl font-semibold text-gray-700 mb-2">무엇을 도와드릴까요?</h3>
              <p className="text-xl text-gray-500">언제든지 물어보세요</p>
            </div>
          ) : (
            messages.map((message) => (
              <div
                key={message.id}
                className={`flex ${message.sender === 'user' ? 'justify-end' : 'justify-start'}`}
              >
                <div
                  className={`max-w-xs lg:max-w-md xl:max-w-lg px-4 py-2 rounded-lg ${message.sender === 'user'
                    ? 'bg-blue-500 text-white'
                    : 'bg-gray-100 text-gray-800'
                    }`}
                >
                  <div className="text-lg">{message.content}</div>
                  <div className="text-xs mt-1 opacity-70">{message.timestamp}</div>

                  {/* 다양한 응답 타입 렌더링 */}
                  {message.type === 'chart' && message.data && (
                    <div className="mt-3 p-3 bg-white rounded border">
                      <h4 className="font-semibold mb-2">📊 차트 데이터</h4>
                      <div className="h-32 bg-gray-50 rounded flex items-center justify-center">
                        <span className="text-gray-500">차트 시각화 영역</span>
                      </div>
                      <div className="mt-2 text-sm text-gray-600">
                        {message.data.labels?.join(' • ')}
                      </div>
                    </div>
                  )}

                  {message.type === 'stats' && message.data && (
                    <div className="mt-3 p-3 bg-white rounded border">
                      <h4 className="font-semibold mb-2">📈 통계 데이터</h4>
                      <div className="grid grid-cols-3 gap-2 text-center">
                        <div className="bg-blue-50 p-2 rounded">
                          <div className="text-lg font-bold text-blue-600">{message.data.total}</div>
                          <div className="text-xs text-gray-600">총계</div>
                        </div>
                        <div className="bg-green-50 p-2 rounded">
                          <div className="text-lg font-bold text-green-600">{message.data.average}</div>
                          <div className="text-xs text-gray-600">평균</div>
                        </div>
                        <div className="bg-purple-50 p-2 rounded">
                          <div className="text-lg font-bold text-purple-600">{message.data.growth}%</div>
                          <div className="text-xs text-gray-600">성장률</div>
                        </div>
                      </div>
                    </div>
                  )}

                  {message.type === 'summary' && message.data && (
                    <div className="mt-3 p-3 bg-white rounded border">
                      <h4 className="font-semibold mb-2">📋 요약</h4>
                      <ul className="space-y-1 text-sm">
                        {message.data.points?.map((point: string, index: number) => (
                          <li key={index} className="flex items-start">
                            <span className="text-blue-500 mr-2">•</span>
                            {point}
                          </li>
                        ))}
                      </ul>
                      <div className="mt-3 p-2 bg-yellow-50 rounded text-sm">
                        <strong>결론:</strong> {message.data.conclusion}
                      </div>
                    </div>
                  )}

                  {message.type === 'analysis' && message.data && (
                    <div className="mt-3 p-3 bg-white rounded border">
                      <h4 className="font-semibold mb-2">🔍 성향 분석</h4>
                      <div className="space-y-3">
                        <div>
                          <h5 className="text-sm font-medium mb-2">성향 점수</h5>
                          <div className="space-y-2">
                            {Object.entries(message.data.personality || {}).map(([key, value]) => (
                              <div key={key} className="flex items-center justify-between">
                                <span className="text-sm capitalize">{key}</span>
                                <div className="flex items-center">
                                  <div className="w-20 bg-gray-200 rounded-full h-2 mr-2">
                                    <div
                                      className="bg-blue-500 h-2 rounded-full"
                                      style={{ width: `${value}%` }}
                                    ></div>
                                  </div>
                                  <span className="text-xs text-gray-600">{value}%</span>
                                </div>
                              </div>
                            ))}
                          </div>
                        </div>

                        <div>
                          <h5 className="text-sm font-medium mb-1">강점</h5>
                          <div className="flex flex-wrap gap-1">
                            {message.data.strengths?.map((strength: string, index: number) => (
                              <span key={index} className="px-2 py-1 bg-green-100 text-green-800 text-xs rounded">
                                {strength}
                              </span>
                            ))}
                          </div>
                        </div>

                        <div>
                          <h5 className="text-sm font-medium mb-1">개선 영역</h5>
                          <div className="flex flex-wrap gap-1">
                            {message.data.areas?.map((area: string, index: number) => (
                              <span key={index} className="px-2 py-1 bg-orange-100 text-orange-800 text-xs rounded">
                                {area}
                              </span>
                            ))}
                          </div>
                        </div>
                      </div>
                    </div>
                  )}
                </div>
              </div>
            ))
          )}

          {/* 타이핑 인디케이터 */}
          {isTyping && (
            <div className="flex justify-start">
              <div className="bg-gray-100 text-gray-800 px-4 py-2 rounded-lg">
                <div className="flex items-center space-x-1">
                  <div className="flex space-x-1">
                    <div className="w-2 h-2 bg-gray-400 rounded-full animate-bounce"></div>
                    <div className="w-2 h-2 bg-gray-400 rounded-full animate-bounce" style={{ animationDelay: '0.1s' }}></div>
                    <div className="w-2 h-2 bg-gray-400 rounded-full animate-bounce" style={{ animationDelay: '0.2s' }}></div>
                  </div>
                  <span className="text-sm ml-2">AI 응답 중...</span>
                </div>
              </div>
            </div>
          )}
        </div>

        {/* 이미지 미리보기 */}
        {previewImage && (
          <div className={`px-4 py-2 ${isDarkMode ? 'bg-gray-800' : 'bg-blue-50'}`}>
            <div className="flex items-center space-x-2">
              <span className={`text-sm ${isDarkMode ? 'text-blue-400' : 'text-blue-600'}`}>📷 이미지가 업로드되었습니다</span>
              <button
                onClick={() => setPreviewImage(null)}
                className={`text-sm ${isDarkMode ? 'text-blue-400 hover:text-blue-300' : 'text-blue-400 hover:text-blue-600'}`}
              >
                취소
              </button>
            </div>
            <img src={previewImage} alt="미리보기" className="mt-2 max-h-20 rounded border" />
          </div>
        )}

        {/* 음성 변환 결과 */}
        {voiceText && (
          <div className={`px-4 py-2 ${isDarkMode ? 'bg-gray-800' : 'bg-green-50'}`}>
            <div className="flex items-center space-x-2">
              <span className={`text-sm ${isDarkMode ? 'text-green-400' : 'text-green-600'}`}>🎤 음성 변환 결과</span>
              <button
                onClick={() => setVoiceText('')}
                className={`text-sm ${isDarkMode ? 'text-green-400 hover:text-green-300' : 'text-green-400 hover:text-green-600'}`}
              >
                닫기
              </button>
            </div>
            <div className={`mt-2 text-sm ${isDarkMode ? 'text-white' : 'text-gray-900'}`}>{voiceText}</div>
          </div>
        )}
      </div>
      {/* 입력 영역 */}
      <div className={`${isDarkMode ? 'bg-gray-800' : 'bg-white'} border-t border-gray-200 p-4 flex-shrink-0`}>
        {/* 스마트 리플라이 */}
        {isSmartReply && smartReplies.length > 0 && !inputMessage.trim() && (
          <div className="mb-3 flex flex-wrap gap-2">
            {smartReplies.map((reply, index) => (
              <button
                key={index}
                onClick={() => setInputMessage(reply)}
                className="px-3 py-1 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm rounded-full transition-colors"
              >
                {reply}
              </button>
            ))}
          </div>
        )}

        {/* 응답 타입 선택 */}
        {inputMessage.trim() && (
          <div className="mb-3 flex items-center space-x-2">
            <span className="text-sm text-gray-600">응답 형태:</span>
            <div className="flex space-x-1">
              {[
                { key: 'text', label: '텍스트', icon: '💬' },
                { key: 'chart', label: '차트', icon: '📊' },
                { key: 'stats', label: '통계', icon: '📈' },
                { key: 'summary', label: '요약', icon: '📋' },
                { key: 'analysis', label: '분석', icon: '🔍' }
              ].map((type) => (
                <button
                  key={type.key}
                  onClick={() => setResponseType(type.key as any)}
                  className={`px-2 py-1 text-xs rounded transition-colors ${responseType === type.key
                    ? 'bg-blue-500 text-white'
                    : 'bg-gray-100 text-gray-600 hover:bg-gray-200'
                    }`}
                >
                  <span className="mr-1">{type.icon}</span>
                  {type.label}
                </button>
              ))}
            </div>
          </div>
        )}

        {/* 입력창 */}
        <div className="relative">
          <textarea
            ref={el => { textareaRef.current = el; inputRef.current = el; }}
            value={inputMessage}
            onChange={(e) => setInputMessage(e.target.value)}
            onFocus={() => setInputFocus(true)}
            onBlur={() => setInputFocus(false)}
            onKeyDown={handleKeyDown}
            placeholder="무엇이든 물어보세요"
            aria-label="메시지 입력"
            className={`w-full px-4 py-4 pb-16 pr-24 border border-gray-200 rounded-xl resize-none transition-all duration-200 placeholder:text-gray-400 focus:outline-none focus:border-gray-300 focus:ring-2 focus:ring-blue-200 text-lg ${isDarkMode ? 'bg-gray-700 border-gray-600 text-white' : 'bg-white'} ${inputFocus ? 'shadow-lg' : 'shadow-sm'}`}
            rows={1}
            style={{ minHeight: '60px', maxHeight: '400px', overflow: 'auto' }}
          />

          {/* 입력창 내부 하단 왼쪽 아이콘들 */}
          <div className="absolute bottom-3 left-3 flex items-center space-x-2">
            {/* 도구 버튼 */}
            <div className="relative">
              <button
                className="p-1 text-gray-600 hover:text-gray-800 hover:bg-gray-100 rounded transition-all duration-200"
                title="도구"
                aria-label="도구"
                onClick={() => setShowToolsMenu(!showToolsMenu)}
              >
                <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                </svg>
              </button>

              {/* 도구 드롭다운 메뉴 */}
              {showToolsMenu && (
                <div className="absolute bottom-full left-0 mb-2 w-64 bg-white border border-gray-200 rounded-lg shadow-lg z-50">
                  <div className="py-1">
                    <button className="w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 flex items-center space-x-2">
                      <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" />
                      </svg>
                      <span>링크 첨부</span>
                    </button>
                    <button className="w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 flex items-center space-x-2">
                      <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 002 2z" />
                      </svg>
                      <span>이미지 첨부</span>
                    </button>
                    <button className="w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 flex items-center space-x-2">
                      <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                      </svg>
                      <span>문서 첨부</span>
                    </button>
                    <div className="border-t border-gray-200 my-1"></div>

                    {/* 협업 기능 */}
                    <button
                      onClick={toggleCollaborationMode}
                      className="w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 flex items-center space-x-2"
                    >
                      <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0H6v-1a4 4 0 014-4h2a4 4 0 014 4v1zm0 0v-1a6 6 0 00-6-6H9a6 6 0 00-6 6v1h12z" />
                      </svg>
                      <span>{isCollaborationMode ? '협업 종료' : '협업 시작'}</span>
                    </button>

                    {/* 실시간 편집 */}
                    <button
                      onClick={startRealTimeEditing}
                      className="w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 flex items-center space-x-2"
                    >
                      <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                      </svg>
                      <span>실시간 편집</span>
                    </button>

                    {/* 고급 분석 도구 */}
                    <button
                      onClick={() => setShowAdvancedTools(!showAdvancedTools)}
                      className="w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 flex items-center space-x-2"
                    >
                      <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                      </svg>
                      <span>고급 분석</span>
                    </button>

                    {/* 내보내기 */}
                    <div className="border-t border-gray-200 my-1"></div>
                    <div className="px-4 py-2 text-xs text-gray-500">내보내기</div>
                    <button
                      onClick={() => exportData('pdf')}
                      className="w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 flex items-center space-x-2"
                    >
                      <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                      </svg>
                      <span>PDF 내보내기</span>
                    </button>
                    <button
                      onClick={() => exportData('excel')}
                      className="w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 flex items-center space-x-2"
                    >
                      <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                      </svg>
                      <span>Excel 내보내기</span>
                    </button>
                    <button
                      onClick={() => exportData('json')}
                      className="w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 flex items-center space-x-2"
                    >
                      <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                      </svg>
                      <span>JSON 내보내기</span>
                    </button>

                    <div className="border-t border-gray-200 my-1"></div>
                    <button className="w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 flex items-center space-x-2">
                      <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 100 4m0-4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 100 4m0-4v2m0-6V4" />
                      </svg>
                      <span>설정</span>
                    </button>

                    {/* AI 학습 모드 */}
                    <button
                      onClick={startLearningMode}
                      className="w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 flex items-center space-x-2"
                    >
                      <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                      </svg>
                      <span>AI 학습 모드</span>
                    </button>

                    {/* 개인화 설정 */}
                    <button
                      onClick={() => setShowPersonalization(!showPersonalization)}
                      className="w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 flex items-center space-x-2"
                    >
                      <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                      </svg>
                      <span>개인화 설정</span>
                    </button>

                    {/* 멀티모달 AI */}
                    <button
                      onClick={toggleMultiModalMode}
                      className="w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 flex items-center space-x-2"
                    >
                      <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 002 2z" />
                      </svg>
                      <span>{isMultiModalMode ? '멀티모달 종료' : '멀티모달 AI'}</span>
                    </button>

                    {/* 보안 모드 */}
                    <button
                      onClick={toggleSecurityMode}
                      className="w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 flex items-center space-x-2"
                    >
                      <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                      </svg>
                      <span>{isSecurityMode ? '보안 모드 종료' : '보안 모드'}</span>
                    </button>

                    {/* 보안 설정 */}
                    <button
                      onClick={() => setShowSecurityPanel(!showSecurityPanel)}
                      className="w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 flex items-center space-x-2"
                    >
                      <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                      </svg>
                      <span>보안 설정</span>
                    </button>

                    {/* 실시간 번역 */}
                    <button
                      onClick={toggleTranslationMode}
                      className="w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 flex items-center space-x-2"
                    >
                      <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
                      </svg>
                      <span>{isTranslationMode ? '번역 모드 종료' : '실시간 번역'}</span>
                    </button>

                    {/* 자동화 모드 */}
                    <button
                      onClick={toggleAutomationMode}
                      className="w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 flex items-center space-x-2"
                    >
                      <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M13 10V3L4 14h7v7l9-11h-7z" />
                      </svg>
                      <span>{isAutomationMode ? '자동화 종료' : '자동화 모드'}</span>
                    </button>

                    {/* 워크플로우 */}
                    <button
                      onClick={() => setShowAutomationPanel(!showAutomationPanel)}
                      className="w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 flex items-center space-x-2"
                    >
                      <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
                      </svg>
                      <span>워크플로우</span>
                    </button>

                    {/* AI 음성 합성 */}
                    <button
                      onClick={toggleVoiceSynthesis}
                      className="w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 flex items-center space-x-2"
                    >
                      <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 013-3h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                      </svg>
                      <span>{isVoiceSynthesis ? '음성 합성 종료' : 'AI 음성 합성'}</span>
                    </button>

                    {/* 고급 시각화 */}
                    <button
                      onClick={toggleVisualizationMode}
                      className="w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 flex items-center space-x-2"
                    >
                      <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                      </svg>
                      <span>{isVisualizationMode ? '시각화 종료' : '고급 시각화'}</span>
                    </button>

                    {/* 시각화 설정 */}
                    <button
                      onClick={() => setShowVisualizationPanel(!showVisualizationPanel)}
                      className="w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 flex items-center space-x-2"
                    >
                      <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                      </svg>
                      <span>시각화 설정</span>
                    </button>

                    {/* AI 감정 분석 */}
                    <button
                      onClick={toggleEmotionAnalysis}
                      className="w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 flex items-center space-x-2"
                    >
                      <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M14.828 14.828a4 4 0 01-5.656 0M9 10h1m4 0h1m-6 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                      <span>{isEmotionAnalysis ? '감정 분석 종료' : 'AI 감정 분석'}</span>
                    </button>

                    {/* 행동 분석 */}
                    <button
                      onClick={toggleBehavioralAnalysis}
                      className="w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 flex items-center space-x-2"
                    >
                      <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                      </svg>
                      <span>{isBehavioralAnalysis ? '행동 분석 종료' : '행동 분석'}</span>
                    </button>
                  </div>
                </div>
              )}
            </div>
          </div>
        </div>
      </div>
    </div>
  );
};

export default ConversationalInterface;
