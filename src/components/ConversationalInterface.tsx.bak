<div>
  <label className="block text-sm font-medium text-gray-700 mb-2">보안 레벨</label>
  <div className="grid grid-cols-4 gap-2">
    {securityLevels.map((level) => (
      <button
        key={level.key}
        onClick={() => setSecurityLevelHandler(level.key as any)}
        className={`p-2 rounded border transition-colors ${securityLevel === level.key
          ? 'bg-blue-500 text-white border-blue-500'
          : 'bg-white text-gray-700 border-gray-300 hover:border-blue-300'
          }`}
      >
        <div className="text-xs font-medium">{level.label}</div>
        <div className="text-xs text-gray-500">{level.description}</div>
      </button>
    ))}
  </div>
</div>

{/* 위협 탐지 */ }
<button
  onClick={toggleThreatDetection}
  className="w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 flex items-center space-x-2"
>
  <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
  </svg>
  <span>{isThreatDetection ? '위협 탐지 종료' : '위협 탐지'}</span>
</button>

{/* 위협 분석 */ }
<div>
  <label className="block text-sm font-medium text-gray-700 mb-2">위협 분석</label>
  <div className="space-y-2">
    {Object.entries(threatMetrics).map(([threat, value]) => (
      <div key={threat} className="flex justify-between items-center">
        <span className="text-sm font-medium">{threat}</span>
        <div className="flex items-center">
          <div className="w-20 bg-gray-200 rounded-full h-2 mr-2">
            <div
              className="bg-red-500 h-2 rounded-full"
              style={{ width: `${value}%` }}
            ></div>
          </div>
          <span className="text-xs text-gray-600">{value}%</span>
        </div>
      </div>
    ))}
  </div>
</div>

