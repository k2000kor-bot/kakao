        <button
          onClick={() => setAdvancedAnalysisEngine(prev => ({ ...prev, isActive: false }))}
          className="text-teal-600 hover:text-teal-800"
        >
          ✕
        </button>
      </div>

      <div className="space-y-4">
        {/* 분석 설정 */}
        <div className="flex space-x-2">
          <select
            value={advancedAnalysisEngine.analysisType}
            onChange={(e) => setAdvancedAnalysisEngine(prev => ({ ...prev, analysisType: e.target.value as any }))}
            className="flex-1 bg-white border border-teal-200 rounded px-3 py-2 text-sm"
          >
            <option value="comprehensive">종합 분석</option>
            <option value="predictive">예측 분석</option>
            <option value="behavioral">행동 분석</option>
            <option value="cognitive">인지 분석</option>
          </select>
          <select
            value={advancedAnalysisEngine.analysisDepth}
            onChange={(e) => setAdvancedAnalysisEngine(prev => ({ ...prev, analysisDepth: e.target.value as any }))}
            className="flex-1 bg-white border border-teal-200 rounded px-3 py-2 text-sm"
          >
            <option value="shallow">표면 분석</option>
            <option value="medium">중간 분석</option>
            <option value="deep">심층 분석</option>
            <option value="expert">전문가 분석</option>
          </select>
        </div>

        {/* 분석 결과 */}
        {Object.keys(advancedAnalysisEngine.analysisResults).length > 0 && (
          <div>
            <h4 className="text-sm font-medium text-teal-700 mb-2">분석 결과</h4>
            <div className="grid grid-cols-2 gap-3">
              {Object.entries(advancedAnalysisEngine.analysisResults).map(([key, value]) => (
                <div key={key} className="bg-white rounded p-3">
                  <div className="flex justify-between items-center mb-1">
                    <span className="text-xs text-teal-700 capitalize">{key}</span>
                    <span className="text-xs font-medium text-teal-800">{value.toFixed(1)}%</span>
                  </div>
                  <div className="w-full bg-teal-100 rounded-full h-2">
                    <div
                      className="bg-teal-500 h-2 rounded-full transition-all duration-300"
                      style={{ width: `${value}%` }}
                    />
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        {/* 분석 실행 버튼 */}
        <div className="flex space-x-2">
          <button
            onClick={() => runAdvancedAnalysis('comprehensive')}
            className="flex-1 bg-teal-500 text-white py-2 px-4 rounded-lg hover:bg-teal-600 transition-colors"
          >
            종합 분석 실행
          </button>
          <button
            onClick={() => runAdvancedAnalysis('predictive')}
            className="flex-1 bg-teal-600 text-white py-2 px-4 rounded-lg hover:bg-teal-700 transition-colors"
          >
            예측 분석 실행
          </button>
        </div>
      </div>
    </div>
  )
}

{/* AI 성능 최적화 패널 */ }
