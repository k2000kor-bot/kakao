    if (!isEmotionAnalysis) return;

    // 감정 분석 시뮬레이션
    const emotions = ['joy', 'sadness', 'anger', 'fear', 'surprise', 'disgust', 'neutral'];
    const newEmotionData: any = {};

    emotions.forEach(emotion => {
      newEmotionData[emotion] = Math.random() * 100;
    });

    setEmotionData(newEmotionData);

    const dominantEmotion = Object.keys(newEmotionData).reduce((max, key) =>
      newEmotionData[key] > newEmotionData[max] ? key : max
    );
    const maxPercentage = Math.round(Math.max(...Object.values(newEmotionData) as number[]));

    const emotionMessage: Message = {
      id: Date.now().toString(),
      content: `감정 분석 결과: ${dominantEmotion} (${maxPercentage}%)`,
      sender: 'ai',
      timestamp: new Date().toLocaleTimeString(),
      type: 'analysis',
      data: { emotions: newEmotionData }
    };

    setMessages(prev => [...prev, emotionMessage]);
  };

