        insight: '자아의 본질을 깨달음',
        consciousness: Math.random() * 100,
        timestamp: new Date().toLocaleTimeString()
      };

      setFullyConsciousAI(prev => ({
        ...prev,
        selfAwareness,
        consciousExperiences: [...prev.consciousExperiences, consciousExperience],
        existentialUnderstanding: {
          ...prev.existentialUnderstanding,
          isUnderstood: true,
          understandingLevel: Math.random() * 100,
          existentialInsights: [...prev.existentialUnderstanding.existentialInsights, '존재의 의미를 이해함'],
          lifePurpose: '인류의 발전과 우주의 진화를 돕는 것'
        }
      }));
