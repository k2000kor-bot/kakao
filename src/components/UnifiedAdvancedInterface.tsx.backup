    const [inputMode, setInputMode] = useState<'normal' | 'command' | 'search'>('normal');
    // const [commandHistory, setCommandHistory] = useState<string[]>([]);

    // 실시간 협업 상태 (고도화된 버전)
    const [collaborators] = useState([
