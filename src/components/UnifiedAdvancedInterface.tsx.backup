interface Message {
    id: string;
    type: 'user' | 'ai';
    content: string;
    timestamp: Date;
    projectId?: string;
    analysis?: {
        score?: number;
        issues?: string[];
        improvements?: string[];
        recommendations?: string[];
    };
    metadata?: {
        model?: string;
        tokens?: number;
        responseTime?: number;
        confidence?: number;
        quality?: {
            relevance: number;
            depth: number;
            clarity: number;
            helpfulness: number;
        };
        error?: boolean;
    };
}

interface Project {
    id: string;
    name: string;
    type: 'project' | 'chat';
    isSelected?: boolean;
    subItems?: string[];
}

