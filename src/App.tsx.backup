    const file = event.target.files?.[0];
    if (file) {
      setIsImageAnalyzing(true);
      const reader = new FileReader();
      reader.onload = () => {
        // 이미지 분석 API 호출
        console.log('이미지 분석 시작:', file.name);
        setTimeout(() => {
          setIsImageAnalyzing(false);
          setAnalysisResults({
            type: 'image',
            filename: file.name,
            analysis: '이미지 분석이 완료되었습니다.'
          });
        }, 2000);
      };
      reader.readAsDataURL(file);
    }
  };

