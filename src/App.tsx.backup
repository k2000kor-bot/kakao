import React, { useState } from 'react';
import './App.css';
import VoiceIntegrationTest from './components/VoiceIntegrationTest';
import ProjectRouter from './components/ProjectRouter';

// 프로젝트 관련 타입 정의
interface Project {
  id: string;
  name: string;
  description: string;
  createdAt: string;
  lastActivity: string;
  messageCount: number;
  files: ProjectFile[];
  guidelines: ProjectGuideline[];
  settings: ProjectSettings;
  archived: boolean;
}

interface ProjectFile {
  id: string;
  name: string;
  type: 'document' | 'image' | 'video' | 'audio' | 'spreadsheet' | 'presentation';
  size: number;
  uploadedAt: string;
  url: string;
  description?: string;
}

interface ProjectGuideline {
  id: string;
  title: string;
  content: string;
  type: 'basic' | 'technical' | 'process' | 'reference';
  createdAt: string;
  priority: 'low' | 'medium' | 'high';
}

interface ProjectSettings {
  theme: 'light' | 'dark' | 'auto';
  language: string;
  aiModel: string;
  autoSave: boolean;
  collaboration: boolean;
}

// 채팅 관련 타입 정의
interface Chat {
  id: string;
  projectId: string;
  title: string;
  description: string;
  messages: ChatMessage[];
  createdAt: string;
  updatedAt: string;
  isActive: boolean;
  status: 'active' | 'archived' | 'completed';
  tags: string[];
  participants: string[];
}

interface ChatMessage {
  id: string;
  projectId: string;
  chatId: string;
  content: string;
  sender: string;
  timestamp: string;
  type: 'question' | 'answer' | 'system' | 'file' | 'image';
  isUser: boolean;
  replyTo?: string;
  edited?: boolean;
  attachments?: Array<{
    id: string;
    name: string;
    type: 'image' | 'file' | 'document';
    url: string;
  }>;
  metadata?: {
    confidence?: number;
    processingTime?: number;
    modelUsed?: string;
  };
}

function App() {
  const [inputValue, setInputValue] = useState('');
  const [messages, setMessages] = useState<Array<{
    id: string;
    content: string;
    isUser: boolean;
    timestamp: Date;
    type?: 'text' | 'chart' | 'data' | 'analysis';
  }>>([]);

  // 프로젝트 관련 상태
  const [projects, setProjects] = useState<Project[]>([
    {
      id: '1',
      name: '부동산 개발 프로젝트',
      description: '강남구 재개발 사업 분석 및 계획',
      createdAt: '2024-01-15',
      lastActivity: '2024-01-20',
      messageCount: 45,
      files: [
        {
          id: '1',
          name: '개발계획서.pdf',
          type: 'document',
          size: 2048576,
          uploadedAt: '2024-01-16',
          url: '#',
          description: '부동산 개발 상세 계획서'
        },
        {
          id: '2',
          name: '시장분석.xlsx',
          type: 'spreadsheet',
          size: 512000,
          uploadedAt: '2024-01-17',
          url: '#',
          description: '시장 동향 분석 데이터'
        }
      ],
      guidelines: [
        {
          id: '1',
          title: '개발 가이드라인',
          content: '부동산 개발 시 준수해야 할 기본 가이드라인',
          type: 'basic',
          createdAt: '2024-01-15',
          priority: 'high'
        },
        {
          id: '2',
          title: '환경영향평가 절차',
          content: '환경영향평가 수행 시 필요한 절차와 준비사항',
          type: 'process',
          createdAt: '2024-01-16',
          priority: 'medium'
        }
      ],
      settings: {
        theme: 'light',
        language: 'ko',
        aiModel: 'gpt-4',
        autoSave: true,
        collaboration: true
      },
      archived: false
    },
    {
      id: '2',
      name: '도시정비 사업',
      description: '서초구 도시정비사업 추진 계획',
      createdAt: '2024-01-10',
      lastActivity: '2024-01-19',
      messageCount: 32,
      files: [
        {
          id: '3',
          name: '정비계획.pdf',
          type: 'document',
          size: 1536000,
          uploadedAt: '2024-01-11',
          url: '#',
          description: '도시정비사업 기본 계획'
        }
      ],
      guidelines: [
        {
          id: '3',
          title: '정비사업 절차',
          content: '도시정비사업 추진 시 필요한 법적 절차',
          type: 'process',
          createdAt: '2024-01-10',
          priority: 'high'
        }
      ],
      settings: {
        theme: 'light',
        language: 'ko',
        aiModel: 'gpt-4',
        autoSave: true,
        collaboration: false
      },
      archived: false
    }
  ]);

  const [selectedProjectId, setSelectedProjectId] = useState<string | null>(null);
  const [selectedChatId, setSelectedChatId] = useState<string | null>(null);
  const [showProjectModal, setShowProjectModal] = useState(false);
  const [showChatModal, setShowChatModal] = useState(false);
  const [newProjectName, setNewProjectName] = useState('');
  const [newProjectDescription, setNewProjectDescription] = useState('');
  const [newChatTitle, setNewChatTitle] = useState('');
  const [newChatDescription, setNewChatDescription] = useState('');
  const [currentView, setCurrentView] = useState<'chat' | 'project-list' | 'chat-list' | 'project-detail'>('chat');
  const [selectedProject, setSelectedProject] = useState<Project | null>(null);

  // 채팅 관련 상태
  const [chats, setChats] = useState<Chat[]>([
    {
      id: '1',
      projectId: '1',
      title: '부동산 개발 분석',
      description: '부동산 개발 프로젝트 관련 분석 및 논의',
      messages: [
        {
          id: '1',
          projectId: '1',
          chatId: '1',
          content: '부동산 개발 프로젝트 분석을 시작하겠습니다.',
          sender: 'CORBU AI',
          timestamp: '2024-01-20T10:00:00Z',
          type: 'system',
          isUser: false
        },
        {
          id: '2',
          projectId: '1',
          chatId: '1',
          content: '시장 분석 결과를 확인해주세요.',
          sender: 'User',
          timestamp: '2024-01-20T10:05:00Z',
          type: 'question',
          isUser: true
        }
      ],
      createdAt: '2024-01-20',
      updatedAt: '2024-01-20',
      isActive: true,
      status: 'active',
      tags: ['부동산', '개발', '분석'],
      participants: ['User', 'CORBU AI']
    },
    {
      id: '2',
      projectId: '1',
      title: '프로젝트 생성 채팅',
      description: '새 프로젝트 생성 관련 채팅',
      messages: [
        {
          id: '3',
          projectId: '1',
          chatId: '2',
          content: '새 프로젝트를 생성하시겠습니까?',
          sender: 'CORBU AI',
          timestamp: '2024-01-20T11:00:00Z',
          type: 'system',
          isUser: false
        }
      ],
      createdAt: '2024-01-20',
      updatedAt: '2024-01-20',
      isActive: true,
      status: 'active',
      tags: ['프로젝트', '생성'],
      participants: ['User', 'CORBU AI']
    },
    {
      id: '3',
      projectId: '2',
      title: '도시정비 사업 채팅',
      description: '도시정비 사업 관련 논의',
      messages: [
        {
          id: '4',
          projectId: '2',
          chatId: '3',
          content: '도시정비 사업 계획을 검토하겠습니다.',
          sender: 'CORBU AI',
          timestamp: '2024-01-19T09:00:00Z',
          type: 'system',
          isUser: false
        }
      ],
      createdAt: '2024-01-19',
      updatedAt: '2024-01-19',
      isActive: true,
      status: 'active',
      tags: ['도시정비', '사업'],
      participants: ['User', 'CORBU AI']
    }
  ]);

  // 유틸리티 함수들
  const formatFileSize = (bytes: number): string => {
    if (bytes === 0) return '0 Bytes';
    const k = 1024;
    const sizes = ['Bytes', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
  };

  const getFileIcon = (type: string): string => {
    const icons = {
      document: '📄',
      image: '🖼️',
      video: '🎥',
      audio: '🎵',
      spreadsheet: '📊',
      presentation: '📽️'
    };
    return icons[type as keyof typeof icons] || '📄';
  };

  // 프로젝트 생성 함수
  const createProject = (name: string, description: string) => {
    const newProject: Project = {
      id: Date.now().toString(),
      name,
      description,
      createdAt: new Date().toISOString().split('T')[0],
      lastActivity: new Date().toISOString().split('T')[0],
      messageCount: 0,
      files: [],
      guidelines: [],
      settings: {
        theme: 'light',
        language: 'ko',
        aiModel: 'gpt-4',
        autoSave: true,
        collaboration: false
      },
      archived: false
    };

    setProjects(prev => [...prev, newProject]);
    return newProject;
  };

  // 채팅 생성 함수
  const createChat = (projectId: string, title: string, description: string) => {
    const newChat: Chat = {
      id: Date.now().toString(),
      projectId,
      title,
      description,
      messages: [
        {
          id: Date.now().toString(),
          projectId,
          chatId: Date.now().toString(),
          content: `새로운 채팅 "${title}"이 생성되었습니다. 무엇을 도와드릴까요?`,
          sender: 'CORBU AI',
          timestamp: new Date().toISOString(),
          type: 'system',
          isUser: false
        }
      ],
      createdAt: new Date().toISOString().split('T')[0],
      updatedAt: new Date().toISOString().split('T')[0],
      isActive: true,
      status: 'active',
      tags: [],
      participants: ['User', 'CORBU AI']
    };

    setChats(prev => [...prev, newChat]);
    return newChat;
  };

  // 현재 선택된 프로젝트의 채팅들 가져오기
  const getProjectChats = (projectId: string) => {
    return chats.filter(chat => chat.projectId === projectId);
  };

  const handleSendMessage = () => {
    if (!inputValue.trim()) return;

    const newMessage = {
      id: Date.now().toString(),
      content: inputValue,
      isUser: true,
      timestamp: new Date(),
      type: 'text' as const
    };

    setMessages(prev => [...prev, newMessage]);
    const userInput = inputValue;
    setInputValue('');

    // AI 응답 처리 (분석, 차트, 데이터 요청 감지)
    setTimeout(() => {
      const aiResponse = generateAIResponse(userInput);
      setMessages(prev => [...prev, aiResponse]);
    }, 1000);
  };

  const generateAIResponse = (userInput: string): {
    id: string;
    content: string;
    isUser: boolean;
    timestamp: Date;
    type: 'text' | 'chart' | 'data' | 'analysis';
  } => {
    const lowerInput = userInput.toLowerCase();

    // 분석 요청 감지
    if (lowerInput.includes('분석') || lowerInput.includes('analyze') || lowerInput.includes('분석해')) {
      return {
        id: (Date.now() + 1).toString(),
        content: `📊 분석 결과\n\n${userInput}에 대한 분석을 수행했습니다.\n\n• 데이터 패턴: 상승 추세\n• 주요 인사이트: 3가지 발견\n• 권장사항: 최적화 필요\n\n더 자세한 분석이 필요하시면 말씀해 주세요.`,
        isUser: false,
        timestamp: new Date(),
        type: 'analysis'
      };
    }

    // 차트 요청 감지
    if (lowerInput.includes('차트') || lowerInput.includes('chart') || lowerInput.includes('그래프')) {
      return {
        id: (Date.now() + 1).toString(),
        content: `📈 차트 데이터\n\n${userInput}에 대한 차트를 생성했습니다.\n\n📊 월별 성과 차트\n├── 1월: 85%\n├── 2월: 92%\n├── 3월: 88%\n└── 4월: 95%\n\n차트 데이터를 다운로드하거나 다른 형태로 보시겠습니까?`,
        isUser: false,
        timestamp: new Date(),
        type: 'chart'
      };
    }

    // 데이터 요청 감지
    if (lowerInput.includes('데이터') || lowerInput.includes('data') || lowerInput.includes('통계')) {
      return {
        id: (Date.now() + 1).toString(),
        content: `📋 데이터 요약\n\n${userInput}에 대한 데이터를 수집했습니다.\n\n주요 지표:\n• 총 데이터: 1,247개\n• 평균값: 73.5\n• 표준편차: 12.3\n• 최대값: 98.2\n• 최소값: 45.1\n\n특정 데이터 필터링이나 추가 분석이 필요하시면 말씀해 주세요.`,
        isUser: false,
        timestamp: new Date(),
        type: 'data'
      };
    }

    // 협업 요청 감지
    if (lowerInput.includes('협업') || lowerInput.includes('collaboration') || lowerInput.includes('팀')) {
      return {
        id: (Date.now() + 1).toString(),
        content: `👥 협업 기능\n\n${userInput}에 대한 협업 세션을 설정했습니다.\n\n🤝 협업 정보:\n• 참여자: 5명\n• 권한: 편집 가능\n• 실시간 동기화: 활성화\n• 변경 이력: 추적 중\n\n새로운 팀원을 초대하거나 권한을 변경하시겠습니까?`,
        isUser: false,
        timestamp: new Date(),
        type: 'text'
      };
    }

    // 보안 분석 요청 감지
    if (lowerInput.includes('보안') || lowerInput.includes('security') || lowerInput.includes('취약점')) {
      return {
        id: (Date.now() + 1).toString(),
        content: `🔒 보안 분석 결과\n\n${userInput}에 대한 보안 분석을 수행했습니다.\n\n🛡️ 보안 상태:\n• 전체 점수: 85/100\n• 위험도: 낮음\n• 발견된 취약점: 2개\n• 권장 조치: 3가지\n\n보안 강화를 위한 상세한 권장사항을 제공하시겠습니까?`,
        isUser: false,
        timestamp: new Date(),
        type: 'analysis'
      };
    }

    // 성능 최적화 요청 감지
    if (lowerInput.includes('성능') || lowerInput.includes('performance') || lowerInput.includes('최적화')) {
      return {
        id: (Date.now() + 1).toString(),
        content: `⚡ 성능 최적화 결과\n\n${userInput}에 대한 성능 최적화를 수행했습니다.\n\n📈 성능 개선:\n• 응답 시간: 2.3초 → 1.1초 (52% 개선)\n• 처리량: 1,000건/분 → 2,100건/분 (110% 증가)\n• 메모리 사용량: 45% → 28% (38% 감소)\n• CPU 사용률: 78% → 52% (33% 감소)\n\n추가 최적화가 필요하시면 말씀해 주세요.`,
        isUser: false,
        timestamp: new Date(),
        type: 'analysis'
      };
    }

    // 카드뉴스 생성 요청 감지
    if (lowerInput.includes('카드뉴스') || lowerInput.includes('cardnews') || lowerInput.includes('카드')) {
      return {
        id: (Date.now() + 1).toString(),
        content: `📱 카드뉴스 생성\n\n${userInput}에 대한 카드뉴스를 생성했습니다.\n\n📋 카드 구성:\n• 카드 1: 주요 제목\n• 카드 2: 핵심 내용\n• 카드 3: 데이터 시각화\n• 카드 4: 결론 및 액션\n\n카드뉴스를 다운로드하거나 공유하시겠습니까?`,
        isUser: false,
        timestamp: new Date(),
        type: 'text'
      };
    }

    // 감정 분석 요청 감지
    if (lowerInput.includes('감정') || lowerInput.includes('emotion') || lowerInput.includes('기분')) {
      return {
        id: (Date.now() + 1).toString(),
        content: `😊 감정 분석 결과\n\n${userInput}에 대한 감정 분석을 수행했습니다.\n\n📊 감정 분포:\n• 긍정: 65%\n• 중립: 25%\n• 부정: 10%\n\n주요 감정 키워드:\n• 기대, 희망, 만족\n\n감정 변화 추이를 확인하시겠습니까?`,
        isUser: false,
        timestamp: new Date(),
        type: 'analysis'
      };
    }

    // 언어 번역 요청 감지
    if (lowerInput.includes('번역') || lowerInput.includes('translate') || lowerInput.includes('언어')) {
      return {
        id: (Date.now() + 1).toString(),
        content: `🌐 언어 번역 결과\n\n${userInput}에 대한 번역을 완료했습니다.\n\n📝 번역 결과:\n• 원문: ${userInput}\n• 영어: Translated content\n• 일본어: 翻訳された内容\n• 중국어: 翻译内容\n\n다른 언어로 번역하거나 발음을 확인하시겠습니까?`,
        isUser: false,
        timestamp: new Date(),
        type: 'text'
      };
    }

    // 음성 변환 요청 감지
    if (lowerInput.includes('음성') || lowerInput.includes('voice') || lowerInput.includes('tts')) {
      return {
        id: (Date.now() + 1).toString(),
        content: `🎤 음성 변환 완료\n\n${userInput}를 음성으로 변환했습니다.\n\n🔊 음성 설정:\n• 언어: 한국어\n• 속도: 보통\n• 톤: 자연스러움\n• 볼륨: 적당함\n\n음성을 재생하거나 다운로드하시겠습니까?`,
        isUser: false,
        timestamp: new Date(),
        type: 'text'
      };
    }

    // 코드 생성 요청 감지
    if (lowerInput.includes('코드') || lowerInput.includes('code') || lowerInput.includes('프로그램')) {
      return {
        id: (Date.now() + 1).toString(),
        content: `💻 코드 생성 완료\n\n${userInput}에 대한 코드를 생성했습니다.\n\n코드 예시:\nfunction example() {\n  console.log("Hello World");\n  return true;\n}\n\n코드를 복사하거나 다른 언어로 변환하시겠습니까?`,
        isUser: false,
        timestamp: new Date(),
        type: 'text'
      };
    }

    // 머신러닝 모델 관리 요청 감지
    if (lowerInput.includes('머신러닝') || lowerInput.includes('machine learning') || lowerInput.includes('모델')) {
      return {
        id: (Date.now() + 1).toString(),
        content: `🤖 머신러닝 모델 관리\n\n${userInput}에 대한 머신러닝 모델을 관리합니다.\n\n📊 모델 상태:\n• 활성 모델: 3개\n• 훈련 중: 1개\n• 성능 점수: 92.5%\n• 정확도: 89.3%\n\n모델을 새로 훈련하거나 성능을 개선하시겠습니까?`,
        isUser: false,
        timestamp: new Date(),
        type: 'analysis'
      };
    }

    // API 통합 요청 감지
    if (lowerInput.includes('api') || lowerInput.includes('통합') || lowerInput.includes('연동')) {
