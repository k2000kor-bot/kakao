    return () => clearInterval(interval);
  }, []);

  // AI 문서 분석 관련 상태
  const [documentAnalysis, setDocumentAnalysis] = useState<{
    id: string;
    filename: string;
    type: 'pdf' | 'doc' | 'txt' | 'image';
    status: 'processing' | 'completed' | 'error';
    results: {
      summary: string;
      keyPoints: string[];
      sentiment: 'positive' | 'negative' | 'neutral';
      entities: Array<{
        name: string;
        type: 'person' | 'organization' | 'location' | 'date';
        confidence: number;
      }>;
      topics: Array<{
        name: string;
        weight: number;
      }>;
      recommendations: string[];
    };
    processingTime: number;
  } | null>(null);

  // 제거된 기능들:
  // - 자동화 워크플로우 상태
  // - 고급 검색 상태

  // AI 문서 분석 시작
  const startDocumentAnalysis = (file: File) => {
    let fileType: 'pdf' | 'doc' | 'txt' | 'image' = 'txt';

    if (file.name.endsWith('.pdf')) {
      fileType = 'pdf';
    } else if (file.name.endsWith('.doc') || file.name.endsWith('.docx')) {
      fileType = 'doc';
    } else if (file.name.endsWith('.txt')) {
      fileType = 'txt';
    } else {
      fileType = 'image';
    }

    const analysis = {
      id: Date.now().toString(),
      filename: file.name,
      type: fileType,
      status: 'processing' as const,
      results: {
        summary: '',
        keyPoints: [] as string[],
        sentiment: 'neutral' as const,
        entities: [] as Array<{
          name: string;
          type: 'person' | 'organization' | 'location' | 'date';
          confidence: number;
        }>,
        topics: [] as Array<{
          name: string;
          weight: number;
        }>,
        recommendations: [] as string[]
      },
      processingTime: 0
    };

    setDocumentAnalysis(analysis);

    // 시뮬레이션된 분석 처리
    setTimeout(() => {
      const results = {
        summary: '이 문서는 부동산 개발 프로젝트에 대한 종합적인 분석 보고서입니다. 주요 내용으로는 시장 분석, 재무 계획, 리스크 평가 등이 포함되어 있습니다.',
        keyPoints: [
          '시장 분석: 강남구 재개발 지역의 시장 잠재력 높음',
          '재무 계획: 총 투자금액 500억원, 예상 수익률 15%',
          '리스크 평가: 정부 정책 변화에 따른 리스크 존재',
          '타임라인: 2024년 3분기 착공, 2026년 완공 예정'
        ],
        sentiment: 'positive' as const,
        entities: [
          { name: '강남구', type: 'location' as const, confidence: 0.95 },
          { name: '2024년', type: 'date' as const, confidence: 0.88 },
          { name: '부동산 개발사', type: 'organization' as const, confidence: 0.92 }
        ],
        topics: [
          { name: '부동산 개발', weight: 0.85 },
          { name: '시장 분석', weight: 0.72 },
          { name: '재무 계획', weight: 0.68 },
          { name: '리스크 관리', weight: 0.55 }
        ],
        recommendations: [
          '정부 정책 변화에 대한 대응 방안 마련 필요',
          '환경 영향 평가 절차 조기 진행 권장',
          '지역 주민과의 소통 강화 방안 수립',
          '투자자 유치를 위한 마케팅 전략 수립'
        ]
      };

      setDocumentAnalysis(prev => prev ? {
        ...prev,
        status: 'completed',
        results,
        processingTime: 3.2
      } : null);

      addNotification('success', '문서 분석 완료', `${file.name} 분석이 완료되었습니다.`);
    }, 3000);
  };

  // 제거된 기능들:
  // - 고급 검색 기능
  // - 워크플로우 실행 기능
  // - 머신러닝 예측 분석 실행
  // - 보안 스캔 실행
  // - 차트 생성
  // - 블록체인 무결성 검증 실행
  // - AI 모델 배포
  // - 양자 회로 실행

  // 제거된 기능들:
  // - 머신러닝 예측 분석 상태 (mlPredictions)
  // - 고급 보안 기능 상태 (securityStatus)
  // - 데이터 시각화 상태 (dataVisualization)
  // - 블록체인 데이터 무결성 검증 상태 (blockchainIntegrity)
  // - 고급 AI 모델 관리 상태 (aiModelManagement)
  // - 양자 컴퓨팅 시뮬레이션 상태 (quantumComputing)

  // 신경망 시각화 상태
  const [neuralNetwork, setNeuralNetwork] = useState<{
    layers: Array<{
      id: string;
      type: 'input' | 'hidden' | 'output';
      neurons: number;
      activation: 'relu' | 'sigmoid' | 'tanh' | 'softmax';
      weights: Array<Array<number>>;
      biases: Array<number>;
    }>;
    training: {
      epoch: number;
      totalEpochs: number;
      loss: number;
      accuracy: number;
      learningRate: number;
      batchSize: number;
      isTraining: boolean;
    };
    predictions: Array<{
      input: Array<number>;
      output: Array<number>;
      confidence: number;
      timestamp: string;
    }>;
  }>({
    layers: [
      {
        id: 'input',
        type: 'input',
        neurons: 4,
        activation: 'relu',
        weights: [],
        biases: []
      },
      {
        id: 'hidden1',
        type: 'hidden',
        neurons: 8,
        activation: 'relu',
        weights: Array.from({ length: 8 }, () => Array.from({ length: 4 }, () => Math.random() * 2 - 1)),
        biases: Array.from({ length: 8 }, () => Math.random() * 2 - 1)
      },
      {
        id: 'hidden2',
        type: 'hidden',
        neurons: 6,
        activation: 'relu',
        weights: Array.from({ length: 6 }, () => Array.from({ length: 8 }, () => Math.random() * 2 - 1)),
        biases: Array.from({ length: 6 }, () => Math.random() * 2 - 1)
      },
      {
        id: 'output',
        type: 'output',
        neurons: 3,
        activation: 'softmax',
        weights: Array.from({ length: 3 }, () => Array.from({ length: 6 }, () => Math.random() * 2 - 1)),
        biases: Array.from({ length: 3 }, () => Math.random() * 2 - 1)
      }
    ],
    training: {
      epoch: 0,
      totalEpochs: 100,
      loss: 0.0,
      accuracy: 0.0,
      learningRate: 0.001,
      batchSize: 32,
      isTraining: false
    },
    predictions: []
  });

  // 고급 AI 에이전트 시스템 상태
  const [aiAgents, setAiAgents] = useState<{
    agents: Array<{
      id: string;
      name: string;
      type: 'assistant' | 'analyst' | 'researcher' | 'creative' | 'specialist';
      status: 'active' | 'idle' | 'busy' | 'learning';
      capabilities: Array<string>;
      performance: {
        tasksCompleted: number;
        successRate: number;
        averageResponseTime: number;
        userSatisfaction: number;
      };
      currentTask: {
        type: string;
        description: string;
        progress: number;
        startedAt: string;
      } | null;
      memory: {
        shortTerm: Array<{ id: string; content: string; timestamp: string }>;
        longTerm: Array<{ id: string; topic: string; knowledge: string; lastAccessed: string }>;
      };
    }>;
    collaboration: {
      activeSessions: number;
      sharedKnowledge: Array<{ id: string; topic: string; contributors: Array<string>; lastUpdated: string }>;
      communicationChannels: Array<{ id: string; type: 'text' | 'voice' | 'visual'; participants: Array<string>; status: 'active' | 'idle' }>;
    };
  }>({
    agents: [
      {
        id: 'agent_001',
        name: 'Alpha Assistant',
        type: 'assistant',
        status: 'active',
        capabilities: ['문서 작성', '데이터 분석', '프로젝트 관리', '통역'],
        performance: {
          tasksCompleted: 156,
          successRate: 94.2,
          averageResponseTime: 2.3,
          userSatisfaction: 4.8
        },
        currentTask: {
          type: '문서 분석',
          description: '프로젝트 보고서 요약 작성 중',
          progress: 75,
          startedAt: new Date().toISOString()
        },
        memory: {
          shortTerm: [
            { id: '1', content: '사용자가 프로젝트 보고서 분석을 요청함', timestamp: new Date().toISOString() }
          ],
          longTerm: [
            { id: '1', topic: '프로젝트 관리', knowledge: '애자일 방법론과 스크럼 프레임워크', lastAccessed: new Date().toISOString() }
          ]
        }
      },
      {
        id: 'agent_002',
        name: 'Beta Analyst',
        type: 'analyst',
        status: 'busy',
        capabilities: ['통계 분석', '예측 모델링', '데이터 시각화', '리포트 생성'],
        performance: {
          tasksCompleted: 89,
          successRate: 96.7,
          averageResponseTime: 4.1,
          userSatisfaction: 4.9
        },
        currentTask: {
          type: '시장 분석',
          description: 'Q4 시장 트렌드 분석 중',
          progress: 45,
          startedAt: new Date(Date.now() - 1800000).toISOString()
        },
        memory: {
          shortTerm: [
            { id: '1', content: '시장 데이터 수집 완료', timestamp: new Date().toISOString() }
          ],
          longTerm: [
            { id: '1', topic: '시장 분석', knowledge: '시계열 분석 및 예측 모델링 기법', lastAccessed: new Date().toISOString() }
          ]
        }
      }
    ],
    collaboration: {
      activeSessions: 2,
      sharedKnowledge: [
        {
          id: 'knowledge_001',
          topic: 'AI 모델 최적화',
          contributors: ['Alpha Assistant', 'Beta Analyst'],
          lastUpdated: new Date().toISOString()
        }
      ],
      communicationChannels: [
        {
          id: 'channel_001',
          type: 'text',
          participants: ['Alpha Assistant', 'Beta Analyst'],
          status: 'active'
        }
      ]
    }
  });

  // 실시간 학습 모니터링 상태
  const [learningMonitor, setLearningMonitor] = useState<{
    activeModels: Array<{
      id: string;
      name: string;
      type: 'supervised' | 'unsupervised' | 'reinforcement';
      status: 'training' | 'evaluating' | 'deploying' | 'completed';
      metrics: {
        loss: number;
        accuracy: number;
        precision: number;
        recall: number;
        f1Score: number;
      };
      progress: {
        epoch: number;
        totalEpochs: number;
        batch: number;
        totalBatches: number;
        timeElapsed: number;
        estimatedTimeRemaining: number;
      };
      hyperparameters: {
        learningRate: number;
        batchSize: number;
        optimizer: string;
        lossFunction: string;
      };
    }>;
    systemMetrics: {
      gpuUtilization: number;
      memoryUsage: number;
      cpuUsage: number;
      networkThroughput: number;
      activeConnections: number;
    };
    alerts: Array<{
      id: string;
      type: 'warning' | 'error' | 'info' | 'success';
      message: string;
      timestamp: string;
      severity: 'low' | 'medium' | 'high' | 'critical';
    }>;
  }>({
    activeModels: [
      {
        id: 'model_001',
        name: 'BERT Fine-tuning',
        type: 'supervised',
        status: 'training',
        metrics: {
          loss: 0.234,
          accuracy: 0.892,
          precision: 0.876,
          recall: 0.901,
          f1Score: 0.888
        },
        progress: {
          epoch: 15,
          totalEpochs: 50,
          batch: 128,
          totalBatches: 500,
          timeElapsed: 1800,
          estimatedTimeRemaining: 3600
        },
        hyperparameters: {
          learningRate: 0.0001,
          batchSize: 16,
          optimizer: 'AdamW',
          lossFunction: 'CrossEntropyLoss'
        }
      }
    ],
    systemMetrics: {
      gpuUtilization: 78.5,
      memoryUsage: 65.2,
      cpuUsage: 45.8,
      networkThroughput: 125.6,
      activeConnections: 12
    },
    alerts: [
      {
        id: 'alert_001',
        type: 'warning',
        message: 'GPU 메모리 사용량이 80%에 근접했습니다.',
        timestamp: new Date().toISOString(),
        severity: 'medium'
      }
    ]
  });

  // 신경망 훈련 시작
  const startNeuralNetworkTraining = () => {
    setNeuralNetwork(prev => ({
      ...prev,
      training: { ...prev.training, isTraining: true }
    }));

    // 시뮬레이션된 훈련 과정
    const trainingInterval = setInterval(() => {
      setNeuralNetwork(prev => {
        if (prev.training.epoch >= prev.training.totalEpochs) {
          clearInterval(trainingInterval);
          return {
            ...prev,
            training: { ...prev.training, isTraining: false }
          };
        }

        return {
          ...prev,
          training: {
            ...prev.training,
            epoch: prev.training.epoch + 1,
            loss: Math.max(0.01, prev.training.loss - 0.005),
            accuracy: Math.min(0.99, prev.training.accuracy + 0.003)
          }
        };
      });
    }, 1000);

    addNotification('success', '신경망 훈련 시작', '신경망 훈련이 시작되었습니다.');
  };

  // AI 에이전트 작업 할당
  const assignTaskToAgent = (agentId: string, taskType: string, description: string) => {
    setAiAgents(prev => ({
      ...prev,
      agents: prev.agents.map(agent =>
        agent.id === agentId
          ? {
            ...agent,
            status: 'busy' as const,
            currentTask: {
              type: taskType,
              description,
              progress: 0,
              startedAt: new Date().toISOString()
            }
          }
          : agent
      )
    }));

    addNotification('success', '작업 할당 완료', `${taskType} 작업이 에이전트에게 할당되었습니다.`);
  };

  // 학습 모니터링 업데이트
  const updateLearningMetrics = () => {
    setLearningMonitor(prev => ({
      ...prev,
      activeModels: prev.activeModels.map(model => ({
        ...model,
        metrics: {
          ...model.metrics,
          loss: Math.max(0.01, model.metrics.loss - 0.001),
          accuracy: Math.min(0.99, model.metrics.accuracy + 0.002)
        },
        progress: {
          ...model.progress,
          batch: model.progress.batch + 1,
          timeElapsed: model.progress.timeElapsed + 60
        }
      })),
      systemMetrics: {
        ...prev.systemMetrics,
        gpuUtilization: Math.min(100, prev.systemMetrics.gpuUtilization + Math.random() * 2 - 1),
        memoryUsage: Math.min(100, prev.systemMetrics.memoryUsage + Math.random() * 2 - 1)
      }
    }));
  };

  // 제거된 고급 기능 클릭 핸들러
  // const handleAdvancedFeatureClick = (feature: string) => {
  //   // 제거된 기능들에 대한 처리
  //   const message = '해당 기능은 제거되었습니다. 필요하시면 대화를 통해 요청해 주세요.';
  //   setMessages(prev => [...prev, {
  //     id: Date.now().toString(),
  //     content: message,
  //     isUser: false,
  //     timestamp: new Date(),
  //     type: 'text'
  //   }]);
  // };

  return (
    <div className="App">
      {/* 사이드바 */}
      <div className="sidebar">
        <div className="sidebar-header">
          <h1 className="app-title">CORBU AI</h1>
        </div>

        <div className="sidebar-section">
          <h3>뷰 전환</h3>
          <div className="sidebar-items">
            <div
              className={`sidebar-item ${currentView === 'chat' ? 'active' : ''}`}
              onClick={() => setCurrentView('chat')}
            >
              <div className="item-icon blue"></div>
              <span>채팅</span>
            </div>
            <div
              className={`sidebar-item ${currentView === 'project-list' ? 'active' : ''}`}
              onClick={() => setCurrentView('project-list')}
            >
              <div className="item-icon green"></div>
              <span>프로젝트 목록</span>
            </div>
            <div
              className={`sidebar-item ${currentView === 'chat-list' ? 'active' : ''}`}
              onClick={() => setCurrentView('chat-list')}
            >
              <div className="item-icon purple"></div>
              <span>채팅 목록</span>
            </div>
          </div>
        </div>

        <div className="sidebar-section">
          <h3>프로젝트</h3>
          <div className="sidebar-items">
            {projects.map(project => (
              <div
                key={project.id}
                className={`sidebar-item ${selectedProjectId === project.id ? 'active' : ''}`}
                onClick={() => handleProjectSelect(project.id)}
              >
                <div className="item-icon blue"></div>
                <span>{project.name}</span>
                <span className="project-count">({project.messageCount})</span>
              </div>
            ))}
            <div
              className="sidebar-item add-project"
              onClick={() => setShowProjectModal(true)}
            >
              <div className="item-icon green"></div>
              <span>+ 새 프로젝트</span>
            </div>
          </div>
        </div>

        {selectedProjectId && (
          <div className="sidebar-section">
            <h3>채팅</h3>
            <div className="sidebar-items">
              {getProjectChats(selectedProjectId).map(chat => (
                <div
                  key={chat.id}
                  className={`sidebar-item ${selectedChatId === chat.id ? 'active' : ''}`}
                  onClick={() => setSelectedChatId(chat.id)}
                >
                  <div className="item-icon purple"></div>
                  <span>{chat.title}</span>
                  <span className="chat-count">({chat.messages.length})</span>
                </div>
              ))}
              <div
                className="sidebar-item add-chat"
                onClick={() => setShowChatModal(true)}
              >
                <div className="item-icon orange"></div>
                <span>+ 새 채팅</span>
              </div>
            </div>
          </div>
        )}

        <div className="sidebar-section">
          <h3>시스템 기능</h3>
          <div className="sidebar-items">
            <div className="sidebar-item">
              <div className="item-icon blue"></div>
              <span>프로젝트</span>
            </div>
            <div className="sidebar-item">
              <div className="item-icon green"></div>
              <span>프로젝트 파일</span>
            </div>
            <div className="sidebar-item">
              <div className="item-icon yellow"></div>
              <span>지침</span>
            </div>
            <div className="sidebar-item">
              <div className="item-icon purple"></div>
              <span>분석 기록</span>
            </div>
            <div className="sidebar-item">
              <div className="item-icon orange"></div>
              <span>템플릿</span>
            </div>
            <div className="sidebar-item">
              <div className="item-icon red"></div>
              <span>내보내기</span>
            </div>
          </div>
        </div>

        <div className="sidebar-section">
          <h3>시스템 명령어</h3>
          <div className="sidebar-items">
            <div className="sidebar-item">
              <div className="item-icon purple"></div>
              <span>파일 업로드</span>
            </div>
            <div className="sidebar-item">
              <div className="item-icon green"></div>
              <span>분석 시작</span>
            </div>
            <div className="sidebar-item">
              <div className="item-icon blue"></div>
              <span>요약 생성</span>
            </div>
            <div className="sidebar-item">
              <div className="item-icon pink"></div>
              <span>카드뉴스 생성</span>
            </div>
          </div>
        </div>


                - 고급 검색
                - ML 예측 분석
                - 보안 스캔
                - 데이터 시각화
                - 블록체인 검증
                - AI 모델 관리
                - 양자 컴퓨팅 */}
              </>
            )}
          </div>
        </div>

        {/* 제거된 고급 기능 아이콘들:
        - 고급 통계
        - 자동화 워크플로우
        - 보안 대시보드
        - 데이터 시각화
        - 블록체인 데이터 무결성 검증
        - AI 모델 관리
        - 양자 컴퓨팅 시뮬레이션
        - 고급 검색 */}
      </div>

      {/* 제거된 고급 기능 팝업:
      - AdvancedFeaturesPopup 컴포넌트 제거됨 */}

      {/* 메인 컨텐츠 */}
      <div className="main-content">
        {currentView === 'chat' && (
          <>
            {messages.length === 0 ? (
              <div className="welcome-section">
                <h2 className="welcome-title">무엇이든 물어보세요!</h2>
                <p className="welcome-subtitle">CORBU.AI가 도와드리겠습니다.</p>

                <div className="command-suggestions">
                  <div className="suggestion-header">
                    <span className="lightbulb-icon">💡</span>
                    <span>명령어를 사용해보세요:</span>
                  </div>
                  <div className="suggestion-list">
                    <div className="suggestion-item">/help - 사용 가능한 명령어 보기</div>
                    <div className="suggestion-item">/upload - 파일 업로드</div>
                    <div className="suggestion-item">/project list - 프로젝트 목록</div>
                    <div className="suggestion-item">데이터를 분석해줘 - 분석 기능</div>
                    <div className="suggestion-item">차트로 보여줘 - 차트 생성</div>
                    <div className="suggestion-item">통계 데이터 보여줘 - 데이터 요약</div>
                    <div className="suggestion-item">예측 분석 - 미래 예측</div>
                    <div className="suggestion-item">AI 학습 - 모델 훈련</div>
                    <div className="suggestion-item">자동화 설정 - 작업 자동화</div>
                    <div className="suggestion-item">요약해줘 - 내용 요약</div>
                    <div className="suggestion-item">템플릿 생성 - 양식 생성</div>
                    <div className="suggestion-item">내보내기 - 결과 다운로드</div>
                    <div className="suggestion-item">실시간 분석 - 라이브 모니터링</div>
                    <div className="suggestion-item">도움말 - 사용법 안내</div>
                  </div>
                </div>
              </div>
            ) : (
              <div className="messages-container">
                {messages.map((message) => (
                  <div key={message.id} className={`message ${message.isUser ? 'user-message' : 'ai-message'}`}>
                    <div className={`message-content ${message.type}`}>
                      {message.content}
                    </div>
                    <div className="message-time">
                      {message.timestamp.toLocaleTimeString()}
                    </div>
                  </div>
                ))}
              </div>
            )}
          </>
        )}

        {currentView === 'project-list' && (
          <div className="project-list-view">
            <h2 className="view-title">프로젝트 목록</h2>
            <div className="project-grid">
              {projects.map(project => (
                <div key={project.id} className="project-card">
                  <div className="project-card-header">
                    <h3 className="project-card-title">{project.name}</h3>
                    <span className="project-card-count">{project.messageCount}개 메시지</span>
                  </div>
                  <p className="project-card-description">{project.description}</p>
                  <div className="project-card-stats">
                    <span className="stat">📁 {project.files.length}개 파일</span>
                    <span className="stat">📋 {project.guidelines.length}개 가이드라인</span>
                  </div>
                  <div className="project-card-footer">
                    <span className="project-date">생성: {project.createdAt}</span>
                    <span className="project-activity">활동: {project.lastActivity}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        {currentView === 'chat-list' && (
          <div className="chat-list-view">
            <h2 className="view-title">채팅 목록</h2>
            <div className="chat-grid">
              {chats.map(chat => {
                const project = projects.find(p => p.id === chat.projectId);
                return (
                  <div key={chat.id} className="chat-card">
                    <div className="chat-card-header">
                      <h3 className="chat-card-title">{chat.title}</h3>
                      <span className="chat-card-count">{chat.messages.length}개 메시지</span>
                    </div>
                    <p className="chat-card-description">{chat.description}</p>
                    <div className="chat-card-project">
                      <span className="project-name">📁 {project?.name || '알 수 없음'}</span>
                    </div>
                    <div className="chat-card-footer">
                      <span className="chat-date">생성: {chat.createdAt}</span>
                      <span className="chat-status">{chat.status}</span>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        )}

        {currentView === 'project-detail' && selectedProject && (
          <div className="project-detail">
            <div className="project-header">
              <div className="project-header-left">
                <button
                  className="back-button"
                  onClick={handleBackToProjectList}
                >
                  ← 뒤로가기
                </button>
                <h2 className="project-title">{selectedProject.name}</h2>
                <p className="project-description">{selectedProject.description}</p>
              </div>
              <div className="project-header-right">
                <div className="project-stats">
                  <div className="stat-item">
                    <span className="stat-label">메시지</span>
                    <span className="stat-value">{selectedProject.messageCount}</span>
                  </div>
                  <div className="stat-item">
                    <span className="stat-label">파일</span>
                    <span className="stat-value">{selectedProject.files.length}</span>
                  </div>
                  <div className="stat-item">
                    <span className="stat-label">지침</span>
                    <span className="stat-value">{selectedProject.guidelines.length}</span>
                  </div>
                </div>
              </div>
            </div>

            <div className="project-tabs">
              <button
                className={`project-tab ${activeTab === 'overview' ? 'active' : ''}`}
                onClick={() => setActiveTab('overview')}
              >
                개요
              </button>
              <button
                className={`project-tab ${activeTab === 'files' ? 'active' : ''}`}
                onClick={() => setActiveTab('files')}
              >
                파일 ({selectedProject.files.length})
              </button>
              <button
                className={`project-tab ${activeTab === 'guidelines' ? 'active' : ''}`}
                onClick={() => setActiveTab('guidelines')}
              >
                지침 ({selectedProject.guidelines.length})
              </button>
              <button
                className={`project-tab ${activeTab === 'chats' ? 'active' : ''}`}
                onClick={() => setActiveTab('chats')}
              >
                채팅 ({getProjectChats(selectedProject.id).length})
              </button>
              <button
                className={`project-tab ${activeTab === 'analytics' ? 'active' : ''}`}
                onClick={() => {
                  setActiveTab('analytics');
                  generateProjectAnalytics(selectedProject);
                }}
              >
                분석
              </button>
              <button
                className={`project-tab ${activeTab === 'settings' ? 'active' : ''}`}
                onClick={() => setActiveTab('settings')}
              >
                설정
              </button>
            </div>

            <div className="project-content">
              {activeTab === 'overview' && (
                <div className="project-overview">
                  <div className="overview-section">
                    <h3>프로젝트 정보</h3>
                    <div className="info-grid">
                      <div className="info-item">
                        <span className="info-label">생성일</span>
                        <span className="info-value">{selectedProject.createdAt}</span>
                      </div>
                      <div className="info-item">
                        <span className="info-label">마지막 활동</span>
                        <span className="info-value">{selectedProject.lastActivity}</span>
                      </div>
                      <div className="info-item">
                        <span className="info-label">상태</span>
                        <span className="info-value">{selectedProject.archived ? '보관됨' : '활성'}</span>
                      </div>
                      <div className="info-item">
                        <span className="info-label">총 메시지</span>
                        <span className="info-value">{selectedProject.messageCount}</span>
                      </div>
                    </div>
                  </div>

                  <div className="overview-section">
                    <h3>최근 활동</h3>
                    <div className="activity-list">
                      {projectActivity.slice(0, 5).map(activity => (
                        <div key={activity.id} className="activity-item">
                          <div className="activity-icon">
                            {activity.type === 'file_upload' && '📁'}
                            {activity.type === 'message' && '💬'}
                            {activity.type === 'guideline' && '📋'}
                            {activity.type === 'chat' && '💭'}
                            {activity.type === 'analysis' && '📊'}
                          </div>
                          <div className="activity-content">
                            <div className="activity-description">{activity.description}</div>
                            <div className="activity-meta">
                              <span className="activity-user">{activity.user}</span>
                              <span className="activity-time">
                                {new Date(activity.timestamp).toLocaleString()}
                              </span>
                            </div>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>

                  <div className="overview-section">
                    <h3>참여자</h3>
                    <div className="participants-list">
                      {projectAnalytics?.participantActivity.map((participant: any, index: number) => (
                        <div key={index} className="participant-item">
                          <div className="participant-avatar">
                            {participant.name.charAt(0)}
                          </div>
                          <div className="participant-info">
                            <div className="participant-name">{participant.name}</div>
                            <div className="participant-stats">
                              <span>{participant.messages}개 메시지</span>
                              <span>마지막 활동: {new Date(participant.lastActive).toLocaleString()}</span>
                            </div>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              )}

              {activeTab === 'files' && (
                <div className="files-tab">
                  <div className="tab-header">
                    <h3>프로젝트 파일</h3>
                    <button
                      className="btn btn-primary"
                      onClick={() => setShowFileUpload(true)}
                    >
                      파일 업로드
                    </button>
                  </div>
                  <div className="files-grid">
                    {selectedProject.files.length > 0 ? (
                      selectedProject.files.map(file => (
                        <div key={file.id} className="file-card">
                          <div className="file-icon">
                            {getFileIcon(file.type)}
                          </div>
                          <div className="file-info">
                            <div className="file-name">{file.name}</div>
                            <div className="file-meta">
                              {formatFileSize(file.size)} • {file.uploadedAt}
                            </div>
                          </div>
                          <div className="file-actions">
                            <button className="file-action-btn">보기</button>
                            <button className="file-action-btn">다운로드</button>
                          </div>
                        </div>
                      ))
                    ) : (
                      <div className="empty-state">
                        <p>업로드된 파일이 없습니다.</p>
                        <button className="upload-btn" onClick={() => setShowFileUpload(true)}>
                          파일 업로드
                        </button>
                      </div>
                    )}
                  </div>
                </div>
              )}

              {activeTab === 'guidelines' && (
                <div className="guidelines-tab">
                  <div className="tab-header">
                    <h3>프로젝트 지침</h3>
                    <button
                      className="btn btn-primary"
                      onClick={() => setShowGuidelineEditor(true)}
                    >
                      지침 추가
                    </button>
                  </div>
                  <div className="guidelines-grid">
                    {selectedProject.guidelines.length > 0 ? (
                      selectedProject.guidelines.map(guideline => (
                        <div key={guideline.id} className="guideline-card">
                          <div className="guideline-header">
                            <h4 className="guideline-title">{guideline.title}</h4>
                            <span className={`guideline-priority ${guideline.priority}`}>
                              {guideline.priority}
                            </span>
                          </div>
                          <p className="guideline-content">{guideline.content}</p>
                          <div className="guideline-footer">
                            <span className="guideline-type">{guideline.type}</span>
                            <button
                              className="edit-guideline-btn"
                              onClick={() => {
                                setEditingGuideline(guideline);
                                setShowGuidelineEditor(true);
                              }}
                            >
                              수정
                            </button>
                          </div>
                        </div>
                      ))
                    ) : (
                      <div className="empty-state">
                        <p>설정된 지침이 없습니다.</p>
                        <button className="add-guideline-btn" onClick={() => setShowGuidelineEditor(true)}>
                          지침 추가
                        </button>
                      </div>
                    )}
                  </div>
                </div>
              )}

              {activeTab === 'chats' && (
                <div className="chats-tab">
                  <div className="tab-header">
                    <h3>프로젝트 채팅</h3>
                    <button
                      className="btn btn-primary"
                      onClick={() => setShowChatModal(true)}
                    >
                      새 채팅
                    </button>
                  </div>
                  <div className="chats-grid">
                    {getProjectChats(selectedProject.id).map(chat => (
                      <div key={chat.id} className="chat-card">
                        <div className="chat-header">
                          <h4 className="chat-title">{chat.title}</h4>
                          <span className="chat-status">{chat.status}</span>
                        </div>
                        <p className="chat-description">{chat.description}</p>
                        <div className="chat-meta">
                          <span>{chat.messages.length}개 메시지</span>
                          <span>생성: {chat.createdAt}</span>
                        </div>
                        <div className="chat-actions">
                          <button className="chat-action-btn">열기</button>
                          <button className="chat-action-btn">보관</button>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              )}

              {activeTab === 'analytics' && projectAnalytics && (
                <div className="analytics-tab">
                  <div className="analytics-overview">
                    <div className="analytics-card">
                      <h4>메시지 트렌드</h4>
                      <div className="trend-chart">
                        {projectAnalytics.messageTrend.map((point: any, index: number) => (
                          <div key={index} className="trend-point">
                            <div className="trend-bar" style={{ height: `${(point.count / 30) * 100}%` }}></div>
                            <span className="trend-label">{point.date}</span>
                          </div>
                        ))}
                      </div>
                    </div>

                    <div className="analytics-card">
                      <h4>파일 사용량</h4>
                      <div className="file-usage">
                        <div className="usage-item">
                          <span>문서</span>
                          <span>{projectAnalytics.fileUsage.documents}</span>
                        </div>
                        <div className="usage-item">
                          <span>이미지</span>
                          <span>{projectAnalytics.fileUsage.images}</span>
                        </div>
                        <div className="usage-item">
                          <span>비디오</span>
                          <span>{projectAnalytics.fileUsage.videos}</span>
                        </div>
                        <div className="usage-item">
                          <span>총 크기</span>
                          <span>{formatFileSize(projectAnalytics.fileUsage.totalSize)}</span>
                        </div>
                      </div>
                    </div>

                    <div className="analytics-card">
                      <h4>성능 지표</h4>
                      <div className="performance-metrics">
                        <div className="metric">
                          <span>응답 시간</span>
                          <span>{projectAnalytics.performance.responseTime}s</span>
                        </div>
                        <div className="metric">
                          <span>정확도</span>
                          <span>{projectAnalytics.performance.accuracy}%</span>
                        </div>
                        <div className="metric">
                          <span>만족도</span>
                          <span>{projectAnalytics.performance.satisfaction}/5</span>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              )}

              {activeTab === 'settings' && (
                <div className="settings-tab">
                  <div className="settings-section">
                    <h3>프로젝트 설정</h3>
                    <div className="settings-form">
                      <div className="form-group">
                        <label>프로젝트 이름</label>
                        <input
                          type="text"
                          value={selectedProject.name}
                          className="form-input"
                          readOnly
                        />
                      </div>
                      <div className="form-group">
                        <label>설명</label>
                        <textarea
                          value={selectedProject.description}
                          className="form-textarea"
                          readOnly
                        />
                      </div>
                      <div className="form-group">
                        <label>상태</label>
                        <select className="form-select">
                          <option value="active">활성</option>
                          <option value="archived">보관</option>
                          <option value="completed">완료</option>
                        </select>
                      </div>
                    </div>
                  </div>

                  <div className="settings-section">
                    <h3>협업 설정</h3>
                    <div className="collaboration-settings">
                      <div className="setting-item">
                        <label>
                          <input type="checkbox" defaultChecked />
                          실시간 협업 활성화
                        </label>
                      </div>
                      <div className="setting-item">
                        <label>
                          <input type="checkbox" defaultChecked />
                          자동 저장
                        </label>
                      </div>
                      <div className="setting-item">
                        <label>
                          <input type="checkbox" />
                          알림 활성화
                        </label>
                      </div>
                    </div>
                  </div>
                </div>
              )}
            </div>
          </div>
        )}

        {/* 입력 영역 */}
        <div className="input-area">
          <div className="input-container">
            <div className="input-icons">
              <div className="input-icon black"></div>
              <div className="input-icon gray"></div>
            </div>
            <input
              type="text"
              value={inputValue}
              onChange={(e) => setInputValue(e.target.value)}
              onKeyPress={handleKeyPress}
              placeholder="메시지를 입력하거나 기능을 요청하세요..."
              className="message-input"
            />
            <div className="input-actions">
              <div className="action-icon gray"></div>
              <div className="action-icon black"></div>
            </div>
          </div>
        </div>
      </div>

      {/* 프로젝트 생성 모달 */}
      {showProjectModal && (
        <div className="modal-overlay">
          <div className="modal-content">
            <div className="modal-header">
              <h3>새 프로젝트 생성</h3>
              <button
                className="modal-close"
                onClick={() => setShowProjectModal(false)}
              >
                ×
              </button>
            </div>
            <div className="modal-body">
              <div className="form-group">
                <label>프로젝트 이름</label>
                <input
                  type="text"
                  value={newProjectName}
                  onChange={(e) => setNewProjectName(e.target.value)}
                  placeholder="프로젝트 이름을 입력하세요"
                  className="form-input"
                />
              </div>
              <div className="form-group">
                <label>프로젝트 설명</label>
                <textarea
                  value={newProjectDescription}
                  onChange={(e) => setNewProjectDescription(e.target.value)}
                  placeholder="프로젝트 설명을 입력하세요"
                  className="form-textarea"
                  rows={3}
                />
              </div>
            </div>
            <div className="modal-footer">
              <button
                className="btn btn-secondary"
                onClick={() => setShowProjectModal(false)}
              >
                취소
              </button>
              <button
                className="btn btn-primary"
                onClick={handleCreateNewProject}
              >
                생성
              </button>
            </div>
          </div>
        </div>
      )}

      {/* 채팅 생성 모달 */}
      {showChatModal && (
        <div className="modal-overlay">
          <div className="modal-content">
            <div className="modal-header">
              <h3>새 채팅 생성</h3>
              <button
                className="modal-close"
                onClick={() => setShowChatModal(false)}
              >
                ×
              </button>
            </div>
            <div className="modal-body">
              <div className="form-group">
                <label>채팅 제목</label>
                <input
                  type="text"
                  value={newChatTitle}
                  onChange={(e) => setNewChatTitle(e.target.value)}
                  placeholder="채팅 제목을 입력하세요"
                  className="form-input"
                />
              </div>
              <div className="form-group">
                <label>채팅 설명</label>
                <textarea
                  value={newChatDescription}
                  onChange={(e) => setNewChatDescription(e.target.value)}
                  placeholder="채팅 설명을 입력하세요"
                  className="form-textarea"
                  rows={3}
                />
              </div>
            </div>
            <div className="modal-footer">
              <button
                className="btn btn-secondary"
                onClick={() => setShowChatModal(false)}
              >
                취소
              </button>
              <button
                className="btn btn-primary"
                onClick={handleCreateNewChat}
              >
                생성
              </button>
            </div>
          </div>
        </div>
      )}

      {/* 음성 인식 상태 표시 */}
      {isVoiceRecording && (
        <div className="voice-status">
          🎤 음성 인식 중...
        </div>
      )}

      {/* 이미지 분석 진행 상태 */}
      {isImageAnalyzing && (
        <div className="image-analysis-progress">
          <div className="progress-spinner"></div>
          <p>이미지 분석 중...</p>
        </div>
      )}

      {/* 분석 결과 표시 */}
      {analysisResults && (
        <div className="analysis-results">
          <div className="analysis-header">
            <h3>분석 결과</h3>
            <button
              className="close-analysis"
              onClick={() => setAnalysisResults(null)}
              aria-label="분석 결과 닫기"
              title="분석 결과를 닫습니다"
            >
              ×
            </button>
          </div>
          <div className="analysis-content">
            {analysisResults?.type === 'image' && (
              <div className="image-analysis-result">
                <h4>이미지 분석 결과</h4>
                <p><strong>파일명:</strong> {analysisResults.filename}</p>
                <p><strong>분석:</strong> {analysisResults.analysis}</p>
              </div>
            )}
            {analysisResults?.type === 'prediction' && analysisResults.predictions && (
              <div className="prediction-analysis-result">
                <h4>예측 분석 결과</h4>
                {analysisResults.predictions.map((pred: {
                  category: string;
                  prediction: string;
                }, index: number) => (
                  <div key={index} className="prediction-item">
                    <span className="prediction-category">{pred.category}</span>
                    <span className="prediction-value">{pred.prediction}</span>
                  </div>
                ))}
              </div>
            )}
            {analysisResults?.type === 'advanced' && analysisResults.data && (
              <div className="advanced-analysis-result">
                <h4>고급 분석 결과</h4>
                <div className="analysis-sections">
                  <div className="analysis-section">
                    <h5>성능 분석</h5>
                    <div className="performance-metrics">
                      <div className="metric">
                        <span>응답 시간</span>
                        <span>{analysisResults.data.performance.responseTime.toFixed(2)}초</span>
                      </div>
                      <div className="metric">
                        <span>정확도</span>
                        <span>{analysisResults.data.performance.accuracy.toFixed(1)}%</span>
                      </div>
                      <div className="metric">
                        <span>만족도</span>
                        <span>{analysisResults.data.performance.satisfaction.toFixed(1)}/5.0</span>
                      </div>
                      <div className="metric">
                        <span>CPU 사용률</span>
                        <span>{analysisResults.data.performance.cpu.toFixed(1)}%</span>
                      </div>
                      <div className="metric">
                        <span>메모리 사용률</span>
                        <span>{analysisResults.data.performance.memory.toFixed(1)}%</span>
                      </div>
                      <div className="metric">
                        <span>디스크 사용률</span>
                        <span>{analysisResults.data.performance.disk.toFixed(1)}%</span>
                      </div>
                    </div>
                  </div>

                  <div className="analysis-section">
                    <h5>보안 지표</h5>
                    <div className="security-metrics">
                      <div className="metric">
                        <span>암호화 수준</span>
                        <span>{analysisResults.data.security.encryptionLevel}</span>
                      </div>
                      <div className="metric">
                        <span>인증 방법</span>
                        <span>{analysisResults.data.security.authenticationMethod}</span>
                      </div>
                      <div className="metric">
                        <span>데이터 보호</span>
                        <span>{analysisResults.data.security.dataProtection}</span>
                      </div>
                      <div className="metric">
                        <span>위협 수</span>
                        <span>{analysisResults.data.security.threats}</span>
                      </div>
                      <div className="metric">
                        <span>취약점 수</span>
                        <span>{analysisResults.data.security.vulnerabilities}</span>
                      </div>
                      <div className="metric">
                        <span>마지막 스캔</span>
                        <span>{new Date(analysisResults.data.security.lastScan).toLocaleString()}</span>
                      </div>
                    </div>
                  </div>

                  <div className="analysis-section">
                    <h5>사용량 지표</h5>
                    <div className="usage-metrics">
                      <div className="metric">
                        <span>일일 활성 사용자</span>
                        <span>{analysisResults.data.usage.dailyActiveUsers.toLocaleString()}</span>
                      </div>
                      <div className="metric">
                        <span>월간 성장률</span>
                        <span>{analysisResults.data.usage.monthlyGrowth.toFixed(1)}%</span>
                      </div>
                      <div className="metric">
                        <span>유지율</span>
                        <span>{analysisResults.data.usage.retentionRate.toFixed(1)}%</span>
                      </div>
                      <div className="metric">
                        <span>총 메시지</span>
                        <span>{analysisResults.data.usage.totalMessages.toLocaleString()}</span>
                      </div>
                      <div className="metric">
                        <span>활성 프로젝트</span>
                        <span>{analysisResults.data.usage.activeProjects}</span>
                      </div>
                      <div className="metric">
                        <span>저장소 사용량</span>
                        <span>{analysisResults.data.usage.storageUsed.toFixed(1)} MB</span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            )}
          </div>
        </div>
      )}

      {/* 숨겨진 파일 업로드 */}
      <input
        id="image-upload"
        type="file"
        accept="image/*"
        onChange={handleImageAnalysis}
        style={{ display: 'none' }}
        aria-label="이미지 파일 업로드"
        title="이미지 파일을 선택하세요"
      />

      {/* 알림 패널 */}
      {showNotifications && (
        <div className="notifications-panel">
          <div className="notifications-header">
            <h3>알림</h3>
            <button
              className="close-notifications"
              onClick={() => setShowNotifications(false)}
              aria-label="알림 패널 닫기"
              title="알림 패널을 닫습니다"
            >
              ×
            </button>
          </div>
          <div className="notifications-list">
            {notifications.length === 0 ? (
              <p className="no-notifications">새로운 알림이 없습니다.</p>
            ) : (
              notifications.map(notification => (
                <div key={notification.id} className={`notification-item ${notification.type}`}>
                  <div className="notification-header">
                    <span className="notification-title">{notification.title}</span>
                    <span className="notification-time">
                      {notification.timestamp.toLocaleTimeString()}
                    </span>
                  </div>
                  <p className="notification-message">{notification.message}</p>
                </div>
              ))
            )}
          </div>
        </div>
      )}



      {/* 실시간 협업 패널 */}
      {collaborationSession && (
        <div className="collaboration-panel">
          <h3>실시간 협업</h3>
          <div className="collaboration-participants">
            <h4>참여자 ({collaborationSession.participants.length})</h4>
            {collaborationSession.participants.map(participant => (
              <div key={participant.id} className="participant-item">
                <div className={`participant-status ${participant.status}`}></div>
                <div className="participant-info">
                  <span className="participant-name">{participant.name}</span>
                  <span className="participant-task">{participant.currentTask}</span>
                  <span className="participant-activity">
                    마지막 활동: {new Date(participant.lastActivity).toLocaleTimeString()}
                  </span>
                </div>
              </div>
            ))}
          </div>

          <div className="shared-files">
            <h4>공유 파일 ({collaborationSession.sharedFiles.length})</h4>
            {collaborationSession.sharedFiles.map(file => (
              <div key={file.id} className="shared-file-item">
                <span className="file-name">{file.name}</span>
                <span className="file-modified">
                  수정: {new Date(file.lastModified).toLocaleString()} by {file.modifiedBy}
                </span>
              </div>
            ))}
          </div>

          <div className="active-editors">
            <h4>활성 편집자 ({collaborationSession.activeEditors.length})</h4>
            {collaborationSession.activeEditors.map(editor => (
              <div key={`${editor.fileId}-${editor.userId}`} className="editor-item">
                <span className="editor-user">{editor.userName}</span>
                <span className="editor-position">
                  라인 {editor.cursorPosition.line}, 열 {editor.cursorPosition.column}
                </span>
              </div>
            ))}
          </div>
        </div>
      )}

      {/* 고급 통계 패널 */}
      {advancedStats && (
        <div className="advanced-stats-panel">
          <h3>고급 통계</h3>

          <div className="stats-section">
            <h4>생산성 지표</h4>
            <div className="stats-grid">
              <div className="stat-item">
                <span className="stat-label">시간당 메시지</span>
                <span className="stat-value">{advancedStats.productivity.messagesPerHour}</span>
              </div>
              <div className="stat-item">
                <span className="stat-label">응답 시간</span>
                <span className="stat-value">{advancedStats.productivity.responseTime.toFixed(2)}초</span>
              </div>
              <div className="stat-item">
                <span className="stat-label">정확도</span>
                <span className="stat-value">{advancedStats.productivity.accuracy.toFixed(1)}%</span>
              </div>
              <div className="stat-item">
                <span className="stat-label">사용자 만족도</span>
                <span className="stat-value">{advancedStats.productivity.userSatisfaction.toFixed(1)}/5.0</span>
              </div>
            </div>
          </div>

          <div className="stats-section">
            <h4>시스템 성능</h4>
            <div className="stats-grid">
              <div className="stat-item">
                <span className="stat-label">CPU 사용률</span>
                <span className="stat-value">{advancedStats.system.cpuUsage.toFixed(1)}%</span>
              </div>
              <div className="stat-item">
                <span className="stat-label">메모리 사용률</span>
                <span className="stat-value">{advancedStats.system.memoryUsage.toFixed(1)}%</span>
              </div>
              <div className="stat-item">
                <span className="stat-label">네트워크 지연</span>
                <span className="stat-value">{advancedStats.system.networkLatency.toFixed(1)}ms</span>
              </div>
              <div className="stat-item">
                <span className="stat-label">오류율</span>
                <span className="stat-value">{advancedStats.system.errorRate.toFixed(2)}%</span>
              </div>
            </div>
          </div>

          <div className="stats-section">
            <h4>사용량 트렌드</h4>
            <div className="trend-chart">
              {advancedStats.trends.dailyActiveUsers.map((users, index) => (
                <div key={index} className="trend-bar" style={{ height: `${(users / 1500) * 100}%` }}>
                  <span className="trend-label">{users}</span>
                </div>
              ))}
            </div>
            <div className="trend-metrics">
              <div className="trend-item">
                <span>주간 성장률</span>
                <span>{advancedStats.trends.weeklyGrowth.toFixed(1)}%</span>
              </div>
              <div className="trend-item">
                <span>월간 유지율</span>
                <span>{advancedStats.trends.monthlyRetention.toFixed(1)}%</span>
              </div>
            </div>
          </div>

          <div className="stats-section">
            <h4>기능 사용률</h4>
            <div className="feature-usage">
              <div className="usage-item">
                <span>채팅</span>
                <div className="usage-bar">
                  <div className="usage-fill" style={{ width: `${advancedStats.trends.featureUsage.chat}%` }}></div>
                </div>
                <span>{advancedStats.trends.featureUsage.chat.toFixed(1)}%</span>
              </div>
              <div className="usage-item">
                <span>분석</span>
                <div className="usage-bar">
                  <div className="usage-fill" style={{ width: `${advancedStats.trends.featureUsage.analysis}%` }}></div>
                </div>
                <span>{advancedStats.trends.featureUsage.analysis.toFixed(1)}%</span>
              </div>
              <div className="usage-item">
                <span>협업</span>
                <div className="usage-bar">
                  <div className="usage-fill" style={{ width: `${advancedStats.trends.featureUsage.collaboration}%` }}></div>
                </div>
                <span>{advancedStats.trends.featureUsage.collaboration.toFixed(1)}%</span>
              </div>
              <div className="usage-item">
                <span>파일 공유</span>
                <div className="usage-bar">
                  <div className="usage-fill" style={{ width: `${advancedStats.trends.featureUsage.fileSharing}%` }}></div>
                </div>
                <span>{advancedStats.trends.featureUsage.fileSharing.toFixed(1)}%</span>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* 파일 업로드 모달 */}
      {showFileUpload && (
        <div className="modal-overlay">
          <div className="modal-content">
            <div className="modal-header">
              <h3>파일 업로드</h3>
              <button
                className="modal-close"
                onClick={() => setShowFileUpload(false)}
              >
                ×
              </button>
            </div>
            <div className="modal-body">
              <div className="file-upload-area">
                <input
                  type="file"
                  multiple
                  onChange={handleFileUpload}
                  className="file-input"
                  aria-label="파일 선택"
                  title="업로드할 파일을 선택하세요"
                />
                <p className="upload-hint">파일을 선택하거나 여기에 드래그하세요</p>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* 지침 편집 모달 */}
      {showGuidelineEditor && (
        <div className="modal-overlay">
          <div className="modal-content">
            <div className="modal-header">
              <h3>{editingGuideline ? '지침 수정' : '새 지침 추가'}</h3>
              <button
                className="modal-close"
                onClick={() => {
                  setShowGuidelineEditor(false);
                  setEditingGuideline(null);
                }}
              >
                ×
              </button>
            </div>
            <div className="modal-body">
              <div className="form-group">
                <label>제목</label>
                <input
                  type="text"
                  defaultValue={editingGuideline?.title || ''}
                  className="form-input"
                  placeholder="지침 제목을 입력하세요"
                />
              </div>
              <div className="form-group">
                <label>내용</label>
                <textarea
                  defaultValue={editingGuideline?.content || ''}
                  className="form-textarea"
                  rows={5}
                  placeholder="지침 내용을 입력하세요"
                />
              </div>
              <div className="form-group">
                <label>우선순위</label>
                <select className="form-select" defaultValue={editingGuideline?.priority || 'medium'} aria-label="우선순위 선택" title="지침의 우선순위를 선택하세요">
                  <option value="low">낮음</option>
                  <option value="medium">보통</option>
                  <option value="high">높음</option>
                </select>
              </div>
            </div>
            <div className="modal-footer">
              <button
                className="btn btn-secondary"
                onClick={() => {
                  setShowGuidelineEditor(false);
                  setEditingGuideline(null);
                }}
              >
                취소
              </button>
              <button
                className="btn btn-primary"
                onClick={() => handleGuidelineSave({
                  title: '새 지침',
                  content: '지침 내용',
                  priority: 'medium'
                })}
              >
                저장
              </button>
            </div>
          </div>
        </div>
      )}

      {/* AI 문서 분석 결과 */}
      {documentAnalysis && (
        <div className="document-analysis-panel">
          <h3>AI 문서 분석 결과</h3>
          <div className="analysis-header">
            <div className="file-info">
              <span className="filename">{documentAnalysis.filename}</span>
              <span className={`status ${documentAnalysis.status}`}>
                {documentAnalysis.status === 'processing' ? '분석 중...' :
                  documentAnalysis.status === 'completed' ? '분석 완료' : '오류'}
              </span>
            </div>
            {documentAnalysis.status === 'completed' && (
              <div className="processing-time">
                처리 시간: {documentAnalysis.processingTime}초
              </div>
            )}
          </div>

          {documentAnalysis.status === 'completed' && documentAnalysis.results && (
            <div className="analysis-results">
              <div className="result-section">
                <h4>요약</h4>
                <p>{documentAnalysis.results.summary}</p>
              </div>

              <div className="result-section">
                <h4>주요 포인트</h4>
                <ul className="key-points">
                  {documentAnalysis.results.keyPoints.map((point, index) => (
                    <li key={index}>{point}</li>
                  ))}
                </ul>
              </div>

              <div className="result-section">
                <h4>감정 분석</h4>
                <div className={`sentiment ${documentAnalysis.results.sentiment}`}>
                  {documentAnalysis.results.sentiment === 'positive' ? '긍정적' :
                    documentAnalysis.results.sentiment === 'negative' ? '부정적' : '중립'}
                </div>
              </div>

              <div className="result-section">
                <h4>추출된 엔티티</h4>
                <div className="entities-grid">
                  {documentAnalysis.results.entities.map((entity, index) => (
                    <div key={index} className="entity-item">
                      <span className="entity-name">{entity.name}</span>
                      <span className="entity-type">{entity.type}</span>
                      <span className="entity-confidence">
                        신뢰도: {(entity.confidence * 100).toFixed(1)}%
                      </span>
                    </div>
                  ))}
                </div>
              </div>

              <div className="result-section">
                <h4>주제 분석</h4>
                <div className="topics-chart">
                  {documentAnalysis.results.topics.map((topic, index) => (
                    <div key={index} className="topic-item">
                      <span className="topic-name">{topic.name}</span>
                      <div className="topic-bar">
                        <div
                          className="topic-fill"
                          style={{ width: `${topic.weight * 100}%` }}
                        ></div>
                      </div>
                      <span className="topic-weight">{(topic.weight * 100).toFixed(1)}%</span>
                    </div>
                  ))}
                </div>
              </div>

              <div className="result-section">
                <h4>추천사항</h4>
                <ul className="recommendations">
                  {documentAnalysis.results.recommendations.map((rec, index) => (
                    <li key={index}>{rec}</li>
                  ))}
                </ul>
              </div>
            </div>
          )}
        </div>
      )}

      {/* 제거된 패널들:
      - 자동화 워크플로우 패널
      - 고급 검색 패널 */}

      {/* 제거된 패널들:
      - ML 예측 분석 패널
      - 보안 대시보드 패널
      - 데이터 시각화 패널
      - 블록체인 무결성 검증 패널
      - AI 모델 관리 패널
      - 양자 컴퓨팅 시뮬레이션 패널 */}

      {/* 신경망 시각화 패널 */}
      <div className="neural-network-panel">
        <h3>신경망 시각화</h3>

        <div className="network-overview">
          <h4>네트워크 구조</h4>
          <div className="layers-visualization">
            {neuralNetwork.layers.map((layer, layerIndex) => (
              <div key={layer.id} className="layer-container">
                <div className="layer-header">
                  <h5>{layer.type.toUpperCase()} Layer</h5>
                  <span className="layer-info">
                    {layer.neurons} neurons, {layer.activation}
                  </span>
                </div>
                <div className="neurons-grid">
                  {Array.from({ length: layer.neurons }, (_, neuronIndex) => (
                    <div key={neuronIndex} className="neuron">
                      <div className="neuron-circle"></div>
                      {layerIndex < neuralNetwork.layers.length - 1 && (
                        <div className="connections">
                          {Array.from({ length: neuralNetwork.layers[layerIndex + 1].neurons }, (_, nextNeuronIndex) => (
                            <div
                              key={nextNeuronIndex}
                              className="connection"
                              style={{
                                opacity: layer.weights[neuronIndex]?.[nextNeuronIndex]
                                  ? Math.abs(layer.weights[neuronIndex][nextNeuronIndex])
                                  : 0.1
                              }}
                            ></div>
                          ))}
                        </div>
                      )}
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>

        <div className="training-section">
          <h4>훈련 상태</h4>
          <div className="training-metrics">
            <div className="metric-card">
              <span className="metric-label">Epoch</span>
              <span className="metric-value">
                {neuralNetwork.training.epoch} / {neuralNetwork.training.totalEpochs}
              </span>
            </div>
            <div className="metric-card">
              <span className="metric-label">Loss</span>
              <span className="metric-value">{neuralNetwork.training.loss.toFixed(4)}</span>
            </div>
            <div className="metric-card">
              <span className="metric-label">Accuracy</span>
              <span className="metric-value">{(neuralNetwork.training.accuracy * 100).toFixed(2)}%</span>
            </div>
            <div className="metric-card">
              <span className="metric-label">Learning Rate</span>
              <span className="metric-value">{neuralNetwork.training.learningRate}</span>
            </div>
          </div>

          <div className="training-controls">
            <button
              className="btn btn-primary"
              onClick={startNeuralNetworkTraining}
              disabled={neuralNetwork.training.isTraining}
            >
              {neuralNetwork.training.isTraining ? '훈련 중...' : '훈련 시작'}
            </button>
          </div>
        </div>
      </div>

      {/* AI 에이전트 시스템 패널 */}
      <div className="ai-agents-panel">
        <h3>AI 에이전트 시스템</h3>

        <div className="agents-overview">
          <h4>활성 에이전트 ({aiAgents.agents.length})</h4>
          <div className="agents-grid">
            {aiAgents.agents.map(agent => (
              <div key={agent.id} className="agent-card">
                <div className="agent-header">
                  <h5>{agent.name}</h5>
                  <span className={`agent-status ${agent.status}`}>
                    {agent.status === 'active' ? '활성' :
                      agent.status === 'idle' ? '대기' :
                        agent.status === 'busy' ? '작업 중' : '학습 중'}
                  </span>
                </div>

                <div className="agent-type">
                  <span className="type-badge">{agent.type}</span>
                </div>

                <div className="agent-capabilities">
                  <h6>능력</h6>
                  <div className="capabilities-list">
                    {agent.capabilities.map((capability, index) => (
                      <span key={index} className="capability-tag">{capability}</span>
                    ))}
                  </div>
                </div>

                <div className="agent-performance">
                  <h6>성능 지표</h6>
                  <div className="performance-metrics">
                    <div className="perf-metric">
                      <span>완료 작업</span>
                      <span>{agent.performance.tasksCompleted}</span>
                    </div>
                    <div className="perf-metric">
                      <span>성공률</span>
                      <span>{agent.performance.successRate}%</span>
                    </div>
                    <div className="perf-metric">
                      <span>평균 응답시간</span>
                      <span>{agent.performance.averageResponseTime}s</span>
                    </div>
                    <div className="perf-metric">
                      <span>사용자 만족도</span>
                      <span>{agent.performance.userSatisfaction}/5.0</span>
                    </div>
                  </div>
                </div>

                {agent.currentTask && (
                  <div className="agent-current-task">
                    <h6>현재 작업</h6>
                    <div className="task-info">
                      <div className="task-type">{agent.currentTask.type}</div>
                      <div className="task-description">{agent.currentTask.description}</div>
                      <div className="task-progress">
                        <div className="progress-bar">
                          <div
                            className="progress-fill"
                            style={{ width: `${agent.currentTask.progress}%` }}
                          ></div>
                        </div>
                        <span className="progress-text">{agent.currentTask.progress}%</span>
                      </div>
                      <div className="task-time">
                        시작: {new Date(agent.currentTask.startedAt).toLocaleString()}
                      </div>
                    </div>
                  </div>
                )}

                <div className="agent-memory">
                  <h6>메모리</h6>
                  <div className="memory-info">
                    <div className="memory-section">
                      <span className="memory-label">단기 메모리:</span>
                      <span className="memory-count">{agent.memory.shortTerm.length} 항목</span>
                    </div>
                    <div className="memory-section">
                      <span className="memory-label">장기 메모리:</span>
                      <span className="memory-count">{agent.memory.longTerm.length} 항목</span>
                    </div>
                  </div>
                </div>

                <div className="agent-actions">
                  <button
                    className="btn btn-primary"
                    onClick={() => assignTaskToAgent(agent.id, '데이터 분석', '새로운 데이터셋 분석')}
                  >
                    작업 할당
                  </button>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      {/* 실시간 학습 모니터링 패널 */}
      <div className="learning-monitor-panel">
        <h3>실시간 학습 모니터링</h3>

        <div className="system-metrics">
          <h4>시스템 메트릭</h4>
          <div className="metrics-grid">
            <div className="metric-card">
              <span className="metric-label">GPU 사용률</span>
              <span className="metric-value">{learningMonitor.systemMetrics.gpuUtilization}%</span>
            </div>
            <div className="metric-card">
              <span className="metric-label">메모리 사용률</span>
              <span className="metric-value">{learningMonitor.systemMetrics.memoryUsage}%</span>
            </div>
            <div className="metric-card">
              <span className="metric-label">CPU 사용률</span>
              <span className="metric-value">{learningMonitor.systemMetrics.cpuUsage}%</span>
            </div>
            <div className="metric-card">
              <span className="metric-label">네트워크 처리량</span>
              <span className="metric-value">{learningMonitor.systemMetrics.networkThroughput} MB/s</span>
            </div>
            <div className="metric-card">
              <span className="metric-label">활성 연결</span>
              <span className="metric-value">{learningMonitor.systemMetrics.activeConnections}</span>
            </div>
          </div>
        </div>

        <div className="active-models">
          <h4>활성 모델 ({learningMonitor.activeModels.length})</h4>
          <div className="models-list">
            {learningMonitor.activeModels.map(model => (
              <div key={model.id} className="model-training-card">
                <div className="model-header">
                  <h5>{model.name}</h5>
                  <span className={`model-status ${model.status}`}>
                    {model.status === 'training' ? '훈련 중' :
                      model.status === 'evaluating' ? '평가 중' :
                        model.status === 'deploying' ? '배포 중' : '완료'}
                  </span>
                </div>

                <div className="model-metrics">
                  <h6>성능 지표</h6>
                  <div className="metrics-row">
                    <div className="metric">
                      <span>Loss</span>
                      <span>{model.metrics.loss.toFixed(4)}</span>
                    </div>
                    <div className="metric">
                      <span>Accuracy</span>
                      <span>{(model.metrics.accuracy * 100).toFixed(2)}%</span>
                    </div>
                    <div className="metric">
                      <span>Precision</span>
                      <span>{(model.metrics.precision * 100).toFixed(2)}%</span>
                    </div>
                    <div className="metric">
                      <span>Recall</span>
                      <span>{(model.metrics.recall * 100).toFixed(2)}%</span>
                    </div>
                    <div className="metric">
                      <span>F1 Score</span>
                      <span>{(model.metrics.f1Score * 100).toFixed(2)}%</span>
                    </div>
                  </div>
                </div>

                <div className="model-progress">
                  <h6>진행 상황</h6>
                  <div className="progress-info">
                    <div className="progress-row">
                      <span>Epoch</span>
                      <span>{model.progress.epoch} / {model.progress.totalEpochs}</span>
                    </div>
                    <div className="progress-row">
                      <span>Batch</span>
                      <span>{model.progress.batch} / {model.progress.totalBatches}</span>
                    </div>
                    <div className="progress-row">
                      <span>경과 시간</span>
                      <span>{Math.floor(model.progress.timeElapsed / 60)}분 {model.progress.timeElapsed % 60}초</span>
                    </div>
                    <div className="progress-row">
                      <span>예상 남은 시간</span>
                      <span>{Math.floor(model.progress.estimatedTimeRemaining / 60)}분</span>
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      {/* 제거된 고급 기능 모달:
      - AdvancedFeatures 컴포넌트 제거됨 */}

      {/* 음성 인식 테스트 버튼 */}
      <button
        onClick={() => setShowVoiceTest(!showVoiceTest)}
        className="fixed bottom-20 right-4 bg-purple-600 text-white p-3 rounded-full shadow-lg hover:bg-purple-700 z-50"
        title="음성 인식 테스트"
      >
        🎤
      </button>

      {/* 음성 인식 테스트 모달 */}
      {showVoiceTest && (
        <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
          <div className="bg-white rounded-lg max-w-4xl w-full max-h-[90vh] overflow-y-auto">
            <div className="flex justify-between items-center p-4 border-b">
              <h2 className="text-xl font-bold">음성 인식 시스템 테스트</h2>
              <button
                onClick={() => setShowVoiceTest(false)}
                className="text-gray-500 hover:text-gray-700"
              >
                ✕
              </button>
            </div>
            <VoiceIntegrationTest />
          </div>
        </div>
      )}

      {/* 프로젝트 관리 버튼 */}
      <button
        onClick={() => setShowProjectRouter(!showProjectRouter)}
        className="fixed bottom-32 right-4 bg-green-600 text-white p-3 rounded-full shadow-lg hover:bg-green-700 z-50"
        title="프로젝트 관리"
      >
        📁
      </button>

      {/* 프로젝트 라우터 모달 */}
      {showProjectRouter && (
        <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
          <div className="bg-white rounded-lg w-full max-w-7xl mx-4 max-h-[90vh] overflow-hidden">
            <div className="flex justify-between items-center p-4 border-b">
              <h2 className="text-xl font-bold">프로젝트 관리</h2>
              <button
                onClick={() => setShowProjectRouter(false)}
                className="text-gray-500 hover:text-gray-700"
              >
                ✕
              </button>
            </div>
            <div className="h-[calc(90vh-80px)] overflow-hidden">
              <ProjectRouter />
            </div>
          </div>
        </div>
      )}
    </div>
  );
}

export default App;
