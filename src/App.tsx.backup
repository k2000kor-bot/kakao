  // 파일 업로드 처리
  const handleFileUpload = (event: React.ChangeEvent<HTMLInputElement>) => {
    const files = event.target.files;
    if (files && selectedProject) {
      const newFiles: ProjectFile[] = Array.from(files).map(file => {
        let fileType: 'document' | 'image' | 'video' | 'audio' | 'spreadsheet' | 'presentation' = 'document';

        if (file.type.includes('image')) {
          fileType = 'image';
        } else if (file.type.includes('video')) {
          fileType = 'video';
        } else if (file.type.includes('audio')) {
          fileType = 'audio';
        } else if (file.type.includes('spreadsheet') || file.name.endsWith('.xlsx') || file.name.endsWith('.xls')) {
          fileType = 'spreadsheet';
        } else if (file.type.includes('presentation') || file.name.endsWith('.ppt') || file.name.endsWith('.pptx')) {
          fileType = 'presentation';
        } else {
          fileType = 'document';
        }

        return {
          id: Date.now().toString() + Math.random(),
          name: file.name,
          type: fileType,
          size: file.size,
          uploadedAt: new Date().toISOString().split('T')[0],
          url: URL.createObjectURL(file),
          description: ''
        };
      });

      setProjects(prev => prev.map(p =>
        p.id === selectedProject.id
          ? { ...p, files: [...p.files, ...newFiles] }
          : p
      ));

      addNotification('success', '파일 업로드 완료', `${newFiles.length}개의 파일이 업로드되었습니다.`);
      setShowFileUpload(false);
    }
  };

  // 지침 추가/수정
  const handleGuidelineSave = (guideline: {
    title: string;
    content: string;
    type?: 'basic' | 'technical' | 'process' | 'reference';
    priority?: 'low' | 'medium' | 'high';
  }) => {
    if (selectedProject) {
      const newGuideline: ProjectGuideline = {
        id: editingGuideline?.id || Date.now().toString(),
        title: guideline.title,
        content: guideline.content,
        type: guideline.type || 'basic',
        createdAt: editingGuideline?.createdAt || new Date().toISOString().split('T')[0],
        priority: guideline.priority || 'medium'
      };

      setProjects(prev => prev.map(p =>
        p.id === selectedProject.id
          ? {
            ...p,
            guidelines: editingGuideline
              ? p.guidelines.map(g => g.id === editingGuideline.id ? newGuideline : g)
              : [...p.guidelines, newGuideline]
          }
          : p
      ));

      addNotification('success', '지침 저장 완료', editingGuideline ? '지침이 수정되었습니다.' : '새 지침이 추가되었습니다.');
      setShowGuidelineEditor(false);
      setEditingGuideline(null);
    }
  };

