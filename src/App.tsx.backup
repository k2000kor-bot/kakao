        content: `📤 내보내기 옵션\n\n${userInput}에 대한 내보내기 옵션입니다.\n\n📁 지원 형식:\n• PDF: 고품질 문서\n• Excel: 데이터 분석용\n• Word: 편집 가능한 문서\n• PNG: 이미지 파일\n\n어떤 형식으로 내보내시겠습니까?`,
        isUser: false,
        timestamp: new Date(),
        type: 'text'
      };
    }

    // 실시간 분석 요청 감지
    if (lowerInput.includes('실시간') || lowerInput.includes('realtime') || lowerInput.includes('라이브')) {
      return {
        id: (Date.now() + 1).toString(),
        content: `⚡ 실시간 분석\n\n${userInput}에 대한 실시간 분석을 시작했습니다.\n\n🔄 실시간 지표:\n• 현재 처리량: 1,234건/분\n• 평균 응답시간: 2.3초\n• 시스템 상태: 정상\n• 업데이트: 30초마다\n\n실시간 모니터링을 중지하시겠습니까?`,
        isUser: false,
        timestamp: new Date(),
        type: 'analysis'
      };
    }

    // 파일 업로드 요청 감지
    if (lowerInput.includes('파일') || lowerInput.includes('upload') || lowerInput.includes('업로드')) {
      return {
        id: (Date.now() + 1).toString(),
        content: `📁 파일 업로드 안내\n\n파일을 업로드하려면 다음 방법을 사용하세요:\n\n1. 사이드바의 "파일 업로드" 클릭\n2. 드래그 앤 드롭으로 파일 추가\n3. 지원 형식: PDF, DOC, XLS, 이미지\n\n업로드된 파일은 자동으로 분석되어 결과를 제공합니다.`,
        isUser: false,
        timestamp: new Date(),
        type: 'text'
      };
    }

    // 프로젝트 목록 요청 감지
    if (lowerInput.includes('프로젝트') || lowerInput.includes('project') || lowerInput.includes('목록')) {
      const projectList = projects.map(project =>
        `• ${project.name} (${project.messageCount}개 메시지, ${project.files.length}개 파일)`
      ).join('\n');

      return {
        id: (Date.now() + 1).toString(),
        content: `📁 프로젝트 목록\n\n현재 활성 프로젝트:\n\n${projectList}\n\n프로젝트 상세보기: "프로젝트 상세 [프로젝트명]"\n새 프로젝트 생성: "새 프로젝트 생성"\n프로젝트 삭제: "프로젝트 삭제 [프로젝트명]"`,
        isUser: false,
        timestamp: new Date(),
        type: 'text' as const
      };
    }

    // 프로젝트 상세보기 요청 감지
    if (lowerInput.includes('프로젝트 상세') || lowerInput.includes('상세보기')) {
      const projectName = lowerInput.replace('프로젝트 상세', '').replace('상세보기', '').trim();
      const project = projects.find(p => p.name.toLowerCase().includes(projectName.toLowerCase()));

      if (project) {
        const fileList = project.files.map(file =>
          `  - ${file.name} (${formatFileSize(file.size)})`
        ).join('\n');

        const guidelineList = project.guidelines.map(guideline =>
          `  - ${guideline.title} (${guideline.priority})`
        ).join('\n');

        return {
          id: (Date.now() + 1).toString(),
          content: `📋 프로젝트 상세 정보\n\n🏗️ ${project.name}\n\n📝 설명: ${project.description}\n📅 생성일: ${project.createdAt}\n🕒 마지막 활동: ${project.lastActivity}\n💬 메시지 수: ${project.messageCount}개\n\n📁 파일 (${project.files.length}개):\n${fileList}\n\n📋 가이드라인 (${project.guidelines.length}개):\n${guidelineList}\n\n⚙️ 설정:\n  - 테마: ${project.settings.theme}\n  - 언어: ${project.settings.language}\n  - AI 모델: ${project.settings.aiModel}\n  - 자동저장: ${project.settings.autoSave ? '활성화' : '비활성화'}\n  - 협업: ${project.settings.collaboration ? '활성화' : '비활성화'}\n\n프로젝트 편집: "프로젝트 편집 [프로젝트명]"\n파일 업로드: "파일 업로드 [프로젝트명]"\n가이드라인 추가: "가이드라인 추가 [프로젝트명]"`,
          isUser: false,
          timestamp: new Date(),
          type: 'text' as const
        };
      } else {
        return {
          id: (Date.now() + 1).toString(),
          content: `❌ 프로젝트를 찾을 수 없습니다.\n\n사용 가능한 프로젝트:\n${projects.map(p => `• ${p.name}`).join('\n')}\n\n정확한 프로젝트명을 입력해 주세요.`,
          isUser: false,
          timestamp: new Date(),
          type: 'text' as const
        };
      }
    }

    // 새 프로젝트 생성 요청 감지
    if (lowerInput.includes('새 프로젝트') || lowerInput.includes('프로젝트 생성')) {
      // 프로젝트명과 설명 추출 시도
      const projectMatch = userInput.match(/프로젝트명:\s*(.+?)(?:\n|$)/i);
      const descMatch = userInput.match(/설명:\s*(.+?)(?:\n|$)/i);

      if (projectMatch && descMatch) {
        const projectName = projectMatch[1].trim();
        const description = descMatch[1].trim();

        const newProject = createProject(projectName, description);

        return {
          id: (Date.now() + 1).toString(),
          content: `✅ 새 프로젝트가 생성되었습니다!\n\n📁 프로젝트명: ${newProject.name}\n📝 설명: ${newProject.description}\n📅 생성일: ${newProject.createdAt}\n\n프로젝트 목록에서 확인하거나 "프로젝트 상세 ${newProject.name}"으로 상세 정보를 볼 수 있습니다.`,
          isUser: false,
          timestamp: new Date(),
          type: 'text' as const
        };
      } else {
        return {
          id: (Date.now() + 1).toString(),
          content: `🆕 새 프로젝트 생성\n\n새 프로젝트를 생성하려면 다음 정보를 제공해 주세요:\n\n프로젝트명: [프로젝트명 입력]\n설명: [프로젝트 설명 입력]\n\n예시:\n프로젝트명: 부동산 개발 프로젝트\n설명: 강남구 재개발 사업 분석 및 계획\n\n프로젝트명과 설명을 입력해 주시면 새 프로젝트를 생성하겠습니다.`,
          isUser: false,
          timestamp: new Date(),
          type: 'text' as const
        };
      }
    }

    // 새 채팅 생성 요청 감지
    if (lowerInput.includes('새 채팅') || lowerInput.includes('채팅 생성')) {
      // 채팅 제목과 설명 추출 시도
      const titleMatch = userInput.match(/제목:\s*(.+?)(?:\n|$)/i);
      const descMatch = userInput.match(/설명:\s*(.+?)(?:\n|$)/i);

      if (titleMatch && descMatch) {
        const title = titleMatch[1].trim();
        const description = descMatch[1].trim();
        const projectId = selectedProjectId || '1'; // 기본 프로젝트 또는 선택된 프로젝트

        const newChat = createChat(projectId, title, description);

        return {
          id: (Date.now() + 1).toString(),
          content: `✅ 새 채팅이 생성되었습니다!\n\n💬 채팅명: ${newChat.title}\n📝 설명: ${newChat.description}\n📅 생성일: ${newChat.createdAt}\n\n채팅 목록에서 확인하거나 바로 대화를 시작할 수 있습니다.`,
          isUser: false,
          timestamp: new Date(),
          type: 'text' as const
        };
      } else {
        return {
          id: (Date.now() + 1).toString(),
          content: `🆕 새 채팅 생성\n\n새 채팅을 생성하려면 다음 정보를 제공해 주세요:\n\n제목: [채팅 제목 입력]\n설명: [채팅 설명 입력]\n\n예시:\n제목: 부동산 분석 채팅\n설명: 부동산 시장 분석 및 논의\n\n제목과 설명을 입력해 주시면 새 채팅을 생성하겠습니다.`,
          isUser: false,
          timestamp: new Date(),
          type: 'text' as const
        };
      }
    }

    // 채팅 목록 요청 감지
    if (lowerInput.includes('채팅 목록') || lowerInput.includes('채팅 리스트')) {
      const chatList = chats.map(chat => {
        const project = projects.find(p => p.id === chat.projectId);
        return `• ${chat.title} (${project?.name || '알 수 없음'}) - ${chat.messages.length}개 메시지`;
      }).join('\n');

      return {
        id: (Date.now() + 1).toString(),
        content: `💬 채팅 목록\n\n현재 활성 채팅:\n\n${chatList}\n\n채팅 상세보기: "채팅 상세 [채팅명]"\n새 채팅 생성: "새 채팅 생성"\n프로젝트별 채팅: "프로젝트 채팅 [프로젝트명]"`,
        isUser: false,
        timestamp: new Date(),
        type: 'text' as const
      };
    }

    // 프로젝트별 채팅 요청 감지
    if (lowerInput.includes('프로젝트 채팅')) {
      const projectName = lowerInput.replace('프로젝트 채팅', '').trim();
      const project = projects.find(p => p.name.toLowerCase().includes(projectName.toLowerCase()));

      if (project) {
        const projectChats = getProjectChats(project.id);
        const chatList = projectChats.map(chat =>
          `• ${chat.title} - ${chat.messages.length}개 메시지`
        ).join('\n');

        return {
          id: (Date.now() + 1).toString(),
          content: `📁 ${project.name} 채팅 목록\n\n${chatList || '아직 채팅이 없습니다.'}\n\n새 채팅 생성: "새 채팅 생성"\n채팅 상세보기: "채팅 상세 [채팅명]"`,
          isUser: false,
          timestamp: new Date(),
          type: 'text' as const
        };
      } else {
        return {
          id: (Date.now() + 1).toString(),
          content: `❌ 프로젝트를 찾을 수 없습니다.\n\n사용 가능한 프로젝트:\n${projects.map(p => `• ${p.name}`).join('\n')}\n\n정확한 프로젝트명을 입력해 주세요.`,
          isUser: false,
          timestamp: new Date(),
          type: 'text' as const
        };
      }
    }

    // 파일 업로드 요청 감지
    if (lowerInput.includes('파일 업로드') || lowerInput.includes('파일 추가')) {
      return {
        id: (Date.now() + 1).toString(),
        content: `📁 파일 업로드 안내\n\n파일을 업로드하려면 다음 방법을 사용하세요:\n\n1. 사이드바의 "파일 업로드" 버튼 클릭\n2. 드래그 앤 드롭으로 파일 추가\n3. 지원 형식: PDF, DOC, XLS, 이미지, 동영상\n\n업로드된 파일은 자동으로 분석되어 결과를 제공합니다.\n\n특정 프로젝트에 파일을 추가하려면:\n"파일 업로드 [프로젝트명] [파일명]" 형식으로 입력하세요.`,
        isUser: false,
        timestamp: new Date(),
        type: 'text' as const
      };
    }

    // 가이드라인 추가 요청 감지
    if (lowerInput.includes('가이드라인') || lowerInput.includes('지침')) {
      return {
        id: (Date.now() + 1).toString(),
        content: `📋 가이드라인 관리\n\n가이드라인을 추가하려면 다음 정보를 제공해 주세요:\n\n제목: [가이드라인 제목]\n내용: [가이드라인 내용]\n유형: basic/technical/process/reference\n우선순위: low/medium/high\n\n예시:\n제목: 개발 가이드라인\n내용: 부동산 개발 시 준수해야 할 기본 가이드라인\n유형: basic\n우선순위: high\n\n가이드라인 정보를 입력해 주시면 추가하겠습니다.`,
        isUser: false,
        timestamp: new Date(),
        type: 'text' as const
      };
    }

    // 도움말 요청 감지
    if (lowerInput.includes('도움') || lowerInput.includes('help') || lowerInput.includes('명령어')) {
      return {
        id: (Date.now() + 1).toString(),
        content: `💡 CORBU AI 도움말\n\n사용 가능한 명령어:\n\n📊 분석 기능:\n• "데이터를 분석해줘"\n• "분석 결과 보여줘"\n• "실시간 분석"\n• "예측 분석"\n• "보안 분석"\n• "성능 최적화"\n• "감정 분석"\n• "머신러닝 모델"\n• "블록체인 분석"\n• "IoT 데이터 분석"\n• "양자 컴퓨팅"\n• "AR/VR 분석"\n• "생체인식 보안"\n• "자율주행 분석"\n\n🏠 부동산/도시정비 기능:\n• "부동산 분석"\n• "도시정비 분석"\n• "여론분석"\n• "시공사선정"\n• "토지이용계획"\n• "환경영향평가"\n• "교통영향평가"\n• "경제성분석"\n\n📁 프로젝트 관리:\n• "프로젝트 목록"\n• "프로젝트 상세 [프로젝트명]"\n• "새 프로젝트 생성"\n• "파일 업로드"\n• "가이드라인 추가"\n\n💬 채팅 관리:\n• "채팅 목록"\n• "새 채팅 생성"\n• "프로젝트 채팅 [프로젝트명]"\n\n📈 차트 기능:\n• "차트로 보여줘"\n• "그래프 생성해줘"\n\n📋 데이터 기능:\n• "데이터 요약해줘"\n• "통계 보여줘"\n\n🤖 AI 기능:\n• "AI 학습"\n• "자동화 설정"\n\n👥 협업 기능:\n• "협업 설정"\n• "팀 관리"\n\n🌐 언어 기능:\n• "번역"\n• "음성 변환"\n\n💻 개발 기능:\n• "코드 생성"\n• "API 통합"\n\n📱 콘텐츠 기능:\n• "카드뉴스 생성"\n\n📝 기타 기능:\n• "요약해줘"\n• "템플릿 생성"\n• "내보내기"\n• "파일 업로드 방법"\n\n무엇을 도와드릴까요?`,
        isUser: false,
        timestamp: new Date(),
        type: 'text'
      };
    }

    // 일반 응답
    return {
      id: (Date.now() + 1).toString(),
      content: `안녕하세요! CORBU AI가 도와드리겠습니다. ${userInput}에 대해 무엇을 도와드릴까요?\n\n💡 사용 가능한 기능:\n• 분석: "데이터를 분석해줘"\n• 차트: "차트로 보여줘"\n• 데이터: "데이터를 보여줘"\n• 예측: "예측 분석"\n• AI 학습: "AI 학습"\n• 자동화: "자동화 설정"\n• 협업: "협업 설정"\n• 보안: "보안 분석"\n• 성능: "성능 최적화"\n• 감정: "감정 분석"\n• 머신러닝: "머신러닝 모델"\n• 블록체인: "블록체인 분석"\n• IoT: "IoT 데이터 분석"\n• 양자: "양자 컴퓨팅"\n• AR/VR: "AR/VR 분석"\n• 생체: "생체인식 보안"\n• 자율주행: "자율주행 분석"\n• API: "API 통합"\n• 번역: "번역"\n• 음성: "음성 변환"\n• 코드: "코드 생성"\n• 카드뉴스: "카드뉴스 생성"\n• 부동산: "부동산 분석"\n• 도시정비: "도시정비 분석"\n• 여론: "여론분석"\n• 시공사: "시공사선정"\n• 토지이용: "토지이용계획"\n• 환경: "환경영향평가"\n• 교통: "교통영향평가"\n• 경제성: "경제성분석"\n• 프로젝트: "프로젝트 목록"\n• 프로젝트상세: "프로젝트 상세 [프로젝트명]"\n• 새프로젝트: "새 프로젝트 생성"\n• 파일업로드: "파일 업로드"\n• 가이드라인: "가이드라인 추가"\n• 요약: "요약해줘"\n• 템플릿: "템플릿 생성"\n• 내보내기: "내보내기"\n• 실시간: "실시간 분석"\n• 도움말: "도움말" 또는 "help"\n• 일반 대화: 자유롭게 질문하세요`,
      isUser: false,
      timestamp: new Date(),
      type: 'text'
    };
  };

  const handleKeyPress = (e: React.KeyboardEvent) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      handleSendMessage();
    }
  };

  // 새 프로젝트 생성 핸들러
  const handleCreateNewProject = () => {
    if (!newProjectName.trim() || !newProjectDescription.trim()) {
      alert('프로젝트 이름과 설명을 입력해주세요.');
      return;
    }

    const newProject = createProject(newProjectName, newProjectDescription);
    setSelectedProjectId(newProject.id);
    setShowProjectModal(false);
    setNewProjectName('');
    setNewProjectDescription('');
  };

  // 새 채팅 생성 핸들러
  const handleCreateNewChat = () => {
    if (!selectedProjectId) {
      alert('먼저 프로젝트를 선택해주세요.');
      return;
    }

    if (!newChatTitle.trim() || !newChatDescription.trim()) {
      alert('채팅 제목과 설명을 입력해주세요.');
      return;
    }

    const newChat = createChat(selectedProjectId, newChatTitle, newChatDescription);
    setSelectedChatId(newChat.id);
    setShowChatModal(false);
    setNewChatTitle('');
    setNewChatDescription('');
  };

