  "shortcuts": [
    {
      "name": "새 프로젝트",
      "short_name": "새 프로젝트",
      "description": "새로운 프로젝트를 빠르게 생성합니다",
      "url": "/?action=new-project",
      "icons": [
        {
          "src": "/icons/shortcut-new-project.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "음성 채팅",
      "short_name": "음성 채팅",
      "description": "AI와 음성으로 대화합니다",
      "url": "/?action=voice-chat",
      "icons": [
        {
          "src": "/icons/shortcut-voice.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "데이터 시각화",
      "short_name": "차트",
      "description": "데이터를 차트로 시각화합니다",
      "url": "/?action=visualization",
      "icons": [
        {
          "src": "/icons/shortcut-chart.png",
          "sizes": "96x96"
        }
      ]
    }
  ],
  "features": [
    "offline",
    "push-notifications",
    "background-sync",
    "speech-recognition",
    "text-to-speech",
    "file-handling"
  ],
  "file_handlers": [
    {
      "action": "/handle-files",
      "accept": {
        "application/pdf": [
          ".pdf"
        ],
        "application/msword": [
          ".doc"
        ],
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [
          ".docx"
        ],
        "application/vnd.ms-excel": [
          ".xls"
        ],
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [
          ".xlsx"
        ],
        "text/plain": [
          ".txt"
        ],
        "image/*": [
          ".jpg",
          ".jpeg",
          ".png",
          ".gif",
          ".webp"
        ]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+corbu",
      "url": "/protocol-handler?url=%s"
    }
  ],
  "edge_side_panel": {
    "preferred_width": 400
  },
  "permissions": [
    "microphone",
    "notifications",
    "storage"
  ]
}