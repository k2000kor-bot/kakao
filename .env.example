# CRA: copy to `.env.local` for local overrides. Do not put secrets in committed files.

# 주소창 `?id=` / `?type=super_agent` 를 merge·스트리밍·Modern Chat 파이프라인 context에 보강하는 동작을 끕니다.
# `/agents` 등에서 `ChatGPTInterface`에 넘기는 props 기반 에이전트 컨텍스트는 그대로입니다.
# REACT_APP_GENSPARK_DISABLE_WINDOW_ROUTE_CONTEXT=1

# 참조 에이전트 기본 프로필(폼·표시명 등) 비활성화 — `0` 이면 끔 (`gensparkReferenceAgentPreset.ts`).
# REACT_APP_GENSPARK_REFERENCE_AGENT_PROFILE=0

# Genspark에서 복사한 시스템 지시문을 참조 에이전트에 반영합니다.
# REACT_APP_GENSPARK_REFERENCE_AGENT_INSTRUCTIONS=
