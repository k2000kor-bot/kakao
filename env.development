# CORBU.AI Development Environment Configuration

# Application Settings
NODE_ENV=development
FLASK_ENV=development
CORBU_AI_VERSION=2.0.0-dev

# Frontend Settings
REACT_APP_API_URL=http://localhost:8004
REACT_APP_ENVIRONMENT=development
REACT_APP_DEBUG=true

# Backend Settings
PYTHONPATH=/app/backend
FLASK_DEBUG=true
FASTAPI_DEBUG=true

# Database Settings
DATABASE_URL=sqlite:///./backend/corbu_ai_dev.db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=corbu_ai_dev
DB_USER=corbu_dev
DB_PASSWORD=corbu_dev_password

# Redis Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# API Keys (Development)
OPENAI_API_KEY=dev_openai_key
ANTHROPIC_API_KEY=dev_anthropic_key
GOOGLE_API_KEY=dev_google_key

# Security Settings
JWT_SECRET=dev_jwt_secret_key_2025
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECRET_KEY=dev_secret_key_2025

# Logging Settings
LOG_LEVEL=DEBUG
LOG_FILE=./logs/corbu_ai_dev.log

# Monitoring Settings
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true
METRICS_PORT=9090

# Performance Settings
WORKER_PROCESSES=2
MAX_CONNECTIONS=100
REQUEST_TIMEOUT=30

# Development Features
HOT_RELOAD=true
AUTO_MIGRATE=true
DEBUG_TOOLBAR=true
