import React, { useState, useEffect } from 'react';
import {
  Box,
  Typography,
  Paper,
  Grid,
  Card,
  CardContent,
  Chip,
  Button,
  Tabs,
  Tab,
  Table,
  TableBody,
  TableCell,
  TableContainer,
  TableHead,
  TableRow,
  LinearProgress,
  IconButton,
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  TextField,
  FormControl,
  InputLabel,
  Select,
  MenuItem,
  List,
  ListItem,
  ListItemText,
  ListItemIcon,
  Divider,
  Alert,
  Badge,
  Tooltip,
  Switch,
  FormControlLabel,
  Avatar,
  AvatarGroup
} from '@mui/material';
import {
  PlayArrow,
  Pause,
  Stop,
  Add,
  Edit,
  Delete,
  Visibility,
  TrendingUp,
  TrendingDown,
  Schedule,
  Assignment,
  Group,
  Analytics,
  Settings,
  Notifications,
  Warning,
  CheckCircle,
  Error,
  Info,
  Person,
  VideoLibrary,
  Assessment,
  Psychology,
  AutoAwesome,
  Timeline,
  Team,
  Member,
  Role,
  Performance,
  Tune as Optimization,
  // Quality,
  Analytics as AnalyticsIcon,
  Settings as SettingsIcon,
  Group as GroupIcon,
  VideoLibrary as VideoLibraryIcon,
  Assessment as AssessmentIcon,
  Psychology as PsychologyIcon,
  AutoAwesome as AutoAwesomeIcon,
  Timeline as TimelineIcon,
  Team as TeamIcon,
  Member as MemberIcon,
  Role as RoleIcon,
  Performance as PerformanceIcon,
  Optimization as OptimizationIcon,
  Quality as QualityIcon,
  Person as PersonIcon
} from '@mui/icons-material';
import {
  BarChart,
  Pie,
  Cell,
  Bar,
  XAxis,
  YAxis,
  CartesianGrid,
  Tooltip as RechartsTooltip,
  Legend,
  ResponsiveContainer,
  LineChart,
  Line,
  RadarChart,
  PolarGrid,
  PolarAngleAxis,
  PolarRadiusAxis,
  Radar,
  AreaChart,
  Area
} from 'recharts';
import aiTeamCompositionOptimizationSystem, {
  TeamComposition,
  TeamAnalytics,
  TeamMember,
  TeamRole,
  TeamPerformance,
  TeamTune as Optimization,
  TeamRecommendation
} from '../services/aiTeamCompositionOptimizationSystem';

interface TabPanelProps {
  children?: React.ReactNode;
  index: number;
  value: number;
}

function TabPanel(props: TabPanelProps) {
  const { children, value, index, ...other } = props;

  return (
    <div
      role="tabpanel"
      hidden={value !== index}
      id={`team-composition-tabpanel-${index}`}
      aria-labelledby={`team-composition-tab-${index}`}
      {...other}
    >
      {value === index && <Box sx={{ p: 3 }}>{children}</Box>}
    </div>
  );
}

const AITeamCompositionOptimizationDashboard: React.FC = () => {
  const [tabValue, setTabValue] = useState(0);
  const [teams, setTeams] = useState<TeamComposition[]>([]);
  const [analytics, setAnalytics] = useState<TeamAnalytics>({
    totalTeams: 0,
    activeTeams: 0,
    averagePerformance: 0,
    averageSatisfaction: 0,
    optimizationRate: 0,
    diversityScore: 0,
    skillBalanceScore: 0,
    collaborationEffectiveness: 0,
    innovationRate: 0,
    developmentProgress: 0
  });
  const [selectedTeam, setSelectedTeam] = useState<TeamComposition | null>(null);
  const [createDialogOpen, setCreateDialogOpen] = useState(false);
  const [detailDialogOpen, setDetailDialogOpen] = useState(false);
  const [isSystemRunning, setIsSystemRunning] = useState(false);

  useEffect(() => {
    const updateData = () => {
      setTeams(aiTeamCompositionOptimizationSystem.getTeams());
      setAnalytics(aiTeamCompositionOptimizationSystem.getAnalytics());
      setIsSystemRunning(aiTeamCompositionOptimizationSystem.isSystemRunning());
    };

    updateData();
    const interval = setInterval(updateData, 5000);
    return () => clearInterval(interval);
  }, []);

  const handleTabChange = (event: React.SyntheticEvent, newValue: number) => {
    setTabValue(newValue);
  };

  const getStatusColor = (status: string) => {
    switch (status) {
      case 'active': return 'success';
      case 'forming': return 'warning';
      case 'completed': return 'info';
      case 'disbanded': return 'error';
      default: return 'default';
    }
  };

  const getTypeColor = (type: string) => {
    switch (type) {
      case 'development': return 'primary';
      case 'research': return 'secondary';
      case 'project': return 'success';
      case 'analysis': return 'warning';
      case 'innovation': return 'info';
      default: return 'default';
    }
  };

  const getCollaborationStyleColor = (style: string) => {
    switch (style) {
      case 'leader': return 'primary';
      case 'contributor': return 'success';
      case 'supporter': return 'warning';
      case 'innovator': return 'info';
      default: return 'default';
    }
  };

  const formatDate = (timestamp: number) => {
    return new Date(timestamp).toLocaleString('ko-KR');
  };

  const getTeamTypeData = () => {
    const typeCounts = teams.reduce((acc, team) => {
      acc[team.type] = (acc[team.type] || 0) + 1;
      return acc;
    }, {} as Record<string, number>);

    return Object.entries(typeCounts).map(([type, count]) => ({
      name: type,
      value: count
    }));
  };

  const getPerformanceData = () => {
    return teams.map(team => ({
      name: team.name,
      overallPerformance: team.performance.overallPerformance * 100,
      technicalPerformance: team.performance.technicalPerformance * 100,
      collaborationPerformance: team.performance.collaborationPerformance * 100,
      communicationPerformance: team.performance.communicationPerformance * 100,
      innovationPerformance: team.performance.innovationPerformance * 100
    }));
  };

  const getMemberData = () => {
    const allMembers = teams.flatMap(team => team.members);
    const styleCounts = allMembers.reduce((acc, member) => {
      acc[member.collaborationStyle] = (acc[member.collaborationStyle] || 0) + 1;
      return acc;
    }, {} as Record<string, number>);

    return Object.entries(styleCounts).map(([style, count]) => ({
      name: style,
      value: count
    }));
  };

  const getSkillData = () => {
    const allSkills = teams.flatMap(team =>
      team.members.flatMap(member => member.skills)
    );
    const categoryCounts = allSkills.reduce((acc, skill) => {
      acc[skill.category] = (acc[skill.category] || 0) + 1;
      return acc;
    }, {} as Record<string, number>);

    return Object.entries(categoryCounts).map(([category, count]) => ({
      name: category,
      value: count
    }));
  };

  const COLORS = ['#0088FE', '#00C49F', '#FFBB28', '#FF8042', '#8884D8', '#82CA9D'];

  return (
    <Box sx={{ p: 3 }}>
      {/* 헤더 */}
      <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', mb: 3 }}>
        <Box>
          <Typography variant="h4" gutterBottom>
            👥 AI 팀 구성 최적화
          </Typography>
          <Typography variant="body1" color="textSecondary">
            학습 경로와 품질 지표 기반 최적 팀 구성 및 관리 시스템
          </Typography>
        </Box>
        <Box sx={{ display: 'flex', gap: 2 }}>
          <Chip
            icon={isSystemRunning ? <CheckCircle /> : <Error />}
            label={isSystemRunning ? '시스템 실행 중' : '시스템 중지됨'}
            color={isSystemRunning ? 'success' : 'error'}
          />
          <Button
            variant="contained"
            startIcon={<Add />}
            onClick={() => setCreateDialogOpen(true)}
          >
            새 팀 구성
          </Button>
        </Box>
      </Box>

      {/* 전체 지표 */}
      <Grid container spacing={3} sx={{ mb: 3 }}>
        <Grid item xs={12} sm={6} md={3}>
          <Card>
            <CardContent>
              <Box sx={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between' }}>
                <Box>
                  <Typography color="textSecondary" gutterBottom>
                    전체 팀
                  </Typography>
                  <Typography variant="h4">
                    {analytics.totalTeams}
                  </Typography>
                </Box>
                <TeamIcon color="primary" sx={{ fontSize: 40 }} />
              </Box>
            </CardContent>
          </Card>
        </Grid>
        <Grid item xs={12} sm={6} md={3}>
          <Card>
            <CardContent>
              <Box sx={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between' }}>
                <Box>
                  <Typography color="textSecondary" gutterBottom>
                    평균 성과
                  </Typography>
                  <Typography variant="h4">
                    {(analytics.averagePerformance * 100).toFixed(1)}%
                  </Typography>
                </Box>
                <PerformanceIcon color="success" sx={{ fontSize: 40 }} />
              </Box>
            </CardContent>
          </Card>
        </Grid>
        <Grid item xs={12} sm={6} md={3}>
          <Card>
            <CardContent>
              <Box sx={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between' }}>
                <Box>
                  <Typography color="textSecondary" gutterBottom>
                    다양성 점수
                  </Typography>
                  <Typography variant="h4">
                    {(analytics.diversityScore * 100).toFixed(1)}%
                  </Typography>
                </Box>
                <GroupIcon color="info" sx={{ fontSize: 40 }} />
              </Box>
            </CardContent>
          </Card>
        </Grid>
        <Grid item xs={12} sm={6} md={3}>
          <Card>
            <CardContent>
              <Box sx={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between' }}>
                <Box>
                  <Typography color="textSecondary" gutterBottom>
                    최적화율
                  </Typography>
                  <Typography variant="h4">
                    {(analytics.optimizationRate * 100).toFixed(1)}%
                  </Typography>
                </Box>
                <OptimizationIcon color="warning" sx={{ fontSize: 40 }} />
              </Box>
            </CardContent>
          </Card>
        </Grid>
      </Grid>

      {/* 탭 네비게이션 */}
      <Box sx={{ borderBottom: 1, borderColor: 'divider', mb: 3 }}>
        <Tabs value={tabValue} onChange={handleTabChange} aria-label="team composition tabs">
          <Tab icon={<TeamIcon />} label="팀 구성" />
          <Tab icon={<MemberIcon />} label="멤버 분석" />
          <Tab icon={<RoleIcon />} label="역할 배정" />
          <Tab icon={<PerformanceIcon />} label="성과 분석" />
          <Tab icon={<OptimizationIcon />} label="최적화" />
          <Tab icon={<AutoAwesomeIcon />} label="권장사항" />
          <Tab icon={<SettingsIcon />} label="설정" />
        </Tabs>
      </Box>

      {/* 탭 콘텐츠 */}
      <TabPanel value={tabValue} index={0}>
        {/* 팀 구성 */}
        <Grid container spacing={3}>
          {/* 팀 목록 */}
          <Grid item xs={12} lg={8}>
            <Card>
              <CardContent>
                <Typography variant="h6" gutterBottom>
                  팀 구성 목록
                </Typography>
                <TableContainer>
                  <Table>
                    <TableHead>
                      <TableRow>
                        <TableCell>팀</TableCell>
                        <TableCell>타입</TableCell>
                        <TableCell>상태</TableCell>
                        <TableCell>멤버</TableCell>
                        <TableCell>성과</TableCell>
                        <TableCell>작업</TableCell>
                      </TableRow>
                    </TableHead>
                    <TableBody>
                      {teams.map((team) => (
                        <TableRow key={team.teamId}>
                          <TableCell>
                            <Box>
                              <Typography variant="subtitle2">{team.name}</Typography>
                              <Typography variant="body2" color="textSecondary">
                                {team.description}
                              </Typography>
                            </Box>
                          </TableCell>
                          <TableCell>
                            <Chip
                              label={team.type}
                              color={getTypeColor(team.type) as any}
                              size="small"
                            />
                          </TableCell>
                          <TableCell>
                            <Chip
                              label={team.status}
                              color={getStatusColor(team.status) as any}
                              size="small"
                            />
                          </TableCell>
                          <TableCell>
                            <AvatarGroup max={3}>
                              {team.members.map((member) => (
                                <Avatar key={member.memberId} sx={{ width: 24, height: 24 }}>
                                  {member.name.charAt(0)}
                                </Avatar>
                              ))}
                            </AvatarGroup>
                            <Typography variant="body2" color="textSecondary">
                              {team.members.length}명
                            </Typography>
                          </TableCell>
                          <TableCell>
                            <Box sx={{ display: 'flex', alignItems: 'center' }}>
                              <Box sx={{ width: '100%', mr: 1 }}>
                                <LinearProgress
                                  variant="determinate"
                                  value={team.performance.overallPerformance * 100}
                                  sx={{ height: 8, borderRadius: 5 }}
                                />
                              </Box>
                              <Box sx={{ minWidth: 35 }}>
                                <Typography variant="body2" color="textSecondary">
                                  {(team.performance.overallPerformance * 100).toFixed(0)}%
                                </Typography>
                              </Box>
                            </Box>
                          </TableCell>
                          <TableCell>
                            <IconButton
                              size="small"
                              onClick={() => {
                                setSelectedTeam(team);
                                setDetailDialogOpen(true);
                              }}
                            >
                              <Visibility />
                            </IconButton>
                          </TableCell>
                        </TableRow>
                      ))}
                    </TableBody>
                  </Table>
                </TableContainer>
              </CardContent>
            </Card>
          </Grid>

          {/* 차트 */}
          <Grid item xs={12} lg={4}>
            <Grid container spacing={3}>
              <Grid item xs={12}>
                <Card>
                  <CardContent>
                    <Typography variant="h6" gutterBottom>
                      팀 타입 분포
                    </Typography>
                    <ResponsiveContainer width="100%" height={200}>
                      <PieChart>
                        <Pie
                          data={getTeamTypeData()}
                          cx="50%"
                          cy="50%"
                          labelLine={false}
                          label={({ name, percent }) => `${name} ${(percent * 100).toFixed(0)}%`}
                          outerRadius={80}
                          fill="#8884d8"
                          dataKey="value"
                        >
                          {getTeamTypeData().map((entry, index) => (
                            <Cell key={`cell-${index}`} fill={COLORS[index % COLORS.length]} />
                          ))}
                        </Pie>
                        <RechartsTooltip />
                      </PieChart>
                    </ResponsiveContainer>
                  </CardContent>
                </Card>
              </Grid>
            </Grid>
          </Grid>
        </Grid>
      </TabPanel>

      <TabPanel value={tabValue} index={1}>
        {/* 멤버 분석 */}
        <Grid container spacing={3}>
          {teams.map((team) => (
            <Grid item xs={12} key={team.teamId}>
              <Card>
                <CardContent>
                  <Typography variant="h6" gutterBottom>
                    {team.name} - 멤버 분석
                  </Typography>
                  <TableContainer>
                    <Table>
                      <TableHead>
                        <TableRow>
                          <TableCell>멤버</TableCell>
                          <TableCell>역할</TableCell>
                          <TableCell>협업 스타일</TableCell>
                          <TableCell>경험</TableCell>
                          <TableCell>품질</TableCell>
                          <TableCell>가용성</TableCell>
                        </TableRow>
                      </TableHead>
                      <TableBody>
                        {team.members.map((member) => (
                          <TableRow key={member.memberId}>
                            <TableCell>
                              <Box sx={{ display: 'flex', alignItems: 'center' }}>
                                <Avatar sx={{ mr: 2 }}>
                                  {member.name.charAt(0)}
                                </Avatar>
                                <Box>
                                  <Typography variant="subtitle2">{member.name}</Typography>
                                  <Typography variant="body2" color="textSecondary">
                                    {member.skills.length}개 스킬
                                  </Typography>
                                </Box>
                              </Box>
                            </TableCell>
                            <TableCell>
                              <Typography variant="body2">{member.role}</Typography>
                            </TableCell>
                            <TableCell>
                              <Chip
                                label={member.collaborationStyle}
                                color={getCollaborationStyleColor(member.collaborationStyle) as any}
                                size="small"
                              />
                            </TableCell>
                            <TableCell>
                              <Typography variant="body2">
                                {member.experience}년
                              </Typography>
                            </TableCell>
                            <TableCell>
                              <Box sx={{ display: 'flex', alignItems: 'center' }}>
                                <Box sx={{ width: '100%', mr: 1 }}>
                                  <LinearProgress
                                    variant="determinate"
                                    value={member.qualityMetrics.overallQuality * 100}
                                    sx={{ height: 8, borderRadius: 5 }}
                                  />
                                </Box>
                                <Box sx={{ minWidth: 35 }}>
                                  <Typography variant="body2" color="textSecondary">
                                    {(member.qualityMetrics.overallQuality * 100).toFixed(0)}%
                                  </Typography>
                                </Box>
                              </Box>
                            </TableCell>
                            <TableCell>
                              <Typography variant="body2">
                                {(member.availability * 100).toFixed(0)}%
                              </Typography>
                            </TableCell>
                          </TableRow>
                        ))}
                      </TableBody>
                    </Table>
                  </TableContainer>
                </CardContent>
              </Card>
            </Grid>
          ))}
        </Grid>
      </TabPanel>

      <TabPanel value={tabValue} index={2}>
        {/* 역할 배정 */}
        <Grid container spacing={3}>
          {teams.map((team) => (
            <Grid item xs={12} key={team.teamId}>
              <Card>
                <CardContent>
                  <Typography variant="h6" gutterBottom>
                    {team.name} - 역할 배정
                  </Typography>
                  <TableContainer>
                    <Table>
                      <TableHead>
                        <TableRow>
                          <TableCell>역할</TableCell>
                          <TableCell>설명</TableCell>
                          <TableCell>중요도</TableCell>
                          <TableCell>배정된 멤버</TableCell>
                          <TableCell>성과</TableCell>
                          <TableCell>작업</TableCell>
                        </TableRow>
                      </TableHead>
                      <TableBody>
                        {team.roles.map((role) => (
                          <TableRow key={role.roleId}>
                            <TableCell>
                              <Typography variant="subtitle2">{role.name}</Typography>
                            </TableCell>
                            <TableCell>
                              <Typography variant="body2" color="textSecondary">
                                {role.description}
                              </Typography>
                            </TableCell>
                            <TableCell>
                              <Chip
                                label={role.importance}
                                color={role.importance === 'critical' ? 'error' :
                                  role.importance === 'important' ? 'warning' : 'default'}
                                size="small"
                              />
                            </TableCell>
                            <TableCell>
                              {role.assignedMember ? (
                                <Box sx={{ display: 'flex', alignItems: 'center' }}>
                                  <Avatar sx={{ mr: 1, width: 24, height: 24 }}>
                                    {team.members.find(m => m.memberId === role.assignedMember)?.name.charAt(0)}
                                  </Avatar>
                                  <Typography variant="body2">
                                    {team.members.find(m => m.memberId === role.assignedMember)?.name}
                                  </Typography>
                                </Box>
                              ) : (
                                <Typography variant="body2" color="textSecondary">
                                  미배정
                                </Typography>
                              )}
                            </TableCell>
                            <TableCell>
                              <Box sx={{ display: 'flex', alignItems: 'center' }}>
                                <Box sx={{ width: '100%', mr: 1 }}>
                                  <LinearProgress
                                    variant="determinate"
                                    value={role.performance * 100}
                                    sx={{ height: 8, borderRadius: 5 }}
                                  />
                                </Box>
                                <Box sx={{ minWidth: 35 }}>
                                  <Typography variant="body2" color="textSecondary">
                                    {(role.performance * 100).toFixed(0)}%
                                  </Typography>
                                </Box>
                              </Box>
                            </TableCell>
                            <TableCell>
                              <IconButton size="small">
                                <Edit />
                              </IconButton>
                            </TableCell>
                          </TableRow>
                        ))}
                      </TableBody>
                    </Table>
                  </TableContainer>
                </CardContent>
              </Card>
            </Grid>
          ))}
        </Grid>
      </TabPanel>

      <TabPanel value={tabValue} index={3}>
        {/* 성과 분석 */}
        <Grid container spacing={3}>
          {/* 성과 차트 */}
          <Grid item xs={12} lg={6}>
            <Card>
              <CardContent>
                <Typography variant="h6" gutterBottom>
                  팀별 성과 비교
                </Typography>
                <ResponsiveContainer width="100%" height={300}>
                  <Assessment data={getPerformanceData()}>
                    <CartesianGrid strokeDasharray="3 3" />
                    <XAxis dataKey="name" />
                    <YAxis />
                    <RechartsTooltip />
                    <Legend />
                    <Bar dataKey="overallPerformance" fill="#8884d8" name="전체 성과" />
                    <Bar dataKey="technicalPerformance" fill="#82ca9d" name="기술 성과" />
                    <Bar dataKey="collaborationPerformance" fill="#ffc658" name="협업 성과" />
                  </BarChart>
                </ResponsiveContainer>
              </CardContent>
            </Card>
          </Grid>

          <Grid item xs={12} lg={6}>
            <Card>
              <CardContent>
                <Typography variant="h6" gutterBottom>
                  협업 스타일 분포
                </Typography>
                <ResponsiveContainer width="100%" height={300}>
                  <PieChart>
                    <Pie
                      data={getMemberData()}
                      cx="50%"
                      cy="50%"
                      labelLine={false}
                      label={({ name, percent }) => `${name} ${(percent * 100).toFixed(0)}%`}
                      outerRadius={100}
                      fill="#8884d8"
                      dataKey="value"
                    >
                      {getMemberData().map((entry, index) => (
                        <Cell key={`cell-${index}`} fill={COLORS[index % COLORS.length]} />
                      ))}
                    </Pie>
                    <RechartsTooltip />
                  </PieChart>
                </ResponsiveContainer>
              </CardContent>
            </Card>
          </Grid>
        </Grid>
      </TabPanel>

      <TabPanel value={tabValue} index={4}>
        {/* 최적화 */}
        <Grid container spacing={3}>
          {teams.map((team) => (
            <Grid item xs={12} key={team.teamId}>
              <Card>
                <CardContent>
                  <Typography variant="h6" gutterBottom>
                    {team.name} - 최적화 결과
                  </Typography>
                  <Grid container spacing={2}>
                    <Grid item xs={12} md={6}>
                      <Typography variant="subtitle1" gutterBottom>
                        최적화 상태
                      </Typography>
                      <Chip
                        label={team.optimization.status}
                        color={team.optimization.status === 'completed' ? 'success' : 'warning'}
                        sx={{ mb: 2 }}
                      />
                      <Typography variant="body2" color="textSecondary">
                        알고리즘: {team.optimization.algorithm}
                      </Typography>
                      <Typography variant="body2" color="textSecondary">
                        최적화 타입: {team.optimization.type}
                      </Typography>
                    </Grid>
                    <Grid item xs={12} md={6}>
                      <Typography variant="subtitle1" gutterBottom>
                        최적화 결과
                      </Typography>
                      {team.optimization.results.map((result) => (
                        <Alert key={result.resultId} severity="info" sx={{ mb: 1 }}>
                          <Typography variant="body2">
                            <strong>{result.metric}:</strong> {(result.improvement * 100).toFixed(1)}% 향상
                          </Typography>
                          <Typography variant="body2" color="textSecondary">
                            {result.explanation}
                          </Typography>
                        </Alert>
                      ))}
                    </Grid>
                  </Grid>
                </CardContent>
              </Card>
            </Grid>
          ))}
        </Grid>
      </TabPanel>

      <TabPanel value={tabValue} index={5}>
        {/* 권장사항 */}
        <Grid container spacing={3}>
          {teams.map((team) => (
            <Grid item xs={12} key={team.teamId}>
              <Card>
                <CardContent>
                  <Typography variant="h6" gutterBottom>
                    {team.name} - 개선 권장사항
                  </Typography>
                  <Grid container spacing={2}>
                    {team.recommendations.map((recommendation) => (
                      <Grid item xs={12} md={6} key={recommendation.recommendationId}>
                        <Alert severity={recommendation.priority === 'critical' ? 'error' :
                          recommendation.priority === 'high' ? 'warning' : 'info'}>
                          <Typography variant="body2" gutterBottom>
                            <strong>{recommendation.title}</strong>
                          </Typography>
                          <Typography variant="body2">
                            {recommendation.description}
                          </Typography>
                          <Typography variant="body2" sx={{ mt: 1 }}>
                            우선순위: {recommendation.priority} |
                            영향도: {(recommendation.impact * 100).toFixed(1)}% |
                            상태: {recommendation.status}
                          </Typography>
                          <Typography variant="body2" sx={{ mt: 1 }}>
                            <strong>구현 방법:</strong> {recommendation.implementation}
                          </Typography>
                          <Typography variant="body2" sx={{ mt: 1 }}>
                            <strong>기대 효과:</strong> {recommendation.expectedOutcome}
                          </Typography>
                        </Alert>
                      </Grid>
                    ))}
                  </Grid>
                </CardContent>
              </Card>
            </Grid>
          ))}
        </Grid>
      </TabPanel>

      <TabPanel value={tabValue} index={6}>
        {/* 설정 */}
        <Grid container spacing={3}>
          <Grid item xs={12} md={6}>
            <Card>
              <CardContent>
                <Typography variant="h6" gutterBottom>
                  팀 구성 설정
                </Typography>
                <List>
                  <ListItem>
                    <ListItemIcon>
                      <AutoAwesome />
                    </ListItemIcon>
                    <ListItemText
                      primary="자동 최적화"
                      secondary="팀 구성 자동 최적화"
                    />
                    <Switch defaultChecked />
                  </ListItem>
                  <ListItem>
                    <ListItemIcon>
                      <Group />
                    </ListItemIcon>
                    <ListItemText
                      primary="다양성 중시"
                      secondary="팀 다양성 최적화"
                    />
                    <Switch defaultChecked />
                  </ListItem>
                  <ListItem>
                    <ListItemIcon>
                      <Quality />
                    </ListItemIcon>
                    <ListItemText
                      primary="스킬 균형"
                      secondary="스킬 균형 최적화"
                    />
                    <Switch defaultChecked />
                  </ListItem>
                  <ListItem>
                    <ListItemIcon>
                      <Performance />
                    </ListItemIcon>
                    <ListItemText
                      primary="성과 추적"
                      secondary="팀 성과 실시간 모니터링"
                    />
                    <Switch defaultChecked />
                  </ListItem>
                </List>
              </CardContent>
            </Card>
          </Grid>

          <Grid item xs={12} md={6}>
            <Card>
              <CardContent>
                <Typography variant="h6" gutterBottom>
                  최적화 설정
                </Typography>
                <List>
                  <ListItem>
                    <ListItemIcon>
                      <Optimization />
                    </ListItemIcon>
                    <ListItemText
                      primary="자동 최적화"
                      secondary="실시간 팀 구성 최적화"
                    />
                    <Switch defaultChecked />
                  </ListItem>
                  <ListItem>
                    <ListItemIcon>
                      <Notifications />
                    </ListItemIcon>
                    <ListItemText
                      primary="알림"
                      secondary="최적화 및 개선 알림"
                    />
                    <Switch defaultChecked />
                  </ListItem>
                  <ListItem>
                    <ListItemIcon>
                      <Timeline />
                    </ListItemIcon>
                    <ListItemText
                      primary="개발 지원"
                      secondary="멤버 개발 프로그램 지원"
                    />
                    <Switch defaultChecked />
                  </ListItem>
                  <ListItem>
                    <ListItemIcon>
                      <Group />
                    </ListItemIcon>
                    <ListItemText
                      primary="의사소통 강화"
                      secondary="팀 의사소통 개선"
                    />
                    <Switch defaultChecked />
                  </ListItem>
                </List>
              </CardContent>
            </Card>
          </Grid>
        </Grid>
      </TabPanel>

      {/* 팀 상세 다이얼로그 */}
      <Dialog
        open={detailDialogOpen}
        onClose={() => setDetailDialogOpen(false)}
        maxWidth="lg"
        fullWidth
      >
        <DialogTitle>
          팀 구성 상세 정보
        </DialogTitle>
        <DialogContent>
          {selectedTeam && (
            <Box>
              <Typography variant="h6" gutterBottom>
                {selectedTeam.name}
              </Typography>
              <Typography variant="body2" color="textSecondary" gutterBottom>
                {selectedTeam.description}
              </Typography>

              <Grid container spacing={3} sx={{ mt: 2 }}>
                <Grid item xs={12} md={6}>
                  <Typography variant="subtitle1" gutterBottom>
                    기본 정보
                  </Typography>
                  <List dense>
                    <ListItem>
                      <ListItemText
                        primary="타입"
                        secondary={selectedTeam.type}
                      />
                    </ListItem>
                    <ListItem>
                      <ListItemText
                        primary="상태"
                        secondary={selectedTeam.status}
                      />
                    </ListItem>
                    <ListItem>
                      <ListItemText
                        primary="멤버 수"
                        secondary={`${selectedTeam.members.length}명`}
                      />
                    </ListItem>
                    <ListItem>
                      <ListItemText
                        primary="생성일"
                        secondary={formatDate(selectedTeam.timestamp)}
                      />
                    </ListItem>
                  </List>
                </Grid>

                <Grid item xs={12} md={6}>
                  <Typography variant="subtitle1" gutterBottom>
                    성과 지표
                  </Typography>
                  <List dense>
                    <ListItem>
                      <ListItemText
                        primary="전체 성과"
                        secondary={`${(selectedTeam.performance.overallPerformance * 100).toFixed(1)}%`}
                      />
                    </ListItem>
                    <ListItem>
                      <ListItemText
                        primary="기술 성과"
                        secondary={`${(selectedTeam.performance.technicalPerformance * 100).toFixed(1)}%`}
                      />
                    </ListItem>
                    <ListItem>
                      <ListItemText
                        primary="협업 성과"
                        secondary={`${(selectedTeam.performance.collaborationPerformance * 100).toFixed(1)}%`}
                      />
                    </ListItem>
                    <ListItem>
                      <ListItemText
                        primary="혁신 성과"
                        secondary={`${(selectedTeam.performance.innovationPerformance * 100).toFixed(1)}%`}
                      />
                    </ListItem>
                  </List>
                </Grid>
              </Grid>
            </Box>
          )}
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setDetailDialogOpen(false)}>닫기</Button>
        </DialogActions>
      </Dialog>

      {/* 새 팀 생성 다이얼로그 */}
      <Dialog
        open={createDialogOpen}
        onClose={() => setCreateDialogOpen(false)}
        maxWidth="md"
        fullWidth
      >
        <DialogTitle>
          새 팀 구성 생성
        </DialogTitle>
        <DialogContent>
          <Grid container spacing={2} sx={{ mt: 1 }}>
            <Grid item xs={12}>
              <TextField
                fullWidth
                label="팀 이름"
                variant="outlined"
              />
            </Grid>
            <Grid item xs={12}>
              <TextField
                fullWidth
                label="설명"
                variant="outlined"
                multiline
                rows={3}
              />
            </Grid>
            <Grid item xs={12} md={6}>
              <FormControl fullWidth>
                <InputLabel>타입</InputLabel>
                <Select label="타입">
                  <MenuItem value="development">개발</MenuItem>
                  <MenuItem value="research">연구</MenuItem>
                  <MenuItem value="project">프로젝트</MenuItem>
                  <MenuItem value="analysis">분석</MenuItem>
                  <MenuItem value="innovation">혁신</MenuItem>
                </Select>
              </FormControl>
            </Grid>
          </Grid>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setCreateDialogOpen(false)}>취소</Button>
          <Button variant="contained" onClick={() => setCreateDialogOpen(false)}>
            생성
          </Button>
        </DialogActions>
      </Dialog>
    </Box>
  );
};

export default AITeamCompositionOptimizationDashboard;
