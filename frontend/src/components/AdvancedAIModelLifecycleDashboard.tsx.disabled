                        cost_per_hour: 0
                    }
                }
            ];

            const mockDeployments: ModelDeployment[] = [
                {
                    id: 'deployment-1',
                    model_id: 'model-nlp-1',
                    version_id: 'version-nlp-1',
                    environment: 'production',
                    status: 'deployed',
                    deployment_strategy: 'rolling',
                    traffic_percentage: 100,
                    health_status: 'healthy',
                    deployment_time: new Date(Date.now() - 86400000),
