    // 자동 새로고침
    useEffect(() => {
        refreshData();

        if (autoRefresh) {
            const interval = setInterval(refreshData, 20000); // 20초마다
            return () => clearInterval(interval);
        }
    }, [autoRefresh]);

    // 모델 타입 색상
    const getModelTypeColor = (type: string) => {
        switch (type) {
            case 'nlp': return 'primary';
            case 'computer_vision': return 'secondary';
            case 'recommendation': return 'info';
            case 'prediction': return 'warning';
            case 'classification': return 'success';
            case 'generation': return 'error';
            default: return 'default';
        }
    };

    // 생명주기 단계 색상
    const getLifecycleStageColor = (stage: string) => {
        switch (stage) {
            case 'development': return 'info';
            case 'training': return 'warning';
            case 'validation': return 'secondary';
            case 'testing': return 'primary';
            case 'staging': return 'warning';
            case 'production': return 'success';
            case 'deprecated': return 'error';
            default: return 'default';
        }
    };

    // 상태 색상
    const getStatusColor = (status: string) => {
        switch (status) {
            case 'queued': return 'info';
            case 'running': return 'warning';
            case 'completed': return 'success';
            case 'failed': return 'error';
            case 'cancelled': return 'default';
            case 'deploying': return 'warning';
            case 'deployed': return 'success';
            case 'rolling_back': return 'warning';
            case 'rolled_back': return 'error';
            default: return 'default';
        }
    };

    // 건강 상태 색상
    const getHealthStatusColor = (status: string) => {
        switch (status) {
            case 'healthy': return 'success';
            case 'degraded': return 'warning';
            case 'unhealthy': return 'error';
            default: return 'default';
        }
    };

    const renderModelOverview = () => (
        <Box sx={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(250px, 1fr))', gap: 3 }}>
            {/* 모델 생명주기 메트릭 카드들 */}
