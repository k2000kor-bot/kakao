                        </Typography>
                        <Typography variant="body2" color="textSecondary">
                            진행 중인 훈련
                        </Typography>
                    </CardContent>
                </Card>
            </Grid>

            <Grid item xs={12} md={3}>
                <Card>
                    <CardContent>
                        <Box display="flex" alignItems="center" mb={2}>
                            <CloudUpload color="success" sx={{ mr: 1 }} />
                            <Typography variant="h6">활성 배포</Typography>
                        </Box>
                        <Typography variant="h4" color="success.main">
                            {lifecycleMetrics?.active_deployments || 0}
                        </Typography>
                        <Typography variant="body2" color="textSecondary">
                            배포된 모델 수
                        </Typography>
                    </CardContent>
                </Card>
            </Grid>

            <Grid item xs={12} md={3}>
                <Card>
                    <CardContent>
                        <Box display="flex" alignItems="center" mb={2}>
                            <CheckCircle color="info" sx={{ mr: 1 }} />
                            <Typography variant="h6">성공률</Typography>
                        </Box>
                        <Typography variant="h4" color="info.main">
                            {((lifecycleMetrics?.success_rate_deployment || 0) * 100).toFixed(0)}%
                        </Typography>
                        <Typography variant="body2" color="textSecondary">
                            배포 성공률
                        </Typography>
                    </CardContent>
                </Card>
            </Grid>

            {/* 생명주기 단계별 모델 분포 */}
            <Grid item xs={12} md={6}>
                <Card>
                    <CardContent>
                        <Typography variant="h6" mb={2}>생명주기 단계별 모델 분포</Typography>
                        {lifecycleMetrics?.models_by_stage && (
                            <Box>
                                {Object.entries(lifecycleMetrics.models_by_stage).map(([stage, count]) => (
                                    <Box key={stage} mb={2}>
                                        <Box display="flex" justifyContent="space-between" mb={1}>
                                            <Typography variant="body2" sx={{ textTransform: 'capitalize' }}>
                                                {stage}
                                            </Typography>
                                            <Typography variant="body2" fontWeight="medium">
                                                {count}개
                                            </Typography>
                                        </Box>
                                        <LinearProgress
                                            variant="determinate"
                                            value={(count / (lifecycleMetrics.total_models || 1)) * 100}
                                            sx={{ height: 8, borderRadius: 4 }}
                                            color={getLifecycleStageColor(stage) as any}
                                        />
                                    </Box>
                                ))}
                            </Box>
                        )}
                    </CardContent>
                </Card>
            </Grid>

            {/* 리소스 사용률 */}
            <Grid item xs={12} md={6}>
                <Card>
                    <CardContent>
                        <Typography variant="h6" mb={2}>리소스 사용률</Typography>
                        {lifecycleMetrics?.resource_utilization && (
                            <Box>
                                <Box mb={2}>
                                    <Box display="flex" justifyContent="space-between" mb={1}>
                                        <Typography variant="body2">CPU 사용률</Typography>
                                        <Typography variant="body2" fontWeight="medium">
                                            {(lifecycleMetrics.resource_utilization.cpu_utilization * 100).toFixed(1)}%
                                        </Typography>
                                    </Box>
                                    <LinearProgress
                                        variant="determinate"
                                        value={lifecycleMetrics.resource_utilization.cpu_utilization * 100}
                                        sx={{ height: 8, borderRadius: 4 }}
                                        color="primary"
                                    />
                                </Box>
                                <Box mb={2}>
                                    <Box display="flex" justifyContent="space-between" mb={1}>
                                        <Typography variant="body2">메모리 사용률</Typography>
                                        <Typography variant="body2" fontWeight="medium">
                                            {(lifecycleMetrics.resource_utilization.memory_utilization * 100).toFixed(1)}%
                                        </Typography>
                                    </Box>
                                    <LinearProgress
                                        variant="determinate"
                                        value={lifecycleMetrics.resource_utilization.memory_utilization * 100}
                                        sx={{ height: 8, borderRadius: 4 }}
                                        color="warning"
                                    />
                                </Box>
                                <Box mb={2}>
                                    <Box display="flex" justifyContent="space-between" mb={1}>
                                        <Typography variant="body2">GPU 사용률</Typography>
                                        <Typography variant="body2" fontWeight="medium">
                                            {(lifecycleMetrics.resource_utilization.gpu_utilization * 100).toFixed(1)}%
                                        </Typography>
                                    </Box>
                                    <LinearProgress
                                        variant="determinate"
                                        value={lifecycleMetrics.resource_utilization.gpu_utilization * 100}
                                        sx={{ height: 8, borderRadius: 4 }}
                                        color="success"
                                    />
                                </Box>
                            </Box>
                        )}
                    </CardContent>
                </Card>
            </Grid>

            {/* 비용 메트릭 */}
            <Grid item xs={12}>
                <Card>
                    <CardContent>
                        <Typography variant="h6" mb={2}>비용 분석</Typography>
                        {lifecycleMetrics?.cost_metrics && (
                            <Grid container spacing={2}>
                                <Grid item xs={12} md={3}>
                                    <Box textAlign="center">
                                        <Typography variant="h5" color="primary">
                                            ${lifecycleMetrics.cost_metrics.total_cost_monthly.toLocaleString()}
                                        </Typography>
                                        <Typography variant="body2" color="textSecondary">
                                            월간 총 비용
                                        </Typography>
                                    </Box>
                                </Grid>
                                <Grid item xs={12} md={3}>
                                    <Box textAlign="center">
                                        <Typography variant="h5" color="success.main">
                                            ${lifecycleMetrics.cost_metrics.cost_per_model.toLocaleString()}
                                        </Typography>
                                        <Typography variant="body2" color="textSecondary">
                                            모델당 비용
                                        </Typography>
                                    </Box>
                                </Grid>
                                <Grid item xs={12} md={3}>
                                    <Box textAlign="center">
                                        <Typography variant="h5" color="info.main">
                                            ${lifecycleMetrics.cost_metrics.cost_per_inference.toFixed(4)}
                                        </Typography>
                                        <Typography variant="body2" color="textSecondary">
                                            추론당 비용
                                        </Typography>
                                    </Box>
                                </Grid>
                                <Grid item xs={12} md={3}>
                                    <Box textAlign="center">
                                        <Typography variant="h5" color="warning.main">
                                            ${lifecycleMetrics.cost_metrics.optimization_savings.toLocaleString()}
                                        </Typography>
                                        <Typography variant="body2" color="textSecondary">
                                            최적화 절약액
                                        </Typography>
                                    </Box>
                                </Grid>
                            </Grid>
                        )}
                    </CardContent>
                </Card>
            </Grid>
        </Grid>
    );

    const renderModelManagement = () => (
        <Grid container spacing={3}>
            <Grid item xs={12}>
                <Card>
                    <CardContent>
                        <Typography variant="h6" mb={2}>모델 관리</Typography>
                        <TableContainer>
                            <Table>
                                <TableHead>
                                    <TableRow>
                                        <TableCell>모델명</TableCell>
                                        <TableCell>타입</TableCell>
                                        <TableCell>버전</TableCell>
                                        <TableCell>생명주기 단계</TableCell>
                                        <TableCell>성능</TableCell>
                                        <TableCell>크기</TableCell>
                                        <TableCell>마지막 업데이트</TableCell>
                                        <TableCell>작업</TableCell>
                                    </TableRow>
                                </TableHead>
                                <TableBody>
                                    {models.map((model) => (
                                        <TableRow key={model.id}>
                                            <TableCell>
                                                <Typography variant="body1" fontWeight="medium">
                                                    {model.name}
                                                </Typography>
                                                <Typography variant="body2" color="textSecondary">
                                                    {model.description}
                                                </Typography>
                                            </TableCell>
                                            <TableCell>
                                                <Chip
                                                    label={model.type}
                                                    size="small"
                                                    color={getModelTypeColor(model.type) as any}
                                                />
                                            </TableCell>
                                            <TableCell>
                                                <Typography variant="body2" fontFamily="monospace">
                                                    v{model.version}
                                                </Typography>
                                            </TableCell>
                                            <TableCell>
                                                <Chip
                                                    label={model.lifecycle_stage}
                                                    size="small"
                                                    color={getLifecycleStageColor(model.lifecycle_stage) as any}
                                                />
                                            </TableCell>
                                            <TableCell>
                                                <Box display="flex" alignItems="center">
                                                    <Typography variant="body2" sx={{ mr: 1 }}>
                                                        {(model.performance_metrics.accuracy * 100).toFixed(1)}%
                                                    </Typography>
                                                    <LinearProgress
                                                        variant="determinate"
                                                        value={model.performance_metrics.accuracy * 100}
                                                        sx={{ width: 60, height: 6 }}
                                                        color={model.performance_metrics.accuracy > 0.9 ? 'success' : 'warning'}
                                                    />
                                                </Box>
                                            </TableCell>
                                            <TableCell>
                                                <Typography variant="body2">
                                                    {(model.size_mb / 1024).toFixed(1)} GB
                                                </Typography>
                                            </TableCell>
                                            <TableCell>
                                                <Typography variant="body2">
                                                    {model.last_updated.toLocaleDateString()}
                                                </Typography>
                                            </TableCell>
                                            <TableCell>
                                                <Box display="flex" gap={1}>
                                                    <Button
                                                        variant="outlined"
                                                        size="small"
                                                        onClick={() => {
                                                            setSelectedModel(model);
                                                            setModelDialogOpen(true);
                                                        }}
                                                    >
                                                        상세 보기
                                                    </Button>
                                                    <Button variant="outlined" size="small" startIcon={<Build />}>
                                                        훈련
                                                    </Button>
                                                    <Button variant="outlined" size="small" startIcon={<CloudUpload />}>
                                                        배포
                                                    </Button>
                                                </Box>
                                            </TableCell>
                                        </TableRow>
                                    ))}
                                </TableBody>
                            </Table>
                        </TableContainer>
                    </CardContent>
                </Card>
            </Grid>
        </Grid>
    );

    const renderTrainingJobs = () => (
        <Grid container spacing={3}>
            <Grid item xs={12}>
                <Card>
                    <CardContent>
                        <Typography variant="h6" mb={2}>훈련 작업 현황</Typography>
                        {trainingJobs.map((job) => (
                            <Accordion key={job.id} sx={{ mb: 2 }}>
                                <AccordionSummary expandIcon={<ExpandMore />}>
                                    <Box display="flex" alignItems="center" width="100%">
                                        <Chip
                                            label={job.status}
                                            size="small"
                                            color={getStatusColor(job.status) as any}
                                            sx={{ mr: 2 }}
                                        />
                                        <Typography variant="h6" sx={{ flexGrow: 1 }}>
                                            {models.find(m => m.id === job.model_id)?.name || '알 수 없는 모델'}
                                        </Typography>
                                        <Typography variant="body2" color="textSecondary">
                                            {job.progress_percentage.toFixed(0)}% 완료
                                        </Typography>
                                    </Box>
                                </AccordionSummary>
                                <AccordionDetails>
                                    <Grid container spacing={2}>
                                        <Grid item xs={12} md={6}>
                                            <Typography variant="subtitle2" mb={1}>훈련 진행 상황</Typography>
                                            <Box mb={2}>
                                                <Box display="flex" justifyContent="space-between" mb={1}>
                                                    <Typography variant="body2">
                                                        에포크: {job.current_epoch}/{job.total_epochs}
                                                    </Typography>
                                                    <Typography variant="body2">
                                                        {job.progress_percentage.toFixed(1)}%
                                                    </Typography>
                                                </Box>
                                                <LinearProgress
                                                    variant="determinate"
                                                    value={job.progress_percentage}
                                                    sx={{ height: 8, borderRadius: 4 }}
                                                />
                                            </Box>

                                            {job.current_metrics && (
                                                <Box>
                                                    <Typography variant="subtitle2" mb={1}>현재 메트릭</Typography>
                                                    <Box display="flex" gap={2}>
                                                        {job.current_metrics.accuracy && (
                                                            <Chip
                                                                label={`정확도: ${(job.current_metrics.accuracy * 100).toFixed(1)}%`}
                                                                size="small"
                                                                color="primary"
                                                            />
                                                        )}
                                                        {job.current_metrics.loss && (
                                                            <Chip
                                                                label={`손실: ${job.current_metrics.loss.toFixed(3)}`}
                                                                size="small"
                                                                color="secondary"
                                                            />
                                                        )}
                                                        {job.current_metrics.f1_score && (
                                                            <Chip
                                                                label={`F1: ${job.current_metrics.f1_score.toFixed(3)}`}
                                                                size="small"
                                                                color="info"
                                                            />
                                                        )}
                                                    </Box>
                                                </Box>
                                            )}
                                        </Grid>

                                        <Grid item xs={12} md={6}>
                                            <Typography variant="subtitle2" mb={1}>리소스 사용량</Typography>
                                            <Box>
                                                <Box display="flex" justifyContent="space-between" mb={1}>
                                                    <Typography variant="body2">CPU</Typography>
                                                    <Typography variant="body2">
                                                        {job.resource_usage.cpu_usage_percent.toFixed(0)}%
                                                    </Typography>
                                                </Box>
                                                <LinearProgress
                                                    variant="determinate"
                                                    value={job.resource_usage.cpu_usage_percent}
                                                    sx={{ height: 6, mb: 1 }}
                                                    color="primary"
                                                />

                                                <Box display="flex" justifyContent="space-between" mb={1}>
                                                    <Typography variant="body2">메모리</Typography>
                                                    <Typography variant="body2">
                                                        {job.resource_usage.memory_usage_gb.toFixed(1)} GB
                                                    </Typography>
                                                </Box>
                                                <LinearProgress
                                                    variant="determinate"
                                                    value={(job.resource_usage.memory_usage_gb / 16) * 100}
                                                    sx={{ height: 6, mb: 1 }}
                                                    color="warning"
                                                />

                                                {job.resource_usage.gpu_usage_percent && (
                                                    <>
                                                        <Box display="flex" justifyContent="space-between" mb={1}>
                                                            <Typography variant="body2">GPU</Typography>
                                                            <Typography variant="body2">
                                                                {job.resource_usage.gpu_usage_percent.toFixed(0)}%
                                                            </Typography>
                                                        </Box>
                                                        <LinearProgress
                                                            variant="determinate"
                                                            value={job.resource_usage.gpu_usage_percent}
                                                            sx={{ height: 6 }}
                                                            color="success"
                                                        />
                                                    </>
                                                )}
                                            </Box>
                                        </Grid>

                                        <Grid item xs={12}>
                                            <Box display="flex" gap={1}>
                                                {job.status === 'running' && (
                                                    <Button variant="outlined" size="small" startIcon={<Stop />} color="error">
                                                        중지
                                                    </Button>
                                                )}
                                                {job.status === 'completed' && (
                                                    <Button variant="outlined" size="small" startIcon={<CloudUpload />}>
                                                        배포
                                                    </Button>
                                                )}
                                                <Button variant="outlined" size="small" startIcon={<Visibility />}>
                                                    로그 보기
                                                </Button>
                                            </Box>
                                        </Grid>
                                    </Grid>
                                </AccordionDetails>
                            </Accordion>
                        ))}
                    </CardContent>
                </Card>
            </Grid>
        </Grid>
    );

    const renderDeploymentManagement = () => (
        <Grid container spacing={3}>
            <Grid item xs={12}>
                <Card>
                    <CardContent>
                        <Typography variant="h6" mb={2}>배포 관리</Typography>
                        <TableContainer>
                            <Table>
                                <TableHead>
                                    <TableRow>
                                        <TableCell>모델</TableCell>
                                        <TableCell>환경</TableCell>
                                        <TableCell>상태</TableCell>
                                        <TableCell>건강 상태</TableCell>
                                        <TableCell>트래픽</TableCell>
                                        <TableCell>성능</TableCell>
                                        <TableCell>배포 시간</TableCell>
                                        <TableCell>작업</TableCell>
                                    </TableRow>
                                </TableHead>
                                <TableBody>
                                    {deployments.map((deployment) => (
                                        <TableRow key={deployment.id}>
                                            <TableCell>
                                                <Typography variant="body1" fontWeight="medium">
                                                    {models.find(m => m.id === deployment.model_id)?.name || '알 수 없는 모델'}
                                                </Typography>
                                                <Typography variant="body2" color="textSecondary">
                                                    {deployment.deployment_strategy}
                                                </Typography>
                                            </TableCell>
                                            <TableCell>
                                                <Chip
                                                    label={deployment.environment}
                                                    size="small"
                                                    color={deployment.environment === 'production' ? 'success' : 'warning'}
                                                />
                                            </TableCell>
                                            <TableCell>
                                                <Chip
                                                    label={deployment.status}
                                                    size="small"
                                                    color={getStatusColor(deployment.status) as any}
                                                />
                                            </TableCell>
                                            <TableCell>
                                                <Chip
                                                    label={deployment.health_status}
                                                    size="small"
                                                    color={getHealthStatusColor(deployment.health_status) as any}
                                                />
                                            </TableCell>
                                            <TableCell>
                                                <Box display="flex" alignItems="center">
                                                    <Typography variant="body2" sx={{ mr: 1 }}>
                                                        {deployment.traffic_percentage}%
                                                    </Typography>
                                                    <LinearProgress
                                                        variant="determinate"
                                                        value={deployment.traffic_percentage}
                                                        sx={{ width: 60, height: 6 }}
                                                    />
                                                </Box>
                                            </TableCell>
                                            <TableCell>
                                                <Typography variant="body2">
                                                    {deployment.average_response_time}ms
                                                </Typography>
                                                <Typography variant="body2" color="textSecondary">
                                                    오류율: {(deployment.error_rate * 100).toFixed(2)}%
                                                </Typography>
                                            </TableCell>
                                            <TableCell>
                                                <Typography variant="body2">
                                                    {deployment.deployment_time.toLocaleDateString()}
                                                </Typography>
                                            </TableCell>
                                            <TableCell>
                                                <Box display="flex" gap={1}>
                                                    <Button variant="outlined" size="small">
                                                        모니터링
                                                    </Button>
                                                    <Button variant="outlined" size="small" startIcon={<Undo />} color="warning">
                                                        롤백
                                                    </Button>
                                                </Box>
                                            </TableCell>
                                        </TableRow>
                                    ))}
                                </TableBody>
                            </Table>
                        </TableContainer>
                    </CardContent>
                </Card>
            </Grid>
        </Grid>
    );

    const renderPerformanceAnalysis = () => (
        <Grid container spacing={3}>
            <Grid item xs={12} md={6}>
                <Card>
                    <CardContent>
                        <Typography variant="h6" mb={2}>성능 트렌드</Typography>
                        {lifecycleMetrics?.model_performance_trends && (
                            <Box>
                                {lifecycleMetrics.model_performance_trends.slice(0, 5).map((trend, index) => (
                                    <Box key={index} mb={2}>
                                        <Box display="flex" justifyContent="space-between" mb={1}>
                                            <Typography variant="body2">
                                                {trend.date.toLocaleDateString()} - {trend.metric_name}
                                            </Typography>
                                            <Typography variant="body2" fontWeight="medium">
                                                {(trend.average_value * 100).toFixed(1)}%
                                            </Typography>
                                        </Box>
                                        <LinearProgress
                                            variant="determinate"
                                            value={trend.average_value * 100}
                                            sx={{ height: 8, borderRadius: 4 }}
                                            color={trend.average_value > 0.9 ? 'success' : trend.average_value > 0.8 ? 'warning' : 'error'}
                                        />
                                    </Box>
                                ))}
                            </Box>
                        )}
                    </CardContent>
                </Card>
            </Grid>

            <Grid item xs={12} md={6}>
                <Card>
                    <CardContent>
                        <Typography variant="h6" mb={2}>모델 성능 비교</Typography>
                        <TableContainer>
                            <Table size="small">
                                <TableHead>
                                    <TableRow>
                                        <TableCell>모델</TableCell>
                                        <TableCell>정확도</TableCell>
                                        <TableCell>응답시간</TableCell>
                                        <TableCell>처리량</TableCell>
                                    </TableRow>
                                </TableHead>
                                <TableBody>
                                    {models.map((model) => (
                                        <TableRow key={model.id}>
                                            <TableCell>
                                                <Typography variant="body2" fontWeight="medium">
                                                    {model.name}
                                                </Typography>
                                            </TableCell>
                                            <TableCell>
                                                <Typography variant="body2" color={model.performance_metrics.accuracy > 0.9 ? 'success.main' : 'warning.main'}>
                                                    {(model.performance_metrics.accuracy * 100).toFixed(1)}%
                                                </Typography>
                                            </TableCell>
                                            <TableCell>
                                                <Typography variant="body2">
                                                    {model.performance_metrics.inference_time_ms}ms
                                                </Typography>
                                            </TableCell>
                                            <TableCell>
                                                <Typography variant="body2">
                                                    {model.performance_metrics.throughput_rps} RPS
                                                </Typography>
                                            </TableCell>
                                        </TableRow>
                                    ))}
                                </TableBody>
                            </Table>
                        </TableContainer>
                    </CardContent>
                </Card>
            </Grid>

            <Grid item xs={12}>
                <Card>
                    <CardContent>
                        <Typography variant="h6" mb={2}>성능 최적화 권장사항</Typography>
                        <List>
                            <ListItem>
                                <ListItemIcon><TrendingUp color="success" /></ListItemIcon>
                                <ListItemText
                                    primary="모델 양자화 적용"
                                    secondary="모델 크기를 75% 줄이고 추론 속도를 50% 향상시킬 수 있습니다."
                                />
                            </ListItem>
                            <ListItem>
                                <ListItemIcon><Memory color="warning" /></ListItemIcon>
                                <ListItemText
                                    primary="메모리 사용량 최적화"
                                    secondary="배치 크기 조정을 통해 메모리 사용량을 30% 줄일 수 있습니다."
                                />
                            </ListItem>
                            <ListItem>
                                <ListItemIcon><Speed color="info" /></ListItemIcon>
                                <ListItemText
                                    primary="캐싱 전략 개선"
                                    secondary="자주 사용되는 추론 결과를 캐싱하여 응답 시간을 40% 단축할 수 있습니다."
                                />
                            </ListItem>
                        </List>
                    </CardContent>
                </Card>
            </Grid>
        </Grid>
    );

    const renderSettings = () => (
        <Card>
            <CardContent>
                <Typography variant="h6" mb={2}>모델 생명주기 관리 설정</Typography>
                <List>
                    <ListItem>
                        <ListItemIcon><Refresh /></ListItemIcon>
                        <ListItemText
                            primary="자동 새로고침"
                            secondary="20초마다 데이터 자동 업데이트"
                        />
                        <Switch
                            checked={autoRefresh}
                            onChange={(e) => setAutoRefresh(e.target.checked)}
                        />
                    </ListItem>
                    <ListItem>
                        <ListItemIcon><Build /></ListItemIcon>
                        <ListItemText
                            primary="자동 훈련"
                            secondary="새로운 데이터 감지 시 자동 재훈련"
                        />
                        <Switch defaultChecked />
                    </ListItem>
                    <ListItem>
                        <ListItemIcon><CloudUpload /></ListItemIcon>
                        <ListItemText
                            primary="자동 배포"
                            secondary="성능 기준 충족 시 자동 배포"
                        />
                        <Switch defaultChecked />
                    </ListItem>
                    <ListItem>
                        <ListItemIcon><Warning /></ListItemIcon>
                        <ListItemText
                            primary="성능 알림"
                            secondary="성능 저하 감지 시 즉시 알림"
                        />
                        <Switch defaultChecked />
                    </ListItem>
                    <ListItem>
                        <ListItemIcon><Undo /></ListItemIcon>
                        <ListItemText
                            primary="자동 롤백"
                            secondary="심각한 오류 발생 시 자동 롤백"
                        />
                        <Switch defaultChecked />
                    </ListItem>
                </List>
            </CardContent>
        </Card>
    );

    const renderContent = () => {
        switch (selectedTab) {
            case 0: return renderModelOverview();
            case 1: return renderModelManagement();
            case 2: return renderTrainingJobs();
            case 3: return renderDeploymentManagement();
            case 4: return renderPerformanceAnalysis();
            case 5: return renderSettings();
            default: return renderModelOverview();
        }
    };

    return (
        <Box sx={{ p: 3, height: '100vh', overflow: 'auto' }}>
            {/* 헤더 */}
            <Box display="flex" justifyContent="space-between" alignItems="center" mb={3}>
                <Box display="flex" alignItems="center">
                    <ModelTraining sx={{ mr: 1, fontSize: 32 }} color="primary" />
                    <Typography variant="h4">고급 AI 모델 생명주기 관리 대시보드</Typography>
                </Box>
                <Box display="flex" alignItems="center" gap={1}>
                    <Typography variant="body2" color="textSecondary">
                        마지막 업데이트: {lastUpdate.toLocaleTimeString()}
                    </Typography>
                    <Tooltip title="전체화면">
                        <IconButton onClick={() => setFullscreen(!fullscreen)}>
                            {fullscreen ? <FullscreenExit /> : <Fullscreen />}
                        </IconButton>
                    </Tooltip>
                </Box>
            </Box>

            {/* 탭 네비게이션 */}
            <Paper sx={{ mb: 3 }}>
                <Box display="flex" overflow="auto">
                    {tabs.map((tab, index) => (
                        <Button
                            key={index}
                            variant={selectedTab === index ? "contained" : "text"}
                            startIcon={tab.icon}
                            onClick={() => setSelectedTab(index)}
                            sx={{
                                minWidth: 'auto',
                                px: 2,
                                py: 1.5,
                                borderRadius: 0,
                                borderBottom: selectedTab === index ? 2 : 0,
                                borderColor: 'primary.main'
                            }}
                        >
                            {tab.label}
                        </Button>
                    ))}
                </Box>
            </Paper>

            {/* 메인 콘텐츠 */}
            {renderContent()}

            {/* 모델 상세 다이얼로그 */}
            <Dialog
                open={modelDialogOpen}
                onClose={() => setModelDialogOpen(false)}
                maxWidth="lg"
                fullWidth
            >
                <DialogTitle>
                    <Box display="flex" alignItems="center">
                        <ModelTraining />
                        <Typography variant="h6" sx={{ ml: 1 }}>
                            모델 상세 정보
                        </Typography>
                    </Box>
                </DialogTitle>
                <DialogContent>
                    {selectedModel && (
                        <Grid container spacing={3}>
                            <Grid item xs={12} md={6}>
                                <Typography variant="h6" mb={2}>기본 정보</Typography>
                                <Box>
                                    <Typography variant="body1" mb={1}>
                                        <strong>이름:</strong> {selectedModel.name}
                                    </Typography>
                                    <Typography variant="body1" mb={1}>
                                        <strong>버전:</strong> {selectedModel.version}
                                    </Typography>
                                    <Typography variant="body1" mb={1}>
                                        <strong>타입:</strong> {selectedModel.type}
                                    </Typography>
                                    <Typography variant="body1" mb={1}>
                                        <strong>프레임워크:</strong> {selectedModel.framework}
                                    </Typography>
                                    <Typography variant="body1" mb={1}>
                                        <strong>크기:</strong> {(selectedModel.size_mb / 1024).toFixed(1)} GB
                                    </Typography>
                                    <Typography variant="body1" mb={1}>
                                        <strong>파라미터:</strong> {selectedModel.parameters.toLocaleString()}
                                    </Typography>
                                </Box>
                            </Grid>

                            <Grid item xs={12} md={6}>
                                <Typography variant="h6" mb={2}>성능 메트릭</Typography>
                                <Box>
                                    <Typography variant="body1" mb={1}>
                                        <strong>정확도:</strong> {(selectedModel.performance_metrics.accuracy * 100).toFixed(1)}%
                                    </Typography>
                                    <Typography variant="body1" mb={1}>
                                        <strong>정밀도:</strong> {(selectedModel.performance_metrics.precision * 100).toFixed(1)}%
                                    </Typography>
                                    <Typography variant="body1" mb={1}>
                                        <strong>재현율:</strong> {(selectedModel.performance_metrics.recall * 100).toFixed(1)}%
                                    </Typography>
                                    <Typography variant="body1" mb={1}>
                                        <strong>F1 점수:</strong> {selectedModel.performance_metrics.f1_score.toFixed(3)}
                                    </Typography>
                                    <Typography variant="body1" mb={1}>
                                        <strong>추론 시간:</strong> {selectedModel.performance_metrics.inference_time_ms}ms
                                    </Typography>
                                    <Typography variant="body1" mb={1}>
                                        <strong>처리량:</strong> {selectedModel.performance_metrics.throughput_rps} RPS
                                    </Typography>
                                </Box>
                            </Grid>
                        </Grid>
                    )}
                </DialogContent>
                <DialogActions>
                    <Button onClick={() => setModelDialogOpen(false)}>닫기</Button>
                    <Button variant="contained" color="primary" startIcon={<Build />}>
                        훈련 시작
                    </Button>
                    <Button variant="contained" color="success" startIcon={<CloudUpload />}>
                        배포
                    </Button>
                </DialogActions>
            </Dialog>
        </Box>
    );
};

export default AdvancedAIModelLifecycleDashboard;
