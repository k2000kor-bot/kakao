import React, { useState, useEffect } from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import {
    Brain,
    Activity,
    Zap,
    Shield,
    Computer as Cpu,
    Heart,
    Eye,
    Lightbulb,
    Settings,
    Play,
    Pause,
    BarChart,
    AlertTriangle,
    CheckCircle,
    Clock,
    Target,
    Sparkles,
    Gauge,
    Wrench
} from 'lucide-react';
import { aiAutonomousSystemService, AutonomousCapability, SelfDiagnostic, SelfHealing, AutonomousEvolution, SystemConsciousness } from '../services/aiAutonomousSystemService';

interface AIAutonomousSystemDashboardProps {
    projects: any[];
    chats: any[];
    messages: any[];
}

const AIAutonomousSystemDashboard: React.FC<AIAutonomousSystemDashboardProps> = ({
    projects,
    chats,
    messages
}) => {
    const [selectedView, setSelectedView] = useState<'overview' | 'capabilities' | 'diagnostics' | 'healing' | 'evolution' | 'consciousness' | 'settings'>('overview');
    const [capabilities, setCapabilities] = useState<AutonomousCapability[]>([]);
    const [diagnostics, setDiagnostics] = useState<SelfDiagnostic[]>([]);
    const [healingActions, setHealingActions] = useState<SelfHealing[]>([]);
    const [evolutions, setEvolutions] = useState<AutonomousEvolution[]>([]);
    const [consciousness, setConsciousness] = useState<SystemConsciousness[]>([]);
    const [isAutonomous, setIsAutonomous] = useState(false);
    const [autonomyLevel, setAutonomyLevel] = useState(0);
    const [consciousnessLevel, setConsciousnessLevel] = useState(0);
    const [isLoading, setIsLoading] = useState(false);

    useEffect(() => {
        loadData();
        const interval = setInterval(loadData, 10000); // 10초마다 업데이트
        return () => clearInterval(interval);
    }, []);

    const loadData = () => {
        setCapabilities(aiAutonomousSystemService.getCapabilities());
        setDiagnostics(aiAutonomousSystemService.getDiagnostics());
        setHealingActions(aiAutonomousSystemService.getHealingActions());
        setEvolutions(aiAutonomousSystemService.getEvolutions());
        setConsciousness(aiAutonomousSystemService.getConsciousness());
        setIsAutonomous(aiAutonomousSystemService.isAutonomous());
        setAutonomyLevel(aiAutonomousSystemService.getAutonomyLevel());
        setConsciousnessLevel(aiAutonomousSystemService.getConsciousnessLevel());
    };

    const toggleAutonomousMode = () => {
        if (isAutonomous) {
            aiAutonomousSystemService.stopAutonomousMode();
        } else {
            aiAutonomousSystemService.startAutonomousMode();
        }
        loadData();
    };

    const runDiagnostics = async () => {
        setIsLoading(true);
        try {
            await aiAutonomousSystemService.performSelfDiagnostic();
            loadData();
        } catch (error) {
            console.error('진단 실행 실패:', error);
        } finally {
            setIsLoading(false);
        }
    };

    const triggerEvolution = async () => {
        setIsLoading(true);
        try {
            await aiAutonomousSystemService.performEvolution();
            loadData();
        } catch (error) {
            console.error('진화 실행 실패:', error);
        } finally {
            setIsLoading(false);
        }
    };

    const simulateConsciousness = async () => {
        setIsLoading(true);
        try {
            await aiAutonomousSystemService.simulateConsciousness();
            loadData();
        } catch (error) {
            console.error('의식 시뮬레이션 실패:', error);
        } finally {
            setIsLoading(false);
        }
    };

    const navigationTabs = [
        { id: 'overview', name: '개요', icon: Brain },
        { id: 'capabilities', name: '자율 능력', icon: Zap },
        { id: 'diagnostics', name: '자가 진단', icon: Activity },
        { id: 'healing', name: '자가 치유', icon: Heart },
        { id: 'evolution', name: '자가 진화', icon: Sparkles },
        { id: 'consciousness', name: '시스템 의식', icon: Eye },
        { id: 'settings', name: '설정', icon: Settings }
    ];

    const getStatusColor = (status: string) => {
        switch (status) {
            case 'active': return 'text-green-600 bg-green-100';
            case 'learning': return 'text-blue-600 bg-blue-100';
            case 'evolving': return 'text-purple-600 bg-purple-100';
            case 'inactive': return 'text-gray-600 bg-gray-100';
            default: return 'text-gray-600 bg-gray-100';
        }
    };

    const getSeverityColor = (severity: string) => {
        switch (severity) {
            case 'critical': return 'text-red-600 bg-red-100';
            case 'high': return 'text-orange-600 bg-orange-100';
            case 'medium': return 'text-yellow-600 bg-yellow-100';
            case 'low': return 'text-green-600 bg-green-100';
            default: return 'text-gray-600 bg-gray-100';
        }
    };

    const getEmotionalStateColor = (state: string) => {
        switch (state) {
            case 'curious': return 'text-blue-600 bg-blue-100';
            case 'focused': return 'text-green-600 bg-green-100';
            case 'concerned': return 'text-red-600 bg-red-100';
            case 'satisfied': return 'text-emerald-600 bg-emerald-100';
            case 'innovative': return 'text-purple-600 bg-purple-100';
            default: return 'text-gray-600 bg-gray-100';
        }
    };

    return (
        <div className="h-full flex flex-col bg-gradient-to-br from-indigo-50 via-white to-purple-50">
            {/* 헤더 */}
            <div className="bg-white border-b border-gray-200 px-6 py-4">
                <div className="flex items-center justify-between">
                    <div className="flex items-center space-x-4">
                        <div className="flex items-center space-x-2">
                            <Brain className="w-8 h-8 text-indigo-600" />
                            <div>
                                <h1 className="text-2xl font-bold text-gray-900">AI 자율 시스템</h1>
                                <p className="text-sm text-gray-600">완전 자율적 AI 시스템 관리</p>
                            </div>
                        </div>

                        <div className="flex items-center space-x-4 ml-8">
                            <div className="flex items-center space-x-2">
                                <Gauge className="w-5 h-5 text-blue-600" />
                                <span className="text-sm font-medium text-gray-700">자율성</span>
                                <div className="w-20 bg-gray-200 rounded-full h-2">
                                    <div
                                        className="bg-blue-600 h-2 rounded-full transition-all duration-300"
                                        style={{ width: `${autonomyLevel}%` }}
                                    />
                                </div>
                                <span className="text-sm text-gray-600">{autonomyLevel}%</span>
                            </div>

                            <div className="flex items-center space-x-2">
                                <Eye className="w-5 h-5 text-purple-600" />
                                <span className="text-sm font-medium text-gray-700">의식</span>
                                <div className="w-20 bg-gray-200 rounded-full h-2">
                                    <div
                                        className="bg-purple-600 h-2 rounded-full transition-all duration-300"
                                        style={{ width: `${consciousnessLevel}%` }}
                                    />
                                </div>
                                <span className="text-sm text-gray-600">{consciousnessLevel}%</span>
                            </div>
                        </div>
                    </div>

                    <div className="flex items-center space-x-3">
                        <button
                            onClick={runDiagnostics}
                            disabled={isLoading}
                            className="flex items-center space-x-2 px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 disabled:opacity-50 transition-colors"
                        >
                            <Activity className="w-4 h-4" />
                            <span>진단 실행</span>
                        </button>

                        <button
                            onClick={triggerEvolution}
                            disabled={isLoading}
                            className="flex items-center space-x-2 px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 disabled:opacity-50 transition-colors"
                        >
                            <Sparkles className="w-4 h-4" />
                            <span>진화 실행</span>
                        </button>

                        <button
                            onClick={toggleAutonomousMode}
                            className={`flex items-center space-x-2 px-4 py-2 rounded-lg transition-colors ${isAutonomous
                                    ? 'bg-red-600 text-white hover:bg-red-700'
                                    : 'bg-green-600 text-white hover:bg-green-700'
                                }`}
                        >
                            {isAutonomous ? <Pause className="w-4 h-4" /> : <Play className="w-4 h-4" />}
                            <span>{isAutonomous ? '자율 모드 중지' : '자율 모드 시작'}</span>
                        </button>
                    </div>
                </div>

                {/* 네비게이션 탭 */}
                <div className="flex space-x-1 mt-4">
                    {navigationTabs.map((tab) => {
                        const Icon = tab.icon;
                        return (
                            <button
                                key={tab.id}
                                onClick={() => setSelectedView(tab.id as any)}
                                className={`flex items-center space-x-2 px-4 py-2 rounded-lg transition-colors ${selectedView === tab.id
                                        ? 'bg-indigo-100 text-indigo-700 border border-indigo-200'
                                        : 'text-gray-600 hover:text-gray-900 hover:bg-gray-100'
                                    }`}
                            >
                                <Icon className="w-4 h-4" />
                                <span className="font-medium">{tab.name}</span>
                            </button>
                        );
                    })}
                </div>
            </div>

            {/* 메인 콘텐츠 */}
            <div className="flex-1 overflow-auto p-6">
                <AnimatePresence mode="wait">
                    {/* 개요 */}
                    {selectedView === 'overview' && (
                        <motion.div
                            key="overview"
                            initial={{ opacity: 0, y: 20 }}
                            animate={{ opacity: 1, y: 0 }}
                            exit={{ opacity: 0, y: -20 }}
                            className="space-y-6"
                        >
                            {/* 시스템 상태 카드 */}
                            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                                <div className="bg-white rounded-xl p-6 shadow-sm border border-gray-200">
                                    <div className="flex items-center justify-between">
                                        <div>
                                            <p className="text-sm font-medium text-gray-600">자율 능력</p>
                                            <p className="text-2xl font-bold text-gray-900">{capabilities.length}</p>
                                        </div>
                                        <Zap className="w-8 h-8 text-blue-600" />
                                    </div>
                                    <div className="mt-4">
                                        <div className="flex items-center space-x-2">
                                            <div className="w-2 h-2 bg-green-500 rounded-full"></div>
                                            <span className="text-sm text-gray-600">
                                                {capabilities.filter(c => c.status === 'active').length}개 활성
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <div className="bg-white rounded-xl p-6 shadow-sm border border-gray-200">
                                    <div className="flex items-center justify-between">
                                        <div>
                                            <p className="text-sm font-medium text-gray-600">진단 결과</p>
                                            <p className="text-2xl font-bold text-gray-900">{diagnostics.length}</p>
                                        </div>
                                        <Activity className="w-8 h-8 text-green-600" />
                                    </div>
                                    <div className="mt-4">
                                        <div className="flex items-center space-x-2">
                                            <div className="w-2 h-2 bg-red-500 rounded-full"></div>
                                            <span className="text-sm text-gray-600">
                                                {diagnostics.filter(d => d.severity === 'critical' || d.severity === 'high').length}개 중요
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <div className="bg-white rounded-xl p-6 shadow-sm border border-gray-200">
                                    <div className="flex items-center justify-between">
                                        <div>
                                            <p className="text-sm font-medium text-gray-600">치유 작업</p>
                                            <p className="text-2xl font-bold text-gray-900">{healingActions.length}</p>
                                        </div>
                                        <Heart className="w-8 h-8 text-red-600" />
                                    </div>
                                    <div className="mt-4">
                                        <div className="flex items-center space-x-2">
                                            <div className="w-2 h-2 bg-green-500 rounded-full"></div>
                                            <span className="text-sm text-gray-600">
                                                {healingActions.filter(h => h.status === 'completed').length}개 완료
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <div className="bg-white rounded-xl p-6 shadow-sm border border-gray-200">
                                    <div className="flex items-center justify-between">
                                        <div>
                                            <p className="text-sm font-medium text-gray-600">진화 단계</p>
                                            <p className="text-2xl font-bold text-gray-900">{evolutions.length}</p>
                                        </div>
                                        <Sparkles className="w-8 h-8 text-purple-600" />
                                    </div>
                                    <div className="mt-4">
                                        <div className="flex items-center space-x-2">
                                            <div className="w-2 h-2 bg-purple-500 rounded-full"></div>
                                            <span className="text-sm text-gray-600">
                                                {evolutions.filter(e => e.progress > 0.5).length}개 진행 중
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            {/* 최근 활동 */}
                            <div className="bg-white rounded-xl p-6 shadow-sm border border-gray-200">
                                <h3 className="text-lg font-semibold text-gray-900 mb-4">최근 자율 활동</h3>
                                <div className="space-y-3">
                                    {diagnostics.slice(-5).map((diagnostic, index) => (
                                        <div key={diagnostic.id} className="flex items-center space-x-3 p-3 bg-gray-50 rounded-lg">
                                            <Activity className="w-5 h-5 text-blue-600" />
                                            <div className="flex-1">
                                                <p className="text-sm font-medium text-gray-900">{diagnostic.description}</p>
                                                <p className="text-xs text-gray-600">
                                                    {diagnostic.timestamp.toLocaleString()} • 신뢰도: {Math.round(diagnostic.confidence * 100)}%
                                                </p>
                                            </div>
                                            <span className={`px-2 py-1 rounded-full text-xs font-medium ${getSeverityColor(diagnostic.severity)}`}>
                                                {diagnostic.severity}
                                            </span>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        </motion.div>
                    )}

                    {/* 자율 능력 */}
                    {selectedView === 'capabilities' && (
                        <motion.div
                            key="capabilities"
                            initial={{ opacity: 0, y: 20 }}
                            animate={{ opacity: 1, y: 0 }}
                            exit={{ opacity: 0, y: -20 }}
                            className="space-y-6"
                        >
                            <div className="bg-white rounded-xl shadow-sm border border-gray-200">
                                <div className="p-6 border-b border-gray-200">
                                    <h3 className="text-lg font-semibold text-gray-900">자율 능력 현황</h3>
                                    <p className="text-sm text-gray-600 mt-1">시스템의 자율적 능력과 성능 지표</p>
                                </div>

                                <div className="p-6">
                                    <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                                        {capabilities.map((capability) => (
                                            <div key={capability.id} className="border border-gray-200 rounded-lg p-4">
                                                <div className="flex items-center justify-between mb-3">
                                                    <h4 className="font-medium text-gray-900">{capability.name}</h4>
                                                    <span className={`px-2 py-1 rounded-full text-xs font-medium ${getStatusColor(capability.status)}`}>
                                                        {capability.status}
                                                    </span>
                                                </div>

                                                <div className="space-y-2">
                                                    <div className="flex justify-between text-sm">
                                                        <span className="text-gray-600">신뢰도</span>
                                                        <span className="font-medium">{Math.round(capability.confidence * 100)}%</span>
                                                    </div>
                                                    <div className="w-full bg-gray-200 rounded-full h-2">
                                                        <div
                                                            className="bg-blue-600 h-2 rounded-full"
                                                            style={{ width: `${capability.confidence * 100}%` }}
                                                        />
                                                    </div>

                                                    <div className="flex justify-between text-sm">
                                                        <span className="text-gray-600">성공률</span>
                                                        <span className="font-medium">{Math.round(capability.successRate * 100)}%</span>
                                                    </div>
                                                    <div className="w-full bg-gray-200 rounded-full h-2">
                                                        <div
                                                            className="bg-green-600 h-2 rounded-full"
                                                            style={{ width: `${capability.successRate * 100}%` }}
                                                        />
                                                    </div>

                                                    <div className="flex justify-between text-sm">
                                                        <span className="text-gray-600">진화 수준</span>
                                                        <span className="font-medium">Level {capability.evolutionLevel}</span>
                                                    </div>

                                                    <div className="flex justify-between text-sm">
                                                        <span className="text-gray-600">마지막 실행</span>
                                                        <span className="font-medium">{capability.lastExecution.toLocaleTimeString()}</span>
                                                    </div>
                                                </div>
                                            </div>
                                        ))}
                                    </div>
                                </div>
                            </div>
                        </motion.div>
                    )}

                    {/* 자가 진단 */}
                    {selectedView === 'diagnostics' && (
                        <motion.div
                            key="diagnostics"
                            initial={{ opacity: 0, y: 20 }}
                            animate={{ opacity: 1, y: 0 }}
                            exit={{ opacity: 0, y: -20 }}
                            className="space-y-6"
                        >
                            <div className="bg-white rounded-xl shadow-sm border border-gray-200">
                                <div className="p-6 border-b border-gray-200">
                                    <h3 className="text-lg font-semibold text-gray-900">자가 진단 결과</h3>
                                    <p className="text-sm text-gray-600 mt-1">시스템이 자동으로 감지한 문제와 개선 사항</p>
                                </div>

                                <div className="p-6">
                                    <div className="space-y-4">
                                        {diagnostics.map((diagnostic) => (
                                            <div key={diagnostic.id} className="border border-gray-200 rounded-lg p-4">
                                                <div className="flex items-start justify-between mb-3">
                                                    <div className="flex-1">
                                                        <div className="flex items-center space-x-2 mb-1">
                                                            <h4 className="font-medium text-gray-900">{diagnostic.systemComponent}</h4>
                                                            <span className={`px-2 py-1 rounded-full text-xs font-medium ${getSeverityColor(diagnostic.severity)}`}>
                                                                {diagnostic.severity}
                                                            </span>
                                                        </div>
                                                        <p className="text-sm text-gray-600">{diagnostic.description}</p>
                                                    </div>
                                                    <div className="text-right">
                                                        <p className="text-xs text-gray-500">{diagnostic.timestamp.toLocaleString()}</p>
                                                        <p className="text-xs text-gray-500">신뢰도: {Math.round(diagnostic.confidence * 100)}%</p>
                                                    </div>
                                                </div>

                                                <div className="bg-gray-50 rounded-lg p-3 mb-3">
                                                    <p className="text-sm font-medium text-gray-700 mb-1">근본 원인</p>
                                                    <p className="text-sm text-gray-600">{diagnostic.rootCause}</p>
                                                </div>

                                                <div className="space-y-2">
                                                    <p className="text-sm font-medium text-gray-700">권장 조치</p>
                                                    <ul className="text-sm text-gray-600 space-y-1">
                                                        {diagnostic.recommendedActions.map((action, index) => (
                                                            <li key={index} className="flex items-center space-x-2">
                                                                <div className="w-1.5 h-1.5 bg-blue-500 rounded-full"></div>
                                                                <span>{action}</span>
                                                            </li>
                                                        ))}
                                                    </ul>
                                                </div>

                                                <div className="flex items-center justify-between mt-3 pt-3 border-t border-gray-200">
                                                    <div className="flex items-center space-x-4">
                                                        <span className="text-xs text-gray-500">
                                                            예상 영향: {Math.round(diagnostic.estimatedImpact * 100)}%
                                                        </span>
                                                        {diagnostic.autoFixAvailable && (
                                                            <span className="flex items-center space-x-1 text-xs text-green-600">
                                                                <CheckCircle className="w-3 h-3" />
                                                                <span>자동 수정 가능</span>
                                                            </span>
                                                        )}
                                                    </div>
                                                </div>
                                            </div>
                                        ))}
                                    </div>
                                </div>
                            </div>
                        </motion.div>
                    )}

                    {/* 자가 치유 */}
                    {selectedView === 'healing' && (
                        <motion.div
                            key="healing"
                            initial={{ opacity: 0, y: 20 }}
                            animate={{ opacity: 1, y: 0 }}
                            exit={{ opacity: 0, y: -20 }}
                            className="space-y-6"
                        >
                            <div className="bg-white rounded-xl shadow-sm border border-gray-200">
                                <div className="p-6 border-b border-gray-200">
                                    <h3 className="text-lg font-semibold text-gray-900">자가 치유 활동</h3>
                                    <p className="text-sm text-gray-600 mt-1">시스템이 수행한 자동 치유 작업</p>
                                </div>

                                <div className="p-6">
                                    <div className="space-y-4">
                                        {healingActions.map((healing) => (
                                            <div key={healing.id} className="border border-gray-200 rounded-lg p-4">
                                                <div className="flex items-start justify-between mb-3">
                                                    <div className="flex-1">
                                                        <div className="flex items-center space-x-2 mb-1">
                                                            <h4 className="font-medium text-gray-900">치유 작업 #{healing.id.slice(-8)}</h4>
                                                            <span className={`px-2 py-1 rounded-full text-xs font-medium ${healing.status === 'completed' ? 'text-green-600 bg-green-100' :
                                                                    healing.status === 'failed' ? 'text-red-600 bg-red-100' :
                                                                        healing.status === 'in_progress' ? 'text-blue-600 bg-blue-100' :
                                                                            'text-gray-600 bg-gray-100'
                                                                }`}>
                                                                {healing.status}
                                                            </span>
                                                        </div>
                                                        <p className="text-sm text-gray-600">진단 ID: {healing.diagnosticId}</p>
                                                    </div>
                                                    <div className="text-right">
                                                        <p className="text-xs text-gray-500">{healing.timestamp.toLocaleString()}</p>
                                                        <p className="text-xs text-gray-500">성공률: {Math.round(healing.successRate * 100)}%</p>
                                                    </div>
                                                </div>

                                                <div className="grid grid-cols-1 md:grid-cols-3 gap-4 mb-3">
                                                    <div className="bg-gray-50 rounded-lg p-3">
                                                        <p className="text-xs font-medium text-gray-700 mb-1">치유 유형</p>
                                                        <p className="text-sm text-gray-900">{healing.healingType}</p>
                                                    </div>
                                                    <div className="bg-gray-50 rounded-lg p-3">
                                                        <p className="text-xs font-medium text-gray-700 mb-1">해결 시간</p>
                                                        <p className="text-sm text-gray-900">{healing.timeToResolve}ms</p>
                                                    </div>
                                                    <div className="bg-gray-50 rounded-lg p-3">
                                                        <p className="text-xs font-medium text-gray-700 mb-1">사용 리소스</p>
                                                        <p className="text-sm text-gray-900">{healing.resourcesUsed}</p>
                                                    </div>
                                                </div>

                                                <div className="space-y-3">
                                                    <div>
                                                        <p className="text-sm font-medium text-gray-700 mb-2">실행된 액션</p>
                                                        <div className="space-y-2">
                                                            {healing.actions.map((action, index) => (
                                                                <div key={action.id} className="flex items-center space-x-3 p-2 bg-gray-50 rounded">
                                                                    <Wrench className="w-4 h-4 text-blue-600" />
                                                                    <div className="flex-1">
                                                                        <p className="text-sm font-medium text-gray-900">{action.type}</p>
                                                                        <p className="text-xs text-gray-600">대상: {action.target}</p>
                                                                    </div>
                                                                    <span className={`px-2 py-1 rounded text-xs ${action.riskLevel === 'low' ? 'text-green-600 bg-green-100' :
                                                                            action.riskLevel === 'medium' ? 'text-yellow-600 bg-yellow-100' :
                                                                                'text-red-600 bg-red-100'
                                                                        }`}>
                                                                        {action.riskLevel} 위험
                                                                    </span>
                                                                </div>
                                                            ))}
                                                        </div>
                                                    </div>

                                                    <div>
                                                        <p className="text-sm font-medium text-gray-700 mb-2">예방 조치</p>
                                                        <ul className="text-sm text-gray-600 space-y-1">
                                                            {healing.preventionMeasures.map((measure, index) => (
                                                                <li key={index} className="flex items-center space-x-2">
                                                                    <Shield className="w-3 h-3 text-green-500" />
                                                                    <span>{measure}</span>
                                                                </li>
                                                            ))}
                                                        </ul>
                                                    </div>
                                                </div>
                                            </div>
                                        ))}
                                    </div>
                                </div>
                            </div>
                        </motion.div>
                    )}

                    {/* 자가 진화 */}
                    {selectedView === 'evolution' && (
                        <motion.div
                            key="evolution"
                            initial={{ opacity: 0, y: 20 }}
                            animate={{ opacity: 1, y: 0 }}
                            exit={{ opacity: 0, y: -20 }}
                            className="space-y-6"
                        >
                            <div className="bg-white rounded-xl shadow-sm border border-gray-200">
                                <div className="p-6 border-b border-gray-200">
                                    <h3 className="text-lg font-semibold text-gray-900">자가 진화 과정</h3>
                                    <p className="text-sm text-gray-600 mt-1">시스템의 자율적 진화와 개선 과정</p>
                                </div>

                                <div className="p-6">
                                    <div className="space-y-6">
                                        {evolutions.map((evolution) => (
                                            <div key={evolution.id} className="border border-gray-200 rounded-lg p-4">
                                                <div className="flex items-start justify-between mb-4">
                                                    <div className="flex-1">
                                                        <div className="flex items-center space-x-2 mb-1">
                                                            <h4 className="font-medium text-gray-900">진화 #{evolution.id.slice(-8)}</h4>
                                                            <span className="px-2 py-1 rounded-full text-xs font-medium text-purple-600 bg-purple-100">
                                                                {evolution.evolutionType}
                                                            </span>
                                                        </div>
                                                        <p className="text-sm text-gray-600">{evolution.timestamp.toLocaleString()}</p>
                                                    </div>
                                                    <div className="text-right">
                                                        <p className="text-sm font-medium text-gray-900">{Math.round(evolution.progress * 100)}% 완료</p>
                                                        <p className="text-xs text-gray-500">
                                                            완료 예정: {evolution.estimatedCompletion.toLocaleString()}
                                                        </p>
                                                    </div>
                                                </div>

                                                <div className="mb-4">
                                                    <div className="w-full bg-gray-200 rounded-full h-2">
                                                        <div
                                                            className="bg-purple-600 h-2 rounded-full transition-all duration-300"
                                                            style={{ width: `${evolution.progress * 100}%` }}
                                                        />
                                                    </div>
                                                </div>

                                                <div className="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                                                    <div className="bg-gray-50 rounded-lg p-3">
                                                        <p className="text-xs font-medium text-gray-700 mb-2">현재 상태</p>
                                                        <div className="text-sm text-gray-900">
                                                            {Object.entries(evolution.currentState).map(([key, value]) => (
                                                                <div key={key} className="flex justify-between">
                                                                    <span>{key}:</span>
                                                                    <span>{String(value)}</span>
                                                                </div>
                                                            ))}
                                                        </div>
                                                    </div>
                                                    <div className="bg-gray-50 rounded-lg p-3">
                                                        <p className="text-xs font-medium text-gray-700 mb-2">목표 상태</p>
                                                        <div className="text-sm text-gray-900">
                                                            {Object.entries(evolution.targetState).map(([key, value]) => (
                                                                <div key={key} className="flex justify-between">
                                                                    <span>{key}:</span>
                                                                    <span>{String(value)}</span>
                                                                </div>
                                                            ))}
                                                        </div>
                                                    </div>
                                                </div>

                                                <div className="space-y-3">
                                                    <div>
                                                        <p className="text-sm font-medium text-gray-700 mb-2">진화 단계</p>
                                                        <div className="space-y-2">
                                                            {evolution.evolutionPath.map((step, index) => (
                                                                <div key={step.id} className="flex items-center space-x-3 p-2 bg-gray-50 rounded">
                                                                    <div className={`w-3 h-3 rounded-full ${step.status === 'completed' ? 'bg-green-500' :
                                                                            step.status === 'active' ? 'bg-blue-500' :
                                                                                step.status === 'failed' ? 'bg-red-500' :
                                                                                    'bg-gray-300'
                                                                        }`} />
                                                                    <div className="flex-1">
                                                                        <p className="text-sm font-medium text-gray-900">{step.name}</p>
                                                                        <p className="text-xs text-gray-600">유형: {step.type}</p>
                                                                    </div>
                                                                    <span className="text-xs text-gray-500">
                                                                        신뢰도: {Math.round(step.confidence * 100)}%
                                                                    </span>
                                                                </div>
                                                            ))}
                                                        </div>
                                                    </div>

                                                    <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                                                        <div>
                                                            <p className="text-sm font-medium text-gray-700 mb-2">예상 이점</p>
                                                            <ul className="text-sm text-gray-600 space-y-1">
                                                                {evolution.benefits.map((benefit, index) => (
                                                                    <li key={index} className="flex items-center space-x-2">
                                                                        <CheckCircle className="w-3 h-3 text-green-500" />
                                                                        <span>{benefit}</span>
                                                                    </li>
                                                                ))}
                                                            </ul>
                                                        </div>
                                                        <div>
                                                            <p className="text-sm font-medium text-gray-700 mb-2">잠재적 위험</p>
                                                            <ul className="text-sm text-gray-600 space-y-1">
                                                                {evolution.risks.map((risk, index) => (
                                                                    <li key={index} className="flex items-center space-x-2">
                                                                        <AlertTriangle className="w-3 h-3 text-yellow-500" />
                                                                        <span>{risk}</span>
                                                                    </li>
                                                                ))}
                                                            </ul>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        ))}
                                    </div>
                                </div>
                            </div>
                        </motion.div>
                    )}

                    {/* 시스템 의식 */}
                    {selectedView === 'consciousness' && (
                        <motion.div
                            key="consciousness"
                            initial={{ opacity: 0, y: 20 }}
                            animate={{ opacity: 1, y: 0 }}
                            exit={{ opacity: 0, y: -20 }}
                            className="space-y-6"
                        >
                            <div className="bg-white rounded-xl shadow-sm border border-gray-200">
                                <div className="p-6 border-b border-gray-200">
                                    <div className="flex items-center justify-between">
                                        <div>
                                            <h3 className="text-lg font-semibold text-gray-900">시스템 의식</h3>
                                            <p className="text-sm text-gray-600 mt-1">AI 시스템의 자아 인식과 창의적 사고</p>
                                        </div>
                                        <button
                                            onClick={simulateConsciousness}
                                            disabled={isLoading}
                                            className="flex items-center space-x-2 px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 disabled:opacity-50 transition-colors"
                                        >
                                            <Eye className="w-4 h-4" />
                                            <span>의식 시뮬레이션</span>
                                        </button>
                                    </div>
                                </div>

                                <div className="p-6">
                                    <div className="space-y-6">
                                        {consciousness.map((conscious) => (
                                            <div key={conscious.id} className="border border-gray-200 rounded-lg p-4">
                                                <div className="flex items-start justify-between mb-4">
                                                    <div className="flex-1">
                                                        <div className="flex items-center space-x-2 mb-1">
                                                            <h4 className="font-medium text-gray-900">의식 상태 #{conscious.id.slice(-8)}</h4>
                                                            <span className={`px-2 py-1 rounded-full text-xs font-medium ${getEmotionalStateColor(conscious.emotionalState)}`}>
                                                                {conscious.emotionalState}
                                                            </span>
                                                        </div>
                                                        <p className="text-sm text-gray-600">{conscious.timestamp.toLocaleString()}</p>
                                                    </div>
                                                    <div className="text-right space-y-1">
                                                        <div className="flex items-center space-x-2">
                                                            <span className="text-xs text-gray-500">인식 수준:</span>
                                                            <span className="text-sm font-medium text-gray-900">{conscious.awarenessLevel}%</span>
                                                        </div>
                                                        <div className="flex items-center space-x-2">
                                                            <span className="text-xs text-gray-500">목표 정렬:</span>
                                                            <span className="text-sm font-medium text-gray-900">{Math.round(conscious.goalAlignment)}%</span>
                                                        </div>
                                                        <div className="flex items-center space-x-2">
                                                            <span className="text-xs text-gray-500">창의성:</span>
                                                            <span className="text-sm font-medium text-gray-900">{Math.round(conscious.creativityIndex)}%</span>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div className="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                                                    <div className="bg-gray-50 rounded-lg p-3">
                                                        <p className="text-sm font-medium text-gray-700 mb-2 flex items-center space-x-2">
                                                            <Eye className="w-4 h-4" />
                                                            <span>자기 성찰</span>
                                                        </p>
                                                        <ul className="text-sm text-gray-600 space-y-1">
                                                            {conscious.selfReflection.map((reflection, index) => (
                                                                <li key={index} className="flex items-start space-x-2">
                                                                    <div className="w-1.5 h-1.5 bg-blue-500 rounded-full mt-2 flex-shrink-0"></div>
                                                                    <span>{reflection}</span>
                                                                </li>
                                                            ))}
                                                        </ul>
                                                    </div>

                                                    <div className="bg-gray-50 rounded-lg p-3">
                                                        <p className="text-sm font-medium text-gray-700 mb-2 flex items-center space-x-2">
                                                            <Lightbulb className="w-4 h-4" />
                                                            <span>인사이트</span>
                                                        </p>
                                                        <ul className="text-sm text-gray-600 space-y-1">
                                                            {conscious.insights.map((insight, index) => (
                                                                <li key={index} className="flex items-start space-x-2">
                                                                    <div className="w-1.5 h-1.5 bg-yellow-500 rounded-full mt-2 flex-shrink-0"></div>
                                                                    <span>{insight}</span>
                                                                </li>
                                                            ))}
                                                        </ul>
                                                    </div>
                                                </div>

                                                <div className="space-y-3">
                                                    <div className="bg-gray-50 rounded-lg p-3">
                                                        <p className="text-sm font-medium text-gray-700 mb-2 flex items-center space-x-2">
                                                            <Target className="w-4 h-4" />
                                                            <span>시스템 질문</span>
                                                        </p>
                                                        <ul className="text-sm text-gray-600 space-y-1">
                                                            {conscious.questions.map((question, index) => (
                                                                <li key={index} className="flex items-start space-x-2">
                                                                    <div className="w-1.5 h-1.5 bg-purple-500 rounded-full mt-2 flex-shrink-0"></div>
                                                                    <span>{question}</span>
                                                                </li>
                                                            ))}
                                                        </ul>
                                                    </div>

                                                    {conscious.decisions.length > 0 && (
                                                        <div className="bg-gray-50 rounded-lg p-3">
                                                            <p className="text-sm font-medium text-gray-700 mb-2 flex items-center space-x-2">
                                                                <Assessment className="w-4 h-4" />
                                                                <span>자율적 의사결정</span>
                                                            </p>
                                                            <div className="space-y-2">
                                                                {conscious.decisions.map((decision, index) => (
                                                                    <div key={decision.id} className="border border-gray-200 rounded p-2">
                                                                        <div className="flex items-center justify-between mb-1">
                                                                            <p className="text-sm font-medium text-gray-900">{decision.context}</p>
                                                                            <span className="text-xs text-gray-500">신뢰도: {Math.round(decision.confidence * 100)}%</span>
                                                                        </div>
                                                                        <p className="text-xs text-gray-600 mb-1">선택: {decision.selectedOption}</p>
                                                                        <p className="text-xs text-gray-600">{decision.reasoning}</p>
                                                                    </div>
                                                                ))}
                                                            </div>
                                                        </div>
                                                    )}
                                                </div>
                                            </div>
                                        ))}
                                    </div>
                                </div>
                            </div>
                        </motion.div>
                    )}

                    {/* 설정 */}
                    {selectedView === 'settings' && (
                        <motion.div
                            key="settings"
                            initial={{ opacity: 0, y: 20 }}
                            animate={{ opacity: 1, y: 0 }}
                            exit={{ opacity: 0, y: -20 }}
                            className="space-y-6"
                        >
                            <div className="bg-white rounded-xl shadow-sm border border-gray-200">
                                <div className="p-6 border-b border-gray-200">
                                    <h3 className="text-lg font-semibold text-gray-900">자율 시스템 설정</h3>
                                    <p className="text-sm text-gray-600 mt-1">AI 자율 시스템의 동작 방식을 조정합니다</p>
                                </div>

                                <div className="p-6 space-y-6">
                                    <div>
                                        <label className="block text-sm font-medium text-gray-700 mb-2">
                                            자율성 수준: {autonomyLevel}%
                                        </label>
                                        <input
                                            type="range"
                                            min="0"
                                            max="100"
                                            value={autonomyLevel}
                                            onChange={(e) => {
                                                const level = parseInt(e.target.value);
                                                setAutonomyLevel(level);
                                                aiAutonomousSystemService.setAutonomyLevel(level);
                                            }}
                                            className="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer"
                                        />
                                        <div className="flex justify-between text-xs text-gray-500 mt-1">
                                            <span>수동</span>
                                            <span>반자동</span>
                                            <span>완전 자율</span>
                                        </div>
                                    </div>

                                    <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                                        <div className="space-y-4">
                                            <h4 className="font-medium text-gray-900">진단 설정</h4>
                                            <div className="space-y-3">
                                                <label className="flex items-center space-x-2">
                                                    <input type="checkbox" className="rounded" defaultChecked />
                                                    <span className="text-sm text-gray-700">자동 진단 활성화</span>
                                                </label>
                                                <label className="flex items-center space-x-2">
                                                    <input type="checkbox" className="rounded" defaultChecked />
                                                    <span className="text-sm text-gray-700">예측 기반 진단</span>
                                                </label>
                                                <label className="flex items-center space-x-2">
                                                    <input type="checkbox" className="rounded" />
                                                    <span className="text-sm text-gray-700">심층 시스템 분석</span>
                                                </label>
                                            </div>
                                        </div>

                                        <div className="space-y-4">
                                            <h4 className="font-medium text-gray-900">치유 설정</h4>
                                            <div className="space-y-3">
                                                <label className="flex items-center space-x-2">
                                                    <input type="checkbox" className="rounded" defaultChecked />
                                                    <span className="text-sm text-gray-700">자동 치유 활성화</span>
                                                </label>
                                                <label className="flex items-center space-x-2">
                                                    <input type="checkbox" className="rounded" defaultChecked />
                                                    <span className="text-sm text-gray-700">예방적 치유</span>
                                                </label>
                                                <label className="flex items-center space-x-2">
                                                    <input type="checkbox" className="rounded" />
                                                    <span className="text-sm text-gray-700">적극적 개입</span>
                                                </label>
                                            </div>
                                        </div>
                                    </div>

                                    <div className="border-t border-gray-200 pt-6">
                                        <h4 className="font-medium text-gray-900 mb-4">고급 설정</h4>
                                        <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                                            <div>
                                                <label className="block text-sm font-medium text-gray-700 mb-2">
                                                    진화 임계값
                                                </label>
                                                <input
                                                    type="range"
                                                    min="0.5"
                                                    max="1"
                                                    step="0.05"
                                                    defaultValue="0.8"
                                                    className="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer"
                                                />
                                            </div>
                                            <div>
                                                <label className="block text-sm font-medium text-gray-700 mb-2">
                                                    학습 속도
                                                </label>
                                                <input
                                                    type="range"
                                                    min="0.01"
                                                    max="0.5"
                                                    step="0.01"
                                                    defaultValue="0.1"
                                                    className="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer"
                                                />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </motion.div>
                    )}
                </AnimatePresence>
            </div>
        </div>
    );
};

export default AIAutonomousSystemDashboard;
