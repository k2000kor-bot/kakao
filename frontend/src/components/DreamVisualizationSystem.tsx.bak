import React, { useState, useEffect } from 'react';
import {
    Box,
    Card,
    CardContent,
    Typography,
    Grid,
    Chip,
    Button,
    Dialog,
    DialogTitle,
    DialogContent,
    DialogActions,
    TextField,
    FormControl,
    InputLabel,
    Select,
    MenuItem,
    CircularProgress,
    Alert,
    Tabs,
    Tab,
    Paper,
    Divider,
    IconButton,
    Tooltip,
    LinearProgress,
    List,
    ListItem,
    ListItemText,
    ListItemIcon,
    Stepper,
    Step,
    StepLabel,
    StepContent,
    Accordion,
    AccordionSummary,
    AccordionDetails
} from '@mui/material';
import {
    Home as HomeIcon,
    TrendingUp as TrendingUpIcon,
    Timeline as TimelineIcon,
    Savings as SavingsIcon,
    Analytics as AnalyticsIcon,
    Refresh as RefreshIcon,
    Add as AddIcon,
    Visibility as VisibilityIcon,
    CheckCircle as CheckCircleIcon,
    Warning as WarningIcon,
    Info as InfoIcon,
    Star as StarIcon,
    CalendarToday as CalendarIcon,
    AttachMoney as MoneyIcon,
    Assessment as AssessmentIcon
} from '@mui/icons-material';
import { LineChart, Line, XAxis, YAxis, CartesianGrid, Tooltip as RechartsTooltip, ResponsiveContainer, BarChart, Bar, PieChart, Pie, Cell, AreaChart, Area } from 'recharts';

interface DreamGoal {
    goal_id: string;
    user_id: string;
    goal_type: string;
    target_property: string;
    target_price: number;
    current_savings: number;
    monthly_income: number;
    monthly_expenses: number;
    target_date: string;
    priority_level: number;
    description: string;
    created_at: string;
}

interface DreamVisualization {
    goal_id: string;
    visualization_type: string;
    image_data: string;
    progress_percentage: number;
    months_remaining: number;
    monthly_savings_needed: number;
    achievement_probability: number;
    milestones: Array<{
        percentage: number;
        target_amount: number;
        months_needed: number;
        milestone_date: string;
        description: string;
    }>;
    recommendations: string[];
}

interface DreamRoadmap {
    roadmap_id: string;
    user_id: string;
    goals: DreamGoal[];
    timeline_months: number;
    total_investment_needed: number;
    monthly_savings_plan: Record<string, number>;
    milestone_dates: string[];
    risk_factors: string[];
    success_strategies: string[];
}

interface DreamVisualizationSystemProps {
    onClose?: () => void;
}

const DreamVisualizationSystem: React.FC<DreamVisualizationSystemProps> = ({ onClose }) => {
    const [activeTab, setActiveTab] = useState(0);
    const [dreamGoals, setDreamGoals] = useState<DreamGoal[]>([]);
    const [selectedGoal, setSelectedGoal] = useState<DreamGoal | null>(null);
    const [visualization, setVisualization] = useState<DreamVisualization | null>(null);
    const [roadmap, setRoadmap] = useState<DreamRoadmap | null>(null);
    const [loading, setLoading] = useState(false);
    const [error, setError] = useState<string | null>(null);
    const [goalDialogOpen, setGoalDialogOpen] = useState(false);
    const [visualizationDialogOpen, setVisualizationDialogOpen] = useState(false);
    const [roadmapDialogOpen, setRoadmapDialogOpen] = useState(false);
    const [activeStep, setActiveStep] = useState(0);
    const [newGoalData, setNewGoalData] = useState({
        user_id: 'user_001',
        goal_type: '아파트구매',
        target_property: '',
        target_price: 0,
        current_savings: 0,
        monthly_income: 0,
        monthly_expenses: 0,
        target_date: '',
        priority_level: 3,
        description: ''
    });

    // 샘플 데이터
    const sampleGoals: DreamGoal[] = [
        {
            goal_id: 'GOAL_001',
            user_id: 'user_001',
            goal_type: '아파트구매',
            target_property: '강남구 아파트 84㎡',
            target_price: 1500000000,
            current_savings: 300000000,
            monthly_income: 8000000,
            monthly_expenses: 5000000,
            target_date: '2026-12-31',
            priority_level: 5,
            description: '강남구 신축 아파트 구매를 통한 자산 증식',
            created_at: '2024-01-15T10:00:00Z'
        },
        {
            goal_id: 'GOAL_002',
            user_id: 'user_001',
            goal_type: '투자',
            target_property: '서초구 오피스텔',
            target_price: 800000000,
            current_savings: 200000000,
            monthly_income: 8000000,
            monthly_expenses: 5000000,
            target_date: '2025-06-30',
            priority_level: 4,
            description: '수익형 부동산 투자를 통한 안정적 수입원 확보',
            created_at: '2024-02-01T14:30:00Z'
        }
    ];

    const sampleVisualization: DreamVisualization = {
        goal_id: 'GOAL_001',
        visualization_type: 'progress_chart',
        image_data: '',
        progress_percentage: 20.0,
        months_remaining: 24,
        monthly_savings_needed: 50000000,
        achievement_probability: 85.0,
        milestones: [
            { percentage: 25, target_amount: 375000000, months_needed: 6, milestone_date: '2024-07-31', description: '25% 달성 목표' },
            { percentage: 50, target_amount: 750000000, months_needed: 12, milestone_date: '2025-01-31', description: '50% 달성 목표' },
            { percentage: 75, target_amount: 1125000000, months_needed: 18, milestone_date: '2025-07-31', description: '75% 달성 목표' },
            { percentage: 100, target_amount: 1500000000, months_needed: 24, milestone_date: '2025-12-31', description: '100% 달성 목표' }
        ],
        recommendations: [
            '월 저축액을 늘리기 위해 지출을 줄이거나 수입을 늘리는 방법을 고려하세요.',
            '정기적인 목표 점검과 계획 수정을 통해 현실적인 계획을 유지하세요.',
            '부동산 시장 동향을 지속적으로 모니터링하여 최적의 구매 시점을 파악하세요.',
            '신용도 관리와 대출 준비를 미리 해두세요.',
            '대용량 자금을 활용한 부동산 투자 상품을 검토해보세요.'
        ]
    };

    useEffect(() => {
        loadDreamGoals();
    }, []);

    const loadDreamGoals = async () => {
        setLoading(true);
        try {
            // 실제 API 호출 시도
            try {
                const response = await fetch('http://localhost:8008/dream-goals', {
                    method: 'GET',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                });

                if (response.ok) {
                    const result = await response.json();
                    console.log('꿈 목표 데이터:', result);
                    setDreamGoals(result.goals || []);
                    setError(null);
                } else {
                    const errorText = await response.text();
                    console.warn('API 호출 실패, 샘플 데이터 사용:', response.status, errorText);
                    throw new Error(`API 호출 실패: ${response.status}`);
                }
            } catch (apiError) {
                console.warn('API 호출 실패, 샘플 데이터 사용:', apiError);
                // API 호출 실패 시 샘플 데이터 사용
                await new Promise(resolve => setTimeout(resolve, 1000));
                setDreamGoals(sampleGoals);
                setError(null);
            }
        } catch (err) {
            console.error('꿈 목표 로딩 오류:', err);
            const errorMessage = err instanceof Error ? err.message : '꿈 목표를 불러오는 중 알 수 없는 오류가 발생했습니다.';
            setError(`꿈 목표를 불러오는 중 오류가 발생했습니다: ${errorMessage}`);
        } finally {
            setLoading(false);
        }
    };

    const createDreamGoal = async () => {
        if (!newGoalData.target_property || !newGoalData.target_price || !newGoalData.target_date) {
            setError('필수 정보를 모두 입력해주세요.');
            return;
        }

        setLoading(true);
        try {
            // 실제 API 호출
            const response = await fetch('http://localhost:8008/create-dream-goal', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    user_id: newGoalData.user_id,
                    goal_data: newGoalData
                }),
            });

            if (response.ok) {
                const goal = await response.json();
                setDreamGoals(prev => [...prev, goal]);
                setGoalDialogOpen(false);
                setNewGoalData({
                    user_id: 'user_001',
                    goal_type: '아파트구매',
                    target_property: '',
                    target_price: 0,
                    current_savings: 0,
                    monthly_income: 0,
                    monthly_expenses: 0,
                    target_date: '',
                    priority_level: 3,
                    description: ''
                });
            } else {
                throw new Error('꿈 목표 생성 요청이 실패했습니다.');
            }
        } catch (err) {
            // 샘플 목표 추가
            const newGoal: DreamGoal = {
                goal_id: `GOAL_${Date.now()}`,
                user_id: newGoalData.user_id,
                goal_type: newGoalData.goal_type,
                target_property: newGoalData.target_property,
                target_price: newGoalData.target_price,
                current_savings: newGoalData.current_savings,
                monthly_income: newGoalData.monthly_income,
                monthly_expenses: newGoalData.monthly_expenses,
                target_date: newGoalData.target_date,
                priority_level: newGoalData.priority_level,
                description: newGoalData.description,
                created_at: new Date().toISOString()
            };
            setDreamGoals(prev => [...prev, newGoal]);
            setGoalDialogOpen(false);
        } finally {
            setLoading(false);
        }
    };

    const visualizeDream = async (goalId: string, visualizationType: string = 'progress_chart') => {
        setLoading(true);
        try {
            // 실제 API 호출
            const response = await fetch('http://localhost:8008/visualize-dream', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    goal_id: goalId,
                    visualization_type: visualizationType
                }),
            });

            if (response.ok) {
                const visualization = await response.json();
                setVisualization(visualization);
                setSelectedGoal(dreamGoals.find(g => g.goal_id === goalId) || null);
                setActiveTab(1); // 시각화 탭으로 이동
                setVisualizationDialogOpen(false);
            } else {
                throw new Error('꿈 시각화 요청이 실패했습니다.');
            }
        } catch (err) {
            // 샘플 시각화 사용
            setVisualization(sampleVisualization);
            setSelectedGoal(dreamGoals.find(g => g.goal_id === goalId) || null);
            setActiveTab(1);
            setVisualizationDialogOpen(false);
        } finally {
            setLoading(false);
        }
    };

    const createDreamRoadmap = async () => {
        if (dreamGoals.length === 0) {
            setError('로드맵을 생성할 목표가 없습니다.');
            return;
        }

        setLoading(true);
        try {
            const response = await fetch('http://localhost:8008/create-dream-roadmap', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    user_id: 'user_001',
                    goal_ids: dreamGoals.map(g => g.goal_id)
                }),
            });

            if (response.ok) {
                const roadmap = await response.json();
                setRoadmap(roadmap);
                setActiveTab(2); // 로드맵 탭으로 이동
                setRoadmapDialogOpen(false);
            } else {
                throw new Error('꿈 로드맵 생성 요청이 실패했습니다.');
            }
        } catch (err) {
            setError('꿈 로드맵 생성 중 오류가 발생했습니다.');
        } finally {
            setLoading(false);
        }
    };

    const getPriorityColor = (level: number) => {
        const colors: Record<number, string> = {
            1: '#F44336',
            2: '#FF5722',
            3: '#FF9800',
            4: '#4CAF50',
            5: '#2196F3'
        };
        return colors[level] || '#9E9E9E';
    };

    const getPriorityLabel = (level: number) => {
        const labels: Record<number, string> = {
            1: '낮음',
            2: '보통',
            3: '중간',
            4: '높음',
            5: '매우 높음'
        };
        return labels[level] || '미설정';
    };

    const getAchievementColor = (probability: number) => {
        if (probability >= 80) return '#4CAF50';
        if (probability >= 60) return '#8BC34A';
        if (probability >= 40) return '#FFC107';
        if (probability >= 20) return '#FF9800';
        return '#F44336';
    };

    const formatCurrency = (amount: number) => {
        return new Intl.NumberFormat('ko-KR', {
            style: 'currency',
            currency: 'KRW',
            minimumFractionDigits: 0,
            maximumFractionDigits: 0,
        }).format(amount);
    };

    const formatDate = (dateString: string) => {
        return new Date(dateString).toLocaleDateString('ko-KR');
    };

    // 차트 데이터 준비
    const milestoneData = visualization ?
        visualization.milestones.map(milestone => ({
            milestone: `${milestone.percentage}%`,
            amount: milestone.target_amount,
            months: milestone.months_needed
        })) : [];

    const savingsPlanData = selectedGoal ? [
        { category: '현재 저축액', amount: selectedGoal.current_savings },
        { category: '필요 저축액', amount: selectedGoal.target_price - selectedGoal.current_savings },
        { category: '월 저축 가능액', amount: (selectedGoal.monthly_income - selectedGoal.monthly_expenses) * 24 }
    ] : [];

    const TabPanel = ({ children, value, index }: { children: React.ReactNode; value: number; index: number }) => (
        <div hidden={value !== index}>
            {value === index && <Box sx={{ p: 3 }}>{children}</Box>}
        </div>
    );

    const steps = [
        '목표 설정',
        '재정 현황',
        '목표 확인',
        '완료'
    ];

    return (
        <Box sx={{ maxWidth: 1200, mx: 'auto', p: 3 }}>
            <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', mb: 3 }}>
                <Typography variant="h4" component="h1" sx={{ fontWeight: 'bold', color: '#2E8B57' }}>
                    꿈 시각화 시스템
                </Typography>
                <Box>
                    <Tooltip title="데이터 새로고침">
                        <IconButton onClick={loadDreamGoals} disabled={loading}>
                            <RefreshIcon />
                        </IconButton>
                    </Tooltip>
                    <Button
                        variant="contained"
                        startIcon={<AddIcon />}
                        onClick={() => setGoalDialogOpen(true)}
                        sx={{ ml: 2 }}
                    >
                        꿈 목표 추가
                    </Button>
                </Box>
            </Box>

            {error && (
                <Alert
                    severity="error"
                    sx={{ mb: 3 }}
                    onClose={() => setError(null)}
                    action={
                        <Button
                            color="inherit"
                            size="small"
                            onClick={() => {
                                console.log('상세 오류 정보:', error);
                                alert(`상세 오류 정보:\n${error}\n\n브라우저 개발자 도구의 콘솔을 확인하세요.`);
                            }}
                        >
                            상세보기
                        </Button>
                    }
                >
                    <Typography variant="body2" sx={{ fontWeight: 'bold', mb: 1 }}>
                        오류가 발생했습니다:
                    </Typography>
                    <Typography variant="body2">
                        {error}
                    </Typography>
                    <Typography variant="caption" sx={{ display: 'block', mt: 1, opacity: 0.8 }}>
                        💡 브라우저 개발자 도구(F12)의 콘솔 탭에서 더 자세한 오류 정보를 확인할 수 있습니다.
                    </Typography>
                </Alert>
            )}

            <Paper sx={{ mb: 3 }}>
                <Tabs value={activeTab} onChange={(e, newValue) => setActiveTab(newValue)}>
                    <Tab label="꿈 목표 관리" icon={<HomeIcon />} />
                    <Tab label="꿈 시각화" icon={<VisibilityIcon />} />
                    <Tab label="실현 로드맵" icon={<TimelineIcon />} />
                    <Tab label="성과 분석" icon={<AnalyticsIcon />} />
                </Tabs>
            </Paper>

            <TabPanel value={activeTab} index={0}>
                <Grid container spacing={3}>
                    {dreamGoals.map((goal) => (
                        <Grid item xs={12} md={6} lg={4} key={goal.goal_id}>
                            <Card sx={{ height: '100%', '&:hover': { boxShadow: 6 } }}>
                                <CardContent>
                                    <Box sx={{ display: 'flex', alignItems: 'center', mb: 2 }}>
                                        <HomeIcon sx={{ fontSize: 40, color: '#2E8B57', mr: 2 }} />
                                        <Box>
                                            <Typography variant="h6" sx={{ fontWeight: 'bold' }}>
                                                {goal.target_property}
                                            </Typography>
                                            <Typography variant="body2" color="text.secondary">
                                                {goal.goal_type}
                                            </Typography>
                                        </Box>
                                    </Box>

                                    <Box sx={{ mb: 2 }}>
                                        <Typography variant="body2" sx={{ mb: 1, fontWeight: 'bold' }}>
                                            목표 금액:
                                        </Typography>
                                        <Typography variant="h6" sx={{ fontWeight: 'bold', color: '#2E8B57' }}>
                                            {formatCurrency(goal.target_price)}
                                        </Typography>
                                    </Box>

                                    <Box sx={{ mb: 2 }}>
                                        <Typography variant="body2" sx={{ mb: 1, fontWeight: 'bold' }}>
                                            현재 저축액:
                                        </Typography>
                                        <Typography variant="body1">
                                            {formatCurrency(goal.current_savings)}
                                        </Typography>
                                        <LinearProgress
                                            variant="determinate"
                                            value={(goal.current_savings / goal.target_price) * 100}
                                            sx={{ mt: 1, height: 8, borderRadius: 4 }}
                                        />
                                        <Typography variant="caption" sx={{ mt: 0.5 }}>
                                            {((goal.current_savings / goal.target_price) * 100).toFixed(1)}% 달성
                                        </Typography>
                                    </Box>

                                    <Box sx={{ mb: 2 }}>
                                        <Typography variant="body2" sx={{ mb: 1, fontWeight: 'bold' }}>
                                            우선순위:
                                        </Typography>
                                        <Chip
                                            label={getPriorityLabel(goal.priority_level)}
                                            size="small"
                                            sx={{
                                                bgcolor: getPriorityColor(goal.priority_level),
                                                color: 'white'
                                            }}
                                        />
                                    </Box>

                                    <Box sx={{ mb: 2 }}>
                                        <Typography variant="body2" sx={{ mb: 1, fontWeight: 'bold' }}>
                                            목표 달성일:
                                        </Typography>
                                        <Typography variant="body2">
                                            {formatDate(goal.target_date)}
                                        </Typography>
                                    </Box>

                                    <Button
                                        variant="contained"
                                        fullWidth
                                        startIcon={<VisibilityIcon />}
                                        onClick={() => visualizeDream(goal.goal_id)}
                                        sx={{ mt: 2 }}
                                    >
                                        꿈 시각화
                                    </Button>
                                </CardContent>
                            </Card>
                        </Grid>
                    ))}
                </Grid>
            </TabPanel>

            <TabPanel value={activeTab} index={1}>
                {visualization && selectedGoal ? (
                    <Grid container spacing={3}>
                        {/* 진행률 요약 */}
                        <Grid item xs={12}>
                            <Card>
                                <CardContent>
                                    <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', mb: 3 }}>
                                        <Typography variant="h5" sx={{ fontWeight: 'bold' }}>
                                            {selectedGoal.target_property} 꿈 시각화
                                        </Typography>
                                        <Box sx={{ display: 'flex', alignItems: 'center' }}>
                                            <Typography variant="h4" sx={{ fontWeight: 'bold', color: '#2E8B57', mr: 2 }}>
                                                {visualization.progress_percentage.toFixed(1)}%
                                            </Typography>
                                            <Typography variant="h6">진행률</Typography>
                                        </Box>
                                    </Box>

                                    <Grid container spacing={3}>
                                        <Grid item xs={12} md={3}>
                                            <Box sx={{ textAlign: 'center' }}>
                                                <Typography variant="h4" sx={{ fontWeight: 'bold', color: '#2196F3' }}>
                                                    {visualization.months_remaining}
                                                </Typography>
                                                <Typography variant="h6">남은 기간 (개월)</Typography>
                                            </Box>
                                        </Grid>
                                        <Grid item xs={12} md={3}>
                                            <Box sx={{ textAlign: 'center' }}>
                                                <Typography variant="h4" sx={{ fontWeight: 'bold', color: '#FF9800' }}>
                                                    {formatCurrency(visualization.monthly_savings_needed)}
                                                </Typography>
                                                <Typography variant="h6">월 저축 필요액</Typography>
                                            </Box>
                                        </Grid>
                                        <Grid item xs={12} md={3}>
                                            <Box sx={{ textAlign: 'center' }}>
                                                <Typography variant="h4" sx={{ fontWeight: 'bold', color: getAchievementColor(visualization.achievement_probability) }}>
                                                    {visualization.achievement_probability.toFixed(1)}%
                                                </Typography>
                                                <Typography variant="h6">달성 확률</Typography>
                                            </Box>
                                        </Grid>
                                        <Grid item xs={12} md={3}>
                                            <Box sx={{ textAlign: 'center' }}>
                                                <Chip
                                                    label={visualization.achievement_probability >= 80 ? '높음' :
                                                        visualization.achievement_probability >= 60 ? '보통' : '낮음'}
                                                    sx={{
                                                        bgcolor: getAchievementColor(visualization.achievement_probability),
                                                        color: 'white',
                                                        fontWeight: 'bold',
                                                        fontSize: '1.2rem',
                                                        height: 40
                                                    }}
                                                />
                                                <Typography variant="h6" sx={{ mt: 1 }}>성공 가능성</Typography>
                                            </Box>
                                        </Grid>
                                    </Grid>
                                </CardContent>
                            </Card>
                        </Grid>

                        {/* 마일스톤 차트 */}
                        <Grid item xs={12} md={8}>
                            <Card>
                                <CardContent>
                                    <Typography variant="h6" sx={{ mb: 2, fontWeight: 'bold' }}>
                                        마일스톤 진행 계획
                                    </Typography>
                                    <ResponsiveContainer width="100%" height={300}>
                                        <AreaChart data={milestoneData}>
                                            <CartesianGrid strokeDasharray="3 3" />
                                            <XAxis dataKey="milestone" />
                                            <YAxis tickFormatter={(value) => `${(value / 100000000).toFixed(0)}억`} />
                                            <RechartsTooltip formatter={(value) => [formatCurrency(value as number), '금액']} />
                                            <Area type="monotone" dataKey="amount" stroke="#4CAF50" fill="#4CAF50" fillOpacity={0.3} />
                                        </AreaChart>
                                    </ResponsiveContainer>
                                </CardContent>
                            </Card>
                        </Grid>

                        {/* 저축 계획 */}
                        <Grid item xs={12} md={4}>
                            <Card sx={{ height: '100%' }}>
                                <CardContent>
                                    <Typography variant="h6" sx={{ mb: 2, fontWeight: 'bold' }}>
                                        저축 계획 분석
                                    </Typography>
                                    <ResponsiveContainer width="100%" height={250}>
                                        <PieChart>
                                            <Pie
                                                data={savingsPlanData}
                                                cx="50%"
                                                cy="50%"
                                                outerRadius={80}
                                                dataKey="amount"
                                                label={({ category, value }) => `${category}: ${(value / 100000000).toFixed(1)}억`}
                                            >
                                                {savingsPlanData.map((entry, index) => (
                                                    <Cell key={`cell-${index}`} fill={`hsl(${index * 120}, 70%, 50%)`} />
                                                ))}
                                            </Pie>
                                            <RechartsTooltip formatter={(value) => [formatCurrency(value as number), '금액']} />
                                        </PieChart>
                                    </ResponsiveContainer>
                                </CardContent>
                            </Card>
                        </Grid>

                        {/* 마일스톤 상세 */}
                        <Grid item xs={12} md={6}>
                            <Card sx={{ height: '100%' }}>
                                <CardContent>
                                    <Typography variant="h6" sx={{ mb: 2, fontWeight: 'bold' }}>
                                        마일스톤 상세
                                    </Typography>
                                    <List>
                                        {visualization.milestones.map((milestone, index) => (
                                            <ListItem key={index}>
                                                <ListItemIcon>
                                                    <CheckCircleIcon sx={{ color: '#4CAF50' }} />
                                                </ListItemIcon>
                                                <ListItemText
                                                    primary={`${milestone.percentage}% 달성 목표`}
                                                    secondary={
                                                        <Box>
                                                            <Typography variant="body2">
                                                                목표 금액: {formatCurrency(milestone.target_amount)}
                                                            </Typography>
                                                            <Typography variant="body2">
                                                                예상 달성일: {formatDate(milestone.milestone_date)}
                                                            </Typography>
                                                            <Typography variant="body2">
                                                                필요 기간: {milestone.months_needed}개월
                                                            </Typography>
                                                        </Box>
                                                    }
                                                />
                                            </ListItem>
                                        ))}
                                    </List>
                                </CardContent>
                            </Card>
                        </Grid>

                        {/* 권장사항 */}
                        <Grid item xs={12} md={6}>
                            <Card sx={{ height: '100%' }}>
                                <CardContent>
                                    <Typography variant="h6" sx={{ mb: 2, fontWeight: 'bold' }}>
                                        성공을 위한 권장사항
                                    </Typography>
                                    <List>
                                        {visualization.recommendations.map((recommendation, index) => (
                                            <ListItem key={index}>
                                                <ListItemIcon>
                                                    <InfoIcon sx={{ color: '#2196F3' }} />
                                                </ListItemIcon>
                                                <ListItemText
                                                    primary={recommendation}
                                                    primaryTypographyProps={{ fontSize: '0.9rem' }}
                                                />
                                            </ListItem>
                                        ))}
                                    </List>
                                </CardContent>
                            </Card>
                        </Grid>
                    </Grid>
                ) : (
                    <Typography>시각화할 꿈 목표를 선택해주세요.</Typography>
                )}
            </TabPanel>

            <TabPanel value={activeTab} index={2}>
                <Grid container spacing={3}>
                    <Grid item xs={12}>
                        <Card>
                            <CardContent>
                                <Typography variant="h6" sx={{ mb: 2, fontWeight: 'bold' }}>
                                    꿈 실현 로드맵
                                </Typography>
                                <Typography variant="body1" color="text.secondary" sx={{ mb: 3 }}>
                                    여러 꿈 목표를 통합하여 체계적인 실현 계획을 수립합니다.
                                </Typography>
                                <Button
                                    variant="outlined"
                                    startIcon={<TimelineIcon />}
                                    onClick={() => setRoadmapDialogOpen(true)}
                                >
                                    로드맵 생성
                                </Button>
                            </CardContent>
                        </Card>
                    </Grid>
                </Grid>
            </TabPanel>

            <TabPanel value={activeTab} index={3}>
                <Grid container spacing={3}>
                    <Grid item xs={12}>
                        <Card>
                            <CardContent>
                                <Typography variant="h6" sx={{ mb: 2, fontWeight: 'bold' }}>
                                    성과 분석
                                </Typography>
                                <Typography variant="body1" color="text.secondary">
                                    꿈 목표 달성 과정과 성과를 분석하여 더 나은 계획을 수립할 수 있습니다.
                                </Typography>
                            </CardContent>
                        </Card>
                    </Grid>
                </Grid>
            </TabPanel>

            {/* 꿈 목표 생성 다이얼로그 */}
            <Dialog open={goalDialogOpen} onClose={() => setGoalDialogOpen(false)} maxWidth="md" fullWidth>
                <DialogTitle>새 꿈 목표 생성</DialogTitle>
                <DialogContent>
                    <Box sx={{ pt: 2 }}>
                        <Stepper activeStep={activeStep} orientation="vertical">
                            <Step>
                                <StepLabel>목표 설정</StepLabel>
                                <StepContent>
                                    <FormControl fullWidth sx={{ mb: 3 }}>
                                        <InputLabel>목표 유형</InputLabel>
                                        <Select
                                            value={newGoalData.goal_type}
                                            onChange={(e) => setNewGoalData(prev => ({ ...prev, goal_type: e.target.value }))}
                                        >
                                            <MenuItem value="아파트구매">아파트 구매</MenuItem>
                                            <MenuItem value="투자">부동산 투자</MenuItem>
                                            <MenuItem value="자산증식">자산 증식</MenuItem>
                                        </Select>
                                    </FormControl>
                                    <TextField
                                        fullWidth
                                        label="목표 부동산"
                                        value={newGoalData.target_property}
                                        onChange={(e) => setNewGoalData(prev => ({ ...prev, target_property: e.target.value }))}
                                        sx={{ mb: 3 }}
                                    />
                                    <TextField
                                        fullWidth
                                        label="목표 금액 (원)"
                                        type="number"
                                        value={newGoalData.target_price}
                                        onChange={(e) => setNewGoalData(prev => ({ ...prev, target_price: Number(e.target.value) }))}
                                        sx={{ mb: 3 }}
                                    />
                                    <Button onClick={() => setActiveStep(1)} variant="contained">
                                        다음
                                    </Button>
                                </StepContent>
                            </Step>

                            <Step>
                                <StepLabel>재정 현황</StepLabel>
                                <StepContent>
                                    <TextField
                                        fullWidth
                                        label="현재 저축액 (원)"
                                        type="number"
                                        value={newGoalData.current_savings}
                                        onChange={(e) => setNewGoalData(prev => ({ ...prev, current_savings: Number(e.target.value) }))}
                                        sx={{ mb: 3 }}
                                    />
                                    <TextField
                                        fullWidth
                                        label="월 수입 (원)"
                                        type="number"
                                        value={newGoalData.monthly_income}
                                        onChange={(e) => setNewGoalData(prev => ({ ...prev, monthly_income: Number(e.target.value) }))}
                                        sx={{ mb: 3 }}
                                    />
                                    <TextField
                                        fullWidth
                                        label="월 지출 (원)"
                                        type="number"
                                        value={newGoalData.monthly_expenses}
                                        onChange={(e) => setNewGoalData(prev => ({ ...prev, monthly_expenses: Number(e.target.value) }))}
                                        sx={{ mb: 3 }}
                                    />
                                    <Box sx={{ mb: 2 }}>
                                        <Button onClick={() => setActiveStep(0)}>이전</Button>
                                        <Button onClick={() => setActiveStep(2)} variant="contained">
                                            다음
                                        </Button>
                                    </Box>
                                </StepContent>
                            </Step>

                            <Step>
                                <StepLabel>목표 확인</StepLabel>
                                <StepContent>
                                    <TextField
                                        fullWidth
                                        label="목표 달성일"
                                        type="date"
                                        value={newGoalData.target_date}
                                        onChange={(e) => setNewGoalData(prev => ({ ...prev, target_date: e.target.value }))}
                                        InputLabelProps={{ shrink: true }}
                                        sx={{ mb: 3 }}
                                    />
                                    <FormControl fullWidth sx={{ mb: 3 }}>
                                        <InputLabel>우선순위</InputLabel>
                                        <Select
                                            value={newGoalData.priority_level}
                                            onChange={(e) => setNewGoalData(prev => ({ ...prev, priority_level: Number(e.target.value) }))}
                                        >
                                            <MenuItem value={1}>1 - 낮음</MenuItem>
                                            <MenuItem value={2}>2 - 보통</MenuItem>
                                            <MenuItem value={3}>3 - 중간</MenuItem>
                                            <MenuItem value={4}>4 - 높음</MenuItem>
                                            <MenuItem value={5}>5 - 매우 높음</MenuItem>
                                        </Select>
                                    </FormControl>
                                    <TextField
                                        fullWidth
                                        multiline
                                        rows={3}
                                        label="목표 설명"
                                        value={newGoalData.description}
                                        onChange={(e) => setNewGoalData(prev => ({ ...prev, description: e.target.value }))}
                                        sx={{ mb: 3 }}
                                    />
                                    <Box sx={{ mb: 2 }}>
                                        <Button onClick={() => setActiveStep(1)}>이전</Button>
                                        <Button onClick={() => setActiveStep(3)} variant="contained">
                                            다음
                                        </Button>
                                    </Box>
                                </StepContent>
                            </Step>

                            <Step>
                                <StepLabel>완료</StepLabel>
                                <StepContent>
                                    <Typography variant="h6" sx={{ mb: 2 }}>
                                        목표 요약
                                    </Typography>
                                    <Box sx={{ mb: 3 }}>
                                        <Typography variant="body1">
                                            <strong>목표:</strong> {newGoalData.target_property}
                                        </Typography>
                                        <Typography variant="body1">
                                            <strong>목표 금액:</strong> {formatCurrency(newGoalData.target_price)}
                                        </Typography>
                                        <Typography variant="body1">
                                            <strong>현재 저축액:</strong> {formatCurrency(newGoalData.current_savings)}
                                        </Typography>
                                        <Typography variant="body1">
                                            <strong>목표 달성일:</strong> {formatDate(newGoalData.target_date)}
                                        </Typography>
                                        <Typography variant="body1">
                                            <strong>우선순위:</strong> {getPriorityLabel(newGoalData.priority_level)}
                                        </Typography>
                                    </Box>
                                    <Box sx={{ mb: 2 }}>
                                        <Button onClick={() => setActiveStep(2)}>이전</Button>
                                        <Button onClick={createDreamGoal} variant="contained" disabled={loading}>
                                            {loading ? <CircularProgress size={20} /> : '목표 생성'}
                                        </Button>
                                    </Box>
                                </StepContent>
                            </Step>
                        </Stepper>
                    </Box>
                </DialogContent>
                <DialogActions>
                    <Button onClick={() => setGoalDialogOpen(false)}>취소</Button>
                </DialogActions>
            </Dialog>

            {/* 꿈 시각화 다이얼로그 */}
            <Dialog open={visualizationDialogOpen} onClose={() => setVisualizationDialogOpen(false)} maxWidth="sm" fullWidth>
                <DialogTitle>꿈 시각화 설정</DialogTitle>
                <DialogContent>
                    <Box sx={{ pt: 2 }}>
                        <Typography variant="h6" sx={{ mb: 2 }}>
                            시각화할 목표 선택
                        </Typography>
                        <FormControl fullWidth sx={{ mb: 3 }}>
                            <InputLabel>꿈 목표</InputLabel>
                            <Select
                                value={selectedGoal?.goal_id || ''}
                                onChange={(e) => {
                                    const goal = dreamGoals.find(g => g.goal_id === e.target.value);
                                    setSelectedGoal(goal || null);
                                }}
                            >
                                {dreamGoals.map((goal) => (
                                    <MenuItem key={goal.goal_id} value={goal.goal_id}>
                                        {goal.target_property}
                                    </MenuItem>
                                ))}
                            </Select>
                        </FormControl>

                        <FormControl fullWidth sx={{ mb: 3 }}>
                            <InputLabel>시각화 유형</InputLabel>
                            <Select defaultValue="progress_chart">
                                <MenuItem value="progress_chart">진행률 차트</MenuItem>
                                <MenuItem value="timeline">타임라인</MenuItem>
                                <MenuItem value="savings_plan">저축 계획</MenuItem>
                                <MenuItem value="dream_house">꿈의 집</MenuItem>
                            </Select>
                        </FormControl>
                    </Box>
                </DialogContent>
                <DialogActions>
                    <Button onClick={() => setVisualizationDialogOpen(false)}>취소</Button>
                    <Button onClick={() => selectedGoal && visualizeDream(selectedGoal.goal_id)} variant="contained" disabled={loading}>
                        {loading ? <CircularProgress size={20} /> : '시각화 생성'}
                    </Button>
                </DialogActions>
            </Dialog>

            {/* 로드맵 생성 다이얼로그 */}
            <Dialog open={roadmapDialogOpen} onClose={() => setRoadmapDialogOpen(false)} maxWidth="sm" fullWidth>
                <DialogTitle>꿈 실현 로드맵 생성</DialogTitle>
                <DialogContent>
                    <Box sx={{ pt: 2 }}>
                        <Typography variant="h6" sx={{ mb: 2 }}>
                            로드맵에 포함할 목표들
                        </Typography>
                        <List>
                            {dreamGoals.map((goal) => (
                                <ListItem key={goal.goal_id}>
                                    <ListItemIcon>
                                        <CheckCircleIcon sx={{ color: '#4CAF50' }} />
                                    </ListItemIcon>
                                    <ListItemText
                                        primary={goal.target_property}
                                        secondary={`목표 금액: ${formatCurrency(goal.target_price)}`}
                                    />
                                </ListItem>
                            ))}
                        </List>
                    </Box>
                </DialogContent>
                <DialogActions>
                    <Button onClick={() => setRoadmapDialogOpen(false)}>취소</Button>
                    <Button onClick={createDreamRoadmap} variant="contained" disabled={loading}>
                        {loading ? <CircularProgress size={20} /> : '로드맵 생성'}
                    </Button>
                </DialogActions>
            </Dialog>
        </Box>
    );
};

export default DreamVisualizationSystem;
