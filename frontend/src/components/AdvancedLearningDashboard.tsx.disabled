import React, { useState, useEffect, useMemo } from 'react';
import {
    Box, Paper, Typography, Grid, Card, CardContent, LinearProgress, Chip, Avatar, IconButton, Button, Divider, List, ListItem, ListItemText, ListItemAvatar, ListItemSecondaryAction, Badge, Tooltip, CircularProgress, Alert, Tabs, Tab, Table, TableBody, TableCell, TableContainer, TableHead, TableRow, Dialog, DialogTitle, DialogContent, DialogActions, TextField, FormControl, InputLabel, Select, MenuItem, Slider, Switch, FormControlLabel, Accordion, AccordionSummary, AccordionDetails
} from '@mui/material';
import {
    TrendingUp as TrendingUpIcon, School as SchoolIcon, Psychology as PsychologyIcon, Memory as MemoryIcon, Assessment as AssessmentIcon, Timeline as TimelineIcon, BarChart as BarChart3, PieChart as PieChartIcon, Speed as SpeedIcon, MyLocation as TargetIcon, Star as StarIcon, EmojiEvents as TrophyIcon, Lightbulb as LightbulbIcon, Bookmark as BookmarkIcon, Refresh as RefreshIcon, Settings as SettingsIcon, ExpandMore as ExpandMoreIcon, ExpandLess as ExpandLessIcon, CalendarToday as CalendarIcon, AccessTime as TimeIcon, Person as PersonIcon, AutoAwesome as AutoAwesomeIcon, TrendingDown as TrendingDownIcon, CheckCircle as CheckCircleIcon, Warning as WarningIcon, Info as InfoIcon, PlayArrow as PlayIcon, Pause as PauseIcon, Stop as StopIcon, Edit as EditIcon, Delete as DeleteIcon, Add as AddIcon, FilterList as FilterIcon, Search as SearchIcon, Download as DownloadIcon, Share as ShareIcon, Print as PrintIcon, Fullscreen as FullscreenIcon, FullscreenExit as FullscreenExitIcon, VideoLibrary as VideoIcon, Article as ArticleIcon, Code as CodeIcon, Quiz as QuizIcon, Assignment as AssignmentIcon, Schedule as ScheduleIcon, Flag as FlagIcon, PriorityHigh as PriorityHighIcon, TrendingFlat as TrendingFlatIcon, Psychology as PsychologyIcon2, School as SchoolIcon2, AutoAwesome as AutoAwesomeIcon2
} from '@mui/icons-material';
import {
    Timeline,
    TimelineItem,
    TimelineSeparator,
    TimelineConnector,
    TimelineContent,
    TimelineDot,
    TimelineOppositeContent
} from '@mui/lab';
import { styled } from '@mui/material/styles';
import advancedConversationMemoryService from '../services/advancedConversationMemoryService';
import personalizedLearningExperienceService from '../services/personalizedLearningExperienceService';
import advancedPerformanceAnalyticsService from '../services/advancedPerformanceAnalyticsService';
import advancedLearningRecommendationEngine from '../services/advancedLearningRecommendationEngine';

// 스타일드 컴포넌트
const DashboardContainer = styled(Box)(({ theme }) => ({
    height: '100vh',
    overflow: 'auto',
    backgroundColor: theme.palette.background.default,
    padding: theme.spacing(2)
}));

const MetricCard = styled(Card)(({ theme }) => ({
    height: '100%',
    display: 'flex',
    flexDirection: 'column',
    transition: 'transform 0.2s ease-in-out',
    '&:hover': {
        transform: 'translateY(-2px)',
        boxShadow: theme.shadows[8]
    }
}));

const ProgressCard = styled(Card)(({ theme }) => ({
    height: '100%',
    display: 'flex',
    flexDirection: 'column',
    background: `linear-gradient(135deg, ${theme.palette.primary.main}15, ${theme.palette.secondary.main}15)`
}));

const InsightCard = styled(Card)(({ theme }) => ({
    height: '100%',
    display: 'flex',
    flexDirection: 'column',
    border: `1px solid ${theme.palette.divider}`,
    '&:hover': {
        borderColor: theme.palette.primary.main
    }
}));

const RecommendationCard = styled(Card)(({ theme }) => ({
    height: '100%',
    display: 'flex',
    flexDirection: 'column',
    background: `linear-gradient(135deg, ${theme.palette.success.main}10, ${theme.palette.info.main}10)`,
    border: `1px solid ${theme.palette.success.main}30`
}));

const PriorityCard = styled(Card)(({ theme }) => ({
    height: '100%',
    display: 'flex',
    flexDirection: 'column',
    border: `2px solid ${theme.palette.warning.main}`,
    background: `${theme.palette.warning.main}10`
}));

// 인터페이스 정의
interface TabPanelProps {
    children?: React.ReactNode;
    index: number;
    value: number;
}

interface AdvancedLearningDashboardProps {
    userId?: string;
    sessionId?: string;
}

interface LearningDashboardData {
    performance_analytics: any;
    learning_recommendations: any;
    conversation_memory: any;
    learning_experience: any;
    recent_activities: any[];
    insights: any[];
    goals: any[];
    recommendations: any[];
}

// 탭 패널 컴포넌트
function TabPanel(props: TabPanelProps) {
    const { children, value, index, ...other } = props;
    return (
        <div
            role="tabpanel"
            hidden={value !== index}
            id={`learning-tabpanel-${index}`}
            aria-labelledby={`learning-tab-${index}`}
            {...other}
        >
            {value === index && <Box sx={{ p: 3 }}>{children}</Box>}
        </div>
    );
}

const AdvancedLearningDashboard: React.FC<AdvancedLearningDashboardProps> = ({
    userId = 'user-1',
    sessionId = 'session-1'
}) => {
    const [dashboardData, setDashboardData] = useState<LearningDashboardData | null>(null);
    const [loading, setLoading] = useState(true);
    const [error, setError] = useState<string | null>(null);
    const [tabValue, setTabValue] = useState(0);
    const [refreshInterval, setRefreshInterval] = useState(30000); // 30초
    const [autoRefresh, setAutoRefresh] = useState(true);
    const [fullscreen, setFullscreen] = useState(false);
    const [settingsDialog, setSettingsDialog] = useState(false);
    const [selectedRecommendation, setSelectedRecommendation] = useState<any>(null);
    const [recommendationDialog, setRecommendationDialog] = useState(false);

    useEffect(() => {
        loadDashboardData();
        const interval = setInterval(() => {
            if (autoRefresh) {
                loadDashboardData();
            }
        }, refreshInterval);

        return () => clearInterval(interval);
    }, [userId, sessionId, autoRefresh, refreshInterval]);

    const loadDashboardData = async () => {
        try {
            setLoading(true);
            setError(null);

            // 1. 대화 메모리 로드
            const memory = await advancedConversationMemoryService.getUserMemory(userId);

            // 2. 학습 경험 로드
            const learningExperience = await personalizedLearningExperienceService.getLearningExperience(userId);

            // 3. 성과 분석 실행
            const performanceRequest = {
                user_id: userId,
                session_id: sessionId,
                conversation_memory: memory,
                learning_experience: learningExperience,
                analysis_type: 'comprehensive'
            };
            const performanceAnalytics = await advancedPerformanceAnalyticsService.analyzePerformance(performanceRequest);

            // 4. 학습 추천 생성
            const recommendationRequest = {
                user_id: userId,
                session_id: sessionId,
                conversation_memory: memory,
                learning_experience: learningExperience,
                performance_analytics: performanceAnalytics,
                current_context: 'learning dashboard'
            };
            const learningRecommendations = await advancedLearningRecommendationEngine.generateRecommendations(recommendationRequest);

            // 5. 대시보드 데이터 구성
            const dashboardData: LearningDashboardData = {
                performance_analytics: performanceAnalytics,
                learning_recommendations: learningRecommendations,
                conversation_memory: memory,
                learning_experience: learningExperience,
                recent_activities: generateRecentActivities(memory, learningExperience),
                insights: generateInsights(memory, learningExperience, performanceAnalytics),
                goals: generateGoals(learningExperience),
                recommendations: generateRecommendations(learningRecommendations)
            };

            setDashboardData(dashboardData);
            setLoading(false);

        } catch (error) {
            console.error('Dashboard data loading error:', error);
            setError('대시보드 데이터를 불러오는 중 오류가 발생했습니다.');
            setLoading(false);
        }
    };

    const generateRecentActivities = (memory: any, learningExperience: any): any[] => {
        const activities = [];

        // 최근 대화 활동
        const recentConversations = memory.conversation_history.slice(-5);
        recentConversations.forEach((entry: any, index: number) => {
            activities.push({
                id: `conversation-${index}`,
                type: 'conversation',
                title: `AI와의 대화`,
                description: entry.user_input?.substring(0, 50) + '...',
                timestamp: entry.timestamp,
                icon: <PsychologyIcon />,
                color: 'primary'
            });
        });

        // 학습 진행 활동
        if (learningExperience.learning_paths) {
            learningExperience.learning_paths.slice(-3).forEach((path: any, index: number) => {
                activities.push({
                    id: `learning-${index}`,
                    type: 'learning',
                    title: path.title,
                    description: `진행률: ${Math.round(path.progress * 100)}%`,
                    timestamp: new Date(),
                    icon: <SchoolIcon />,
                    color: 'success'
                });
            });
        }

        return activities.sort((a, b) => new Date(b.timestamp).getTime() - new Date(a.timestamp).getTime());
    };

    const generateInsights = (memory: any, learningExperience: any, performanceAnalytics: any): any[] => {
        const insights = [];

        // 성과 인사이트
        if (performanceAnalytics.overall_score < 60) {
            insights.push({
                id: 'performance-insight',
                type: 'warning',
                title: '성과 개선 필요',
                description: '현재 성과가 목표에 미치지 못합니다. 학습 전략을 재검토해보세요.',
                icon: <TrendingDownIcon />,
                priority: 'high'
            });
        }

        // 학습 패턴 인사이트
        if (performanceAnalytics.learning_patterns?.length > 0) {
            const topPattern = performanceAnalytics.learning_patterns[0];
            insights.push({
                id: 'pattern-insight',
                type: 'info',
                title: '학습 패턴 발견',
                description: `${topPattern.pattern_type} 학습 방식이 가장 효과적입니다.`,
                icon: <PsychologyIcon2 />,
                priority: 'medium'
            });
        }

        // 기술 격차 인사이트
        const criticalGaps = performanceAnalytics.skill_gaps?.filter((gap: any) => gap.impact_priority === 'critical');
        if (criticalGaps?.length > 0) {
            insights.push({
                id: 'skill-gap-insight',
                type: 'error',
                title: '긴급 기술 격차',
                description: `${criticalGaps.length}개의 중요한 기술 격차가 발견되었습니다.`,
                icon: <WarningIcon />,
                priority: 'critical'
            });
        }

        return insights;
    };

    const generateGoals = (learningExperience: any): any[] => {
        const goals = [];

        if (learningExperience.learning_goals) {
            learningExperience.learning_goals.forEach((goal: any, index: number) => {
                goals.push({
                    id: `goal-${index}`,
                    title: goal.title,
                    description: goal.description,
                    progress: goal.progress || 0,
                    target_date: goal.target_date,
                    priority: goal.priority || 'medium',
                    category: goal.category || 'learning'
                });
            });
        }

        return goals;
    };

    const generateRecommendations = (learningRecommendations: any): any[] => {
        const recommendations = [];

        // 우선순위 추천
        if (learningRecommendations.priority_recommendations) {
            learningRecommendations.priority_recommendations.forEach((rec: any, index: number) => {
                recommendations.push({
                    id: `priority-${index}`,
                    type: 'priority',
                    title: rec.title,
                    description: rec.description,
                    priority: rec.priority,
                    category: rec.category,
                    action_items: rec.action_items,
                    timeline: rec.timeline,
                    effort_level: rec.effort_level
                });
            });
        }

        // 콘텐츠 추천
        if (learningRecommendations.content_recommendations) {
            learningRecommendations.content_recommendations.slice(0, 3).forEach((rec: any, index: number) => {
                recommendations.push({
                    id: `content-${index}`,
                    type: 'content',
                    title: rec.title,
                    description: rec.description,
                    content_type: rec.type,
                    estimated_time: rec.estimated_time,
                    difficulty_level: rec.difficulty_level,
                    relevance_score: rec.relevance_score
                });
            });
        }

        return recommendations;
    };

    const handleTabChange = (event: React.SyntheticEvent, newValue: number) => {
        setTabValue(newValue);
    };

    const renderMetricCard = (title: string, value: string | number, subtitle: string, icon: React.ReactNode, color: string, trend?: number) => (
        <MetricCard>
            <CardContent>
                <Box display="flex" alignItems="center" justifyContent="space-between" mb={2}>
                    <Avatar sx={{ bgcolor: `${color}.main`, width: 48, height: 48 }}>
                        {icon}
                    </Avatar>
                    {trend !== undefined && (
                        <Box display="flex" alignItems="center">
                            {trend > 0 ? <TrendingUpIcon color="success" /> : <TrendingDownIcon color="error" />}
                            <Typography variant="caption" color={trend > 0 ? 'success.main' : 'error.main'}>
                                {Math.abs(trend)}%
                            </Typography>
                        </Box>
                    )}
                </Box>
                <Typography variant="h4" component="div" gutterBottom>
                    {value}
                </Typography>
                <Typography variant="h6" color="text.secondary" gutterBottom>
                    {title}
                </Typography>
                <Typography variant="body2" color="text.secondary">
                    {subtitle}
                </Typography>
            </CardContent>
        </MetricCard>
    );

    const renderProgressCard = (title: string, progress: number, target: number, description: string) => (
        <ProgressCard>
            <CardContent>
                <Box display="flex" alignItems="center" mb={2}>
                    <TargetIcon sx={{ mr: 1, color: 'primary.main' }} />
                    <Typography variant="h6">{title}</Typography>
                </Box>
                <Box display="flex" alignItems="center" mb={1}>
                    <Typography variant="h4" component="div" sx={{ mr: 1 }}>
                        {Math.round(progress * 100)}%
                    </Typography>
                    <Typography variant="body2" color="text.secondary">
                        목표: {target}%
                    </Typography>
                </Box>
                <LinearProgress
                    variant="determinate"
                    value={progress * 100}
                    sx={{ height: 8, borderRadius: 4, mb: 1 }}
                />
                <Typography variant="body2" color="text.secondary">
                    {description}
                </Typography>
            </CardContent>
        </ProgressCard>
    );

    const renderInsightCard = (insight: any) => (
        <InsightCard>
            <CardContent>
                <Box display="flex" alignItems="center" mb={2}>
                    <Avatar sx={{
                        bgcolor: insight.type === 'warning' ? 'warning.main' :
                            insight.type === 'error' ? 'error.main' : 'info.main',
                        width: 40, height: 40, mr: 2
                    }}>
                        {insight.icon}
                    </Avatar>
                    <Box>
                        <Typography variant="h6">{insight.title}</Typography>
                        <Chip
                            label={insight.priority}
                            size="small"
                            color={insight.priority === 'critical' ? 'error' :
                                insight.priority === 'high' ? 'warning' : 'default'}
                        />
                    </Box>
                </Box>
                <Typography variant="body2" color="text.secondary">
                    {insight.description}
                </Typography>
            </CardContent>
        </InsightCard>
    );

    const renderRecommendationCard = (recommendation: any) => (
        <RecommendationCard>
            <CardContent>
                <Box display="flex" alignItems="center" mb={2}>
                    <Avatar sx={{
                        bgcolor: recommendation.type === 'priority' ? 'warning.main' : 'success.main',
                        width: 40, height: 40, mr: 2
                    }}>
                        {recommendation.type === 'priority' ? <PriorityHighIcon /> : <VideoIcon />}
                    </Avatar>
                    <Box flex={1}>
                        <Typography variant="h6">{recommendation.title}</Typography>
                        {recommendation.priority && (
                            <Chip
                                label={recommendation.priority}
                                size="small"
                                color={recommendation.priority === 'urgent' ? 'error' :
                                    recommendation.priority === 'high' ? 'warning' : 'default'}
                            />
                        )}
                    </Box>
                    <IconButton
                        size="small"
                        onClick={() => {
                            setSelectedRecommendation(recommendation);
                            setRecommendationDialog(true);
                        }}
                    >
                        <InfoIcon />
                    </IconButton>
                </Box>
                <Typography variant="body2" color="text.secondary" mb={2}>
                    {recommendation.description}
                </Typography>
                {recommendation.type === 'content' && (
                    <Box display="flex" alignItems="center" justifyContent="space-between">
                        <Chip label={recommendation.content_type} size="small" />
                        <Typography variant="caption">
                            {recommendation.estimated_time}분
                        </Typography>
                    </Box>
                )}
            </CardContent>
        </RecommendationCard>
    );

    if (loading) {
        return (
            <DashboardContainer>
                <Box display="flex" justifyContent="center" alignItems="center" height="100vh">
                    <CircularProgress size={60} />
                    <Typography variant="h6" sx={{ ml: 2 }}>
                        학습 대시보드를 불러오는 중...
                    </Typography>
                </Box>
            </DashboardContainer>
        );
    }

    if (error) {
        return (
            <DashboardContainer>
                <Alert severity="error" sx={{ mb: 2 }}>
                    {error}
                </Alert>
                <Button variant="contained" onClick={loadDashboardData}>
                    다시 시도
                </Button>
            </DashboardContainer>
        );
    }

    if (!dashboardData) {
        return (
            <DashboardContainer>
                <Typography variant="h6" textAlign="center">
                    대시보드 데이터가 없습니다.
                </Typography>
            </DashboardContainer>
        );
    }

    const { performance_analytics, learning_recommendations, recent_activities, insights, goals, recommendations } = dashboardData;

    return (
        <DashboardContainer>
            {/* 헤더 */}
            <Box display="flex" justifyContent="space-between" alignItems="center" mb={3}>
                <Box>
                    <Typography variant="h4" gutterBottom>
                        🎓 고급 학습 대시보드
                    </Typography>
                    <Typography variant="body1" color="text.secondary">
                        개인화된 학습 경로와 실시간 성과 분석
                    </Typography>
                </Box>
                <Box display="flex" gap={1}>
                    <Tooltip title="새로고침">
                        <IconButton onClick={loadDashboardData}>
                            <RefreshIcon />
                        </IconButton>
                    </Tooltip>
                    <Tooltip title="설정">
                        <IconButton onClick={() => setSettingsDialog(true)}>
                            <SettingsIcon />
                        </IconButton>
                    </Tooltip>
                    <Tooltip title={fullscreen ? "전체화면 종료" : "전체화면"}>
                        <IconButton onClick={() => setFullscreen(!fullscreen)}>
                            {fullscreen ? <FullscreenExitIcon /> : <FullscreenIcon />}
                        </IconButton>
                    </Tooltip>
                </Box>
            </Box>

            {/* 주요 지표 */}
            <Grid container spacing={3} mb={3}>
                <Grid item xs={12} sm={6} md={3}>
                    {renderMetricCard(
                        '전체 성과 점수',
                        Math.round(performance_analytics.overall_score),
                        '학습 효율성과 만족도 종합',
                        <AssessmentIcon />,
                        'primary',
                        performance_analytics.overall_score > 70 ? 5 : -3
                    )}
                </Grid>
                <Grid item xs={12} sm={6} md={3}>
                    {renderMetricCard(
                        '학습 효율성',
                        `${Math.round(performance_analytics.learning_efficiency)}%`,
                        '시간 대비 학습 성과',
                        <SpeedIcon />,
                        'success',
                        performance_analytics.learning_efficiency > 60 ? 8 : -5
                    )}
                </Grid>
                <Grid item xs={12} sm={6} md={3}>
                    {renderMetricCard(
                        '기술 격차',
                        performance_analytics.skill_gaps?.length || 0,
                        '개선이 필요한 기술 영역',
                        <TargetIcon />,
                        'warning',
                        performance_analytics.skill_gaps?.length > 5 ? -10 : 2
                    )}
                </Grid>
                <Grid item xs={12} sm={6} md={3}>
                    {renderMetricCard(
                        '추천 콘텐츠',
                        learning_recommendations.content_recommendations?.length || 0,
                        '개인화된 학습 자료',
                        <VideoIcon />,
                        'info',
                        12
                    )}
                </Grid>
            </Grid>

            {/* 탭 네비게이션 */}
            <Paper sx={{ mb: 3 }}>
                <Tabs value={tabValue} onChange={handleTabChange} variant="scrollable" scrollButtons="auto">
                    <Tab label="학습 진행률" icon={<TimelineIcon />} />
                    <Tab label="성과 분석" icon={<AssessmentIcon />} />
                    <Tab label="학습 추천" icon={<LightbulbIcon />} />
                    <Tab label="기술 개발" icon={<CodeIcon />} />
                    <Tab label="최근 활동" icon={<ScheduleIcon />} />
                    <Tab label="인사이트" icon={<AutoAwesomeIcon />} />
                </Tabs>
            </Paper>

            {/* 탭 콘텐츠 */}
            <TabPanel value={tabValue} index={0}>
                <Grid container spacing={3}>
                    <Grid item xs={12} md={6}>
                        {renderProgressCard(
                            '전체 학습 진행률',
                            performance_analytics.performance_metrics.learning_progress.mastery_level,
                            100,
                            '현재 학습 목표 달성률'
                        )}
                    </Grid>
                    <Grid item xs={12} md={6}>
                        {renderProgressCard(
                            '기억력 보존률',
                            performance_analytics.performance_metrics.learning_progress.retention_rate,
                            80,
                            '학습한 내용의 기억 보존률'
                        )}
                    </Grid>
                    <Grid item xs={12}>
                        <Card>
                            <CardContent>
                                <Typography variant="h6" gutterBottom>
                                    학습 목표 진행 상황
                                </Typography>
                                {goals.map((goal) => (
                                    <Box key={goal.id} mb={2}>
                                        <Box display="flex" justifyContent="space-between" alignItems="center" mb={1}>
                                            <Typography variant="subtitle1">{goal.title}</Typography>
                                            <Chip label={goal.priority} size="small" />
                                        </Box>
                                        <LinearProgress
                                            variant="determinate"
                                            value={goal.progress * 100}
                                            sx={{ height: 8, borderRadius: 4 }}
                                        />
                                        <Typography variant="body2" color="text.secondary" mt={1}>
                                            {goal.description}
                                        </Typography>
                                    </Box>
                                ))}
                            </CardContent>
                        </Card>
                    </Grid>
                </Grid>
            </TabPanel>

            <TabPanel value={tabValue} index={1}>
                <Grid container spacing={3}>
                    <Grid item xs={12} md={6}>
                        <Card>
                            <CardContent>
                                <Typography variant="h6" gutterBottom>
                                    성과 메트릭스
                                </Typography>
                                <TableContainer>
                                    <Table>
                                        <TableHead>
                                            <TableRow>
                                                <TableCell>지표</TableCell>
                                                <TableCell>값</TableCell>
                                                <TableCell>상태</TableCell>
                                            </TableRow>
                                        </TableHead>
                                        <TableBody>
                                            <TableRow>
                                                <TableCell>전체 점수</TableCell>
                                                <TableCell>{Math.round(performance_analytics.overall_score)}</TableCell>
                                                <TableCell>
                                                    <Chip
                                                        label={performance_analytics.overall_score > 70 ? '우수' : '개선 필요'}
                                                        color={performance_analytics.overall_score > 70 ? 'success' : 'warning'}
                                                        size="small"
                                                    />
                                                </TableCell>
                                            </TableRow>
                                            <TableRow>
                                                <TableCell>학습 효율성</TableCell>
                                                <TableCell>{Math.round(performance_analytics.learning_efficiency)}%</TableCell>
                                                <TableCell>
                                                    <Chip
                                                        label={performance_analytics.learning_efficiency > 60 ? '양호' : '낮음'}
                                                        color={performance_analytics.learning_efficiency > 60 ? 'success' : 'error'}
                                                        size="small"
                                                    />
                                                </TableCell>
                                            </TableRow>
                                            <TableRow>
                                                <TableCell>만족도</TableCell>
                                                <TableCell>{performance_analytics.performance_metrics.satisfaction_score.average.toFixed(1)}/5</TableCell>
                                                <TableCell>
                                                    <Chip
                                                        label={performance_analytics.performance_metrics.satisfaction_score.average > 4 ? '높음' : '보통'}
                                                        color={performance_analytics.performance_metrics.satisfaction_score.average > 4 ? 'success' : 'default'}
                                                        size="small"
                                                    />
                                                </TableCell>
                                            </TableRow>
                                        </TableBody>
                                    </Table>
                                </TableContainer>
                            </CardContent>
                        </Card>
                    </Grid>
                    <Grid item xs={12} md={6}>
                        <Card>
                            <CardContent>
                                <Typography variant="h6" gutterBottom>
                                    기술 격차 분석
                                </Typography>
                                {performance_analytics.skill_gaps?.slice(0, 5).map((gap: any) => (
                                    <Box key={gap.skill_name} mb={2}>
                                        <Box display="flex" justifyContent="space-between" alignItems="center" mb={1}>
                                            <Typography variant="subtitle2">{gap.skill_name}</Typography>
                                            <Chip
                                                label={gap.impact_priority}
                                                size="small"
                                                color={gap.impact_priority === 'critical' ? 'error' :
                                                    gap.impact_priority === 'high' ? 'warning' : 'default'}
                                            />
                                        </Box>
                                        <LinearProgress
                                            variant="determinate"
                                            value={gap.current_level * 100}
                                            sx={{ height: 6, borderRadius: 3 }}
                                        />
                                        <Typography variant="caption" color="text.secondary">
                                            현재: {Math.round(gap.current_level * 100)}% | 목표: {Math.round(gap.required_level * 100)}%
                                        </Typography>
                                    </Box>
                                ))}
                            </CardContent>
                        </Card>
                    </Grid>
                </Grid>
            </TabPanel>

            <TabPanel value={tabValue} index={2}>
                <Grid container spacing={3}>
                    <Grid item xs={12}>
                        <Typography variant="h6" gutterBottom>
                            우선순위 추천
                        </Typography>
                        <Grid container spacing={2}>
                            {recommendations.filter(r => r.type === 'priority').slice(0, 3).map((recommendation) => (
                                <Grid item xs={12} md={4} key={recommendation.id}>
                                    {renderRecommendationCard(recommendation)}
                                </Grid>
                            ))}
                        </Grid>
                    </Grid>
                    <Grid item xs={12}>
                        <Typography variant="h6" gutterBottom>
                            콘텐츠 추천
                        </Typography>
                        <Grid container spacing={2}>
                            {recommendations.filter(r => r.type === 'content').map((recommendation) => (
                                <Grid item xs={12} md={4} key={recommendation.id}>
                                    {renderRecommendationCard(recommendation)}
                                </Grid>
                            ))}
                        </Grid>
                    </Grid>
                </Grid>
            </TabPanel>

            <TabPanel value={tabValue} index={3}>
                <Grid container spacing={3}>
                    <Grid item xs={12}>
                        <Card>
                            <CardContent>
                                <Typography variant="h6" gutterBottom>
                                    기술 개발 계획
                                </Typography>
                                {learning_recommendations.skill_development?.map((plan: any) => (
                                    <Accordion key={plan.skill_name}>
                                        <AccordionSummary expandIcon={<ExpandMoreIcon />}>
                                            <Box display="flex" alignItems="center" width="100%">
                                                <Typography variant="subtitle1" sx={{ flexGrow: 1 }}>
                                                    {plan.skill_name}
                                                </Typography>
                                                <Chip
                                                    label={plan.priority}
                                                    color={plan.priority === 'critical' ? 'error' :
                                                        plan.priority === 'high' ? 'warning' : 'default'}
                                                    size="small"
                                                />
                                            </Box>
                                        </AccordionSummary>
                                        <AccordionDetails>
                                            <Grid container spacing={2}>
                                                <Grid item xs={12} md={6}>
                                                    <Typography variant="subtitle2" gutterBottom>
                                                        현재 수준: {Math.round(plan.current_level * 100)}%
                                                    </Typography>
                                                    <Typography variant="subtitle2" gutterBottom>
                                                        목표 수준: {Math.round(plan.target_level * 100)}%
                                                    </Typography>
                                                    <Typography variant="subtitle2" gutterBottom>
                                                        예상 소요 시간: {plan.timeline}일
                                                    </Typography>
                                                </Grid>
                                                <Grid item xs={12} md={6}>
                                                    <Typography variant="subtitle2" gutterBottom>
                                                        학습 자료:
                                                    </Typography>
                                                    <List dense>
                                                        {plan.learning_resources.slice(0, 3).map((resource: string, index: number) => (
                                                            <ListItem key={index}>
                                                                <ListItemText primary={resource} />
                                                            </ListItem>
                                                        ))}
                                                    </List>
                                                </Grid>
                                            </Grid>
                                        </AccordionDetails>
                                    </Accordion>
                                ))}
                            </CardContent>
                        </Card>
                    </Grid>
                </Grid>
            </TabPanel>

            <TabPanel value={tabValue} index={4}>
                <Grid container spacing={3}>
                    <Grid item xs={12}>
                        <Card>
                            <CardContent>
                                <Typography variant="h6" gutterBottom>
                                    최근 활동 타임라인
                                </Typography>
                                <Timeline>
                                    {recent_activities.map((activity) => (
                                        <TimelineItem key={activity.id}>
                                            <TimelineOppositeContent>
                                                <Typography variant="caption" color="text.secondary">
                                                    {new Date(activity.timestamp).toLocaleString()}
                                                </Typography>
                                            </TimelineOppositeContent>
                                            <TimelineSeparator>
                                                <TimelineDot color={activity.color as any}>
                                                    {activity.icon}
                                                </TimelineDot>
                                                <TimelineConnector />
                                            </TimelineSeparator>
                                            <TimelineContent>
                                                <Typography variant="subtitle2">
                                                    {activity.title}
                                                </Typography>
                                                <Typography variant="body2" color="text.secondary">
                                                    {activity.description}
                                                </Typography>
                                            </TimelineContent>
                                        </TimelineItem>
                                    ))}
                                </Timeline>
                            </CardContent>
                        </Card>
                    </Grid>
                </Grid>
            </TabPanel>

            <TabPanel value={tabValue} index={5}>
                <Grid container spacing={3}>
                    {insights.map((insight) => (
                        <Grid item xs={12} md={6} key={insight.id}>
                            {renderInsightCard(insight)}
                        </Grid>
                    ))}
                </Grid>
            </TabPanel>

            {/* 설정 다이얼로그 */}
            <Dialog open={settingsDialog} onClose={() => setSettingsDialog(false)} maxWidth="sm" fullWidth>
                <DialogTitle>대시보드 설정</DialogTitle>
                <DialogContent>
                    <Box mb={3}>
                        <FormControlLabel
                            control={
                                <Switch
                                    checked={autoRefresh}
                                    onChange={(e) => setAutoRefresh(e.target.checked)}
                                />
                            }
                            label="자동 새로고침"
                        />
                    </Box>
                    <Box mb={3}>
                        <Typography gutterBottom>새로고침 간격 (초)</Typography>
                        <Slider
                            value={refreshInterval / 1000}
                            onChange={(e, value) => setRefreshInterval(value as number * 1000)}
                            min={10}
                            max={120}
                            step={10}
                            marks
                            valueLabelDisplay="auto"
                        />
                    </Box>
                </DialogContent>
                <DialogActions>
                    <Button onClick={() => setSettingsDialog(false)}>닫기</Button>
                </DialogActions>
            </Dialog>

            {/* 추천 상세 다이얼로그 */}
            <Dialog open={recommendationDialog} onClose={() => setRecommendationDialog(false)} maxWidth="md" fullWidth>
                <DialogTitle>
                    {selectedRecommendation?.title}
                </DialogTitle>
                <DialogContent>
                    {selectedRecommendation && (
                        <Box>
                            <Typography variant="body1" paragraph>
                                {selectedRecommendation.description}
                            </Typography>
                            {selectedRecommendation.action_items && (
                                <Box mb={2}>
                                    <Typography variant="h6" gutterBottom>
                                        실행 항목:
                                    </Typography>
                                    <List>
                                        {selectedRecommendation.action_items.map((item: string, index: number) => (
                                            <ListItem key={index}>
                                                <ListItemText primary={item} />
                                            </ListItem>
                                        ))}
                                    </List>
                                </Box>
                            )}
                            {selectedRecommendation.timeline && (
                                <Typography variant="body2" color="text.secondary">
                                    예상 소요 시간: {selectedRecommendation.timeline}일
                                </Typography>
                            )}
                        </Box>
                    )}
                </DialogContent>
                <DialogActions>
                    <Button onClick={() => setRecommendationDialog(false)}>닫기</Button>
                    <Button variant="contained" color="primary">
                        추천 실행
                    </Button>
                </DialogActions>
            </Dialog>
        </DashboardContainer>
    );
};

export default AdvancedLearningDashboard;
