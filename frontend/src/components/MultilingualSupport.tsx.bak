// 다국어 지원 언어 목록
export const SUPPORTED_LANGUAGES = [
    { code: 'ko', name: '한국어', nativeName: '한국어', flag: '🇰🇷', rtl: false },
    { code: 'en', name: 'English', nativeName: 'English', flag: '🇺🇸', rtl: false },
    { code: 'ja', name: '日本語', nativeName: '日本語', flag: '🇯🇵', rtl: false },
    { code: 'zh', name: '中文', nativeName: '中文', flag: '🇨🇳', rtl: false },
    { code: 'es', name: 'Español', nativeName: 'Español', flag: '🇪🇸', rtl: false },
    { code: 'fr', name: 'Français', nativeName: 'Français', flag: '🇫🇷', rtl: false },
    { code: 'de', name: 'Deutsch', nativeName: 'Deutsch', flag: '🇩🇪', rtl: false },
    { code: 'ar', name: 'العربية', nativeName: 'العربية', flag: '🇸🇦', rtl: true },
    { code: 'hi', name: 'हिन्दी', nativeName: 'हिन्दी', flag: '🇮🇳', rtl: false },
    { code: 'pt', name: 'Português', nativeName: 'Português', flag: '🇧🇷', rtl: false }
];

// 번역 데이터 타입
interface TranslationData {
    [key: string]: string | TranslationData;
}

// 다국어 컨텍스트 타입
interface MultilingualContextType {
    currentLanguage: string;
    setLanguage: (languageCode: string) => void;
    t: (key: string, params?: Record<string, string | number>) => string;
    isRTL: boolean;
    availableLanguages: typeof SUPPORTED_LANGUAGES;
    translationProgress: Record<string, number>;
    autoTranslate: boolean;
    setAutoTranslate: (enabled: boolean) => void;
}

// 다국어 컨텍스트 생성
const MultilingualContext = createContext<MultilingualContextType | undefined>(undefined);

