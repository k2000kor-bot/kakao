// 다국어 프로바이더 컴포넌트
interface MultilingualProviderProps {
    children: ReactNode;
}

export const MultilingualProvider: React.FC<MultilingualProviderProps> = ({ children }) => {
    const [currentLanguage, setCurrentLanguage] = useState('ko');
    const [translations, setTranslations] = useState<Record<string, TranslationData>>(DEFAULT_TRANSLATIONS);
    const [translationProgress, setTranslationProgress] = useState<Record<string, number>>({});
    const [autoTranslate, setAutoTranslate] = useState(false);

    // 현재 언어의 RTL 여부
    const currentLangInfo = SUPPORTED_LANGUAGES.find(lang => lang.code === currentLanguage);
    const isRTL = currentLangInfo?.rtl || false;

    // 번역 함수
    const t = (key: string, params?: Record<string, string | number>): string => {
        const keys = key.split('.');
        let value: any = translations[currentLanguage] || translations['ko'];

        for (const k of keys) {
            value = value?.[k];
            if (value === undefined) {
                // 번역이 없으면 한국어로 폴백
                value = translations['ko'];
                for (const fallbackKey of keys) {
                    value = value?.[fallbackKey];
                }
                break;
            }
        }

        if (typeof value !== 'string') {
            return key; // 번역을 찾을 수 없으면 키 반환
        }

        // 매개변수 치환
        if (params) {
            return value.replace(/\{\{(\w+)\}\}/g, (match, paramKey) => {
                return params[paramKey]?.toString() || match;
            });
        }

        return value;
    };

    // 언어 변경 핸들러
    const handleLanguageChange = (languageCode: string) => {
        setCurrentLanguage(languageCode);

        // HTML lang 속성 변경
        document.documentElement.lang = languageCode;

        // RTL/LTR 설정
        if (SUPPORTED_LANGUAGES.find(lang => lang.code === languageCode)?.rtl) {
            document.documentElement.dir = 'rtl';
        } else {
            document.documentElement.dir = 'ltr';
        }

        // 로컬 스토리지에 저장
        localStorage.setItem('preferred-language', languageCode);
    };

    // 자동 번역 기능
    const translateText = async (text: string, targetLang: string): Promise<string> => {
        // 실제 구현에서는 Google Translate API나 다른 번역 서비스 사용
        // 여기서는 간단한 예시만 제공
        try {
            // 시뮬레이션된 번역 API 호출
            const response = await fetch('/api/translate', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ text, targetLang })
            });

            if (response.ok) {
                const data = await response.json();
                return data.translatedText;
            }
        } catch (error) {
            console.error('Translation error:', error);
        }

        return text; // 번역 실패 시 원본 텍스트 반환
    };

    // 번역 진행률 업데이트
    const updateTranslationProgress = (languageCode: string, progress: number) => {
        setTranslationProgress(prev => ({
            ...prev,
            [languageCode]: progress
        }));
    };

    // 초기화
    useEffect(() => {
        // 저장된 언어 설정 불러오기
        const savedLanguage = localStorage.getItem('preferred-language');
        if (savedLanguage && SUPPORTED_LANGUAGES.find(lang => lang.code === savedLanguage)) {
            handleLanguageChange(savedLanguage);
        }

        // 브라우저 언어 감지
        const browserLanguage = navigator.language.split('-')[0];
        const supportedBrowserLang = SUPPORTED_LANGUAGES.find(lang => lang.code === browserLanguage);
        if (supportedBrowserLang && !savedLanguage) {
            handleLanguageChange(browserLanguage);
        }
    }, []);

    const contextValue: MultilingualContextType = {
        currentLanguage,
        setLanguage: handleLanguageChange,
        t,
        isRTL,
        availableLanguages: SUPPORTED_LANGUAGES,
        translationProgress,
        autoTranslate,
        setAutoTranslate
    };

    return (
        <MultilingualContext.Provider value={contextValue}>
            <Box sx={{ direction: isRTL ? 'rtl' : 'ltr' }}>
                {children}
            </Box>
        </MultilingualContext.Provider>
    );
};

// 다국어 훅
export const useTranslation = () => {
    const context = useContext(MultilingualContext);
    if (context === undefined) {
        throw new Error('useTranslation must be used within a MultilingualProvider');
    }
    return context;
};

// 언어 선택 컴포넌트
interface LanguageSelectorProps {
    onClose?: () => void;
}

export const LanguageSelector: React.FC<LanguageSelectorProps> = ({ onClose }) => {
    const { currentLanguage, setLanguage, availableLanguages, translationProgress, t } = useTranslation();
    const [settingsOpen, setSettingsOpen] = useState(false);

    return (
        <>
            <Box sx={{ p: 2 }}>
                <Typography variant="h6" sx={{ mb: 2, fontWeight: 'bold' }}>
                    {t('language.selectLanguage')}
                </Typography>

                <List>
                    {availableLanguages.map((language) => (
                        <ListItem
                            key={language.code}
                            button
                            onClick={() => {
                                setLanguage(language.code);
                                onClose?.();
                            }}
                            selected={currentLanguage === language.code}
                        >
                            <ListItemIcon>
                                <span style={{ fontSize: '1.5rem' }}>{language.flag}</span>
                            </ListItemIcon>
                            <ListItemText
                                primary={language.nativeName}
                                secondary={language.name}
                            />
                            {currentLanguage === language.code && (
                                <CheckCircleIcon color="primary" />
                            )}
                            {translationProgress[language.code] && translationProgress[language.code] < 100 && (
                                <Chip
                                    label={`${translationProgress[language.code]}%`}
                                    size="small"
                                    color="warning"
                                    sx={{ ml: 1 }}
                                />
                            )}
                        </ListItem>
                    ))}
                </List>

                <Divider sx={{ my: 2 }} />

                <Button
                    fullWidth
                    startIcon={<SettingsIcon />}
                    onClick={() => setSettingsOpen(true)}
                >
                    {t('language.title')}
                </Button>
            </Box>

            {/* 언어 설정 다이얼로그 */}
            <Dialog open={settingsOpen} onClose={() => setSettingsOpen(false)} maxWidth="md" fullWidth>
                <DialogTitle>{t('language.title')}</DialogTitle>
                <DialogContent>
                    <Grid container spacing={3} sx={{ pt: 2 }}>
                        <Grid item xs={12}>
                            <Typography variant="h6" sx={{ mb: 2, fontWeight: 'bold' }}>
                                {t('language.translationProgress')}
                            </Typography>

                            {availableLanguages.map((language) => (
                                <Box key={language.code} sx={{ mb: 2 }}>
                                    <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', mb: 1 }}>
                                        <Typography variant="body2">
                                            {language.flag} {language.nativeName}
                                        </Typography>
                                        <Typography variant="body2">
                                            {translationProgress[language.code] || 0}%
                                        </Typography>
                                    </Box>
                                    <Box
                                        sx={{
                                            width: '100%',
                                            height: 8,
                                            backgroundColor: 'grey.200',
                                            borderRadius: 4,
                                            overflow: 'hidden'
                                        }}
                                    >
                                        <Box
                                            sx={{
                                                width: `${translationProgress[language.code] || 0}%`,
                                                height: '100%',
                                                backgroundColor: 'primary.main',
                                                transition: 'width 0.3s ease'
                                            }}
                                        />
                                    </Box>
                                </Box>
                            ))}
                        </Grid>

                        <Grid item xs={12}>
                            <Typography variant="h6" sx={{ mb: 2, fontWeight: 'bold' }}>
                                번역 관리
                            </Typography>

                            <Box sx={{ display: 'flex', gap: 2, flexWrap: 'wrap' }}>
                                <Button
                                    startIcon={<DownloadIcon />}
                                    variant="outlined"
                                >
                                    {t('language.downloadTranslations')}
                                </Button>
                                <Button
                                    startIcon={<UploadIcon />}
                                    variant="outlined"
                                >
                                    {t('language.uploadTranslations')}
                                </Button>
                                <Button
                                    startIcon={<RefreshIcon />}
                                    variant="outlined"
                                    color="warning"
                                >
                                    {t('language.resetTranslations')}
                                </Button>
                            </Box>
                        </Grid>
                    </Grid>
                </DialogContent>
                <DialogActions>
                    <Button onClick={() => setSettingsOpen(false)}>
                        {t('common.close')}
                    </Button>
                </DialogActions>
            </Dialog>
        </>
    );
};

// 언어 표시 컴포넌트
export const LanguageDisplay: React.FC = () => {
    const { currentLanguage, availableLanguages } = useTranslation();
    const currentLang = availableLanguages.find(lang => lang.code === currentLanguage);

    return (
        <Box sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
            <span style={{ fontSize: '1.2rem' }}>{currentLang?.flag}</span>
            <Typography variant="body2">
                {currentLang?.nativeName}
            </Typography>
        </Box>
    );
};

export default MultilingualSupport;
