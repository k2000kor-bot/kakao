import React, { useState, useEffect } from 'react';
import {
    Box,
    Card,
    CardContent,
    Typography,
    Grid,
    Chip,
    Button,
    Dialog,
    DialogTitle,
    DialogContent,
    DialogActions,
    TextField,
    FormControl,
    InputLabel,
    Select,
    MenuItem,
    CircularProgress,
    Alert,
    Tabs,
    Tab,
    Paper,
    Divider,
    IconButton,
    Tooltip,
    Table,
    TableBody,
    TableCell,
    TableContainer,
    TableHead,
    TableRow,
    LinearProgress,
    Rating,
    List,
    ListItem,
    ListItemText
} from '@mui/material';
import {
    Business as BusinessIcon,
    TrendingUp as TrendingUpIcon,
    Warning as WarningIcon,
    CheckCircle as CheckCircleIcon,
    Analytics as AnalyticsIcon,
    Refresh as RefreshIcon,
    Compare as CompareIcon,
    Timeline as TimelineIcon,
    Star as StarIcon
} from '@mui/icons-material';
import { LineChart, Line, XAxis, YAxis, CartesianGrid, Tooltip as RechartsTooltip, ResponsiveContainer, BarChart, Bar, PieChart, Pie, Cell } from 'recharts';

interface ConstructionCompany {
    company_id: string;
    name: string;
    established_year: number;
    capital: number;
    employees: number;
    projects_completed: number;
    current_projects: number;
    specialties: string[];
    certifications: string[];
    reputation_score: number;
    defect_rate: number;
    response_time_days: number;
    customer_satisfaction: number;
}

interface DefectIssue {
    issue_id: string;
    company_id: string;
    project_name: string;
    issue_type: string;
    severity: string;
    description: string;
    reported_date: string;
    resolved_date?: string;
    resolution_method?: string;
    cost_impact: number;
    customer_impact_score: number;
}

interface CompanyAnalysis {
    company: ConstructionCompany;
    defect_history: DefectIssue[];
    reliability_score: number;
    quality_score: number;
    responsiveness_score: number;
    cost_effectiveness_score: number;
    overall_rating: string;
    strengths: string[];
    weaknesses: string[];
    recommendations: string[];
}

interface ConstructionCompanyInfoProps {
    onClose?: () => void;
}

const ConstructionCompanyInfo: React.FC<ConstructionCompanyInfoProps> = ({ onClose }) => {
    const [activeTab, setActiveTab] = useState(0);
    const [companies, setCompanies] = useState<ConstructionCompany[]>([]);
    const [selectedCompany, setSelectedCompany] = useState<CompanyAnalysis | null>(null);
    const [loading, setLoading] = useState(false);
    const [error, setError] = useState<string | null>(null);
    const [comparisonDialogOpen, setComparisonDialogOpen] = useState(false);
    const [trendDialogOpen, setTrendDialogOpen] = useState(false);
    const [selectedCompanyId, setSelectedCompanyId] = useState('');

    // 샘플 데이터
    const sampleCompanies: ConstructionCompany[] = [
        {
            company_id: 'COMP001',
            name: '대한건설',
            established_year: 1985,
            capital: 50000000000,
            employees: 1200,
            projects_completed: 150,
            current_projects: 8,
            specialties: ['아파트', '오피스텔', '상업시설'],
            certifications: ['ISO9001', 'ISO14001', 'OHSAS18001'],
            reputation_score: 8.5,
            defect_rate: 2.3,
            response_time_days: 3.2,
            customer_satisfaction: 8.7
        },
        {
            company_id: 'COMP002',
            name: '한국건설',
            established_year: 1992,
            capital: 30000000000,
            employees: 800,
            projects_completed: 95,
            current_projects: 5,
            specialties: ['아파트', '빌라', '단독주택'],
            certifications: ['ISO9001', 'ISO14001'],
            reputation_score: 7.8,
            defect_rate: 3.1,
            response_time_days: 4.5,
            customer_satisfaction: 7.9
        },
        {
            company_id: 'COMP003',
            name: '서울건설',
            established_year: 1978,
            capital: 80000000000,
            employees: 2000,
            projects_completed: 280,
            current_projects: 12,
            specialties: ['아파트', '오피스텔', '상업시설', '공공시설'],
            certifications: ['ISO9001', 'ISO14001', 'OHSAS18001', 'KS인증'],
            reputation_score: 9.2,
            defect_rate: 1.8,
            response_time_days: 2.1,
            customer_satisfaction: 9.1
        }
    ];

    const sampleDefects: DefectIssue[] = [
        {
            issue_id: 'DEF001',
            company_id: 'COMP001',
            project_name: '대한아파트 1단지',
            issue_type: '벽체균열',
            severity: '중간',
            description: '외벽에 미세한 균열 발견',
            reported_date: '2024-01-15',
            resolved_date: '2024-01-25',
            resolution_method: '실리콘 보수 및 방수처리',
            cost_impact: 5000000,
            customer_impact_score: 6.0
        },
        {
            issue_id: 'DEF002',
            company_id: 'COMP002',
            project_name: '한국빌라 2동',
            issue_type: '배관누수',
            severity: '높음',
            description: '화장실 배관에서 누수 발생',
            reported_date: '2024-02-10',
            resolved_date: '2024-02-20',
            resolution_method: '배관 교체 및 방수처리',
            cost_impact: 8000000,
            customer_impact_score: 8.0
        },
        {
            issue_id: 'DEF003',
            company_id: 'COMP003',
            project_name: '서울오피스텔 A동',
            issue_type: '엘리베이터 고장',
            severity: '높음',
            description: '엘리베이터 작동 불량',
            reported_date: '2024-03-05',
            resolved_date: '2024-03-08',
            resolution_method: '부품 교체 및 정비',
            cost_impact: 12000000,
            customer_impact_score: 9.0
        }
    ];

    useEffect(() => {
        loadCompanies();
    }, []);

    const loadCompanies = async () => {
        setLoading(true);
        try {
            // 실제 API 호출 시도
            try {
                const response = await fetch('http://localhost:8006/companies', {
                    method: 'GET',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                });

                if (response.ok) {
                    const result = await response.json();
                    console.log('시공사 정보 데이터:', result);
                    setCompanies(result.companies || []);
                    setError(null);
                } else {
                    const errorText = await response.text();
                    console.warn('API 호출 실패, 샘플 데이터 사용:', response.status, errorText);
                    throw new Error(`API 호출 실패: ${response.status}`);
                }
            } catch (apiError) {
                console.warn('API 호출 실패, 샘플 데이터 사용:', apiError);
                // API 호출 실패 시 샘플 데이터 사용
                await new Promise(resolve => setTimeout(resolve, 1000));
                setCompanies(sampleCompanies);
                setError(null);
            }
        } catch (err) {
            console.error('시공사 정보 로딩 오류:', err);
            const errorMessage = err instanceof Error ? err.message : '시공사 정보를 불러오는 중 알 수 없는 오류가 발생했습니다.';
            setError(`시공사 정보를 불러오는 중 오류가 발생했습니다: ${errorMessage}`);
        } finally {
            setLoading(false);
        }
    };

    const analyzeCompany = async (companyId: string) => {
        setLoading(true);
        try {
            // 실제 API 호출
            const response = await fetch('http://localhost:8006/analyze-company', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ company_id: companyId }),
            });

            if (response.ok) {
                const analysis = await response.json();
                console.log('시공사 분석 결과:', analysis);
                setSelectedCompany(analysis);
                setActiveTab(1); // 분석 결과 탭으로 이동
                setError(null);
            } else {
                const errorText = await response.text();
                console.error('시공사 분석 API 오류:', response.status, errorText);
                throw new Error(`시공사 분석 요청이 실패했습니다. (상태: ${response.status}, 오류: ${errorText})`);
            }
        } catch (err) {
            console.warn('시공사 분석 API 호출 실패, 샘플 데이터 사용:', err);
            // 샘플 분석 결과 사용
            const company = sampleCompanies.find(c => c.company_id === companyId);
            if (company) {
                const sampleAnalysis: CompanyAnalysis = {
                    company,
                    defect_history: sampleDefects.filter(d => d.company_id === companyId),
                    reliability_score: 42.5,
                    quality_score: 38.2,
                    responsiveness_score: 35.8,
                    cost_effectiveness_score: 41.2,
                    overall_rating: 'A (우수)',
                    strengths: ['높은 시장 신뢰도', '낮은 하자율', '빠른 하자 대응'],
                    weaknesses: ['제한된 프로젝트 경험'],
                    recommendations: [
                        '품질 관리 시스템 강화 및 시공 과정 모니터링 개선',
                        '정기적인 품질 점검 및 예방적 유지보수 체계 구축',
                        '디지털 기술 도입을 통한 건설 프로세스 혁신'
                    ]
                };
                setSelectedCompany(sampleAnalysis);
                setActiveTab(1);
                setError(null);
            } else {
                const errorMessage = err instanceof Error ? err.message : '시공사 분석 중 알 수 없는 오류가 발생했습니다.';
                setError(`시공사 분석 중 오류가 발생했습니다: ${errorMessage}`);
            }
        } finally {
            setLoading(false);
        }
    };

    const compareCompanies = async (companyIds: string[]) => {
        try {
            const response = await fetch('http://localhost:8006/compare-companies', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ company_ids: companyIds }),
            });

            if (response.ok) {
                const comparison = await response.json();
                // 비교 결과 처리
                console.log('Company comparison:', comparison);
            }
        } catch (err) {
            setError('시공사 비교 분석 중 오류가 발생했습니다.');
        }
    };

    const getRatingColor = (rating: string) => {
        if (rating.includes('A+')) return '#4CAF50';
        if (rating.includes('A')) return '#8BC34A';
        if (rating.includes('B+')) return '#FFC107';
        if (rating.includes('B')) return '#FF9800';
        if (rating.includes('C')) return '#FF5722';
        return '#9E9E9E';
    };

    const getSeverityColor = (severity: string) => {
        const colors: Record<string, string> = {
            '낮음': '#4CAF50',
            '중간': '#FF9800',
            '높음': '#F44336'
        };
        return colors[severity] || '#9E9E9E';
    };

    const formatCurrency = (amount: number) => {
        return new Intl.NumberFormat('ko-KR', {
            style: 'currency',
            currency: 'KRW',
            minimumFractionDigits: 0,
            maximumFractionDigits: 0,
        }).format(amount);
    };

    const TabPanel = ({ children, value, index }: { children: React.ReactNode; value: number; index: number }) => (
        <div hidden={value !== index}>
            {value === index && <Box sx={{ p: 3 }}>{children}</Box>}
        </div>
    );

    return (
        <Box sx={{ maxWidth: 1200, mx: 'auto', p: 3 }}>
            <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', mb: 3 }}>
                <Typography variant="h4" component="h1" sx={{ fontWeight: 'bold', color: '#2E8B57' }}>
                    시공사 정보 시스템
                </Typography>
                <Box>
                    <Tooltip title="데이터 새로고침">
                        <IconButton onClick={loadCompanies} disabled={loading}>
                            <RefreshIcon />
                        </IconButton>
                    </Tooltip>
                    <Button
                        variant="contained"
                        startIcon={<CompareIcon />}
                        onClick={() => setComparisonDialogOpen(true)}
                        sx={{ ml: 2 }}
                    >
                        시공사 비교
                    </Button>
                </Box>
            </Box>

            {error && (
                <Alert
                    severity="error"
                    sx={{ mb: 3 }}
                    onClose={() => setError(null)}
                    action={
                        <Button
                            color="inherit"
                            size="small"
                            onClick={() => {
                                console.log('상세 오류 정보:', error);
                                alert(`상세 오류 정보:\n${error}\n\n브라우저 개발자 도구의 콘솔을 확인하세요.`);
                            }}
                        >
                            상세보기
                        </Button>
                    }
                >
                    <Typography variant="body2" sx={{ fontWeight: 'bold', mb: 1 }}>
                        오류가 발생했습니다:
                    </Typography>
                    <Typography variant="body2">
                        {error}
                    </Typography>
                    <Typography variant="caption" sx={{ display: 'block', mt: 1, opacity: 0.8 }}>
                        💡 브라우저 개발자 도구(F12)의 콘솔 탭에서 더 자세한 오류 정보를 확인할 수 있습니다.
                    </Typography>
                </Alert>
            )}

            <Paper sx={{ mb: 3 }}>
                <Tabs value={activeTab} onChange={(e, newValue) => setActiveTab(newValue)}>
                    <Tab label="시공사 목록" icon={<BusinessIcon />} />
                    <Tab label="상세 분석" icon={<AnalyticsIcon />} />
                    <Tab label="하자 이슈" icon={<WarningIcon />} />
                    <Tab label="트렌드 분석" icon={<TimelineIcon />} />
                </Tabs>
            </Paper>

            <TabPanel value={activeTab} index={0}>
                {loading ? (
                    <Box sx={{ display: 'flex', justifyContent: 'center', p: 4 }}>
                        <CircularProgress />
                    </Box>
                ) : (
                    <Grid container spacing={3}>
                        {companies.map((company) => (
                            <Grid item xs={12} md={6} lg={4} key={company.company_id}>
                                <Card sx={{ height: '100%', '&:hover': { boxShadow: 6 } }}>
                                    <CardContent>
                                        <Box sx={{ display: 'flex', alignItems: 'center', mb: 2 }}>
                                            <BusinessIcon sx={{ fontSize: 40, color: '#2E8B57', mr: 2 }} />
                                            <Box>
                                                <Typography variant="h6" sx={{ fontWeight: 'bold' }}>
                                                    {company.name}
                                                </Typography>
                                                <Typography variant="body2" color="text.secondary">
                                                    설립: {company.established_year}년
                                                </Typography>
                                            </Box>
                                        </Box>

                                        <Box sx={{ mb: 2 }}>
                                            <Typography variant="body2" sx={{ mb: 1, fontWeight: 'bold' }}>
                                                신뢰도 점수:
                                            </Typography>
                                            <Box sx={{ display: 'flex', alignItems: 'center' }}>
                                                <Rating value={company.reputation_score / 2} precision={0.1} readOnly size="small" />
                                                <Typography variant="body2" sx={{ ml: 1 }}>
                                                    {company.reputation_score}/10
                                                </Typography>
                                            </Box>
                                        </Box>

                                        <Box sx={{ mb: 2 }}>
                                            <Typography variant="body2" sx={{ mb: 1, fontWeight: 'bold' }}>
                                                하자율:
                                            </Typography>
                                            <LinearProgress
                                                variant="determinate"
                                                value={company.defect_rate * 10}
                                                sx={{
                                                    height: 8,
                                                    borderRadius: 4,
                                                    bgcolor: '#E0E0E0',
                                                    '& .MuiLinearProgress-bar': {
                                                        bgcolor: company.defect_rate <= 2 ? '#4CAF50' : company.defect_rate <= 3 ? '#FF9800' : '#F44336'
                                                    }
                                                }}
                                            />
                                            <Typography variant="body2" sx={{ mt: 0.5 }}>
                                                {company.defect_rate}%
                                            </Typography>
                                        </Box>

                                        <Box sx={{ mb: 2 }}>
                                            <Typography variant="body2" sx={{ mb: 1, fontWeight: 'bold' }}>
                                                평균 응답 시간:
                                            </Typography>
                                            <Typography variant="body2">
                                                {company.response_time_days}일
                                            </Typography>
                                        </Box>

                                        <Box sx={{ mb: 2 }}>
                                            <Typography variant="body2" sx={{ mb: 1, fontWeight: 'bold' }}>
                                                전문 분야:
                                            </Typography>
                                            <Box sx={{ display: 'flex', flexWrap: 'wrap', gap: 0.5 }}>
                                                {company.specialties.map((specialty) => (
                                                    <Chip key={specialty} label={specialty} size="small" />
                                                ))}
                                            </Box>
                                        </Box>

                                        <Box sx={{ mb: 2 }}>
                                            <Typography variant="body2" sx={{ mb: 1, fontWeight: 'bold' }}>
                                                프로젝트 현황:
                                            </Typography>
                                            <Typography variant="body2">
                                                완료: {company.projects_completed}개 | 진행중: {company.current_projects}개
                                            </Typography>
                                        </Box>

                                        <Button
                                            variant="contained"
                                            fullWidth
                                            onClick={() => analyzeCompany(company.company_id)}
                                            disabled={loading}
                                            sx={{ mt: 2 }}
                                        >
                                            상세 분석
                                        </Button>
                                    </CardContent>
                                </Card>
                            </Grid>
                        ))}
                    </Grid>
                )}
            </TabPanel>

            <TabPanel value={activeTab} index={1}>
                {selectedCompany ? (
                    <Grid container spacing={3}>
                        {/* 회사 기본 정보 */}
                        <Grid item xs={12}>
                            <Card>
                                <CardContent>
                                    <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', mb: 3 }}>
                                        <Typography variant="h5" sx={{ fontWeight: 'bold' }}>
                                            {selectedCompany.company.name} 분석 결과
                                        </Typography>
                                        <Chip
                                            label={selectedCompany.overall_rating}
                                            sx={{
                                                bgcolor: getRatingColor(selectedCompany.overall_rating),
                                                color: 'white',
                                                fontWeight: 'bold'
                                            }}
                                        />
                                    </Box>

                                    <Grid container spacing={3}>
                                        <Grid item xs={12} md={3}>
                                            <Box sx={{ textAlign: 'center' }}>
                                                <Typography variant="h4" sx={{ fontWeight: 'bold', color: '#4CAF50' }}>
                                                    {selectedCompany.reliability_score.toFixed(1)}
                                                </Typography>
                                                <Typography variant="h6">신뢰성 점수</Typography>
                                            </Box>
                                        </Grid>
                                        <Grid item xs={12} md={3}>
                                            <Box sx={{ textAlign: 'center' }}>
                                                <Typography variant="h4" sx={{ fontWeight: 'bold', color: '#2196F3' }}>
                                                    {selectedCompany.quality_score.toFixed(1)}
                                                </Typography>
                                                <Typography variant="h6">품질 점수</Typography>
                                            </Box>
                                        </Grid>
                                        <Grid item xs={12} md={3}>
                                            <Box sx={{ textAlign: 'center' }}>
                                                <Typography variant="h4" sx={{ fontWeight: 'bold', color: '#FF9800' }}>
                                                    {selectedCompany.responsiveness_score.toFixed(1)}
                                                </Typography>
                                                <Typography variant="h6">응답성 점수</Typography>
                                            </Box>
                                        </Grid>
                                        <Grid item xs={12} md={3}>
                                            <Box sx={{ textAlign: 'center' }}>
                                                <Typography variant="h4" sx={{ fontWeight: 'bold', color: '#9C27B0' }}>
                                                    {selectedCompany.cost_effectiveness_score.toFixed(1)}
                                                </Typography>
                                                <Typography variant="h6">비용 효율성</Typography>
                                            </Box>
                                        </Grid>
                                    </Grid>
                                </CardContent>
                            </Card>
                        </Grid>

                        {/* 강점과 약점 */}
                        <Grid item xs={12} md={6}>
                            <Card sx={{ height: '100%' }}>
                                <CardContent>
                                    <Typography variant="h6" sx={{ mb: 2, fontWeight: 'bold', color: '#4CAF50' }}>
                                        강점
                                    </Typography>
                                    <List>
                                        {selectedCompany.strengths.map((strength, index) => (
                                            <ListItem key={index}>
                                                <ListItemText
                                                    primary={strength}
                                                    primaryTypographyProps={{ fontSize: '0.9rem' }}
                                                />
                                                <CheckCircleIcon sx={{ color: '#4CAF50', ml: 1 }} />
                                            </ListItem>
                                        ))}
                                    </List>
                                </CardContent>
                            </Card>
                        </Grid>

                        <Grid item xs={12} md={6}>
                            <Card sx={{ height: '100%' }}>
                                <CardContent>
                                    <Typography variant="h6" sx={{ mb: 2, fontWeight: 'bold', color: '#F44336' }}>
                                        약점
                                    </Typography>
                                    <List>
                                        {selectedCompany.weaknesses.map((weakness, index) => (
                                            <ListItem key={index}>
                                                <ListItemText
                                                    primary={weakness}
                                                    primaryTypographyProps={{ fontSize: '0.9rem' }}
                                                />
                                                <WarningIcon sx={{ color: '#F44336', ml: 1 }} />
                                            </ListItem>
                                        ))}
                                    </List>
                                </CardContent>
                            </Card>
                        </Grid>

                        {/* 권장사항 */}
                        <Grid item xs={12}>
                            <Card>
                                <CardContent>
                                    <Typography variant="h6" sx={{ mb: 2, fontWeight: 'bold' }}>
                                        개선 권장사항
                                    </Typography>
                                    <List>
                                        {selectedCompany.recommendations.map((recommendation, index) => (
                                            <ListItem key={index}>
                                                <ListItemText
                                                    primary={`${index + 1}. ${recommendation}`}
                                                    primaryTypographyProps={{ fontSize: '0.9rem' }}
                                                />
                                            </ListItem>
                                        ))}
                                    </List>
                                </CardContent>
                            </Card>
                        </Grid>
                    </Grid>
                ) : (
                    <Typography>분석할 시공사를 선택해주세요.</Typography>
                )}
            </TabPanel>

            <TabPanel value={activeTab} index={2}>
                {selectedCompany ? (
                    <Grid container spacing={3}>
                        <Grid item xs={12}>
                            <Card>
                                <CardContent>
                                    <Typography variant="h6" sx={{ mb: 2, fontWeight: 'bold' }}>
                                        하자 이슈 현황
                                    </Typography>
                                    <TableContainer>
                                        <Table>
                                            <TableHead>
                                                <TableRow>
                                                    <TableCell>프로젝트</TableCell>
                                                    <TableCell>이슈 유형</TableCell>
                                                    <TableCell>심각도</TableCell>
                                                    <TableCell>신고일</TableCell>
                                                    <TableCell>해결일</TableCell>
                                                    <TableCell>비용 영향</TableCell>
                                                    <TableCell>고객 영향</TableCell>
                                                </TableRow>
                                            </TableHead>
                                            <TableBody>
                                                {selectedCompany.defect_history.map((defect) => (
                                                    <TableRow key={defect.issue_id}>
                                                        <TableCell>{defect.project_name}</TableCell>
                                                        <TableCell>{defect.issue_type}</TableCell>
                                                        <TableCell>
                                                            <Chip
                                                                label={defect.severity}
                                                                size="small"
                                                                sx={{
                                                                    bgcolor: getSeverityColor(defect.severity),
                                                                    color: 'white'
                                                                }}
                                                            />
                                                        </TableCell>
                                                        <TableCell>{defect.reported_date}</TableCell>
                                                        <TableCell>{defect.resolved_date || '미해결'}</TableCell>
                                                        <TableCell>{formatCurrency(defect.cost_impact)}</TableCell>
                                                        <TableCell>
                                                            <Rating value={defect.customer_impact_score / 2} precision={0.1} readOnly size="small" />
                                                        </TableCell>
                                                    </TableRow>
                                                ))}
                                            </TableBody>
                                        </Table>
                                    </TableContainer>
                                </CardContent>
                            </Card>
                        </Grid>
                    </Grid>
                ) : (
                    <Typography>분석할 시공사를 선택해주세요.</Typography>
                )}
            </TabPanel>

            <TabPanel value={activeTab} index={3}>
                <Grid container spacing={3}>
                    <Grid item xs={12}>
                        <Card>
                            <CardContent>
                                <Typography variant="h6" sx={{ mb: 2, fontWeight: 'bold' }}>
                                    하자 트렌드 분석
                                </Typography>
                                <Typography variant="body1" color="text.secondary">
                                    시공사별 하자 발생 패턴과 해결 추이를 분석하여 품질 개선 방향을 제시합니다.
                                </Typography>
                                <Button
                                    variant="outlined"
                                    startIcon={<TimelineIcon />}
                                    onClick={() => setTrendDialogOpen(true)}
                                    sx={{ mt: 2 }}
                                >
                                    트렌드 분석 시작
                                </Button>
                            </CardContent>
                        </Card>
                    </Grid>
                </Grid>
            </TabPanel>

            {/* 시공사 비교 다이얼로그 */}
            <Dialog open={comparisonDialogOpen} onClose={() => setComparisonDialogOpen(false)} maxWidth="md" fullWidth>
                <DialogTitle>시공사 비교 분석</DialogTitle>
                <DialogContent>
                    <Box sx={{ pt: 2 }}>
                        <Typography variant="h6" sx={{ mb: 2 }}>
                            비교할 시공사 선택 (최대 3개)
                        </Typography>
                        <FormControl fullWidth sx={{ mb: 2 }}>
                            <InputLabel>시공사 1</InputLabel>
                            <Select
                                value={selectedCompanyId}
                                onChange={(e) => setSelectedCompanyId(e.target.value)}
                            >
                                {companies.map((company) => (
                                    <MenuItem key={company.company_id} value={company.company_id}>
                                        {company.name}
                                    </MenuItem>
                                ))}
                            </Select>
                        </FormControl>
                    </Box>
                </DialogContent>
                <DialogActions>
                    <Button onClick={() => setComparisonDialogOpen(false)}>취소</Button>
                    <Button onClick={() => compareCompanies([selectedCompanyId])} variant="contained">
                        비교 분석
                    </Button>
                </DialogActions>
            </Dialog>

            {/* 트렌드 분석 다이얼로그 */}
            <Dialog open={trendDialogOpen} onClose={() => setTrendDialogOpen(false)} maxWidth="md" fullWidth>
                <DialogTitle>하자 트렌드 분석</DialogTitle>
                <DialogContent>
                    <Box sx={{ pt: 2 }}>
                        <Typography variant="h6" sx={{ mb: 2 }}>
                            분석할 시공사 선택
                        </Typography>
                        <FormControl fullWidth sx={{ mb: 2 }}>
                            <InputLabel>시공사</InputLabel>
                            <Select
                                value={selectedCompanyId}
                                onChange={(e) => setSelectedCompanyId(e.target.value)}
                            >
                                {companies.map((company) => (
                                    <MenuItem key={company.company_id} value={company.company_id}>
                                        {company.name}
                                    </MenuItem>
                                ))}
                            </Select>
                        </FormControl>
                    </Box>
                </DialogContent>
                <DialogActions>
                    <Button onClick={() => setTrendDialogOpen(false)}>취소</Button>
                    <Button onClick={() => setTrendDialogOpen(false)} variant="contained">
                        분석 시작
                    </Button>
                </DialogActions>
            </Dialog>
        </Box>
    );
};

export default ConstructionCompanyInfo;
