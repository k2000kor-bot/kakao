const mockRiskAssessments = [
    {
        id: 'risk-001',
        risk_type: 'financial',
        severity: 'high',
        probability: 0.3,
        impact: 0.8,
        risk_score: 0.24,
        mitigation_strategies: ['단계적 투자', '위험 분산', '보험 가입'],
