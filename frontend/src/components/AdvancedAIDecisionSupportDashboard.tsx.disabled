        mitigation_strategies: ['단계적 도입', '직원 교육', '모니터링 강화'],
        contingency_plans: ['롤백 계획', '대체 프로세스'],
        monitoring_indicators: ['생산성', '품질 지표', '고객 만족도']
    }
];

const COLORS = ['#8884d8', '#82ca9d', '#ffc658', '#ff7300', '#00ff00'];

const AdvancedAIDecisionSupportDashboard: React.FC = () => {
    const [currentTab, setCurrentTab] = useState(0);
    const [isFullscreen, setIsFullscreen] = useState(false);
    const [selectedContext, setSelectedContext] = useState<any>(null);
    const [contextDialogOpen, setContextDialogOpen] = useState(false);
    const [metrics, setMetrics] = useState(mockMetrics);
    const [decisionContexts, setDecisionContexts] = useState(mockDecisionContexts);
    const [decisionOptions, setDecisionOptions] = useState(mockDecisionOptions);
    const [scenarioAnalyses, setScenarioAnalyses] = useState(mockScenarioAnalyses);
    const [riskAssessments, setRiskAssessments] = useState(mockRiskAssessments);

    useEffect(() => {
        const interval = setInterval(() => {
            // 실시간 데이터 업데이트
            setMetrics(prev => ({
                ...prev,
                totalDecisions: prev.totalDecisions + (Math.random() > 0.8 ? 1 : 0),
                averageConfidence: Math.min(1, Math.max(0, prev.averageConfidence + (Math.random() - 0.5) * 0.02)),
                decisionQualityScore: Math.min(1, Math.max(0, prev.decisionQualityScore + (Math.random() - 0.5) * 0.01))
            }));
        }, 15000);

        return () => clearInterval(interval);
    }, []);

    const handleTabChange = (event: React.SyntheticEvent, newValue: number) => {
        setCurrentTab(newValue);
    };

    const handleContextClick = (context: any) => {
        setSelectedContext(context);
        setContextDialogOpen(true);
    };

    const getDecisionTypeColor = (type: string) => {
        switch (type) {
            case 'strategic': return 'primary';
            case 'operational': return 'secondary';
            case 'tactical': return 'info';
            case 'emergency': return 'error';
            default: return 'default';
        }
    };

    const getComplexityColor = (complexity: string) => {
        switch (complexity) {
            case 'low': return 'success';
            case 'medium': return 'warning';
            case 'high': return 'error';
            case 'critical': return 'error';
            default: return 'default';
        }
    };

    const getUrgencyColor = (urgency: string) => {
        switch (urgency) {
            case 'low': return 'success';
            case 'medium': return 'warning';
            case 'high': return 'error';
            case 'urgent': return 'error';
            default: return 'default';
        }
    };

    const getRiskSeverityColor = (severity: string) => {
        switch (severity) {
            case 'low': return 'success';
            case 'medium': return 'warning';
            case 'high': return 'error';
            case 'critical': return 'error';
            default: return 'default';
        }
    };

    const renderOverviewTab = () => (
        <Box>
            <Box sx={{ display: 'grid', gridTemplateColumns: { xs: '1fr', md: 'repeat(2, 1fr)' }, gap: 3 }}>
                {/* 시스템 상태 카드 */}
                <Card>
                    <CardContent>
                        <Typography variant="h6" gutterBottom>
                            의사결정 지원 시스템 상태
                        </Typography>
                        <Box display="flex" alignItems="center" gap={2} mb={2}>
                            <Chip
                                label="정상 운영"
                                color="success"
                                icon={<CheckCircle />}
                            />
                            <Typography variant="body2" color="textSecondary">
                                마지막 업데이트: {new Date().toLocaleTimeString()}
                            </Typography>
                        </Box>
                        <Box sx={{ display: 'grid', gridTemplateColumns: 'repeat(2, 1fr)', gap: 2 }}>
                            <Box>
                                <Typography variant="body2" color="textSecondary">총 의사결정</Typography>
                                <Typography variant="h4">{metrics.totalDecisions}</Typography>
                            </Box>
                            <Box>
                                <Typography variant="body2" color="textSecondary">성공률</Typography>
                                <Typography variant="h4">{((metrics.successfulDecisions / metrics.totalDecisions) * 100).toFixed(1)}%</Typography>
                            </Box>
                            <Box>
                                <Typography variant="body2" color="textSecondary">평균 신뢰도</Typography>
                                <Typography variant="h4">{(metrics.averageConfidence * 100).toFixed(1)}%</Typography>
                            </Box>
                            <Box>
                                <Typography variant="body2" color="textSecondary">품질 점수</Typography>
                                <Typography variant="h4">{(metrics.decisionQualityScore * 100).toFixed(1)}%</Typography>
                            </Box>
                        </Box>
                    </CardContent>
                </Card>

                {/* 의사결정 유형 분포 */}
                <Card>
                    <CardContent>
                        <Typography variant="h6" gutterBottom>
                            의사결정 유형 분포
                        </Typography>
                        <ResponsiveContainer width="100%" height={200}>
                            <PieChart>
                                <Pie
                                    data={[
                                        { name: '전략적', value: 35, fill: '#8884d8' },
                                        { name: '운영적', value: 40, fill: '#82ca9d' },
                                        { name: '전술적', value: 20, fill: '#ffc658' },
                                        { name: '긴급', value: 5, fill: '#ff7300' }
                                    ]}
                                    cx="50%"
                                    cy="50%"
                                    outerRadius={80}
                                    dataKey="value"
                                    label
                                >
                                    {[0, 1, 2, 3].map((entry, index) => (
                                        <Cell key={`cell-${index}`} fill={COLORS[index % COLORS.length]} />
                                    ))}
                                </Pie>
                                <RechartsTooltip />
                            </PieChart>
                        </ResponsiveContainer>
                    </CardContent>
                </Card>

                {/* 의사결정 컨텍스트 요약 */}
                <Box sx={{ gridColumn: { xs: '1', md: '1 / -1' } }}>
                    <Card>
                        <CardContent>
                            <Typography variant="h6" gutterBottom>
                                의사결정 컨텍스트 현황
                            </Typography>
                            <TableContainer>
                                <Table size="small">
                                    <TableHead>
                                        <TableRow>
                                            <TableCell>사용자 ID</TableCell>
                                            <TableCell>의사결정 유형</TableCell>
                                            <TableCell>도메인</TableCell>
                                            <TableCell>복잡도</TableCell>
                                            <TableCell>긴급도</TableCell>
                                            <TableCell>위험 허용도</TableCell>
                                            <TableCell>생성 시간</TableCell>
                                            <TableCell>상태</TableCell>
                                        </TableRow>
                                    </TableHead>
                                    <TableBody>
                                        {decisionContexts.map((context) => (
                                            <TableRow key={context.id} hover onClick={() => handleContextClick(context)} style={{ cursor: 'pointer' }}>
                                                <TableCell>{context.user_id}</TableCell>
                                                <TableCell>
                                                    <Chip
                                                        label={context.decision_type}
                                                        size="small"
                                                        color={getDecisionTypeColor(context.decision_type)}
                                                    />
                                                </TableCell>
                                                <TableCell>
                                                    <Chip label={context.domain} size="small" variant="outlined" />
                                                </TableCell>
                                                <TableCell>
                                                    <Chip
                                                        label={context.complexity}
                                                        size="small"
                                                        color={getComplexityColor(context.complexity)}
                                                    />
                                                </TableCell>
                                                <TableCell>
                                                    <Chip
                                                        label={context.urgency}
                                                        size="small"
                                                        color={getUrgencyColor(context.urgency)}
                                                    />
                                                </TableCell>
                                                <TableCell>
                                                    <LinearProgress
                                                        variant="determinate"
                                                        value={context.risk_tolerance * 100}
                                                        sx={{ width: 100, height: 6, borderRadius: 3 }}
                                                    />
                                                    <Typography variant="body2" sx={{ mt: 0.5 }}>
                                                        {(context.risk_tolerance * 100).toFixed(0)}%
                                                    </Typography>
                                                </TableCell>
                                                <TableCell>
                                                    {context.created_at.toLocaleDateString()}
                                                </TableCell>
                                                <TableCell>
                                                    <Chip
                                                        label="진행 중"
                                                        color="info"
                                                        size="small"
                                                    />
                                                </TableCell>
                                            </TableRow>
                                        ))}
                                    </TableBody>
                                </Table>
                            </TableContainer>
                        </CardContent>
                    </Card>
                </Box>
            </Box>
        </Box>
    );

    const renderOptionsTab = () => (
        <Box>
            <Box sx={{ display: 'grid', gridTemplateColumns: { xs: '1fr', md: 'repeat(2, 1fr)' }, gap: 3 }}>
                {decisionOptions.map((option) => (
                    <Card key={option.id}>
                        <CardContent>
                            <Box display="flex" justifyContent="space-between" alignItems="center" mb={2}>
                                <Typography variant="h6">
                                    {option.title}
                                </Typography>
                                <Chip
                                    label={`${(option.ranking_score * 100).toFixed(0)}점`}
                                    color="primary"
                                    size="small"
                                />
                            </Box>

                            <Typography variant="body2" color="textSecondary" paragraph>
                                {option.description}
                            </Typography>

                            <Box mb={2}>
                                <Typography variant="subtitle2" gutterBottom>영향도 분석</Typography>
                                <Box sx={{ display: 'grid', gridTemplateColumns: 'repeat(2, 1fr)', gap: 1 }}>
                                    <Box>
                                        <Typography variant="body2" color="textSecondary">재무적 영향</Typography>
                                        <LinearProgress
                                            variant="determinate"
                                            value={option.estimated_impact.financial * 100}
                                            color="success"
                                            sx={{ height: 6, borderRadius: 3 }}
                                        />
                                    </Box>
                                    <Box>
                                        <Typography variant="body2" color="textSecondary">운영적 영향</Typography>
                                        <LinearProgress
                                            variant="determinate"
                                            value={option.estimated_impact.operational * 100}
                                            color="info"
                                            sx={{ height: 6, borderRadius: 3 }}
                                        />
                                    </Box>
                                    <Box>
                                        <Typography variant="body2" color="textSecondary">전략적 영향</Typography>
                                        <LinearProgress
                                            variant="determinate"
                                            value={option.estimated_impact.strategic * 100}
                                            color="primary"
                                            sx={{ height: 6, borderRadius: 3 }}
                                        />
                                    </Box>
                                    <Box>
                                        <Typography variant="body2" color="textSecondary">위험 수준</Typography>
                                        <LinearProgress
                                            variant="determinate"
                                            value={option.estimated_impact.risk * 100}
                                            color="error"
                                            sx={{ height: 6, borderRadius: 3 }}
                                        />
                                    </Box>
                                </Box>
                            </Box>

                                <Box display="flex" justifyContent="space-between" mb={2}>
                                    <Box>
                                        <Typography variant="body2" color="textSecondary">성공 확률</Typography>
                                        <Typography variant="h6">{(option.probability_of_success * 100).toFixed(1)}%</Typography>
                                    </Box>
                                    <Box>
                                        <Typography variant="body2" color="textSecondary">신뢰도</Typography>
                                        <Typography variant="h6">{(option.confidence_level * 100).toFixed(1)}%</Typography>
                                    </Box>
                                    <Box>
                                        <Typography variant="body2" color="textSecondary">예상 비용</Typography>
                                        <Typography variant="h6">${(option.resource_requirements.cost / 1000).toFixed(0)}K</Typography>
                                    </Box>
                                </Box>

                                <Box display="flex" gap={1} mb={2}>
                                    <Typography variant="body2" color="textSecondary">장점:</Typography>
                                    {option.pros.slice(0, 2).map((pro, index) => (
                                        <Chip key={index} label={pro} size="small" color="success" variant="outlined" />
                                    ))}
                                </Box>

                                <Box display="flex" gap={1}>
                                    <Typography variant="body2" color="textSecondary">단점:</Typography>
                                    {option.cons.slice(0, 2).map((con, index) => (
                                        <Chip key={index} label={con} size="small" color="error" variant="outlined" />
                                    ))}
                                </Box>
                            </CardContent>
                        </Card>
                    </Grid>
                ))}
            </Grid>
        </Box>
    );

    const renderScenariosTab = () => (
        <Box>
            <Grid container spacing={3}>
                {scenarioAnalyses.map((scenario) => (
                    <Grid item xs={12} md={6} key={scenario.id}>
                        <Card>
                            <CardContent>
                                <Typography variant="h6" gutterBottom>
                                    {scenario.scenario_name}
                                </Typography>

                                <Typography variant="body2" color="textSecondary" paragraph>
                                    {scenario.description}
                                </Typography>

                                <Box mb={2}>
                                    <Typography variant="subtitle2" gutterBottom>시나리오 결과 비교</Typography>
                                    <ResponsiveContainer width="100%" height={300}>
                                        <RadarChart data={[
                                            {
                                                metric: '재무적 영향',
                                                best: scenario.outcomes.best_case.financial_impact * 100,
                                                likely: scenario.outcomes.most_likely.financial_impact * 100,
                                                worst: scenario.outcomes.worst_case.financial_impact * 100
                                            },
                                            {
                                                metric: '운영적 영향',
                                                best: scenario.outcomes.best_case.operational_impact * 100,
                                                likely: scenario.outcomes.most_likely.operational_impact * 100,
                                                worst: scenario.outcomes.worst_case.operational_impact * 100
                                            },
                                            {
                                                metric: '전략적 영향',
                                                best: scenario.outcomes.best_case.strategic_impact * 100,
                                                likely: scenario.outcomes.most_likely.strategic_impact * 100,
                                                worst: scenario.outcomes.worst_case.strategic_impact * 100
                                            },
                                            {
                                                metric: '위험 수준',
                                                best: scenario.outcomes.best_case.risk_level * 100,
                                                likely: scenario.outcomes.most_likely.risk_level * 100,
                                                worst: scenario.outcomes.worst_case.risk_level * 100
                                            },
                                            {
                                                metric: '성공 확률',
                                                best: scenario.outcomes.best_case.success_probability * 100,
                                                likely: scenario.outcomes.most_likely.success_probability * 100,
                                                worst: scenario.outcomes.worst_case.success_probability * 100
                                            }
                                        ]}>
                                            <PolarGrid />
                                            <PolarAngleAxis dataKey="metric" />
                                            <PolarRadiusAxis angle={90} domain={[0, 100]} />
                                            <Radar name="최적 케이스" dataKey="best" stroke="#8884d8" fill="#8884d8" fillOpacity={0.6} />
                                            <Radar name="가능성 높음" dataKey="likely" stroke="#82ca9d" fill="#82ca9d" fillOpacity={0.6} />
                                            <Radar name="최악 케이스" dataKey="worst" stroke="#ffc658" fill="#ffc658" fillOpacity={0.6} />
                                            <RechartsTooltip />
                                        </RadarChart>
                                    </ResponsiveContainer>
                                </Box>

                                <Box mb={2}>
                                    <Typography variant="subtitle2" gutterBottom>가정 사항</Typography>
                                    <List dense>
                                        {scenario.assumptions.map((assumption, index) => (
                                            <ListItem key={index}>
                                                <ListItemIcon>
                                                    <Info color="info" />
                                                </ListItemIcon>
                                                <ListItemText primary={assumption} />
                                            </ListItem>
                                        ))}
                                    </List>
                                </Box>

                                <Box display="flex" justifyContent="space-between" alignItems="center">
                                    <Typography variant="body2" color="textSecondary">
                                        발생 확률: {(scenario.probability * 100).toFixed(1)}%
                                    </Typography>
                                    <Button variant="contained" size="small" startIcon={<Analytics />}>
                                        상세 분석
                                    </Button>
                                </Box>
                            </CardContent>
                        </Card>
                    </Grid>
                ))}
            </Grid>
        </Box>
    );

    const renderRisksTab = () => (
        <Box>
            <Grid container spacing={3}>
                {riskAssessments.map((risk) => (
                    <Grid item xs={12} md={6} key={risk.id}>
                        <Card>
                            <CardContent>
                                <Box display="flex" justifyContent="space-between" alignItems="center" mb={2}>
                                    <Typography variant="h6">
                                        {risk.risk_type} 위험
                                    </Typography>
                                    <Chip
                                        label={risk.severity}
                                        color={getRiskSeverityColor(risk.severity)}
                                        size="small"
                                    />
                                </Box>

                                <Box mb={2}>
                                    <Typography variant="subtitle2" gutterBottom>위험 점수</Typography>
                                    <Box display="flex" alignItems="center" gap={2}>
                                        <LinearProgress
                                            variant="determinate"
                                            value={risk.risk_score * 100}
                                            color={risk.risk_score > 0.5 ? 'error' : 'warning'}
                                            sx={{ flexGrow: 1, height: 8, borderRadius: 4 }}
                                        />
                                        <Typography variant="h6">
                                            {(risk.risk_score * 100).toFixed(1)}%
                                        </Typography>
                                    </Box>
                                </Box>

                                <Grid container spacing={2} mb={2}>
                                    <Grid item xs={6}>
                                        <Typography variant="body2" color="textSecondary">발생 확률</Typography>
                                        <Typography variant="h6">{(risk.probability * 100).toFixed(1)}%</Typography>
                                    </Grid>
                                    <Grid item xs={6}>
                                        <Typography variant="body2" color="textSecondary">영향도</Typography>
                                        <Typography variant="h6">{(risk.impact * 100).toFixed(1)}%</Typography>
                                    </Grid>
                                </Grid>

                                <Accordion>
                                    <AccordionSummary expandIcon={<ExpandMore />}>
                                        <Typography variant="subtitle2">완화 전략</Typography>
                                    </AccordionSummary>
                                    <AccordionDetails>
                                        <List dense>
                                            {risk.mitigation_strategies.map((strategy, index) => (
                                                <ListItem key={index}>
                                                    <ListItemIcon>
                                                        <CheckCircle color="success" />
                                                    </ListItemIcon>
                                                    <ListItemText primary={strategy} />
                                                </ListItem>
                                            ))}
                                        </List>
                                    </AccordionDetails>
                                </Accordion>

                                <Accordion>
                                    <AccordionSummary expandIcon={<ExpandMore />}>
                                        <Typography variant="subtitle2">비상 계획</Typography>
                                    </AccordionSummary>
                                    <AccordionDetails>
                                        <List dense>
                                            {risk.contingency_plans.map((plan, index) => (
                                                <ListItem key={index}>
                                                    <ListItemIcon>
                                                        <Warning color="warning" />
                                                    </ListItemIcon>
                                                    <ListItemText primary={plan} />
                                                </ListItem>
                                            ))}
                                        </List>
                                    </AccordionDetails>
                                </Accordion>

                                <Box mt={2}>
                                    <Typography variant="subtitle2" gutterBottom>모니터링 지표</Typography>
                                    <Box display="flex" gap={1} flexWrap="wrap">
                                        {risk.monitoring_indicators.map((indicator, index) => (
                                            <Chip key={index} label={indicator} size="small" variant="outlined" />
                                        ))}
                                    </Box>
                                </Box>
                            </CardContent>
                        </Card>
                    </Grid>
                ))}

                {/* 위험 트렌드 차트 */}
                <Grid item xs={12}>
                    <Card>
                        <CardContent>
                            <Typography variant="h6" gutterBottom>
                                위험 트렌드 분석
                            </Typography>
                            <ResponsiveContainer width="100%" height={400}>
                                <LineChart data={Array.from({ length: 20 }, (_, i) => ({
                                    time: i,
                                    financial_risk: 0.3 + Math.random() * 0.4,
                                    operational_risk: 0.2 + Math.random() * 0.3,
                                    strategic_risk: 0.4 + Math.random() * 0.5,
                                    compliance_risk: 0.1 + Math.random() * 0.2
                                }))}>
                                    <CartesianGrid strokeDasharray="3 3" />
                                    <XAxis dataKey="time" />
                                    <YAxis />
                                    <RechartsTooltip />
                                    <Line type="monotone" dataKey="financial_risk" stroke="#8884d8" name="재무적 위험" />
                                    <Line type="monotone" dataKey="operational_risk" stroke="#82ca9d" name="운영적 위험" />
                                    <Line type="monotone" dataKey="strategic_risk" stroke="#ffc658" name="전략적 위험" />
                                    <Line type="monotone" dataKey="compliance_risk" stroke="#ff7300" name="규정 위험" />
                                </LineChart>
                            </ResponsiveContainer>
                        </CardContent>
                    </Card>
                </Grid>
            </Grid>
        </Box>
    );

    const renderPerformanceTab = () => (
        <Box>
            <Grid container spacing={3}>
                {/* 성능 지표 카드들 */}
                <Grid item xs={12} md={3}>
                    <Card>
                        <CardContent>
                            <Typography variant="h6" gutterBottom>
                                의사결정 성공률
                            </Typography>
                            <Typography variant="h3" color="success">
                                {((metrics.successfulDecisions / metrics.totalDecisions) * 100).toFixed(1)}%
                            </Typography>
                        </CardContent>
                    </Card>
                </Grid>
                <Grid item xs={12} md={3}>
                    <Card>
                        <CardContent>
                            <Typography variant="h6" gutterBottom>
                                평균 구현 시간
                            </Typography>
                            <Typography variant="h3" color="info">
                                {metrics.averageImplementationTime}일
                            </Typography>
                        </CardContent>
                    </Card>
                </Grid>
                <Grid item xs={12} md={3}>
                    <Card>
                        <CardContent>
                            <Typography variant="h6" gutterBottom>
                                위험 완화 성공률
                            </Typography>
                            <Typography variant="h3" color="warning">
                                {(metrics.riskMitigationSuccessRate * 100).toFixed(1)}%
                            </Typography>
                        </CardContent>
                    </Card>
                </Grid>
                <Grid item xs={12} md={3}>
                    <Card>
                        <CardContent>
                            <Typography variant="h6" gutterBottom>
                                이해관계자 만족도
                            </Typography>
                            <Typography variant="h3" color="primary">
                                {(metrics.stakeholderSatisfaction * 100).toFixed(1)}%
                            </Typography>
                        </CardContent>
                    </Card>
                </Grid>

                {/* 성능 트렌드 차트 */}
                <Grid item xs={12}>
                    <Card>
                        <CardContent>
                            <Typography variant="h6" gutterBottom>
                                의사결정 품질 트렌드
                            </Typography>
                            <ResponsiveContainer width="100%" height={400}>
                                <LineChart data={Array.from({ length: 20 }, (_, i) => ({
                                    time: i,
                                    quality_score: 0.7 + Math.random() * 0.3,
                                    confidence: 0.6 + Math.random() * 0.4,
                                    satisfaction: 0.8 + Math.random() * 0.2,
                                    implementation_time: 10 + Math.random() * 10
                                }))}>
                                    <CartesianGrid strokeDasharray="3 3" />
                                    <XAxis dataKey="time" />
                                    <YAxis />
                                    <RechartsTooltip />
                                    <Line type="monotone" dataKey="quality_score" stroke="#8884d8" name="품질 점수" />
                                    <Line type="monotone" dataKey="confidence" stroke="#82ca9d" name="신뢰도" />
                                    <Line type="monotone" dataKey="satisfaction" stroke="#ffc658" name="만족도" />
                                </LineChart>
                            </ResponsiveContainer>
                        </CardContent>
                    </Card>
                </Grid>
            </Grid>
        </Box>
    );

    const renderSettingsTab = () => (
        <Box>
            <Grid container spacing={3}>
                <Grid item xs={12} md={6}>
                    <Card>
                        <CardContent>
                            <Typography variant="h6" gutterBottom>
                                시스템 설정
                            </Typography>
                            <Box display="flex" flexDirection="column" gap={2}>
                                <Button variant="contained" color="primary" startIcon={<Refresh />}>
                                    의사결정 엔진 재시작
                                </Button>
                                <Button variant="outlined" color="secondary" startIcon={<Analytics />}>
                                    최적화 알고리즘 업데이트
                                </Button>
                                <Button variant="outlined" color="info" startIcon={<Risk />}>
                                    위험 모델 재훈련
                                </Button>
                                <Button variant="outlined" color="warning" startIcon={<Settings />}>
                                    고급 설정
                                </Button>
                            </Box>
                        </CardContent>
                    </Card>
                </Grid>

                <Grid item xs={12} md={6}>
                    <Card>
                        <CardContent>
                            <Typography variant="h6" gutterBottom>
                                시스템 상태
                            </Typography>
                            <Box display="flex" flexDirection="column" gap={2}>
                                <Alert severity="success">
                                    의사결정 지원 시스템이 정상적으로 작동 중입니다.
                                </Alert>
                                <Alert severity="info">
                                    최적화 알고리즘이 활성화되어 있습니다.
                                </Alert>
                                <Alert severity="warning">
                                    일부 위험 지표가 임계값을 초과했습니다.
                                </Alert>
                            </Box>
                        </CardContent>
                    </Card>
                </Grid>
            </Grid>
        </Box>
    );

    return (
        <Box sx={{ p: 3, height: '100vh', overflow: 'auto' }}>
            {/* 헤더 */}
            <Box display="flex" justifyContent="space-between" alignItems="center" mb={3}>
                <Box>
                    <Typography variant="h4" gutterBottom>
                        🧠 고급 AI 의사결정 지원 대시보드
                    </Typography>
                    <Typography variant="body1" color="textSecondary">
                        복잡한 의사결정 로직, 시나리오 분석, 위험 평가, 최적화 알고리즘
                    </Typography>
                </Box>
                <Box display="flex" gap={1}>
                    <Tooltip title="새로고침">
                        <IconButton>
                            <Refresh />
                        </IconButton>
                    </Tooltip>
                    <Tooltip title={isFullscreen ? "전체화면 해제" : "전체화면"}>
                        <IconButton onClick={() => setIsFullscreen(!isFullscreen)}>
                            {isFullscreen ? <FullscreenExit /> : <Fullscreen />}
                        </IconButton>
                    </Tooltip>
                </Box>
            </Box>

            {/* 탭 네비게이션 */}
            <Paper sx={{ mb: 3 }}>
                <Tabs value={currentTab} onChange={handleTabChange} variant="scrollable" scrollButtons="auto">
                    <Tab icon={<Assessment />} label="개요" />
                    <Tab icon={<Lightbulb />} label="의사결정 옵션" />
                    <Tab icon={<Analytics />} label="시나리오 분석" />
                    <Tab icon={<Risk />} label="위험 평가" />
                    <Tab icon={<TrendingUp />} label="성능 모니터링" />
                    <Tab icon={<Settings />} label="설정" />
                </Tabs>
            </Paper>

            {/* 탭 콘텐츠 */}
            <Box>
                {currentTab === 0 && renderOverviewTab()}
                {currentTab === 1 && renderOptionsTab()}
                {currentTab === 2 && renderScenariosTab()}
                {currentTab === 3 && renderRisksTab()}
                {currentTab === 4 && renderPerformanceTab()}
                {currentTab === 5 && renderSettingsTab()}
            </Box>

            {/* 의사결정 컨텍스트 상세 다이얼로그 */}
            <Dialog open={contextDialogOpen} onClose={() => setContextDialogOpen(false)} maxWidth="md" fullWidth>
                <DialogTitle>
                    의사결정 컨텍스트 상세 정보: {selectedContext?.user_id}
                </DialogTitle>
                <DialogContent>
                    {selectedContext && (
                        <Box>
                            <Grid container spacing={2}>
                                <Grid item xs={6}>
                                    <Typography variant="subtitle2">의사결정 유형</Typography>
                                    <Typography variant="body2">{selectedContext.decision_type}</Typography>
                                </Grid>
                                <Grid item xs={6}>
                                    <Typography variant="subtitle2">도메인</Typography>
                                    <Typography variant="body2">{selectedContext.domain}</Typography>
                                </Grid>
                                <Grid item xs={6}>
                                    <Typography variant="subtitle2">복잡도</Typography>
                                    <Typography variant="body2">{selectedContext.complexity}</Typography>
                                </Grid>
                                <Grid item xs={6}>
                                    <Typography variant="subtitle2">긴급도</Typography>
                                    <Typography variant="body2">{selectedContext.urgency}</Typography>
                                </Grid>
                                <Grid item xs={12}>
                                    <Typography variant="subtitle2">이해관계자</Typography>
                                    <Box display="flex" gap={1} flexWrap="wrap">
                                        {selectedContext.stakeholders.map((stakeholder: string, index: number) => (
                                            <Chip key={index} label={stakeholder} size="small" />
                                        ))}
                                    </Box>
                                </Grid>
                                <Grid item xs={12}>
                                    <Typography variant="subtitle2">제약 조건</Typography>
                                    <List dense>
                                        {selectedContext.constraints.map((constraint: string, index: number) => (
                                            <ListItem key={index}>
                                                <ListItemIcon>
                                                    <Warning color="warning" />
                                                </ListItemIcon>
                                                <ListItemText primary={constraint} />
                                            </ListItem>
                                        ))}
                                    </List>
                                </Grid>
                                <Grid item xs={12}>
                                    <Typography variant="subtitle2">목표</Typography>
                                    <List dense>
                                        {selectedContext.objectives.map((objective: string, index: number) => (
                                            <ListItem key={index}>
                                                <ListItemIcon>
                                                    <CheckCircle color="success" />
                                                </ListItemIcon>
                                                <ListItemText primary={objective} />
                                            </ListItem>
                                        ))}
                                    </List>
                                </Grid>
                            </Grid>
                        </Box>
                    )}
                </DialogContent>
                <DialogActions>
                    <Button onClick={() => setContextDialogOpen(false)}>닫기</Button>
                    <Button variant="contained" color="primary">옵션 생성</Button>
                </DialogActions>
            </Dialog>
        </Box>
    );
};

export default AdvancedAIDecisionSupportDashboard;
