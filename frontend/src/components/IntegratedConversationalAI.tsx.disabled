// AI 응답 생성 함수
const generateAIResponse = (userMessage: string): ConversationMessage => {
    const lowerMessage = userMessage.toLowerCase();

    // 시스템 상태 관련 질문
    if (lowerMessage.includes('시스템') || lowerMessage.includes('상태') || lowerMessage.includes('어떻게')) {
        const activeSystems = aiSystems.filter(sys => sys.status === 'active');
        const avgPerformance = activeSystems.reduce((sum, sys) => sum + sys.performance, 0) / activeSystems.length;

        return {
            id: Date.now().toString(),
            type: 'ai',
            content: `현재 CORBU AI 시스템의 상태입니다:\n\n📊 **전체 시스템 상태**: ${activeSystems.length}/${aiSystems.length}개 시스템 활성화\n📈 **평균 성능**: ${avgPerformance.toFixed(1)}%\n🟢 **모든 시스템 정상 작동 중**\n\n어떤 시스템에 대해 더 자세히 알고 싶으신가요?`,
            timestamp: new Date(),
            systemInfo: aiSystems,
            confidence: 0.95
        };
    }

    // 특정 시스템 관련 질문
    const systemKeywords = {
        '심리학': 'ai-psychology',
        '심리': 'ai-psychology',
        '상담': 'ai-psychology',
        '감정': 'ai-psychology',
        '예측': 'ai-predictive-analytics',
        '분석': 'ai-predictive-analytics',
        '트렌드': 'ai-predictive-analytics',
        '품질': 'ai-quality-assurance',
        '보증': 'ai-quality-assurance',
        '윤리': 'ai-ethics-governance',
        '거버넌스': 'ai-ethics-governance',
        '미래': 'ai-future-prediction',
        '비전': 'ai-future-vision',
        '혁신': 'ai-creative-innovation',
        '창의': 'ai-creative-innovation',
        '통합': 'ai-system-integration',
        '생태계': 'ai-ecosystem',
        '에이전트': 'ai-ecosystem'
    };

    for (const [keyword, systemId] of Object.entries(systemKeywords)) {
        if (lowerMessage.includes(keyword)) {
            const system = aiSystems.find(s => s.id === systemId);
            if (system) {
                return {
                    id: Date.now().toString(),
                    type: 'ai',
                    content: `**${system.name}**에 대한 정보입니다:\n\n📋 **설명**: ${system.description}\n📊 **성능**: ${system.performance}%\n🏷️ **카테고리**: ${system.category}\n\n🔧 **주요 기능**:\n${system.features.map(f => `• ${f}`).join('\n')}\n\n마지막 업데이트: ${system.lastUpdated}`,
                    timestamp: new Date(),
                    systemInfo: [system],
                    confidence: 0.92
                };
            }
        }
    }

    // 기능 관련 질문
    if (lowerMessage.includes('기능') || lowerMessage.includes('할 수') || lowerMessage.includes('뭐')) {
        const allFeatures = aiSystems.flatMap(sys => sys.features);
        const uniqueFeatures = [...new Set(allFeatures)];

        return {
            id: Date.now().toString(),
            type: 'ai',
            content: `CORBU AI 시스템에서 제공하는 주요 기능들입니다:\n\n${uniqueFeatures.map(f => `• ${f}`).join('\n')}\n\n총 ${uniqueFeatures.length}개의 고유 기능을 제공하며, 각 시스템별로 특화된 서비스를 제공합니다. 특정 기능에 대해 더 자세히 알고 싶으시면 말씀해 주세요!`,
            timestamp: new Date(),
            confidence: 0.88
        };
    }

    // 성능 관련 질문
    if (lowerMessage.includes('성능') || lowerMessage.includes('효율') || lowerMessage.includes('속도')) {
        const performanceData = aiSystems.map(sys => ({
            name: sys.name,
            performance: sys.performance
        })).sort((a, b) => b.performance - a.performance);

        return {
            id: Date.now().toString(),
            type: 'ai',
            content: `**시스템 성능 현황** (성능 순):\n\n${performanceData.map(sys => `📊 ${sys.name}: ${sys.performance}%`).join('\n')}\n\n평균 성능: ${(performanceData.reduce((sum, sys) => sum + sys.performance, 0) / performanceData.length).toFixed(1)}%\n\n모든 시스템이 89% 이상의 높은 성능을 유지하고 있습니다!`,
            timestamp: new Date(),
            analysis: {
                type: 'performance',
                data: performanceData,
                insights: ['모든 시스템이 89% 이상의 성능 유지', 'AI 통합 대시보드가 최고 성능', '전체적으로 안정적인 운영 중']
            },
            confidence: 0.94
        };
    }

    // 기본 응답
    return {
        id: Date.now().toString(),
        type: 'ai',
        content: `안녕하세요! 저는 CORBU AI 시스템의 통합 어시스턴트입니다. 🤖\n\n다음과 같은 질문을 할 수 있습니다:\n\n• "시스템 상태는 어때?" - 전체 시스템 현황\n• "심리학 시스템은 뭐야?" - 특정 시스템 정보\n• "어떤 기능들이 있어?" - 제공 기능 목록\n• "성능은 어때?" - 시스템 성능 현황\n• "AI 통합 플랫폼에 대해 알려줘" - 특정 시스템 상세 정보\n\n무엇이든 물어보세요!`,
        timestamp: new Date(),
        confidence: 0.85
    };
};

const IntegratedConversationalAI: React.FC = () => {
    const [messages, setMessages] = useState<ConversationMessage[]>([
        {
            id: '1',
            type: 'ai',
            content: '안녕하세요! 저는 CORBU AI 시스템의 통합 어시스턴트입니다. 🤖\n\n전체 AI 시스템에 대한 질문이나 정보를 원하시면 언제든 말씀해 주세요. 시스템 상태, 기능, 성능 등 모든 것을 알려드릴 수 있습니다!',
            timestamp: new Date(),
            confidence: 0.95
        }
    ]);
    const [inputValue, setInputValue] = useState('');
    const [isTyping, setIsTyping] = useState(false);
    const [isRecording, setIsRecording] = useState(false);
    const [showSystemInfo, setShowSystemInfo] = useState(false);
    const [selectedSystem, setSelectedSystem] = useState<AISystemInfo | null>(null);
    const messagesEndRef = useRef<HTMLDivElement>(null);

    const scrollToBottom = () => {
        messagesEndRef.current?.scrollIntoView({ behavior: 'smooth' });
    };

    useEffect(() => {
        scrollToBottom();
    }, [messages]);

    const handleSendMessage = async () => {
        if (!inputValue.trim()) return;

        const userMessage: ConversationMessage = {
            id: Date.now().toString(),
            type: 'user',
            content: inputValue,
            timestamp: new Date()
        };

        setMessages(prev => [...prev, userMessage]);
        setInputValue('');
        setIsTyping(true);

        // AI 응답 생성 (실제로는 API 호출)
        setTimeout(() => {
            const aiResponse = generateAIResponse(inputValue);
            setMessages(prev => [...prev, aiResponse]);
            setIsTyping(false);
        }, 1000);
    };

    const handleKeyPress = (e: React.KeyboardEvent) => {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            handleSendMessage();
        }
    };

    const handleSystemInfoClick = (system: AISystemInfo) => {
        setSelectedSystem(system);
        setShowSystemInfo(true);
    };

    const getSystemStatusColor = (status: string) => {
        switch (status) {
            case 'active': return 'success';
            case 'inactive': return 'warning';
            case 'error': return 'error';
            default: return 'default';
        }
    };

    const getPerformanceColor = (performance: number) => {
        if (performance >= 90) return 'success';
        if (performance >= 80) return 'warning';
        return 'error';
    };

    return (
        <Box sx={{ height: '100vh', display: 'flex', flexDirection: 'column' }}>
            {/* 헤더 */}
            <Card sx={{ mb: 2 }}>
                <CardContent>
                    <Box sx={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between' }}>
                        <Box sx={{ display: 'flex', alignItems: 'center', gap: 2 }}>
                            <Avatar sx={{ bgcolor: 'primary.main' }}>
                                <SmartToy />
                            </Avatar>
                            <Box>
                                <Typography variant="h6">CORBU AI 통합 대화형 시스템</Typography>
                                <Typography variant="body2" color="text.secondary">
                                    전체 AI 시스템에 대한 질문-답변 서비스
                                </Typography>
                            </Box>
                        </Box>
                        <Box sx={{ display: 'flex', gap: 1 }}>
                            <Chip
                                label={`${aiSystems.filter(s => s.status === 'active').length}/${aiSystems.length} 시스템 활성화`}
                                color="success"
                                size="small"
                            />
                            <Chip
                                label={`평균 성능 ${(aiSystems.reduce((sum, sys) => sum + sys.performance, 0) / aiSystems.length).toFixed(1)}%`}
                                color="primary"
                                size="small"
                            />
                        </Box>
                    </Box>
                </CardContent>
            </Card>

            {/* 메인 컨텐츠 */}
            <Box sx={{ display: 'flex', flex: 1, gap: 2 }}>
                {/* 채팅 영역 */}
                <Card sx={{ flex: 1, display: 'flex', flexDirection: 'column' }}>
                    <CardContent sx={{ flex: 1, display: 'flex', flexDirection: 'column', p: 0 }}>
                        {/* 메시지 영역 */}
                        <Box sx={{ flex: 1, overflowY: 'auto', p: 2, display: 'flex', flexDirection: 'column', gap: 2 }}>
                            {messages.map((message) => (
                                <Box
                                    key={message.id}
                                    sx={{
                                        display: 'flex',
                                        justifyContent: message.type === 'user' ? 'flex-end' : 'flex-start',
                                        mb: 2
                                    }}
                                >
                                    <Paper
                                        sx={{
                                            p: 2,
                                            maxWidth: '70%',
                                            backgroundColor: message.type === 'user' ? 'primary.main' : 'grey.100',
                                            color: message.type === 'user' ? 'white' : 'text.primary'
                                        }}
                                    >
                                        <Typography variant="body1" sx={{ whiteSpace: 'pre-line' }}>
                                            {message.content}
                                        </Typography>

                                        {message.systemInfo && (
                                            <Box sx={{ mt: 2 }}>
                                                <Typography variant="caption" color="text.secondary">
                                                    관련 시스템:
                                                </Typography>
                                                <Box sx={{ display: 'flex', flexWrap: 'wrap', gap: 1, mt: 1 }}>
                                                    {message.systemInfo.map((system) => (
                                                        <Chip
                                                            key={system.id}
                                                            label={system.name}
                                                            size="small"
                                                            onClick={() => handleSystemInfoClick(system)}
                                                            sx={{ cursor: 'pointer' }}
                                                        />
                                                    ))}
                                                </Box>
                                            </Box>
                                        )}

                                        {message.analysis && (
                                            <Box sx={{ mt: 2 }}>
                                                <Typography variant="caption" color="text.secondary">
                                                    분석 인사이트:
                                                </Typography>
                                                <List dense>
                                                    {message.analysis.insights.map((insight, index) => (
                                                        <ListItem key={index} sx={{ py: 0 }}>
                                                            <ListItemIcon sx={{ minWidth: 20 }}>
                                                                <Info fontSize="small" />
                                                            </ListItemIcon>
                                                            <ListItemText primary={insight} />
                                                        </ListItem>
                                                    ))}
                                                </List>
                                            </Box>
                                        )}

                                        <Typography variant="caption" sx={{ display: 'block', mt: 1, opacity: 0.7 }}>
                                            {message.timestamp.toLocaleTimeString()}
                                            {message.confidence && ` • 신뢰도: ${(message.confidence * 100).toFixed(0)}%`}
                                        </Typography>
                                    </Paper>
                                </Box>
                            ))}

                            {isTyping && (
                                <Box sx={{ display: 'flex', justifyContent: 'flex-start' }}>
                                    <Paper sx={{ p: 2, backgroundColor: 'grey.100' }}>
                                        <Box sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                                            <CircularProgress size={16} />
                                            <Typography variant="body2">AI가 응답을 생성하고 있습니다...</Typography>
                                        </Box>
                                    </Paper>
                                </Box>
                            )}

                            <div ref={messagesEndRef} />
                        </Box>

                        {/* 입력 영역 */}
                        <Box sx={{ p: 2, borderTop: 1, borderColor: 'divider' }}>
                            <Box sx={{ display: 'flex', gap: 1 }}>
                                <TextField
                                    fullWidth
                                    variant="outlined"
                                    placeholder="CORBU AI 시스템에 대해 무엇이든 물어보세요..."
                                    value={inputValue}
                                    onChange={(e) => setInputValue(e.target.value)}
                                    onKeyPress={handleKeyPress}
                                    multiline
                                    maxRows={3}
                                />
                                <IconButton
                                    color={isRecording ? 'error' : 'primary'}
                                    onClick={() => setIsRecording(!isRecording)}
                                >
                                    {isRecording ? <MicOff /> : <Mic />}
                                </IconButton>
                                <Button
                                    variant="contained"
                                    onClick={handleSendMessage}
                                    disabled={!inputValue.trim() || isTyping}
                                    startIcon={<Send />}
                                >
                                    전송
                                </Button>
                            </Box>
                        </Box>
                    </CardContent>
                </Card>

                {/* 시스템 정보 사이드바 */}
                <Card sx={{ width: 300, display: 'flex', flexDirection: 'column' }}>
                    <CardContent>
                        <Typography variant="h6" gutterBottom>AI 시스템 현황</Typography>
                        <Box sx={{ display: 'flex', flexDirection: 'column', gap: 1 }}>
                            {aiSystems.map((system) => (
                                <Paper
                                    key={system.id}
                                    sx={{
                                        p: 1.5,
                                        cursor: 'pointer',
                                        '&:hover': { backgroundColor: 'action.hover' }
                                    }}
                                    onClick={() => handleSystemInfoClick(system)}
                                >
                                    <Box sx={{ display: 'flex', alignItems: 'center', gap: 1, mb: 1 }}>
                                        {system.icon}
                                        <Typography variant="body2" sx={{ flex: 1 }}>
                                            {system.name}
                                        </Typography>
                                        <Chip
                                            label={system.status}
                                            size="small"
                                            color={getSystemStatusColor(system.status) as any}
                                        />
                                    </Box>
                                    <LinearProgress
                                        variant="determinate"
                                        value={system.performance}
                                        color={getPerformanceColor(system.performance) as any}
                                        sx={{ height: 4, borderRadius: 2 }}
                                    />
                                    <Typography variant="caption" color="text.secondary">
                                        성능: {system.performance}%
                                    </Typography>
                                </Paper>
                            ))}
                        </Box>
                    </CardContent>
                </Card>
            </Box>

            {/* 시스템 상세 정보 다이얼로그 */}
            <Dialog
                open={showSystemInfo}
                onClose={() => setShowSystemInfo(false)}
                maxWidth="md"
                fullWidth
            >
                <DialogTitle>
                    {selectedSystem?.name} 상세 정보
                </DialogTitle>
                <DialogContent>
                    {selectedSystem && (
                        <Box>
                            <Box sx={{ display: 'flex', alignItems: 'center', gap: 2, mb: 2 }}>
                                {selectedSystem.icon}
                                <Box>
                                    <Typography variant="h6">{selectedSystem.name}</Typography>
                                    <Typography variant="body2" color="text.secondary">
                                        {selectedSystem.description}
                                    </Typography>
                                </Box>
                            </Box>

                            <Grid container spacing={2}>
                                <Grid item xs={6}>
                                    <Card>
                                        <CardContent>
                                            <Typography variant="subtitle2" gutterBottom>성능 지표</Typography>
                                            <Box sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                                                <LinearProgress
                                                    variant="determinate"
                                                    value={selectedSystem.performance}
                                                    color={getPerformanceColor(selectedSystem.performance) as any}
                                                    sx={{ flex: 1, height: 8, borderRadius: 4 }}
                                                />
                                                <Typography variant="body2">
                                                    {selectedSystem.performance}%
                                                </Typography>
                                            </Box>
                                        </CardContent>
                                    </Card>
                                </Grid>
                                <Grid item xs={6}>
                                    <Card>
                                        <CardContent>
                                            <Typography variant="subtitle2" gutterBottom>상태</Typography>
                                            <Chip
                                                label={selectedSystem.status}
                                                color={getSystemStatusColor(selectedSystem.status) as any}
                                            />
                                        </CardContent>
                                    </Card>
                                </Grid>
                            </Grid>

                            <Card sx={{ mt: 2 }}>
                                <CardContent>
                                    <Typography variant="subtitle2" gutterBottom>주요 기능</Typography>
                                    <Box sx={{ display: 'flex', flexWrap: 'wrap', gap: 1 }}>
                                        {selectedSystem.features.map((feature, index) => (
                                            <Chip
                                                key={index}
                                                label={feature}
                                                size="small"
                                                variant="outlined"
                                            />
                                        ))}
                                    </Box>
                                </CardContent>
                            </Card>

                            <Typography variant="caption" color="text.secondary" sx={{ display: 'block', mt: 2 }}>
                                마지막 업데이트: {selectedSystem.lastUpdated}
                            </Typography>
                        </Box>
                    )}
                </DialogContent>
                <DialogActions>
                    <Button onClick={() => setShowSystemInfo(false)}>닫기</Button>
                </DialogActions>
            </Dialog>
        </Box>
    );
};

export default IntegratedConversationalAI;
