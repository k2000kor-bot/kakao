// AI 시스템 정보 인터페이스
interface AISystemInfo {
    id: string;
    name: string;
    description: string;
    status: 'active' | 'inactive' | 'error';
    performance: number;
    category: string;
    features: string[];
    lastUpdated: string;
    icon: React.ReactNode;
}

// 대화 메시지 인터페이스
interface ConversationMessage {
    id: string;
    type: 'user' | 'ai';
    content: string;
    timestamp: Date;
    systemInfo?: AISystemInfo[];
    analysis?: {
        type: string;
        data: any;
        insights: string[];
    };
    confidence?: number;
}

