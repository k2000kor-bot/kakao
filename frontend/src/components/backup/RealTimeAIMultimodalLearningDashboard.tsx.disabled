import React, { useState, useEffect } from 'react';
import {
    Box,
    Typography,
    Paper,
    Grid,
    Card,
    CardContent,
    Chip,
    LinearProgress,
    Table,
    TableBody,
    TableCell,
    TableContainer,
    TableHead,
    TableRow,
    Tabs,
    Tab,
    Button,
    Dialog,
    DialogTitle,
    DialogContent,
    DialogActions,
    IconButton,
    Alert,
    Tooltip,
    Badge,
    Avatar,
    List,
    ListItem,
    ListItemText,
    ListItemIcon
} from '@mui/material';
import {
    School,
    Visibility,
    VolumeUp,
    TextFields,
    VideoLibrary,
    Psychology,
    TrendingUp,
    Assessment,
    Lightbulb,
    Refresh,
    Fullscreen,
    FullscreenExit,
    Settings,
    PlayArrow,
    Pause,
    CheckCircle,
    Warning,
    Error,
    Info
} from '@mui/icons-material';
import { LineChart, Line, XAxis, YAxis, CartesianGrid, Tooltip as RechartsTooltip, ResponsiveContainer, BarChart, Bar, Pie, Cell, RadarChart, PolarGrid, PolarAngleAxis, PolarRadiusAxis, Radar } from 'recharts';

// Mock data for demonstration
const mockMetrics = {
    totalUsers: 156,
    activeSessions: 23,
    averageEngagement: 0.847,
    learningEffectiveness: 0.923,
    multimodalUsage: 0.678,
    patternDetectionAccuracy: 0.891,
    recommendationsGenerated: 342,
    systemHealth: 'excellent' as const
};

const mockLearningPaths = [
    {
        id: 'path-001',
        userId: 'user-001',
        currentLevel: 'intermediate',
        targetLevel: 'advanced',
        progress: 67,
        modules: [
            { id: 'mod-1', title: '시각적 학습 기초', type: 'visual', completionRate: 85 },
            { id: 'mod-2', title: '청각적 학습 심화', type: 'audio', completionRate: 72 },
            { id: 'mod-3', title: '멀티모달 통합', type: 'mixed', completionRate: 45 }
        ],
        performance: {
            accuracy: 0.89,
            speed: 0.76,
            retention: 0.82,
            engagement: 0.91
        }
    },
    {
        id: 'path-002',
        userId: 'user-002',
        currentLevel: 'beginner',
        targetLevel: 'intermediate',
        progress: 34,
        modules: [
            { id: 'mod-1', title: '시각적 학습 기초', type: 'visual', completionRate: 95 },
            { id: 'mod-4', title: '텍스트 기반 학습', type: 'textual', completionRate: 28 }
        ],
        performance: {
            accuracy: 0.73,
            speed: 0.68,
            retention: 0.75,
            engagement: 0.84
        }
    }
];

const mockPatterns = [
    {
        id: 'pattern-001',
        userId: 'user-001',
        patternType: 'visual',
        strength: 0.89,
        frequency: 45,
        effectiveness: 0.92,
        modalities: ['image', 'text']
    },
    {
        id: 'pattern-002',
        userId: 'user-001',
        patternType: 'auditory',
        strength: 0.67,
        frequency: 23,
        effectiveness: 0.78,
        modalities: ['audio', 'text']
    },
    {
        id: 'pattern-003',
        userId: 'user-002',
        patternType: 'reading',
        strength: 0.94,
        frequency: 67,
        effectiveness: 0.87,
        modalities: ['text']
    }
];

const mockRecommendations = [
    {
        id: 'rec-001',
        userId: 'user-001',
        type: 'activity',
        priority: 'high',
        title: '시각적 학습 강화',
        description: '시각적 패턴이 매우 효과적으로 작동하고 있습니다. 더 많은 이미지 기반 활동을 추천합니다.',
        modalities: ['image', 'video'],
        estimatedImpact: 0.92
    },
    {
        id: 'rec-002',
        userId: 'user-002',
        type: 'review',
        priority: 'medium',
        title: '복습 필요',
        description: '학습 정확도 향상을 위해 이전 내용을 복습해보세요.',
        modalities: ['text', 'visual'],
        estimatedImpact: 0.85
    }
];

const mockAnalyses = [
    {
        id: 'analysis-001',
        inputId: 'input-001',
        userId: 'user-001',
        analysis: {
            textAnalysis: {
                sentiment: 'positive',
                topics: ['학습', '기술'],
                complexity: 0.7,
                keywords: ['AI', '학습', '패턴']
            },
            imageAnalysis: {
                objects: ['사람', '컴퓨터', '책'],
                emotions: ['집중', '호기심'],
                colors: ['파랑', '흰색'],
                composition: '중앙집중'
            },
            crossModalInsights: ['텍스트와 이미지에서 일관된 긍정적 감정이 감지되었습니다.']
        },
        confidence: 0.89
    }
];

const COLORS = ['#8884d8', '#82ca9d', '#ffc658', '#ff7300', '#00ff00'];

const RealTimeAIMultimodalLearningDashboard: React.FC = () => {
    const [currentTab, setCurrentTab] = useState(0);
    const [isFullscreen, setIsFullscreen] = useState(false);
    const [selectedPath, setSelectedPath] = useState<any>(null);
    const [pathDialogOpen, setPathDialogOpen] = useState(false);
    const [metrics, setMetrics] = useState(mockMetrics);
    const [learningPaths, setLearningPaths] = useState(mockLearningPaths);
    const [patterns, setPatterns] = useState(mockPatterns);
    const [recommendations, setRecommendations] = useState(mockRecommendations);
    const [analyses, setAnalyses] = useState(mockAnalyses);

    useEffect(() => {
        const interval = setInterval(() => {
            // 실시간 데이터 업데이트
            setMetrics(prev => ({
                ...prev,
                activeSessions: Math.max(1, prev.activeSessions + (Math.random() > 0.5 ? 1 : -1)),
                averageEngagement: Math.min(1, Math.max(0, prev.averageEngagement + (Math.random() - 0.5) * 0.02)),
                learningEffectiveness: Math.min(1, Math.max(0, prev.learningEffectiveness + (Math.random() - 0.5) * 0.01))
            }));

            // 학습 경로 진행률 업데이트
            setLearningPaths(prev => prev.map(path => ({
                ...path,
                progress: Math.min(100, path.progress + (Math.random() > 0.8 ? Math.random() * 2 : 0))
            })));
        }, 10000);

        return () => clearInterval(interval);
    }, []);

    const handleTabChange = (event: React.SyntheticEvent, newValue: number) => {
        setCurrentTab(newValue);
    };

    const handlePathClick = (path: any) => {
        setSelectedPath(path);
        setPathDialogOpen(true);
    };

    const getHealthColor = (health: string) => {
        switch (health) {
            case 'excellent': return 'success';
            case 'good': return 'info';
            case 'warning': return 'warning';
            case 'critical': return 'error';
            default: return 'default';
        }
    };

    const getPatternTypeIcon = (type: string) => {
        switch (type) {
            case 'visual': return <Visibility />;
            case 'auditory': return <VolumeUp />;
            case 'reading': return <TextFields />;
            case 'kinesthetic': return <Psychology />;
            case 'mixed': return <VideoLibrary />;
            default: return <School />;
        }
    };

    const getPriorityColor = (priority: string) => {
        switch (priority) {
            case 'urgent': return 'error';
            case 'high': return 'warning';
            case 'medium': return 'info';
            case 'low': return 'success';
            default: return 'default';
        }
    };

    const renderOverviewTab = () => (
        <Box>
            <Grid container spacing={3}>
                {/* 시스템 상태 카드 */}
                <Grid item xs={12} md={6}>
                    <Card>
                        <CardContent>
                            <Typography variant="h6" gutterBottom>
                                시스템 상태
                            </Typography>
                            <Box display="flex" alignItems="center" gap={2} mb={2}>
                                <Chip
                                    label={metrics.systemHealth.toUpperCase()}
                                    color={getHealthColor(metrics.systemHealth)}
                                    icon={<CheckCircle />}
                                />
                                <Typography variant="body2" color="textSecondary">
                                    마지막 업데이트: {new Date().toLocaleTimeString()}
                                </Typography>
                            </Box>
                            <Grid container spacing={2}>
                                <Grid item xs={6}>
                                    <Typography variant="body2" color="textSecondary">총 사용자</Typography>
                                    <Typography variant="h4">{metrics.totalUsers}</Typography>
                                </Grid>
                                <Grid item xs={6}>
                                    <Typography variant="body2" color="textSecondary">활성 세션</Typography>
                                    <Typography variant="h4">{metrics.activeSessions}</Typography>
                                </Grid>
                                <Grid item xs={6}>
                                    <Typography variant="body2" color="textSecondary">평균 참여도</Typography>
                                    <Typography variant="h4">{(metrics.averageEngagement * 100).toFixed(1)}%</Typography>
                                </Grid>
                                <Grid item xs={6}>
                                    <Typography variant="body2" color="textSecondary">학습 효과성</Typography>
                                    <Typography variant="h4">{(metrics.learningEffectiveness * 100).toFixed(1)}%</Typography>
                                </Grid>
                            </Grid>
                        </CardContent>
                    </Card>
                </Grid>

                {/* 멀티모달 사용률 차트 */}
                <Grid item xs={12} md={6}>
                    <Card>
                        <CardContent>
                            <Typography variant="h6" gutterBottom>
                                모달리티별 사용률
                            </Typography>
                            <ResponsiveContainer width="100%" height={200}>
                                <PieChart>
                                    <Pie
                                        data={[
                                            { name: '시각적', value: 35, fill: '#8884d8' },
                                            { name: '청각적', value: 25, fill: '#82ca9d' },
                                            { name: '텍스트', value: 30, fill: '#ffc658' },
                                            { name: '멀티모달', value: 10, fill: '#ff7300' }
                                        ]}
                                        cx="50%"
                                        cy="50%"
                                        outerRadius={80}
                                        dataKey="value"
                                        label
                                    >
                                        {[0, 1, 2, 3].map((entry, index) => (
                                            <Cell key={`cell-${index}`} fill={COLORS[index % COLORS.length]} />
                                        ))}
                                    </Pie>
                                    <RechartsTooltip />
                                </PieChart>
                            </ResponsiveContainer>
                        </CardContent>
                    </Card>
                </Grid>

                {/* 학습 경로 요약 */}
                <Grid item xs={12}>
                    <Card>
                        <CardContent>
                            <Typography variant="h6" gutterBottom>
                                학습 경로 현황
                            </Typography>
                            <TableContainer>
                                <Table size="small">
                                    <TableHead>
                                        <TableRow>
                                            <TableCell>사용자 ID</TableCell>
                                            <TableCell>현재 레벨</TableCell>
                                            <TableCell>목표 레벨</TableCell>
                                            <TableCell>진행률</TableCell>
                                            <TableCell>정확도</TableCell>
                                            <TableCell>참여도</TableCell>
                                            <TableCell>상태</TableCell>
                                        </TableRow>
                                    </TableHead>
                                    <TableBody>
                                        {learningPaths.map((path) => (
                                            <TableRow key={path.id} hover onClick={() => handlePathClick(path)} style={{ cursor: 'pointer' }}>
                                                <TableCell>{path.userId}</TableCell>
                                                <TableCell>
                                                    <Chip label={path.currentLevel} size="small" color="primary" />
                                                </TableCell>
                                                <TableCell>
                                                    <Chip label={path.targetLevel} size="small" color="secondary" />
                                                </TableCell>
                                                <TableCell>
                                                    <Box display="flex" alignItems="center" gap={1}>
                                                        <LinearProgress
                                                            variant="determinate"
                                                            value={path.progress}
                                                            sx={{ width: 100, height: 6, borderRadius: 3 }}
                                                        />
                                                        <Typography variant="body2">{path.progress}%</Typography>
                                                    </Box>
                                                </TableCell>
                                                <TableCell>{(path.performance.accuracy * 100).toFixed(1)}%</TableCell>
                                                <TableCell>{(path.performance.engagement * 100).toFixed(1)}%</TableCell>
                                                <TableCell>
                                                    <Chip
                                                        label={path.progress > 80 ? '우수' : path.progress > 50 ? '양호' : '개선필요'}
                                                        color={path.progress > 80 ? 'success' : path.progress > 50 ? 'info' : 'warning'}
                                                        size="small"
                                                    />
                                                </TableCell>
                                            </TableRow>
                                        ))}
                                    </TableBody>
                                </Table>
                            </TableContainer>
                        </CardContent>
                    </Card>
                </Grid>
            </Grid>
        </Box>
    );

    const renderPatternsTab = () => (
        <Box>
            <Grid container spacing={3}>
                {patterns.map((pattern) => (
                    <Grid item xs={12} md={6} lg={4} key={pattern.id}>
                        <Card>
                            <CardContent>
                                <Box display="flex" alignItems="center" gap={2} mb={2}>
                                    {getPatternTypeIcon(pattern.patternType)}
                                    <Typography variant="h6">
                                        {pattern.patternType} 패턴
                                    </Typography>
                                </Box>

                                <Box mb={2}>
                                    <Typography variant="body2" color="textSecondary" gutterBottom>
                                        패턴 강도
                                    </Typography>
                                    <LinearProgress
                                        variant="determinate"
                                        value={pattern.strength * 100}
                                        color="primary"
                                        sx={{ height: 8, borderRadius: 4 }}
                                    />
                                    <Typography variant="body2" sx={{ mt: 0.5 }}>
                                        {(pattern.strength * 100).toFixed(1)}%
                                    </Typography>
                                </Box>

                                <Box display="flex" justifyContent="space-between" mb={1}>
                                    <Typography variant="body2" color="textSecondary">빈도</Typography>
                                    <Typography variant="body2">{pattern.frequency}회</Typography>
                                </Box>
                                <Box display="flex" justifyContent="space-between" mb={1}>
                                    <Typography variant="body2" color="textSecondary">효과성</Typography>
                                    <Typography variant="body2">{(pattern.effectiveness * 100).toFixed(1)}%</Typography>
                                </Box>
                                <Box display="flex" justifyContent="space-between">
                                    <Typography variant="body2" color="textSecondary">모달리티</Typography>
                                    <Box display="flex" gap={0.5}>
                                        {pattern.modalities.map((modality, index) => (
                                            <Chip key={index} label={modality} size="small" variant="outlined" />
                                        ))}
                                    </Box>
                                </Box>
                            </CardContent>
                        </Card>
                    </Grid>
                ))}

                {/* 패턴 분석 차트 */}
                <Grid item xs={12}>
                    <Card>
                        <CardContent>
                            <Typography variant="h6" gutterBottom>
                                패턴 효과성 분석
                            </Typography>
                            <ResponsiveContainer width="100%" height={300}>
                                <RadarChart data={patterns.map(p => ({
                                    pattern: p.patternType,
                                    strength: p.strength * 100,
                                    effectiveness: p.effectiveness * 100,
                                    frequency: Math.min(100, p.frequency)
                                }))}>
                                    <PolarGrid />
                                    <PolarAngleAxis dataKey="pattern" />
                                    <PolarRadiusAxis angle={90} domain={[0, 100]} />
                                    <Radar name="강도" dataKey="strength" stroke="#8884d8" fill="#8884d8" fillOpacity={0.6} />
                                    <Radar name="효과성" dataKey="effectiveness" stroke="#82ca9d" fill="#82ca9d" fillOpacity={0.6} />
                                    <RechartsTooltip />
                                </RadarChart>
                            </ResponsiveContainer>
                        </CardContent>
                    </Card>
                </Grid>
            </Grid>
        </Box>
    );

    const renderAnalysisTab = () => (
        <Box>
            <Grid container spacing={3}>
                {analyses.map((analysis) => (
                    <Grid item xs={12} md={6} key={analysis.id}>
                        <Card>
                            <CardContent>
                                <Typography variant="h6" gutterBottom>
                                    멀티모달 분석 결과
                                </Typography>

                                {analysis.analysis.textAnalysis && (
                                    <Box mb={2}>
                                        <Typography variant="subtitle2" gutterBottom>텍스트 분석</Typography>
                                        <Box display="flex" gap={1} mb={1}>
                                            <Chip
                                                label={`감정: ${analysis.analysis.textAnalysis.sentiment}`}
                                                color={analysis.analysis.textAnalysis.sentiment === 'positive' ? 'success' :
                                                    analysis.analysis.textAnalysis.sentiment === 'negative' ? 'error' : 'default'}
                                                size="small"
                                            />
                                            <Chip
                                                label={`복잡도: ${(analysis.analysis.textAnalysis.complexity * 100).toFixed(0)}%`}
                                                size="small"
                                            />
                                        </Box>
                                        <Typography variant="body2" color="textSecondary">
                                            주제: {analysis.analysis.textAnalysis.topics.join(', ')}
                                        </Typography>
                                        <Typography variant="body2" color="textSecondary">
                                            키워드: {analysis.analysis.textAnalysis.keywords.join(', ')}
                                        </Typography>
                                    </Box>
                                )}

                                {analysis.analysis.imageAnalysis && (
                                    <Box mb={2}>
                                        <Typography variant="subtitle2" gutterBottom>이미지 분석</Typography>
                                        <Typography variant="body2" color="textSecondary">
                                            객체: {analysis.analysis.imageAnalysis.objects.join(', ')}
                                        </Typography>
                                        <Typography variant="body2" color="textSecondary">
                                            감정: {analysis.analysis.imageAnalysis.emotions.join(', ')}
                                        </Typography>
                                        <Typography variant="body2" color="textSecondary">
                                            색상: {analysis.analysis.imageAnalysis.colors.join(', ')}
                                        </Typography>
                                    </Box>
                                )}

                                {analysis.analysis.crossModalInsights.length > 0 && (
                                    <Box>
                                        <Typography variant="subtitle2" gutterBottom>크로스모달 인사이트</Typography>
                                        {analysis.analysis.crossModalInsights.map((insight, index) => (
                                            <Alert key={index} severity="info" sx={{ mt: 1 }}>
                                                {insight}
                                            </Alert>
                                        ))}
                                    </Box>
                                )}

                                <Box display="flex" justifyContent="space-between" alignItems="center" mt={2}>
                                    <Typography variant="body2" color="textSecondary">
                                        신뢰도: {(analysis.confidence * 100).toFixed(1)}%
                                    </Typography>
                                    <LinearProgress
                                        variant="determinate"
                                        value={analysis.confidence * 100}
                                        sx={{ width: 100, height: 6, borderRadius: 3 }}
                                    />
                                </Box>
                            </CardContent>
                        </Card>
                    </Grid>
                ))}
            </Grid>
        </Box>
    );

    const renderRecommendationsTab = () => (
        <Box>
            <Grid container spacing={3}>
                {recommendations.map((rec) => (
                    <Grid item xs={12} md={6} key={rec.id}>
                        <Card>
                            <CardContent>
                                <Box display="flex" justifyContent="space-between" alignItems="center" mb={2}>
                                    <Typography variant="h6">
                                        {rec.title}
                                    </Typography>
                                    <Chip
                                        label={rec.priority}
                                        color={getPriorityColor(rec.priority)}
                                        size="small"
                                    />
                                </Box>

                                <Typography variant="body2" color="textSecondary" paragraph>
                                    {rec.description}
                                </Typography>

                                <Box display="flex" gap={1} mb={2}>
                                    <Chip label={rec.type} variant="outlined" size="small" />
                                    {rec.modalities.map((modality, index) => (
                                        <Chip key={index} label={modality} size="small" />
                                    ))}
                                </Box>

                                <Box display="flex" justifyContent="space-between" alignItems="center">
                                    <Typography variant="body2" color="textSecondary">
                                        예상 효과: {(rec.estimatedImpact * 100).toFixed(1)}%
                                    </Typography>
                                    <Button variant="contained" size="small" startIcon={<PlayArrow />}>
                                        적용
                                    </Button>
                                </Box>
                            </CardContent>
                        </Card>
                    </Grid>
                ))}
            </Grid>
        </Box>
    );

    const renderPerformanceTab = () => (
        <Box>
            <Grid container spacing={3}>
                {/* 성능 지표 카드들 */}
                <Grid item xs={12} md={3}>
                    <Card>
                        <CardContent>
                            <Typography variant="h6" gutterBottom>
                                패턴 감지 정확도
                            </Typography>
                            <Typography variant="h3" color="primary">
                                {(metrics.patternDetectionAccuracy * 100).toFixed(1)}%
                            </Typography>
                        </CardContent>
                    </Card>
                </Grid>
                <Grid item xs={12} md={3}>
                    <Card>
                        <CardContent>
                            <Typography variant="h6" gutterBottom>
                                멀티모달 사용률
                            </Typography>
                            <Typography variant="h3" color="secondary">
                                {(metrics.multimodalUsage * 100).toFixed(1)}%
                            </Typography>
                        </CardContent>
                    </Card>
                </Grid>
                <Grid item xs={12} md={3}>
                    <Card>
                        <CardContent>
                            <Typography variant="h6" gutterBottom>
                                생성된 추천
                            </Typography>
                            <Typography variant="h3" color="info">
                                {metrics.recommendationsGenerated}
                            </Typography>
                        </CardContent>
                    </Card>
                </Grid>
                <Grid item xs={12} md={3}>
                    <Card>
                        <CardContent>
                            <Typography variant="h6" gutterBottom>
                                평균 참여도
                            </Typography>
                            <Typography variant="h3" color="success">
                                {(metrics.averageEngagement * 100).toFixed(1)}%
                            </Typography>
                        </CardContent>
                    </Card>
                </Grid>

                {/* 성능 트렌드 차트 */}
                <Grid item xs={12}>
                    <Card>
                        <CardContent>
                            <Typography variant="h6" gutterBottom>
                                학습 효과성 트렌드
                            </Typography>
                            <ResponsiveContainer width="100%" height={400}>
                                <LineChart data={Array.from({ length: 20 }, (_, i) => ({
                                    time: i,
                                    effectiveness: 0.8 + Math.random() * 0.2,
                                    engagement: 0.7 + Math.random() * 0.3,
                                    accuracy: 0.75 + Math.random() * 0.25
                                }))}>
                                    <CartesianGrid strokeDasharray="3 3" />
                                    <XAxis dataKey="time" />
                                    <YAxis />
                                    <RechartsTooltip />
                                    <Line type="monotone" dataKey="effectiveness" stroke="#8884d8" name="효과성" />
                                    <Line type="monotone" dataKey="engagement" stroke="#82ca9d" name="참여도" />
                                    <Line type="monotone" dataKey="accuracy" stroke="#ffc658" name="정확도" />
                                </LineChart>
                            </ResponsiveContainer>
                        </CardContent>
                    </Card>
                </Grid>
            </Grid>
        </Box>
    );

    const renderSettingsTab = () => (
        <Box>
            <Grid container spacing={3}>
                <Grid item xs={12} md={6}>
                    <Card>
                        <CardContent>
                            <Typography variant="h6" gutterBottom>
                                시스템 설정
                            </Typography>
                            <Box display="flex" flexDirection="column" gap={2}>
                                <Button variant="contained" color="primary" startIcon={<Refresh />}>
                                    패턴 감지 재시작
                                </Button>
                                <Button variant="outlined" color="secondary" startIcon={<Assessment />}>
                                    학습 경로 최적화
                                </Button>
                                <Button variant="outlined" color="info" startIcon={<Lightbulb />}>
                                    추천 엔진 업데이트
                                </Button>
                                <Button variant="outlined" color="warning" startIcon={<Settings />}>
                                    고급 설정
                                </Button>
                            </Box>
                        </CardContent>
                    </Card>
                </Grid>

                <Grid item xs={12} md={6}>
                    <Card>
                        <CardContent>
                            <Typography variant="h6" gutterBottom>
                                시스템 상태
                            </Typography>
                            <Box display="flex" flexDirection="column" gap={2}>
                                <Alert severity="success">
                                    멀티모달 학습 시스템이 정상적으로 작동 중입니다.
                                </Alert>
                                <Alert severity="info">
                                    패턴 감지 엔진이 활성화되어 있습니다.
                                </Alert>
                                <Alert severity="warning">
                                    일부 사용자의 학습 진행률이 낮습니다.
                                </Alert>
                            </Box>
                        </CardContent>
                    </Card>
                </Grid>
            </Grid>
        </Box>
    );

    return (
        <Box sx={{ p: 3, height: '100vh', overflow: 'auto' }}>
            {/* 헤더 */}
            <Box display="flex" justifyContent="space-between" alignItems="center" mb={3}>
                <Box>
                    <Typography variant="h4" gutterBottom>
                        🎓 실시간 AI 멀티모달 학습 대시보드
                    </Typography>
                    <Typography variant="body1" color="textSecondary">
                        이미지, 텍스트, 음성 통합 학습, 실시간 패턴 감지, 적응형 학습 경로
                    </Typography>
                </Box>
                <Box display="flex" gap={1}>
                    <Tooltip title="새로고침">
                        <IconButton>
                            <Refresh />
                        </IconButton>
                    </Tooltip>
                    <Tooltip title={isFullscreen ? "전체화면 해제" : "전체화면"}>
                        <IconButton onClick={() => setIsFullscreen(!isFullscreen)}>
                            {isFullscreen ? <FullscreenExit /> : <Fullscreen />}
                        </IconButton>
                    </Tooltip>
                </Box>
            </Box>

            {/* 탭 네비게이션 */}
            <Paper sx={{ mb: 3 }}>
                <Tabs value={currentTab} onChange={handleTabChange} variant="scrollable" scrollButtons="auto">
                    <Tab icon={<Assessment />} label="개요" />
                    <Tab icon={<Psychology />} label="학습 패턴" />
                    <Tab icon={<VideoLibrary />} label="멀티모달 분석" />
                    <Tab icon={<Lightbulb />} label="추천사항" />
                    <Tab icon={<TrendingUp />} label="성능 모니터링" />
                    <Tab icon={<Settings />} label="설정" />
                </Tabs>
            </Paper>

            {/* 탭 콘텐츠 */}
            <Box>
                {currentTab === 0 && renderOverviewTab()}
                {currentTab === 1 && renderPatternsTab()}
                {currentTab === 2 && renderAnalysisTab()}
                {currentTab === 3 && renderRecommendationsTab()}
                {currentTab === 4 && renderPerformanceTab()}
                {currentTab === 5 && renderSettingsTab()}
            </Box>

            {/* 학습 경로 상세 다이얼로그 */}
            <Dialog open={pathDialogOpen} onClose={() => setPathDialogOpen(false)} maxWidth="md" fullWidth>
                <DialogTitle>
                    학습 경로 상세 정보: {selectedPath?.userId}
                </DialogTitle>
                <DialogContent>
                    {selectedPath && (
                        <Box>
                            <Grid container spacing={2}>
                                <Grid item xs={6}>
                                    <Typography variant="subtitle2">현재 레벨</Typography>
                                    <Typography variant="body2">{selectedPath.currentLevel}</Typography>
                                </Grid>
                                <Grid item xs={6}>
                                    <Typography variant="subtitle2">목표 레벨</Typography>
                                    <Typography variant="body2">{selectedPath.targetLevel}</Typography>
                                </Grid>
                                <Grid item xs={6}>
                                    <Typography variant="subtitle2">진행률</Typography>
                                    <Typography variant="body2">{selectedPath.progress}%</Typography>
                                </Grid>
                                <Grid item xs={6}>
                                    <Typography variant="subtitle2">정확도</Typography>
                                    <Typography variant="body2">{(selectedPath.performance.accuracy * 100).toFixed(1)}%</Typography>
                                </Grid>
                                <Grid item xs={12}>
                                    <Typography variant="subtitle2">학습 모듈</Typography>
                                    <List>
                                        {selectedPath.modules.map((module: any) => (
                                            <ListItem key={module.id}>
                                                <ListItemIcon>
                                                    {getPatternTypeIcon(module.type)}
                                                </ListItemIcon>
                                                <ListItemText
                                                    primary={module.title}
                                                    secondary={`완료율: ${module.completionRate}%`}
                                                />
                                            </ListItem>
                                        ))}
                                    </List>
                                </Grid>
                            </Grid>
                        </Box>
                    )}
                </DialogContent>
                <DialogActions>
                    <Button onClick={() => setPathDialogOpen(false)}>닫기</Button>
                    <Button variant="contained" color="primary">경로 최적화</Button>
                </DialogActions>
            </Dialog>
        </Box>
    );
};

export default RealTimeAIMultimodalLearningDashboard;
