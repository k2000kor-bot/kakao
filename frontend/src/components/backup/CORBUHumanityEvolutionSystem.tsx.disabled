              <Tab label="사회적 영향" />
              <Tab label="기술 발전" />
              <Tab label="미래 비전" />
            </Tabs>

            {/* 진화 단계 탭 */}
            {activeTab === 0 && (
              <Box sx={{ mt: 3 }}>
                <Typography variant="h6" gutterBottom>인류 진화 단계</Typography>
                <Grid container spacing={3}>
                  {evolutionStages.map((stage) => (
                    <Grid item xs={12} md={6} key={stage.id}>
                      <Card 
                        sx={{ 
                          cursor: 'pointer',
                          '&:hover': { bgcolor: 'action.hover' }
                        }}
                        onClick={() => handleStageClick(stage)}
                      >
                        <CardContent>
                          <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start', mb: 2 }}>
                            <Typography variant="h6" sx={{ flexGrow: 1 }}>
                              {stage.name}
                            </Typography>
                            <Chip 
                              label={getStatusLabel(stage.status)} 
                              size="small" 
                              color={getStatusColor(stage.status) as any}
                            />
                          </Box>
                          <Typography variant="body2" color="text.secondary" paragraph>
                            {stage.description}
                          </Typography>
                          <Box sx={{ mb: 2 }}>
                            <Typography variant="caption" color="text.secondary">
                              진행률: {stage.progress}%
                            </Typography>
                            <LinearProgress
                              variant="determinate"
                              value={stage.progress}
                              sx={{ height: 6, borderRadius: 3, mt: 0.5 }}
                            />
                          </Box>
                          <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                            <Typography variant="caption" color="text.secondary">
                              타임라인: {stage.timeline}
                            </Typography>
                            <Typography variant="caption" color="text.secondary">
                              수명: {stage.metrics.lifeExpectancy}년
                            </Typography>
                          </Box>
                        </CardContent>
                      </Card>
                    </Grid>
                  ))}
                </Grid>
              </Box>
            )}

            {/* 사회적 영향 탭 */}
            {activeTab === 1 && (
              <Box sx={{ mt: 3 }}>
                <Typography variant="h6" gutterBottom>AI 기술의 사회적 영향</Typography>
                <Grid container spacing={3}>
                  <Grid item xs={12} md={6}>
                    <Card>
                      <CardContent>
                        <Typography variant="h6" gutterBottom>긍정적 영향</Typography>
                        <List>
                          <ListItem>
                            <ListItemIcon>
                              <CheckCircleIcon color="success" />
                            </ListItemIcon>
                            <ListItemText primary="의료 혁신" secondary="AI 진단 및 치료로 수명 연장" />
                          </ListItem>
                          <ListItem>
                            <ListItemIcon>
                              <CheckCircleIcon color="success" />
                            </ListItemIcon>
                            <ListItemText primary="교육 혁신" secondary="개인화된 학습으로 교육 수준 향상" />
                          </ListItem>
                          <ListItem>
                            <ListItemIcon>
                              <CheckCircleIcon color="success" />
                            </ListItemIcon>
                            <ListItemText primary="노동 혁신" secondary="AI 협업으로 생산성 증대" />
                          </ListItem>
                          <ListItem>
                            <ListItemIcon>
                              <CheckCircleIcon color="success" />
                            </ListItemIcon>
                            <ListItemText primary="환경 보호" secondary="AI 기반 지속가능한 발전" />
                          </ListItem>
                        </List>
                      </CardContent>
                    </Card>
                  </Grid>
                  <Grid item xs={12} md={6}>
                    <Card>
                      <CardContent>
                        <Typography variant="h6" gutterBottom>도전 과제</Typography>
                        <List>
                          <ListItem>
                            <ListItemIcon>
                              <WarningIcon color="warning" />
                            </ListItemIcon>
                            <ListItemText primary="일자리 변화" secondary="AI로 인한 직업 구조 변화" />
                          </ListItem>
                          <ListItem>
                            <ListItemIcon>
                              <WarningIcon color="warning" />
                            </ListItemIcon>
                            <ListItemText primary="윤리적 문제" secondary="AI 윤리 및 거버넌스" />
                          </ListItem>
                          <ListItem>
                            <ListItemIcon>
                              <WarningIcon color="warning" />
                            </ListItemIcon>
                            <ListItemText primary="개인정보 보호" secondary="데이터 보안 및 프라이버시" />
                          </ListItem>
                          <ListItem>
                            <ListItemIcon>
                              <WarningIcon color="warning" />
                            </ListItemIcon>
                            <ListItemText primary="사회적 불평등" secondary="기술 격차 및 디지털 분할" />
                          </ListItem>
                        </List>
                      </CardContent>
                    </Card>
                  </Grid>
                </Grid>
              </Box>
            )}

            {/* 기술 발전 탭 */}
            {activeTab === 2 && (
              <Box sx={{ mt: 3 }}>
                <Typography variant="h6" gutterBottom>진화 기술 발전</Typography>
                <Grid container spacing={3}>
                  <Grid item xs={12} md={6}>
                    <Accordion>
                      <AccordionSummary expandIcon={<ExpandMoreIcon />}>
                        <Typography variant="h6">뇌-컴퓨터 인터페이스</Typography>
                      </AccordionSummary>
                      <AccordionDetails>
                        <Typography variant="body2" color="text.secondary" paragraph>
                          뇌와 컴퓨터의 직접적인 연결을 통한 인지 능력 증강
                        </Typography>
                        <Button variant="contained" startIcon={<ScienceIcon />}>
                          기술 연구
                        </Button>
                      </AccordionDetails>
                    </Accordion>
                  </Grid>
                  <Grid item xs={12} md={6}>
                    <Accordion>
                      <AccordionSummary expandIcon={<ExpandMoreIcon />}>
                        <Typography variant="h6">의식 업로드</Typography>
                      </AccordionSummary>
                      <AccordionDetails>
                        <Typography variant="body2" color="text.secondary" paragraph>
                          인간 의식을 디지털 형태로 보존 및 이전
                        </Typography>
                        <Button variant="contained" startIcon={<PsychologyIcon />}>
                          의식 연구
                        </Button>
                      </AccordionDetails>
                    </Accordion>
                  </Grid>
                  <Grid item xs={12} md={6}>
                    <Accordion>
                      <AccordionSummary expandIcon={<ExpandMoreIcon />}>
                        <Typography variant="h6">생체공학</Typography>
                      </AccordionSummary>
                      <AccordionDetails>
                        <Typography variant="body2" color="text.secondary" paragraph>
                          인공 장기 및 신체 부위를 통한 신체 능력 향상
                        </Typography>
                        <Button variant="contained" startIcon={<HealthIcon />}>
                          생체 연구
                        </Button>
                      </AccordionDetails>
                    </Accordion>
                  </Grid>
                  <Grid item xs={12} md={6}>
                    <Accordion>
                      <AccordionSummary expandIcon={<ExpandMoreIcon />}>
                        <Typography variant="h6">나노기술</Typography>
                      </AccordionSummary>
                      <AccordionDetails>
                        <Typography variant="body2" color="text.secondary" paragraph>
                          분자 수준의 정밀한 기술을 통한 치료 및 증강
                        </Typography>
                        <Button variant="contained" startIcon={<ScienceIcon />}>
                          나노 연구
                        </Button>
                      </AccordionDetails>
                    </Accordion>
                  </Grid>
                </Grid>
              </Box>
            )}

            {/* 미래 비전 탭 */}
            {activeTab === 3 && (
              <Box sx={{ mt: 3 }}>
                <Typography variant="h6" gutterBottom>인류의 미래 비전</Typography>
                <Grid container spacing={3}>
                  <Grid item xs={12} md={6}>
                    <Card>
                      <CardContent>
                        <Typography variant="h6" gutterBottom>2030년 비전</Typography>
                        <Typography variant="body2" color="text.secondary" paragraph>
                          AI와 인간의 완전한 융합을 통한 새로운 인류의 탄생
                        </Typography>
                        <Box sx={{ mb: 2 }}>
                          <Typography variant="body2">평균 수명: 120년</Typography>
                          <LinearProgress variant="determinate" value={85} sx={{ height: 6, borderRadius: 3 }} />
                        </Box>
                        <Box sx={{ mb: 2 }}>
                          <Typography variant="body2">교육 수준: 100%</Typography>
                          <LinearProgress variant="determinate" value={92} sx={{ height: 6, borderRadius: 3 }} />
                        </Box>
                        <Box sx={{ mb: 2 }}>
                          <Typography variant="body2">기술 도입률: 95%</Typography>
                          <LinearProgress variant="determinate" value={78} sx={{ height: 6, borderRadius: 3 }} />
                        </Box>
                        <Box>
                          <Typography variant="body2">행복 지수: 95점</Typography>
                          <LinearProgress variant="determinate" value={88} sx={{ height: 6, borderRadius: 3 }} />
                        </Box>
                      </CardContent>
                    </Card>
                  </Grid>
                  <Grid item xs={12} md={6}>
                    <Card>
                      <CardContent>
                        <Typography variant="h6" gutterBottom>2040년 비전</Typography>
                        <Typography variant="body2" color="text.secondary" paragraph>
                          우주 진출을 통한 새로운 문명의 시작
                        </Typography>
                        <Box sx={{ mb: 2 }}>
                          <Typography variant="body2">우주 정착: 100만 명</Typography>
                          <LinearProgress variant="determinate" value={10} sx={{ height: 6, borderRadius: 3 }} />
                        </Box>
                        <Box sx={{ mb: 2 }}>
                          <Typography variant="body2">행성 개조: 3개</Typography>
                          <LinearProgress variant="determinate" value={5} sx={{ height: 6, borderRadius: 3 }} />
                        </Box>
                        <Box sx={{ mb: 2 }}>
                          <Typography variant="body2">초광속 통신: 완성</Typography>
                          <LinearProgress variant="determinate" value={15} sx={{ height: 6, borderRadius: 3 }} />
                        </Box>
                        <Box>
                          <Typography variant="body2">우주 평화: 달성</Typography>
                          <LinearProgress variant="determinate" value={20} sx={{ height: 6, borderRadius: 3 }} />
                        </Box>
                      </CardContent>
                    </Card>
                  </Grid>
                </Grid>
              </Box>
            )}
          </CardContent>
        </Card>

        {/* SpeedDial */}
        <SpeedDial
          ariaLabel="인류 진화 도구"
          sx={{ position: 'fixed', bottom: 16, right: 16 }}
          icon={<SpeedDialIcon />}
        >
          {quickActions.map((action) => (
            <SpeedDialAction
              key={action.name}
              icon={action.icon}
              tooltipTitle={action.name}
              onClick={action.action}
            />
          ))}
        </SpeedDial>

        {/* 진화 단계 상세 다이얼로그 */}
        <Dialog
          open={showStageDialog}
          onClose={() => setShowStageDialog(false)}
          maxWidth="md"
          fullWidth
        >
          {selectedStage && (
            <>
              <DialogTitle>
                <Box sx={{ display: 'flex', alignItems: 'center', gap: 2 }}>
                  <Typography variant="h6">{selectedStage.name}</Typography>
                  <Chip 
                    label={getStatusLabel(selectedStage.status)} 
                    color={getStatusColor(selectedStage.status) as any}
                  />
                </Box>
              </DialogTitle>
              <DialogContent>
                <Typography variant="body1" paragraph>
                  {selectedStage.description}
                </Typography>
                
                <Typography variant="h6" gutterBottom>주요 기술:</Typography>
                <Box sx={{ mb: 2 }}>
                  {selectedStage.technologies.map((tech, index) => (
                    <Chip key={index} label={tech} sx={{ mr: 1, mb: 1 }} />
                  ))}
                </Box>

                <Typography variant="h6" gutterBottom>혜택:</Typography>
                <List dense>
                  {selectedStage.benefits.map((benefit, index) => (
                    <ListItem key={index}>
                      <ListItemIcon>
                        <CheckCircleIcon color="success" />
                      </ListItemIcon>
                      <ListItemText primary={benefit} />
                    </ListItem>
                  ))}
                </List>

                <Typography variant="h6" gutterBottom>도전 과제:</Typography>
                <List dense>
                  {selectedStage.challenges.map((challenge, index) => (
                    <ListItem key={index}>
                      <ListItemIcon>
                        <WarningIcon color="warning" />
                      </ListItemIcon>
                      <ListItemText primary={challenge} />
                    </ListItem>
                  ))}
                </List>

                <Typography variant="h6" gutterBottom>예상 지표:</Typography>
                <Grid container spacing={2}>
                  <Grid item xs={6}>
                    <Typography variant="body2">인구: {selectedStage.metrics.population.toLocaleString()}</Typography>
                  </Grid>
                  <Grid item xs={6}>
                    <Typography variant="body2">평균 수명: {selectedStage.metrics.lifeExpectancy}년</Typography>
                  </Grid>
                  <Grid item xs={6}>
                    <Typography variant="body2">교육 수준: {selectedStage.metrics.educationLevel}%</Typography>
                  </Grid>
                  <Grid item xs={6}>
                    <Typography variant="body2">기술 도입률: {selectedStage.metrics.technologyAdoption}%</Typography>
                  </Grid>
                  <Grid item xs={6}>
                    <Typography variant="body2">행복 지수: {selectedStage.metrics.happinessIndex}점</Typography>
                  </Grid>
                  <Grid item xs={6}>
                    <Typography variant="body2">지속가능성: {selectedStage.metrics.sustainabilityScore}점</Typography>
                  </Grid>
                </Grid>

                <Box sx={{ mt: 2 }}>
                  <Typography variant="body2" color="text.secondary">
                    타임라인: {selectedStage.timeline}
                  </Typography>
                  <Typography variant="body2" color="text.secondary">
                    진행률: {selectedStage.progress}%
                  </Typography>
                  <Typography variant="body2" color="text.secondary">
                    영향: {selectedStage.impact}
                  </Typography>
                </Box>
              </DialogContent>
              <DialogActions>
                <Button onClick={() => setShowStageDialog(false)}>닫기</Button>
                <Button variant="contained" onClick={() => setShowStageDialog(false)}>
                  진화 관리
                </Button>
              </DialogActions>
            </>
          )}
        </Dialog>

        {/* Snackbar */}
        <Snackbar
          open={showSnackbar}
          autoHideDuration={3000}
          onClose={() => setShowSnackbar(false)}
          message={snackbarMessage}
        />

        {/* 자식 컴포넌트 렌더링 */}
        {children}
      </Container>
    </Box>
  );
};

export default CORBUHumanityEvolutionSystem;
