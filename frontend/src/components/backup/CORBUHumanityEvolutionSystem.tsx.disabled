      benefits: ['신체적 능력 향상', '질병 예방 및 치료', '수명 연장', '인지 능력 증강'],
      challenges: ['윤리적 문제', '기술적 한계', '사회적 수용성', '개인정보 보호'],
      metrics: {
        population: 8500000000,
        lifeExpectancy: 85,
        educationLevel: 92,
        technologyAdoption: 78,
        happinessIndex: 88,
        sustainabilityScore: 85
      }
    },
    {
      id: 'consciousness-expansion',
      name: '의식 확장',
      description: 'AI를 통한 인간 의식의 확장 및 새로운 인지 능력 개발',
      status: 'planned',
      progress: 45,
      impact: '인간 의식의 새로운 차원으로의 진화',
      timeline: '2026-2028',
      technologies: ['의식 업로드', '가상 현실', '증강 현실', 'AI 의식 융합'],
      benefits: ['무한한 학습 능력', '새로운 경험', '의식 보존', '창의성 증대'],
      challenges: ['의식의 본질', '정체성 문제', '기술적 복잡성', '윤리적 딜레마'],
      metrics: {
        population: 8700000000,
        lifeExpectancy: 90,
        educationLevel: 95,
        technologyAdoption: 85,
        happinessIndex: 92,
        sustainabilityScore: 88
      }
    },
    {
      id: 'post-humanity',
      name: '포스트 휴먼',
      description: '인간을 넘어선 새로운 형태의 지적 존재로의 진화',
      status: 'planned',
      progress: 25,
      impact: '인류 문명의 새로운 단계 진입',
      timeline: '2028-2030',
      technologies: ['초지능 AI', '양자 의식', '우주 탐사', '불멸성 기술'],
      benefits: ['무한한 지능', '우주 탐사', '불멸성', '새로운 문명'],
      challenges: ['인간성 상실', '사회적 혼란', '기술적 위험', '윤리적 문제'],
      metrics: {
        population: 9000000000,
        lifeExpectancy: 120,
        educationLevel: 98,
        technologyAdoption: 95,
        happinessIndex: 95,
        sustainabilityScore: 92
      }
    },
    {
      id: 'cosmic-civilization',
      name: '우주 문명',
      description: '지구를 넘어선 우주 규모의 문명으로의 확장',
      status: 'future',
      progress: 10,
      impact: '인류의 우주 진출 및 새로운 문명 건설',
      timeline: '2030-2040',
      technologies: ['우주 정착', '행성 개조', '우주 AI 네트워크', '초광속 통신'],
      benefits: ['무한한 자원', '새로운 세계', '문명의 확장', '우주 평화'],
      challenges: ['기술적 한계', '자원 부족', '우주 환경', '외계 문명'],
      metrics: {
        population: 10000000000,
        lifeExpectancy: 150,
        educationLevel: 100,
        technologyAdoption: 100,
        happinessIndex: 98,
        sustainabilityScore: 95
      }
    }
  ];

  const humanityMetrics: HumanityMetric[] = [
    {
      name: '평균 수명',
      value: 85,
      target: 120,
      unit: '년',
      trend: 'up',
      color: 'success.main',
      description: 'AI 기술을 통한 의료 발전으로 수명 연장'
    },
    {
      name: '교육 수준',
      value: 92,
      target: 100,
      unit: '%',
      trend: 'up',
      color: 'info.main',
      description: 'AI 기반 개인화 교육으로 교육 수준 향상'
    },
    {
      name: '기술 도입률',
      value: 78,
      target: 95,
      unit: '%',
      trend: 'up',
      color: 'primary.main',
      description: 'AI 기술의 광범위한 도입 및 활용'
    },
    {
      name: '행복 지수',
      value: 88,
      target: 95,
      unit: '점',
      trend: 'up',
      color: 'warning.main',
      description: 'AI를 통한 삶의 질 향상 및 행복도 증가'
    },
    {
      name: '지속가능성',
      value: 85,
      target: 95,
      unit: '점',
      trend: 'up',
      color: 'success.main',
      description: 'AI 기반 환경 보호 및 지속가능한 발전'
    },
    {
      name: '인지 능력',
      value: 82,
      target: 100,
      unit: '점',
      trend: 'up',
      color: 'secondary.main',
      description: 'AI 보조를 통한 인지 능력 증강'
    }
  ];

  const handleStageClick = (stage: EvolutionStage) => {
    setSelectedStage(stage);
    setShowStageDialog(true);
  };

  const getStatusColor = (status: string) => {
    switch (status) {
      case 'completed': return 'success';
      case 'in-progress': return 'primary';
      case 'planned': return 'warning';
      case 'future': return 'info';
      default: return 'default';
    }
  };

  const getStatusLabel = (status: string) => {
    switch (status) {
      case 'completed': return '완료';
      case 'in-progress': return '진행 중';
      case 'planned': return '계획됨';
      case 'future': return '미래';
      default: return '알 수 없음';
    }
  };

  const quickActions = [
    {
      icon: <PsychologyIcon />, name: '진화 분석', action: () => {
        setSnackbarMessage('인류 진화 분석이 실행되었습니다.');
        setShowSnackbar(true);
      }
    },
    {
      icon: <ScienceIcon />, name: '기술 연구', action: () => {
        setSnackbarMessage('진화 기술 연구가 시작되었습니다.');
        setShowSnackbar(true);
      }
    },
    {
      icon: <GroupIcon />, name: '사회 영향', action: () => {
        setSnackbarMessage('사회적 영향 분석이 진행되었습니다.');
        setShowSnackbar(true);
      }
    },
  ];

  return (
    <Box sx={{ p: 3 }}>
      <Container maxWidth="xl">
        {/* 헤더 */}
        <Box sx={{ mb: 4, textAlign: 'center' }}>
          <Typography variant="h3" gutterBottom sx={{ display: 'flex', alignItems: 'center', justifyContent: 'center', gap: 2 }}>
            <PsychologyIcon sx={{ fontSize: 40, color: 'primary.main' }} />
            CORBU AI 인류 진화 시스템
          </Typography>
          <Typography variant="h6" color="text.secondary">
            AI 기술을 통한 인류의 진화 및 문명 발전
          </Typography>
        </Box>

        {/* 인류 지표 */}
        <Card sx={{ mb: 4 }}>
          <CardContent>
            <Typography variant="h5" gutterBottom>인류 진화 지표</Typography>
