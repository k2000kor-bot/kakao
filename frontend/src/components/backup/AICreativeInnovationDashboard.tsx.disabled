interface InnovationMetric {
    id: string;
    name: string;
    value: number;
    target: number;
    status: 'excellent' | 'good' | 'warning' | 'critical';
    trend: 'up' | 'down' | 'stable';
    lastUpdated: string;
    description: string;
}

interface CreativeProject {
    id: string;
    name: string;
    category: string;
    status: 'concept' | 'development' | 'testing' | 'launched' | 'completed';
    creativity: number;
    innovation: number;
    feasibility: number;
    lastUpdated: string;
    description: string;
    team: string[];
    milestones: string[];
}

interface IdeaGeneration {
    id: string;
    name: string;
    category: string;
    novelty: number;
    usefulness: number;
    feasibility: number;
    lastGenerated: string;
    description: string;
    tags: string[];
    applications: string[];
}

interface ProblemSolution {
    id: string;
    name: string;
    problem: string;
    solution: string;
    creativity: number;
    effectiveness: number;
    implementation: number;
    lastUpdated: string;
    status: 'proposed' | 'in-progress' | 'implemented' | 'evaluated';
    stakeholders: string[];
}

