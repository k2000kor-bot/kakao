                                    <Typography variant="h6">{metric.name}</Typography>
                                    {getTrendIcon(metric.trend)}
                                </Box>

                                <Typography variant="h4" color="primary" sx={{ mb: 1 }}>
                                    {metric.value.toFixed(1)}%
                                </Typography>

                                <Box sx={{ display: 'flex', alignItems: 'center', gap: 1, mb: 2 }}>
                                    <Chip
                                        label={metric.status.toUpperCase()}
                                        color={getStatusColor(metric.status) as any}
                                        size="small"
                                    />
                                    <Typography variant="body2" color="text.secondary">
                                        목표: {metric.target}%
                                    </Typography>
                                </Box>

                                <LinearProgress
                                    variant="determinate"
                                    value={(metric.value / metric.target) * 100}
                                    color={getStatusColor(metric.status) as any}
                                    sx={{ mb: 1 }}
                                />

                                <Typography variant="body2" color="text.secondary">
                                    {metric.description}
                                </Typography>

                                <Typography variant="caption" color="text.secondary">
                                    마지막 업데이트: {metric.lastUpdated}
                                </Typography>
                            </CardContent>
                        </Card>
                    </Grid>
                ))}
            </Grid>

            {/* 차트 섹션 */}
            <Grid container spacing={3} sx={{ mb: 3 }}>
                <Grid item xs={12} md={6}>
                    <Card>
                        <CardContent>
                            <Typography variant="h6" gutterBottom>혁신 지표 추이</Typography>
                            <Line
                                data={innovationChartData}
                                options={{
                                    responsive: true,
                                    plugins: {
                                        legend: { position: 'top' as const },
                                        title: { display: false }
                                    },
                                    scales: {
                                        y: {
                                            beginAtZero: true,
                                            max: 100
                                        }
                                    }
                                }}
                            />
                        </CardContent>
                    </Card>
                </Grid>

                <Grid item xs={12} md={6}>
                    <Card>
                        <CardContent>
                            <Typography variant="h6" gutterBottom>프로젝트 성과</Typography>
                            <Bar
                                data={projectChartData}
                                options={{
                                    responsive: true,
                                    plugins: {
                                        legend: { position: 'top' as const },
                                        title: { display: false }
                                    },
                                    scales: {
                                        y: {
                                            beginAtZero: true,
                                            max: 100
                                        }
                                    }
                                }}
                            />
                        </CardContent>
                    </Card>
                </Grid>
            </Grid>

            {/* 창조적 프로젝트 테이블 */}
            <Card sx={{ mb: 3 }}>
                <CardContent>
                    <Typography variant="h6" gutterBottom>창조적 프로젝트 관리</Typography>
                    <TableContainer component={Paper}>
                        <Table>
                            <TableHead>
                                <TableRow>
                                    <TableCell>프로젝트명</TableCell>
                                    <TableCell>카테고리</TableCell>
                                    <TableCell>상태</TableCell>
                                    <TableCell>창의성</TableCell>
                                    <TableCell>혁신성</TableCell>
                                    <TableCell>실현 가능성</TableCell>
                                    <TableCell>상세</TableCell>
                                </TableRow>
                            </TableHead>
                            <TableBody>
                                {creativeProjects.map((project) => (
                                    <TableRow key={project.id}>
                                        <TableCell>{project.name}</TableCell>
                                        <TableCell>{project.category}</TableCell>
                                        <TableCell>
                                            <Chip
                                                label={project.status.toUpperCase()}
                                                color={getProjectStatusColor(project.status) as any}
                                                size="small"
                                            />
                                        </TableCell>
                                        <TableCell>{project.creativity}%</TableCell>
                                        <TableCell>{project.innovation}%</TableCell>
                                        <TableCell>{project.feasibility}%</TableCell>
                                        <TableCell>
                                            <Button
                                                size="small"
                                                onClick={() => handleProjectDetails(project.id)}
                                            >
                                                상세보기
                                            </Button>
                                        </TableCell>
                                    </TableRow>
                                ))}
                            </TableBody>
                        </Table>
                    </TableContainer>
                </CardContent>
            </Card>

            {/* 아이디어 생성 */}
            <Grid container spacing={3} sx={{ mb: 3 }}>
                <Grid item xs={12} md={8}>
                    <Card>
                        <CardContent>
                            <Typography variant="h6" gutterBottom>아이디어 생성 결과</Typography>
                            <TableContainer component={Paper}>
                                <Table>
                                    <TableHead>
                                        <TableRow>
                                            <TableCell>아이디어명</TableCell>
                                            <TableCell>카테고리</TableCell>
                                            <TableCell>새로움</TableCell>
                                            <TableCell>유용성</TableCell>
                                            <TableCell>실현 가능성</TableCell>
                                            <TableCell>생성일</TableCell>
                                        </TableRow>
                                    </TableHead>
                                    <TableBody>
                                        {ideaGenerations.map((idea) => (
                                            <TableRow key={idea.id}>
                                                <TableCell>{idea.name}</TableCell>
                                                <TableCell>{idea.category}</TableCell>
                                                <TableCell>{idea.novelty}%</TableCell>
                                                <TableCell>{idea.usefulness}%</TableCell>
                                                <TableCell>{idea.feasibility}%</TableCell>
                                                <TableCell>{idea.lastGenerated}</TableCell>
                                            </TableRow>
                                        ))}
                                    </TableBody>
                                </Table>
                            </TableContainer>
                        </CardContent>
                    </Card>
                </Grid>

                <Grid item xs={12} md={4}>
                    <Card>
                        <CardContent>
                            <Typography variant="h6" gutterBottom>아이디어 품질</Typography>
                            <Doughnut
                                data={ideaChartData}
                                options={{
                                    responsive: true,
                                    plugins: {
                                        legend: { position: 'bottom' as const },
                                        title: { display: false }
                                    }
                                }}
                            />
                        </CardContent>
                    </Card>
                </Grid>
            </Grid>

            {/* 문제 해결 */}
            <Card sx={{ mb: 3 }}>
                <CardContent>
                    <Typography variant="h6" gutterBottom>창조적 문제 해결</Typography>
                    <TableContainer component={Paper}>
                        <Table>
                            <TableHead>
                                <TableRow>
                                    <TableCell>문제명</TableCell>
                                    <TableCell>창의성</TableCell>
                                    <TableCell>효과성</TableCell>
                                    <TableCell>구현도</TableCell>
                                    <TableCell>상태</TableCell>
                                    <TableCell>마지막 업데이트</TableCell>
                                </TableRow>
                            </TableHead>
                            <TableBody>
                                {problemSolutions.map((solution) => (
                                    <TableRow key={solution.id}>
                                        <TableCell>{solution.name}</TableCell>
                                        <TableCell>{solution.creativity}%</TableCell>
                                        <TableCell>{solution.effectiveness}%</TableCell>
                                        <TableCell>{solution.implementation}%</TableCell>
                                        <TableCell>
                                            <Chip
                                                label={solution.status.toUpperCase()}
                                                color={getSolutionStatusColor(solution.status) as any}
                                                size="small"
                                            />
                                        </TableCell>
                                        <TableCell>{solution.lastUpdated}</TableCell>
                                    </TableRow>
                                ))}
                            </TableBody>
                        </Table>
                    </TableContainer>
                </CardContent>
            </Card>

            {/* 프로젝트 상세 다이얼로그 */}
            <Dialog
                open={projectDialogOpen}
                onClose={() => setProjectDialogOpen(false)}
                maxWidth="md"
                fullWidth
            >
                <DialogTitle>
                    프로젝트 상세 정보
                </DialogTitle>
                <DialogContent>
                    {selectedProject && (
                        <Box>
                            <Typography variant="h6" gutterBottom>
                                {creativeProjects.find(project => project.id === selectedProject)?.name}
                            </Typography>
                            <Typography variant="body1" paragraph>
                                {creativeProjects.find(project => project.id === selectedProject)?.description}
                            </Typography>

                            <Accordion>
                                <AccordionSummary expandIcon={<ExpandMore />}>
                                    <Typography>팀 구성</Typography>
                                </AccordionSummary>
                                <AccordionDetails>
                                    <List>
                                        {creativeProjects.find(project => project.id === selectedProject)?.team.map((member, index) => (
                                            <ListItem key={index}>
                                                <ListItemIcon>
                                                    <Person color="primary" />
                                                </ListItemIcon>
                                                <ListItemText primary={member} />
                                            </ListItem>
                                        ))}
                                    </List>
                                </AccordionDetails>
                            </Accordion>

                            <Accordion>
                                <AccordionSummary expandIcon={<ExpandMore />}>
                                    <Typography>마일스톤</Typography>
                                </AccordionSummary>
                                <AccordionDetails>
                                    <List>
                                        {creativeProjects.find(project => project.id === selectedProject)?.milestones.map((milestone, index) => (
                                            <ListItem key={index}>
                                                <ListItemIcon>
                                                    <Check color="primary" />
                                                </ListItemIcon>
                                                <ListItemText primary={milestone} />
                                            </ListItem>
                                        ))}
                                    </List>
                                </AccordionDetails>
                            </Accordion>
                        </Box>
                    )}
                </DialogContent>
                <DialogActions>
                    <Button onClick={() => setProjectDialogOpen(false)}>닫기</Button>
                </DialogActions>
            </Dialog>

            {/* 플로팅 액션 버튼 */}
            <Fab
                color="primary"
                aria-label="새 아이디어 생성"
                sx={{ position: 'fixed', bottom: 16, right: 16 }}
            >
                <Add />
            </Fab>
        </Box>
    );
};

export default AICreativeInnovationDashboard;
