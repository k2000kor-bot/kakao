import React, { useState, useEffect } from 'react';
import {
    Box,
    Card,
    CardContent,
    Typography,
    Grid,
    Chip,
    Button,
    IconButton,
    Tooltip,
    LinearProgress,
    Avatar,
    Dialog,
    DialogTitle,
    DialogContent,
    DialogActions,
    TextField,
    Select,
    MenuItem,
    FormControl,
    InputLabel,
    useTheme,
    alpha
} from '@mui/material';
import {
    Analytics,
    TrendingUp,
    TrendingDown,
    Speed,
    Psychology,
    AutoAwesome,
    Timeline,
    Assessment,
    Insights,
    DataUsage,
    BarChart,
    BubbleChart,
    ScatterPlot,
    Timeline as TimelineIcon,
    Refresh,
    Download,
    Share,
    Settings,
    Warning,
    CheckCircle,
    Error
} from '@mui/icons-material';
import { Line, Bar, Doughnut, Radar } from 'react-chartjs-2';

interface AIMetric {
    id: string;
    name: string;
    value: number;
    target: number;
    trend: 'up' | 'down' | 'stable';
    status: 'excellent' | 'good' | 'warning' | 'critical';
    description: string;
    lastUpdated: Date;
}

interface AIAnalysis {
    id: string;
    type: 'sentiment' | 'intent' | 'quality' | 'performance';
    data: any;
    confidence: number;
    insights: string[];
    recommendations: string[];
}

const AdvancedAIAnalyticsDashboard: React.FC = () => {
    const theme = useTheme();
    const [selectedMetric, setSelectedMetric] = useState<AIMetric | null>(null);
    const [showAnalysisDialog, setShowAnalysisDialog] = useState(false);
    const [timeRange, setTimeRange] = useState<'1h' | '24h' | '7d' | '30d'>('24h');

    // AI 메트릭 데이터
    const [aiMetrics, setAiMetrics] = useState<AIMetric[]>([
        {
            id: 'response-quality',
            name: 'AI 응답 품질',
            value: 94.2,
            target: 90,
            trend: 'up',
            status: 'excellent',
            description: 'AI 응답의 정확성과 유용성',
            lastUpdated: new Date()
        },
        {
            id: 'processing-speed',
            name: '처리 속도',
            value: 1.2,
            target: 2.0,
            trend: 'up',
            status: 'excellent',
            description: '평균 응답 처리 시간 (초)',
            lastUpdated: new Date()
        },
        {
            id: 'user-satisfaction',
            name: '사용자 만족도',
            value: 87.5,
            target: 85,
            trend: 'up',
            status: 'good',
            description: '사용자 피드백 기반 만족도',
            lastUpdated: new Date()
        },
        {
            id: 'model-accuracy',
            name: '모델 정확도',
            value: 91.8,
            target: 90,
            trend: 'stable',
            status: 'good',
            description: 'AI 모델의 예측 정확도',
            lastUpdated: new Date()
        },
        {
            id: 'conversation-flow',
            name: '대화 흐름',
            value: 82.3,
            target: 80,
            trend: 'up',
            status: 'good',
            description: '자연스러운 대화 진행률',
            lastUpdated: new Date()
        },
        {
            id: 'error-rate',
            name: '오류율',
            value: 2.1,
            target: 5.0,
            trend: 'down',
            status: 'excellent',
            description: '시스템 오류 발생률 (%)',
            lastUpdated: new Date()
        }
    ]);

    // 차트 데이터
    const [chartData, setChartData] = useState({
        performance: {
            labels: ['00:00', '04:00', '08:00', '12:00', '16:00', '20:00'],
            datasets: [{
                label: 'AI 성능',
                data: [85, 88, 92, 94, 91, 89],
                borderColor: theme.palette.primary.main,
                backgroundColor: alpha(theme.palette.primary.main, 0.1),
                tension: 0.4
            }]
        },
        usage: {
            labels: ['일반', '비즈니스', '기술', '창의적'],
            datasets: [{
                data: [35, 25, 20, 20],
                backgroundColor: [
                    theme.palette.primary.main,
                    theme.palette.secondary.main,
                    theme.palette.success.main,
                    theme.palette.warning.main
                ]
            }]
        },
        quality: {
            labels: ['Ultimate', 'Enhanced', 'Standard'],
            datasets: [{
                label: '품질 점수',
                data: [96, 88, 75],
                backgroundColor: [
                    theme.palette.success.main,
                    theme.palette.primary.main,
                    theme.palette.warning.main
                ]
            }]
        }
    });

    // 상태 색상 함수
    const getStatusColor = (status: string) => {
        switch (status) {
            case 'excellent':
                return 'success';
            case 'good':
                return 'primary';
            case 'warning':
                return 'warning';
            case 'critical':
                return 'error';
            default:
                return 'default';
        }
    };

    // 트렌드 아이콘 함수
    const getTrendIcon = (trend: string) => {
        switch (trend) {
            case 'up':
                return <TrendingUp color="success" />;
            case 'down':
                return <TrendingDown color="error" />;
            default:
                return <TimelineIcon color="action" />;
        }
    };

    // 실시간 데이터 업데이트
    useEffect(() => {
        const interval = setInterval(() => {
            setAiMetrics(prev => prev.map(metric => ({
                ...metric,
                value: Math.max(0, Math.min(100, metric.value + (Math.random() - 0.5) * 2)),
                lastUpdated: new Date()
            })));
        }, 30000); // 30초마다 업데이트

        return () => clearInterval(interval);
    }, []);

    return (
        <Box sx={{ p: 3 }}>
            {/* 헤더 */}
            <Box sx={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', mb: 3 }}>
                <Box>
                    <Typography variant="h4" component="h1" gutterBottom>
                        🤖 고급 AI 분석 대시보드
                    </Typography>
                    <Typography variant="body1" color="text.secondary">
                        AI 시스템 성능 및 품질 실시간 모니터링
                    </Typography>
                </Box>
                <Box sx={{ display: 'flex', gap: 2 }}>
                    <FormControl size="small">
                        <Select
                            value={timeRange}
                            onChange={(e) => setTimeRange(e.target.value as any)}
                            sx={{ minWidth: 120 }}
                        >
                            <MenuItem value="1h">1시간</MenuItem>
                            <MenuItem value="24h">24시간</MenuItem>
                            <MenuItem value="7d">7일</MenuItem>
                            <MenuItem value="30d">30일</MenuItem>
                        </Select>
                    </FormControl>
                    <Button
                        variant="outlined"
                        startIcon={<Refresh />}
                        onClick={() => window.location.reload()}
                    >
                        새로고침
                    </Button>
                </Box>
            </Box>

            {/* AI 메트릭 카드 */}
            <Box sx={{ display: 'grid', gridTemplateColumns: { xs: '1fr', sm: '1fr 1fr', md: '1fr 1fr 1fr' }, gap: 3, mb: 4 }}>
                {aiMetrics.map((metric) => (
                    <Box key={metric.id}>
                        <Card sx={{
                            height: '100%',
                            background: `linear-gradient(135deg, ${alpha(theme.palette.primary.main, 0.1)}, ${alpha(theme.palette.secondary.main, 0.1)})`,
                            '&:hover': {
                                transform: 'translateY(-2px)',
                                transition: 'transform 0.2s ease-in-out'
                            }
                        }}>
                            <CardContent>
                                <Box sx={{ display: 'flex', alignItems: 'center', mb: 2 }}>
                                    <Avatar sx={{
                                        bgcolor: getStatusColor(metric.status) === 'success' ? 'success.main' :
                                            getStatusColor(metric.status) === 'primary' ? 'primary.main' : 'warning.main',
                                        mr: 2
                                    }}>
                                        <Analytics />
                                    </Avatar>
                                    <Box sx={{ flex: 1 }}>
                                        <Typography variant="h6" component="h3">
                                            {metric.name}
                                        </Typography>
                                        <Typography variant="caption" color="text.secondary">
                                            {metric.description}
                                        </Typography>
                                    </Box>
                                    {getTrendIcon(metric.trend)}
                                </Box>

                                <Typography variant="h3" component="div" sx={{ mb: 1, fontWeight: 'bold' }}>
                                    {metric.value.toFixed(1)}
                                    {metric.id === 'processing-speed' ? 's' : '%'}
                                </Typography>

                                <LinearProgress
                                    variant="determinate"
                                    value={(metric.value / metric.target) * 100}
                                    color={getStatusColor(metric.status) as any}
                                    sx={{ mb: 1, height: 8, borderRadius: 4 }}
                                />

                                <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                                    <Chip
                                        label={metric.status}
                                        color={getStatusColor(metric.status) as any}
                                        size="small"
                                    />
                                    <Typography variant="caption" color="text.secondary">
                                        목표: {metric.target}
                                        {metric.id === 'processing-speed' ? 's' : '%'}
                                    </Typography>
                                </Box>
                            </CardContent>
                        </Card>
                    </Box>
                ))}
            </Box>

            {/* 차트 섹션 */}
            <Box sx={{ display: 'grid', gridTemplateColumns: { xs: '1fr', md: '2fr 1fr' }, gap: 3 }}>
                {/* 성능 트렌드 */}
                <Box>
                    <Card>
                        <CardContent>
                            <Box sx={{ display: 'flex', alignItems: 'center', mb: 2 }}>
                                <Assessment sx={{ mr: 1, color: 'primary.main' }} />
                                <Typography variant="h6" component="h3">
                                    AI 성능 트렌드
                                </Typography>
                            </Box>
                            <Line
                                data={chartData.performance}
                                options={{
                                    responsive: true,
                                    plugins: {
                                        legend: { display: false },
                                        tooltip: { mode: 'index', intersect: false }
                                    },
                                    scales: {
                                        y: { beginAtZero: true, max: 100 }
                                    }
                                }}
                            />
                        </CardContent>
                    </Card>
                </Box>

                {/* 사용 패턴 */}
                <Box>
                    <Card>
                        <CardContent>
                            <Box sx={{ display: 'flex', alignItems: 'center', mb: 2 }}>
                                <BubbleChart sx={{ mr: 1, color: 'primary.main' }} />
                                <Typography variant="h6" component="h3">
                                    사용 패턴
                                </Typography>
                            </Box>
                            <Doughnut
                                data={chartData.usage}
                                options={{
                                    responsive: true,
                                    plugins: {
                                        legend: { position: 'bottom' }
                                    }
                                }}
                            />
                        </CardContent>
                    </Card>
                </Box>

                {/* 품질 분석 */}
                <Box>
                    <Card>
                        <CardContent>
                            <Box sx={{ display: 'flex', alignItems: 'center', mb: 2 }}>
                                <Assessment sx={{ mr: 1, color: 'primary.main' }} />
                                <Typography variant="h6" component="h3">
                                    품질별 성능
                                </Typography>
                            </Box>
                            <Bar
                                data={chartData.quality}
                                options={{
                                    responsive: true,
                                    plugins: {
                                        legend: { display: false }
                                    },
                                    scales: {
                                        y: { beginAtZero: true, max: 100 }
                                    }
                                }}
                            />
                        </CardContent>
                    </Card>
                </Box>

                {/* AI 인사이트 */}
                <Box>
                    <Card>
                        <CardContent>
                            <Box sx={{ display: 'flex', alignItems: 'center', mb: 2 }}>
                                <Insights sx={{ mr: 1, color: 'primary.main' }} />
                                <Typography variant="h6" component="h3">
                                    AI 인사이트
                                </Typography>
                            </Box>
                            <Box sx={{ space: 2 }}>
                                <Box sx={{ display: 'flex', alignItems: 'center', mb: 2 }}>
                                    <CheckCircle sx={{ mr: 1, color: 'success.main' }} />
                                    <Typography variant="body2">
                                        응답 품질이 목표치를 4.2% 상회하고 있습니다
                                    </Typography>
                                </Box>
                                <Box sx={{ display: 'flex', alignItems: 'center', mb: 2 }}>
                                    <TrendingUp sx={{ mr: 1, color: 'primary.main' }} />
                                    <Typography variant="body2">
                                        처리 속도가 지난 주 대비 15% 향상되었습니다
                                    </Typography>
                                </Box>
                                <Box sx={{ display: 'flex', alignItems: 'center', mb: 2 }}>
                                    <Warning sx={{ mr: 1, color: 'warning.main' }} />
                                    <Typography variant="body2">
                                        비즈니스 모드 사용률이 증가하고 있습니다
                                    </Typography>
                                </Box>
                                <Box sx={{ display: 'flex', alignItems: 'center' }}>
                                    <AutoAwesome sx={{ mr: 1, color: 'secondary.main' }} />
                                    <Typography variant="body2">
                                        Ultimate 모드의 정확도가 96%로 최고치를 기록했습니다
                                    </Typography>
                                </Box>
                            </Box>
                        </CardContent>
                    </Card>
                </Box>
            </Box>

            {/* 빠른 액션 버튼 */}
            <Box sx={{ mt: 4, display: 'flex', gap: 2, flexWrap: 'wrap' }}>
                <Button
                    variant="contained"
                    startIcon={<Download />}
                    sx={{
                        background: 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)',
                        '&:hover': { background: 'linear-gradient(135deg, #5a6fd8 0%, #6a4190 100%)' }
                    }}
                >
                    분석 리포트 다운로드
                </Button>
                <Button
                    variant="outlined"
                    startIcon={<Share />}
                >
                    팀과 공유
                </Button>
                <Button
                    variant="outlined"
                    startIcon={<Settings />}
                >
                    분석 설정
                </Button>
            </Box>
        </Box>
    );
};

export default AdvancedAIAnalyticsDashboard;
