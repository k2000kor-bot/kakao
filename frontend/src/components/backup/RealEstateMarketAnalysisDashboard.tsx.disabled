import React, { useState, useEffect } from 'react';
import {
    Box,
    Card,
    CardContent,
    Typography,
    Grid,
    Chip,
    Button,
    Dialog,
    DialogTitle,
    DialogContent,
    DialogActions,
    List,
    ListItem,
    ListItemText,
    ListItemIcon,
    IconButton,
    Tooltip,
    LinearProgress,
    Paper,
    Table,
    TableBody,
    TableCell,
    TableContainer,
    TableHead,
    TableRow,
    Switch,
    FormControlLabel,
    Accordion,
    AccordionSummary,
    AccordionDetails,
    Badge,
    Alert,
    TextField,
    InputAdornment,
    Tabs,
    Tab,
    Divider,
    CircularProgress,
    Avatar,
    Rating,
    CardHeader,
    CardActions
} from '@mui/material';
import {
    TrendingUp,
    TrendingDown,
    TrendingFlat,
    Home,
    Business,
    Assessment,
    Analytics,
    Visibility,
    ExpandMore,
    PlayArrow,
    Stop,
    Pause,
    Refresh,
    Settings,
    AutoFixHigh,
    SmartToy,
    Article,
    Timeline,
    LineChart,
    FilterList,
    Search,
    Add,
    Edit,
    Delete,
    Share,
    Download,
    Upload,
    Notifications,
    Info,
    Help,
    Book,
    School,
    Work,
    LocationOn,
    AttachMoney,
    Timeline as TimelineIcon,
    TrendingUp as TrendingUpIcon,
    TrendingDown as TrendingDownIcon,
    TrendingFlat as TrendingFlatIcon,
    Fullscreen,
    FullscreenExit,
    Star,
    StarBorder,
    StarHalf,
    ThumbUp,
    ThumbDown,
    ThumbUpOutlined,
    ThumbDownOutlined,
    Report,
    BugReport,
    BuildCircle,
    Architecture,
    DesignServices,
    Engineering as EngineeringIcon,
    Construction as ConstructionIcon,
    HomeRepairService as HomeRepairIcon,
    Handyman as HandymanIcon,
    Plumbing as PlumbingIcon,
    ElectricalServices as ElectricalIcon,
    CleaningServices as CleaningIcon,
    Security as SecurityIcon,
    LocalHospital as HospitalIcon,
    School as SchoolIcon2,
    ShoppingCart as ShoppingIcon,
    Restaurant as RestaurantIcon,
    LocalGroceryStore as GroceryIcon,
    DirectionsBus as BusIcon,
    DirectionsSubway as SubwayIcon,
    DirectionsCar as CarIcon,
    LocalTaxi as TaxiIcon,
    BikeScooter as BikeIcon,
    DirectionsWalk as WalkIcon,
    Warning
} from '@mui/icons-material';

interface MarketData {
    id: string;
    region: string;
    propertyType: 'apartment' | 'villa' | 'officetel' | 'house' | 'commercial';
    transactionType: 'sale' | 'rent' | 'jeonse';
    price: number;
    area: number;
    rooms: number;
    bathrooms: number;
    floor: number;
    totalFloors: number;
    yearBuilt: number;
    transactionDate: Date;
    pricePerSquareMeter: number;
    marketTrend: 'rising' | 'falling' | 'stable';
    priceChange: number;
    priceChangePercent: number;
}

interface PolicyChange {
    id: string;
    title: string;
    description: string;
    category: 'tax' | 'loan' | 'regulation' | 'subsidy' | 'development';
    impact: 'positive' | 'negative' | 'neutral';
    severity: 'high' | 'medium' | 'low';
    effectiveDate: Date;
    affectedRegions: string[];
    affectedPropertyTypes: string[];
    marketImpact: {
        priceImpact: number;
        volumeImpact: number;
        demandImpact: number;
    };
    status: 'proposed' | 'approved' | 'implemented' | 'expired';
}

interface InvestmentAnalysis {
    id: string;
    region: string;
    propertyType: string;
    investmentType: 'buy' | 'rent' | 'develop' | 'flip';
    expectedReturn: number;
    riskLevel: 'low' | 'medium' | 'high';
    investmentHorizon: 'short' | 'medium' | 'long';
    analysis: {
        marketGrowth: number;
        rentalYield: number;
        capitalGain: number;
        liquidity: number;
        riskFactors: string[];
        opportunities: string[];
    };
    recommendation: 'strong_buy' | 'buy' | 'hold' | 'sell' | 'strong_sell';
    confidence: number;
}

interface MarketTrend {
    region: string;
    period: string;
    averagePrice: number;
    priceChange: number;
    volumeChange: number;
    daysOnMarket: number;
    supplyDemandRatio: number;
    marketSentiment: 'bullish' | 'bearish' | 'neutral';
}

const RealEstateMarketAnalysisDashboard: React.FC = () => {
    const [marketData, setMarketData] = useState<MarketData[]>([]);
    const [policyChanges, setPolicyChanges] = useState<PolicyChange[]>([]);
    const [investmentAnalyses, setInvestmentAnalyses] = useState<InvestmentAnalysis[]>([]);
    const [marketTrends, setMarketTrends] = useState<MarketTrend[]>([]);
    const [selectedTab, setSelectedTab] = useState(0);
    const [fullscreen, setFullscreen] = useState(false);
    const [autoRefresh, setAutoRefresh] = useState(true);
    const [selectedAnalysis, setSelectedAnalysis] = useState<InvestmentAnalysis | null>(null);
    const [analysisDialogOpen, setAnalysisDialogOpen] = useState(false);
    const [lastUpdate, setLastUpdate] = useState(new Date());

    // 탭 정의
    const tabs = [
        { label: '시장 개요', icon: <Home /> },
        { label: '시세 분석', icon: <Assessment /> },
        { label: '정책 변화', icon: <Article /> },
        { label: '투자 분석', icon: <Assessment /> },
        { label: '트렌드 분석', icon: <Timeline /> },
        { label: '예측 모델', icon: <Analytics /> },
        { label: '설정', icon: <Settings /> }
    ];

    // 데이터 새로고침
    const refreshData = async () => {
        try {
            // 실제로는 API 호출
            const mockMarketData: MarketData[] = [
                {
                    id: 'data-1',
                    region: '강남구',
                    propertyType: 'apartment',
                    transactionType: 'sale',
                    price: 1500000000,
                    area: 84.5,
                    rooms: 3,
                    bathrooms: 2,
                    floor: 15,
                    totalFloors: 25,
                    yearBuilt: 2015,
                    transactionDate: new Date(Date.now() - 86400000),
                    pricePerSquareMeter: 17751479,
                    marketTrend: 'rising',
                    priceChange: 50000000,
                    priceChangePercent: 3.4
                },
                {
                    id: 'data-2',
                    region: '서초구',
                    propertyType: 'apartment',
                    transactionType: 'rent',
                    price: 50000000,
                    area: 59.5,
                    rooms: 2,
                    bathrooms: 1,
                    floor: 8,
                    totalFloors: 20,
                    yearBuilt: 2018,
                    transactionDate: new Date(Date.now() - 172800000),
                    pricePerSquareMeter: 840336,
                    marketTrend: 'stable',
                    priceChange: 0,
                    priceChangePercent: 0
                }
            ];

            const mockPolicyChanges: PolicyChange[] = [
                {
                    id: 'policy-1',
                    title: '부동산 투기억제를 위한 종합대책',
                    description: '투기지역 지정 및 규제 강화, 양도소득세 인상 등',
                    category: 'regulation',
                    impact: 'negative',
                    severity: 'high',
                    effectiveDate: new Date('2024-01-01'),
                    affectedRegions: ['강남구', '서초구', '송파구'],
                    affectedPropertyTypes: ['apartment', 'villa'],
                    marketImpact: {
                        priceImpact: -5.2,
                        volumeImpact: -15.8,
                        demandImpact: -8.5
                    },
                    status: 'implemented'
                },
                {
                    id: 'policy-2',
                    title: '청년주택구입자금 지원 확대',
                    description: '청년층 주택구입자금 지원 한도 상향 및 지원 대상 확대',
                    category: 'subsidy',
                    impact: 'positive',
                    severity: 'medium',
                    effectiveDate: new Date('2024-03-01'),
                    affectedRegions: ['전국'],
                    affectedPropertyTypes: ['apartment', 'villa', 'officetel'],
                    marketImpact: {
                        priceImpact: 2.1,
                        volumeImpact: 8.5,
                        demandImpact: 12.3
                    },
                    status: 'implemented'
                }
            ];

            const mockInvestmentAnalyses: InvestmentAnalysis[] = [
                {
                    id: 'analysis-1',
                    region: '강남구',
                    propertyType: 'apartment',
                    investmentType: 'buy',
                    expectedReturn: 8.5,
                    riskLevel: 'medium',
                    investmentHorizon: 'long',
                    analysis: {
                        marketGrowth: 4.2,
                        rentalYield: 3.8,
                        capitalGain: 5.2,
                        liquidity: 7.5,
                        riskFactors: ['정책 리스크', '금리 상승 리스크'],
                        opportunities: ['교통 인프라 개선', '상권 발전']
                    },
                    recommendation: 'buy',
                    confidence: 0.75
                },
                {
                    id: 'analysis-2',
                    region: '서초구',
                    propertyType: 'officetel',
                    investmentType: 'rent',
                    expectedReturn: 6.2,
                    riskLevel: 'low',
                    investmentHorizon: 'medium',
                    analysis: {
                        marketGrowth: 3.1,
                        rentalYield: 5.8,
                        capitalGain: 2.5,
                        liquidity: 6.2,
                        riskFactors: ['공급 과잉'],
                        opportunities: ['원룸 수요 증가']
                    },
                    recommendation: 'hold',
                    confidence: 0.68
                }
            ];

            const mockMarketTrends: MarketTrend[] = [
                {
                    region: '강남구',
                    period: '2024 Q1',
                    averagePrice: 1800000000,
                    priceChange: 3.2,
                    volumeChange: -8.5,
                    daysOnMarket: 45,
                    supplyDemandRatio: 1.2,
                    marketSentiment: 'neutral'
                },
                {
                    region: '서초구',
                    period: '2024 Q1',
                    averagePrice: 1650000000,
                    priceChange: 2.8,
                    volumeChange: -5.2,
                    daysOnMarket: 38,
                    supplyDemandRatio: 1.1,
                    marketSentiment: 'bullish'
                }
            ];

            setMarketData(mockMarketData);
            setPolicyChanges(mockPolicyChanges);
            setInvestmentAnalyses(mockInvestmentAnalyses);
            setMarketTrends(mockMarketTrends);
            setLastUpdate(new Date());
        } catch (error) {
            console.error('데이터 새로고침 오류:', error);
        }
    };

    useEffect(() => {
        refreshData();

        if (autoRefresh) {
            const interval = setInterval(refreshData, 30000); // 30초마다 새로고침
            return () => clearInterval(interval);
        }
    }, [autoRefresh]);

    const getTrendIcon = (trend: string) => {
        switch (trend) {
            case 'rising': return <TrendingUpIcon color="success" />;
            case 'falling': return <TrendingDownIcon color="error" />;
            case 'stable': return <TrendingFlatIcon color="warning" />;
            default: return <TrendingFlatIcon />;
        }
    };

    const getImpactColor = (impact: string) => {
        switch (impact) {
            case 'positive': return 'success';
            case 'negative': return 'error';
            case 'neutral': return 'warning';
            default: return 'default';
        }
    };

    const getRiskColor = (risk: string) => {
        switch (risk) {
            case 'low': return 'success';
            case 'medium': return 'warning';
            case 'high': return 'error';
            default: return 'default';
        }
    };

    const getRecommendationColor = (recommendation: string) => {
        switch (recommendation) {
            case 'strong_buy': return 'success';
            case 'buy': return 'success';
            case 'hold': return 'warning';
            case 'sell': return 'error';
            case 'strong_sell': return 'error';
            default: return 'default';
        }
    };

    const renderMarketOverview = () => (
        <Grid container spacing={3}>
            <Grid item xs={12} md={3}>
                <Card>
                    <CardContent>
                        <Box display="flex" alignItems="center" mb={2}>
                            <Home color="primary" sx={{ mr: 1 }} />
                            <Typography variant="h6">평균 매매가</Typography>
                        </Box>
                        <Typography variant="h4" color="primary">18억원</Typography>
                        <Typography variant="body2" color="textSecondary">
                            전월 대비 +3.2%
                        </Typography>
                    </CardContent>
                </Card>
            </Grid>
            <Grid item xs={12} md={3}>
                <Card>
                    <CardContent>
                        <Box display="flex" alignItems="center" mb={2}>
                            <Business color="primary" sx={{ mr: 1 }} />
                            <Typography variant="h6">거래량</Typography>
                        </Box>
                        <Typography variant="h4" color="primary">1,247건</Typography>
                        <Typography variant="body2" color="textSecondary">
                            전월 대비 -8.5%
                        </Typography>
                    </CardContent>
                </Card>
            </Grid>
            <Grid item xs={12} md={3}>
                <Card>
                    <CardContent>
                        <Box display="flex" alignItems="center" mb={2}>
                            <TrendingUp color="primary" sx={{ mr: 1 }} />
                            <Typography variant="h6">시장 지수</Typography>
                        </Box>
                        <Typography variant="h4" color="primary">125.8</Typography>
                        <Typography variant="body2" color="textSecondary">
                            전월 대비 +2.1%
                        </Typography>
                    </CardContent>
                </Card>
            </Grid>
            <Grid item xs={12} md={3}>
                <Card>
                    <CardContent>
                        <Box display="flex" alignItems="center" mb={2}>
                            <Assessment color="primary" sx={{ mr: 1 }} />
                            <Typography variant="h6">시장 심리</Typography>
                        </Box>
                        <Typography variant="h4" color="primary">중립</Typography>
                        <Typography variant="body2" color="textSecondary">
                            투자자 관망세
                        </Typography>
                    </CardContent>
                </Card>
            </Grid>

            <Grid item xs={12}>
                <Card>
                    <CardContent>
                        <Typography variant="h6" mb={2}>최근 거래 현황</Typography>
                        <TableContainer>
                            <Table>
                                <TableHead>
                                    <TableRow>
                                        <TableCell>지역</TableCell>
                                        <TableCell>매물 유형</TableCell>
                                        <TableCell>거래 유형</TableCell>
                                        <TableCell>가격</TableCell>
                                        <TableCell>면적</TableCell>
                                        <TableCell>시세 변동</TableCell>
                                        <TableCell>시장 동향</TableCell>
                                        <TableCell>작업</TableCell>
                                    </TableRow>
                                </TableHead>
                                <TableBody>
                                    {marketData.map((data) => (
                                        <TableRow key={data.id}>
                                            <TableCell>
                                                <Typography variant="body2" fontWeight="medium">
                                                    {data.region}
                                                </Typography>
                                            </TableCell>
                                            <TableCell>
                                                <Chip
                                                    label={data.propertyType === 'apartment' ? '아파트' :
                                                        data.propertyType === 'villa' ? '빌라' :
                                                            data.propertyType === 'officetel' ? '오피스텔' :
                                                                data.propertyType === 'house' ? '단독주택' : '상업용'}
                                                    size="small"
                                                    color="primary"
                                                />
                                            </TableCell>
                                            <TableCell>
                                                <Chip
                                                    label={data.transactionType === 'sale' ? '매매' :
                                                        data.transactionType === 'rent' ? '전세' : '월세'}
                                                    size="small"
                                                    color="secondary"
                                                />
                                            </TableCell>
                                            <TableCell>
                                                <Typography variant="body2">
                                                    {(data.price / 100000000).toFixed(1)}억원
                                                </Typography>
                                            </TableCell>
                                            <TableCell>
                                                <Typography variant="body2">
                                                    {data.area}㎡
                                                </Typography>
                                            </TableCell>
                                            <TableCell>
                                                <Box display="flex" alignItems="center">
                                                    <Typography variant="body2" sx={{ mr: 1 }}>
                                                        {data.priceChangePercent > 0 ? '+' : ''}{data.priceChangePercent}%
                                                    </Typography>
                                                    {getTrendIcon(data.marketTrend)}
                                                </Box>
                                            </TableCell>
                                            <TableCell>
                                                <Chip
                                                    label={data.marketTrend === 'rising' ? '상승' :
                                                        data.marketTrend === 'falling' ? '하락' : '보합'}
                                                    size="small"
                                                    color={data.marketTrend === 'rising' ? 'success' :
                                                        data.marketTrend === 'falling' ? 'error' : 'warning'}
                                                />
                                            </TableCell>
                                            <TableCell>
                                                <Button variant="outlined" size="small">
                                                    상세 보기
                                                </Button>
                                            </TableCell>
                                        </TableRow>
                                    ))}
                                </TableBody>
                            </Table>
                        </TableContainer>
                    </CardContent>
                </Card>
            </Grid>
        </Grid>
    );

    const renderPriceAnalysis = () => (
        <Grid container spacing={3}>
            <Grid item xs={12} md={6}>
                <Card>
                    <CardContent>
                        <Typography variant="h6" mb={2}>지역별 시세 분석</Typography>
                        {marketTrends.map((trend) => (
                            <Box key={trend.region} mb={3}>
                                <Typography variant="subtitle1" mb={1}>{trend.region}</Typography>
                                <Box display="flex" justifyContent="space-between" mb={1}>
                                    <Typography variant="body2">평균 가격</Typography>
                                    <Typography variant="body2">
                                        {(trend.averagePrice / 100000000).toFixed(1)}억원
                                    </Typography>
                                </Box>
                                <Box display="flex" justifyContent="space-between" mb={1}>
                                    <Typography variant="body2">가격 변동</Typography>
                                    <Typography variant="body2">
                                        {trend.priceChange > 0 ? '+' : ''}{trend.priceChange}%
                                    </Typography>
                                </Box>
                                <Box display="flex" justifyContent="space-between" mb={1}>
                                    <Typography variant="body2">거래량 변동</Typography>
                                    <Typography variant="body2">
                                        {trend.volumeChange > 0 ? '+' : ''}{trend.volumeChange}%
                                    </Typography>
                                </Box>
                                <Box display="flex" justifyContent="space-between">
                                    <Typography variant="body2">시장 심리</Typography>
                                    <Chip
                                        label={trend.marketSentiment === 'bullish' ? '낙관적' :
                                            trend.marketSentiment === 'bearish' ? '비관적' : '중립적'}
                                        size="small"
                                        color={trend.marketSentiment === 'bullish' ? 'success' :
                                            trend.marketSentiment === 'bearish' ? 'error' : 'warning'}
                                    />
                                </Box>
                            </Box>
                        ))}
                    </CardContent>
                </Card>
            </Grid>

            <Grid item xs={12} md={6}>
                <Card>
                    <CardContent>
                        <Typography variant="h6" mb={2}>매물 유형별 분석</Typography>
                        <List>
                            <ListItem>
                                <ListItemIcon><Home /></ListItemIcon>
                                <ListItemText
                                    primary="아파트"
                                    secondary="평균 18억원, +3.2%"
                                />
                                <Chip label="상승" color="success" size="small" />
                            </ListItem>
                            <ListItem>
                                <ListItemIcon><Business /></ListItemIcon>
                                <ListItemText
                                    primary="빌라"
                                    secondary="평균 12억원, +1.8%"
                                />
                                <Chip label="상승" color="success" size="small" />
                            </ListItem>
                            <ListItem>
                                <ListItemIcon><Business /></ListItemIcon>
                                <ListItemText
                                    primary="오피스텔"
                                    secondary="평균 8억원, -0.5%"
                                />
                                <Chip label="하락" color="error" size="small" />
                            </ListItem>
                        </List>
                    </CardContent>
                </Card>
            </Grid>
        </Grid>
    );

    const renderPolicyChanges = () => (
        <Grid container spacing={3}>
            <Grid item xs={12}>
                <Card>
                    <CardContent>
                        <Typography variant="h6" mb={2}>정책 변화 분석</Typography>
                        <TableContainer>
                            <Table>
                                <TableHead>
                                    <TableRow>
                                        <TableCell>정책명</TableCell>
                                        <TableCell>카테고리</TableCell>
                                        <TableCell>영향도</TableCell>
                                        <TableCell>심각도</TableCell>
                                        <TableCell>시장 영향</TableCell>
                                        <TableCell>상태</TableCell>
                                        <TableCell>작업</TableCell>
                                    </TableRow>
                                </TableHead>
                                <TableBody>
                                    {policyChanges.map((policy) => (
                                        <TableRow key={policy.id}>
                                            <TableCell>
                                                <Typography variant="body2" fontWeight="medium">
                                                    {policy.title}
                                                </Typography>
                                            </TableCell>
                                            <TableCell>
                                                <Chip
                                                    label={policy.category === 'tax' ? '세제' :
                                                        policy.category === 'loan' ? '대출' :
                                                            policy.category === 'regulation' ? '규제' :
                                                                policy.category === 'subsidy' ? '지원' : '개발'}
                                                    size="small"
                                                    color="primary"
                                                />
                                            </TableCell>
                                            <TableCell>
                                                <Chip
                                                    label={policy.impact === 'positive' ? '긍정적' :
                                                        policy.impact === 'negative' ? '부정적' : '중립적'}
                                                    size="small"
                                                    color={getImpactColor(policy.impact) as any}
                                                />
                                            </TableCell>
                                            <TableCell>
                                                <Chip
                                                    label={policy.severity === 'high' ? '높음' :
                                                        policy.severity === 'medium' ? '보통' : '낮음'}
                                                    size="small"
                                                    color={policy.severity === 'high' ? 'error' :
                                                        policy.severity === 'medium' ? 'warning' : 'success'}
                                                />
                                            </TableCell>
                                            <TableCell>
                                                <Typography variant="body2">
                                                    가격: {policy.marketImpact.priceImpact > 0 ? '+' : ''}{policy.marketImpact.priceImpact}%
                                                </Typography>
                                                <Typography variant="body2">
                                                    거래량: {policy.marketImpact.volumeImpact > 0 ? '+' : ''}{policy.marketImpact.volumeImpact}%
                                                </Typography>
                                            </TableCell>
                                            <TableCell>
                                                <Chip
                                                    label={policy.status === 'proposed' ? '제안' :
                                                        policy.status === 'approved' ? '승인' :
                                                            policy.status === 'implemented' ? '시행' : '만료'}
                                                    size="small"
                                                    color={policy.status === 'implemented' ? 'success' :
                                                        policy.status === 'approved' ? 'warning' : 'default'}
                                                />
                                            </TableCell>
                                            <TableCell>
                                                <Button variant="outlined" size="small">
                                                    상세 보기
                                                </Button>
                                            </TableCell>
                                        </TableRow>
                                    ))}
                                </TableBody>
                            </Table>
                        </TableContainer>
                    </CardContent>
                </Card>
            </Grid>
        </Grid>
    );

    const renderInvestmentAnalysis = () => (
        <Grid container spacing={3}>
            <Grid item xs={12}>
                <Card>
                    <CardContent>
                        <Typography variant="h6" mb={2}>투자 분석</Typography>
                        <TableContainer>
                            <Table>
                                <TableHead>
                                    <TableRow>
                                        <TableCell>지역</TableCell>
                                        <TableCell>매물 유형</TableCell>
                                        <TableCell>투자 유형</TableCell>
                                        <TableCell>예상 수익률</TableCell>
                                        <TableCell>위험도</TableCell>
                                        <TableCell>투자 기간</TableCell>
                                        <TableCell>추천</TableCell>
                                        <TableCell>작업</TableCell>
                                    </TableRow>
                                </TableHead>
                                <TableBody>
                                    {investmentAnalyses.map((analysis) => (
                                        <TableRow key={analysis.id}>
                                            <TableCell>
                                                <Typography variant="body2" fontWeight="medium">
                                                    {analysis.region}
                                                </Typography>
                                            </TableCell>
                                            <TableCell>
                                                <Chip
                                                    label={analysis.propertyType === 'apartment' ? '아파트' :
                                                        analysis.propertyType === 'villa' ? '빌라' :
                                                            analysis.propertyType === 'officetel' ? '오피스텔' : '기타'}
                                                    size="small"
                                                    color="primary"
                                                />
                                            </TableCell>
                                            <TableCell>
                                                <Chip
                                                    label={analysis.investmentType === 'buy' ? '매수' :
                                                        analysis.investmentType === 'rent' ? '임대' :
                                                            analysis.investmentType === 'develop' ? '개발' : '플립'}
                                                    size="small"
                                                    color="secondary"
                                                />
                                            </TableCell>
                                            <TableCell>
                                                <Typography variant="body2" color="success.main">
                                                    {analysis.expectedReturn}%
                                                </Typography>
                                            </TableCell>
                                            <TableCell>
                                                <Chip
                                                    label={analysis.riskLevel === 'low' ? '낮음' :
                                                        analysis.riskLevel === 'medium' ? '보통' : '높음'}
                                                    size="small"
                                                    color={getRiskColor(analysis.riskLevel) as any}
                                                />
                                            </TableCell>
                                            <TableCell>
                                                <Chip
                                                    label={analysis.investmentHorizon === 'short' ? '단기' :
                                                        analysis.investmentHorizon === 'medium' ? '중기' : '장기'}
                                                    size="small"
                                                    color="info"
                                                />
                                            </TableCell>
                                            <TableCell>
                                                <Chip
                                                    label={analysis.recommendation === 'strong_buy' ? '강력매수' :
                                                        analysis.recommendation === 'buy' ? '매수' :
                                                            analysis.recommendation === 'hold' ? '보유' :
                                                                analysis.recommendation === 'sell' ? '매도' : '강력매도'}
                                                    size="small"
                                                    color={getRecommendationColor(analysis.recommendation) as any}
                                                />
                                            </TableCell>
                                            <TableCell>
                                                <Button
                                                    variant="outlined"
                                                    size="small"
                                                    onClick={() => {
                                                        setSelectedAnalysis(analysis);
                                                        setAnalysisDialogOpen(true);
                                                    }}
                                                >
                                                    상세 보기
                                                </Button>
                                            </TableCell>
                                        </TableRow>
                                    ))}
                                </TableBody>
                            </Table>
                        </TableContainer>
                    </CardContent>
                </Card>
            </Grid>
        </Grid>
    );

    const renderTrendAnalysis = () => (
        <Grid container spacing={3}>
            <Grid item xs={12} md={6}>
                <Card>
                    <CardContent>
                        <Typography variant="h6" mb={2}>시장 트렌드</Typography>
                        <List>
                            <ListItem>
                                <ListItemIcon><TrendingUpIcon color="success" /></ListItemIcon>
                                <ListItemText
                                    primary="강남구 아파트 시세 상승"
                                    secondary="전월 대비 +3.2%, 거래량 증가"
                                />
                            </ListItem>
                            <ListItem>
                                <ListItemIcon><TrendingDownIcon color="error" /></ListItemIcon>
                                <ListItemText
                                    primary="오피스텔 시세 하락"
                                    secondary="전월 대비 -0.5%, 공급 과잉"
                                />
                            </ListItem>
                            <ListItem>
                                <ListItemIcon><TrendingFlatIcon color="warning" /></ListItemIcon>
                                <ListItemText
                                    primary="전세 시장 안정"
                                    secondary="전월 대비 +0.2%, 수요 안정"
                                />
                            </ListItem>
                        </List>
                    </CardContent>
                </Card>
            </Grid>

            <Grid item xs={12} md={6}>
                <Card>
                    <CardContent>
                        <Typography variant="h6" mb={2}>투자자 심리</Typography>
                        <Box display="flex" justifyContent="space-around" alignItems="center" mb={3}>
                            <Box textAlign="center">
                                <Typography variant="h4" color="success.main">45%</Typography>
                                <Typography variant="body2">낙관적</Typography>
                            </Box>
                            <Box textAlign="center">
                                <Typography variant="h4" color="warning.main">35%</Typography>
                                <Typography variant="body2">중립적</Typography>
                            </Box>
                            <Box textAlign="center">
                                <Typography variant="h4" color="error.main">20%</Typography>
                                <Typography variant="body2">비관적</Typography>
                            </Box>
                        </Box>
                        <Alert severity="info">
                            정책 변화에 따른 관망세가 지속되고 있습니다.
                        </Alert>
                    </CardContent>
                </Card>
            </Grid>
        </Grid>
    );

    const renderPredictionModel = () => (
        <Grid container spacing={3}>
            <Grid item xs={12} md={6}>
                <Card>
                    <CardContent>
                        <Typography variant="h6" mb={2}>AI 예측 모델</Typography>
                        <Box mb={3}>
                            <Typography variant="subtitle1" mb={1}>3개월 후 예측</Typography>
                            <Box display="flex" justifyContent="space-between" mb={1}>
                                <Typography variant="body2">강남구 아파트</Typography>
                                <Typography variant="body2" color="success.main">+2.8%</Typography>
                            </Box>
                            <Box display="flex" justifyContent="space-between" mb={1}>
                                <Typography variant="body2">서초구 아파트</Typography>
                                <Typography variant="body2" color="success.main">+1.9%</Typography>
                            </Box>
                            <Box display="flex" justifyContent="space-between">
                                <Typography variant="body2">송파구 아파트</Typography>
                                <Typography variant="body2" color="error.main">-0.5%</Typography>
                            </Box>
                        </Box>
                        <Alert severity="success">
                            AI 모델 정확도: 87.3%
                        </Alert>
                    </CardContent>
                </Card>
            </Grid>

            <Grid item xs={12} md={6}>
                <Card>
                    <CardContent>
                        <Typography variant="h6" mb={2}>위험 요소 분석</Typography>
                        <List>
                            <ListItem>
                                <ListItemIcon><Warning color="error" /></ListItemIcon>
                                <ListItemText
                                    primary="금리 상승 리스크"
                                    secondary="예상 영향도: 높음"
                                />
                            </ListItem>
                            <ListItem>
                                <ListItemIcon><Warning color="warning" /></ListItemIcon>
                                <ListItemText
                                    primary="정책 변화 리스크"
                                    secondary="예상 영향도: 보통"
                                />
                            </ListItem>
                            <ListItem>
                                <ListItemIcon><Info color="info" /></ListItemIcon>
                                <ListItemText
                                    primary="경기 침체 리스크"
                                    secondary="예상 영향도: 낮음"
                                />
                            </ListItem>
                        </List>
                    </CardContent>
                </Card>
            </Grid>
        </Grid>
    );

    const renderSettings = () => (
        <Card>
            <CardContent>
                <Typography variant="h6" mb={2}>시장 분석 설정</Typography>
                <List>
                    <ListItem>
                        <ListItemIcon><Refresh /></ListItemIcon>
                        <ListItemText
                            primary="자동 새로고침"
                            secondary="30초마다 데이터 자동 업데이트"
                        />
                        <Switch
                            checked={autoRefresh}
                            onChange={(e) => setAutoRefresh(e.target.checked)}
                        />
                    </ListItem>
                    <ListItem>
                        <ListItemIcon><Notifications /></ListItemIcon>
                        <ListItemText
                            primary="정책 변화 알림"
                            secondary="새로운 정책 발표 시 즉시 알림"
                        />
                        <Switch defaultChecked />
                    </ListItem>
                    <ListItem>
                        <ListItemIcon><AutoFixHigh /></ListItemIcon>
                        <ListItemText
                            primary="AI 예측 알림"
                            secondary="시장 예측 결과 변경 시 알림"
                        />
                        <Switch defaultChecked />
                    </ListItem>
                </List>
            </CardContent>
        </Card>
    );

    const renderContent = () => {
        switch (selectedTab) {
            case 0: return renderMarketOverview();
            case 1: return renderPriceAnalysis();
            case 2: return renderPolicyChanges();
            case 3: return renderInvestmentAnalysis();
            case 4: return renderTrendAnalysis();
            case 5: return renderPredictionModel();
            case 6: return renderSettings();
            default: return renderMarketOverview();
        }
    };

    return (
        <Box sx={{ p: 3, height: '100vh', overflow: 'auto' }}>
            {/* 헤더 */}
            <Box display="flex" justifyContent="space-between" alignItems="center" mb={3}>
                <Box display="flex" alignItems="center">
                    <Home sx={{ mr: 1, fontSize: 32 }} color="primary" />
                    <Typography variant="h4">부동산 시장 분석 대시보드</Typography>
                </Box>
                <Box display="flex" alignItems="center" gap={1}>
                    <Typography variant="body2" color="textSecondary">
                        마지막 업데이트: {lastUpdate.toLocaleTimeString()}
                    </Typography>
                    <Tooltip title="전체화면">
                        <IconButton onClick={() => setFullscreen(!fullscreen)}>
                            {fullscreen ? <FullscreenExit /> : <Fullscreen />}
                        </IconButton>
                    </Tooltip>
                </Box>
            </Box>

            {/* 탭 네비게이션 */}
            <Paper sx={{ mb: 3 }}>
                <Box display="flex" overflow="auto">
                    {tabs.map((tab, index) => (
                        <Button
                            key={index}
                            variant={selectedTab === index ? "contained" : "text"}
                            startIcon={tab.icon}
                            onClick={() => setSelectedTab(index)}
                            sx={{
                                minWidth: 'auto',
                                px: 2,
                                py: 1.5,
                                borderRadius: 0,
                                borderBottom: selectedTab === index ? 2 : 0,
                                borderColor: 'primary.main'
                            }}
                        >
                            {tab.label}
                        </Button>
                    ))}
                </Box>
            </Paper>

            {/* 메인 콘텐츠 */}
            {renderContent()}

            {/* 투자 분석 상세 다이얼로그 */}
            <Dialog
                open={analysisDialogOpen}
                onClose={() => setAnalysisDialogOpen(false)}
                maxWidth="md"
                fullWidth
            >
                <DialogTitle>
                    {selectedAnalysis?.region} {selectedAnalysis?.propertyType} 투자 분석
                </DialogTitle>
                <DialogContent>
                    {selectedAnalysis && (
                        <Box>
                            <Typography variant="h6" mb={2}>투자 개요</Typography>
                            <Grid container spacing={2} mb={3}>
                                <Grid item xs={6}>
                                    <Typography variant="body2" color="textSecondary">예상 수익률</Typography>
                                    <Typography variant="h6" color="success.main">
                                        {selectedAnalysis.expectedReturn}%
                                    </Typography>
                                </Grid>
                                <Grid item xs={6}>
                                    <Typography variant="body2" color="textSecondary">위험도</Typography>
                                    <Chip
                                        label={selectedAnalysis.riskLevel === 'low' ? '낮음' :
                                            selectedAnalysis.riskLevel === 'medium' ? '보통' : '높음'}
                                        color={getRiskColor(selectedAnalysis.riskLevel) as any}
                                    />
                                </Grid>
                                <Grid item xs={6}>
                                    <Typography variant="body2" color="textSecondary">투자 기간</Typography>
                                    <Chip
                                        label={selectedAnalysis.investmentHorizon === 'short' ? '단기' :
                                            selectedAnalysis.investmentHorizon === 'medium' ? '중기' : '장기'}
                                        color="info"
                                    />
                                </Grid>
                                <Grid item xs={6}>
                                    <Typography variant="body2" color="textSecondary">신뢰도</Typography>
                                    <Typography variant="h6">
                                        {(selectedAnalysis.confidence * 100).toFixed(0)}%
                                    </Typography>
                                </Grid>
                            </Grid>

                            <Typography variant="h6" mb={2}>상세 분석</Typography>
                            <Grid container spacing={2} mb={3}>
                                <Grid item xs={6}>
                                    <Typography variant="body2" color="textSecondary">시장 성장률</Typography>
                                    <Typography variant="body1">{selectedAnalysis.analysis.marketGrowth}%</Typography>
                                </Grid>
                                <Grid item xs={6}>
                                    <Typography variant="body2" color="textSecondary">임대 수익률</Typography>
                                    <Typography variant="body1">{selectedAnalysis.analysis.rentalYield}%</Typography>
                                </Grid>
                                <Grid item xs={6}>
                                    <Typography variant="body2" color="textSecondary">자본 이득</Typography>
                                    <Typography variant="body1">{selectedAnalysis.analysis.capitalGain}%</Typography>
                                </Grid>
                                <Grid item xs={6}>
                                    <Typography variant="body2" color="textSecondary">유동성</Typography>
                                    <Typography variant="body1">{selectedAnalysis.analysis.liquidity}/10</Typography>
                                </Grid>
                            </Grid>

                            <Typography variant="h6" mb={2}>위험 요소</Typography>
                            <Box mb={3}>
                                {selectedAnalysis.analysis.riskFactors.map((risk, index) => (
                                    <Chip key={index} label={risk} color="error" sx={{ mr: 1, mb: 1 }} />
                                ))}
                            </Box>

                            <Typography variant="h6" mb={2}>기회 요소</Typography>
                            <Box mb={3}>
                                {selectedAnalysis.analysis.opportunities.map((opportunity, index) => (
                                    <Chip key={index} label={opportunity} color="success" sx={{ mr: 1, mb: 1 }} />
                                ))}
                            </Box>
                        </Box>
                    )}
                </DialogContent>
                <DialogActions>
                    <Button onClick={() => setAnalysisDialogOpen(false)}>닫기</Button>
                    <Button variant="contained">투자 전략 생성</Button>
                </DialogActions>
            </Dialog>
        </Box>
    );
};

export default RealEstateMarketAnalysisDashboard;

