                        </Box>
                        <Typography variant="h4" color="primary">92%</Typography>
                        <Typography variant="body2" color="textSecondary">
                            프로젝트 완료율
                        </Typography>
                    </CardContent>
                </Card>
            </Grid>

            <Grid item xs={12}>
                <Card>
                    <CardContent>
                        <Typography variant="h6" mb={2}>시공사 목록</Typography>
                        <TableContainer>
                            <Table>
                                <TableHead>
                                    <TableRow>
                                        <TableCell>시공사명</TableCell>
                                        <TableCell>규모</TableCell>
                                        <TableCell>평점</TableCell>
                                        <TableCell>경험</TableCell>
                                        <TableCell>완료 프로젝트</TableCell>
                                        <TableCell>전체 점수</TableCell>
                                        <TableCell>상태</TableCell>
                                        <TableCell>작업</TableCell>
                                    </TableRow>
                                </TableHead>
                                <TableBody>
                                    {companies.map((company) => (
                                        <TableRow key={company.id}>
                                            <TableCell>
                                                <Box display="flex" alignItems="center">
                                                    <Avatar sx={{ mr: 1 }}>{company.name[0]}</Avatar>
                                                    <Box>
                                                        <Typography variant="body2" fontWeight="medium">
                                                            {company.name}
                                                        </Typography>
                                                        <Typography variant="caption" color="textSecondary">
                                                            {company.specialties.join(', ')}
                                                        </Typography>
                                                    </Box>
                                                </Box>
                                            </TableCell>
                                            <TableCell>
                                                <Chip
                                                    label={company.type === 'large' ? '대형' :
                                                        company.type === 'medium' ? '중형' : '소형'}
                                                    size="small"
                                                    color="primary"
                                                />
                                            </TableCell>
                                            <TableCell>
                                                <Box display="flex" alignItems="center">
                                                    <Rating value={company.rating} readOnly size="small" />
                                                    <Typography variant="body2" sx={{ ml: 1 }}>
                                                        {company.rating}
                                                    </Typography>
                                                </Box>
                                            </TableCell>
                                            <TableCell>
                                                <Typography variant="body2">{company.experience}년</Typography>
