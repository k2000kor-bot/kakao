                    minScore: 0,
                    maxScore: 100
                },
                {
                    id: 'criteria-6',
                    name: '비용 효율성',
                    weight: 0.10,
                    description: '비용 효율성과 예산 관리 능력을 평가',
                    evaluationMethod: '이전 프로젝트 비용 효율성 분석',
                    minScore: 0,
                    maxScore: 100
                }
            ];

            const mockCompanyComparisons: CompanyComparison[] = [
                {
                    companyId: 'company-1',
                    companyName: '대한건설(주)',
                    criteriaScores: {
                        'criteria-1': 85,
                        'criteria-2': 90,
                        'criteria-3': 85,
                        'criteria-4': 92,
                        'criteria-5': 78,
                        'criteria-6': 88
                    },
                    totalScore: 86.2,
                    rank: 1,
                    strengths: ['재무 건전성 우수', '안전 관리 우수', '기술력 우수'],
                    weaknesses: ['일정 관리 개선 필요'],
                    recommendation: 'recommended'
                },
                {
                    companyId: 'company-2',
                    companyName: '신세계건설',
                    criteriaScores: {
                        'criteria-1': 75,
                        'criteria-2': 80,
                        'criteria-3': 78,
                        'criteria-4': 85,
                        'criteria-5': 82,
                        'criteria-6': 75
                    },
                    totalScore: 79.2,
                    rank: 2,
                    strengths: ['일정 관리 우수', '비용 효율성'],
                    weaknesses: ['재무 건전성 개선 필요', '품질 관리 강화 필요'],
                    recommendation: 'acceptable'
                }
            ];

            setCompanies(mockCompanies);
            setSelectionCriteria(mockSelectionCriteria);
            setCompanyComparisons(mockCompanyComparisons);
            setLastUpdate(new Date());
        } catch (error) {
            console.error('데이터 새로고침 오류:', error);
        }
    };

    useEffect(() => {
        refreshData();

        if (autoRefresh) {
            const interval = setInterval(refreshData, 30000); // 30초마다 새로고침
            return () => clearInterval(interval);
        }
    }, [autoRefresh]);

    const getSeverityColor = (severity: string) => {
        switch (severity) {
            case 'critical': return 'error';
            case 'high': return 'warning';
            case 'medium': return 'info';
            case 'low': return 'success';
            default: return 'default';
        }
    };

    const getStatusColor = (status: string) => {
        switch (status) {
            case 'open': return 'error';
            case 'in_progress': return 'warning';
            case 'resolved': return 'success';
            case 'closed': return 'default';
            default: return 'default';
        }
    };

    const getCompanyTypeIcon = (type: string) => {
        switch (type) {
            case 'large': return <Business />;
            case 'medium': return <Build />;
            case 'small': return <Engineering />;
            default: return <Business />;
        }
    };

    const renderCompanyOverview = () => (
