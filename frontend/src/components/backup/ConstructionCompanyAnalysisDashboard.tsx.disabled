interface ConstructionCompany {
    id: string;
    name: string;
    type: 'large' | 'medium' | 'small';
    rating: number;
    experience: number;
    completedProjects: number;
    currentProjects: number;
    specialties: string[];
    certifications: string[];
    contactInfo: {
        phone: string;
        email: string;
        website: string;
        address: string;
    };
    performanceMetrics: {
        qualityScore: number;
        safetyScore: number;
        scheduleScore: number;
        costScore: number;
        overallScore: number;
    };
    reputation: {
        positiveReviews: number;
        negativeReviews: number;
        neutralReviews: number;
        averageRating: number;
    };
    financialHealth: {
        revenue: number;
        profitMargin: number;
        debtRatio: number;
        creditRating: string;
    };
    issues: ConstructionIssue[];
    strengths: string[];
    weaknesses: string[];
    recommendations: string[];
}

interface ConstructionIssue {
    id: string;
    title: string;
    description: string;
    severity: 'critical' | 'high' | 'medium' | 'low';
    category: 'quality' | 'safety' | 'schedule' | 'cost' | 'communication' | 'management';
    status: 'open' | 'in_progress' | 'resolved' | 'closed';
    reportedDate: Date;
    resolvedDate?: Date;
    impact: {
        cost: number;
        delay: number;
        quality: number;
        safety: number;
    };
    resolution: {
        action: string;
        cost: number;
        time: number;
        effectiveness: number;
    };
    relatedIssues: string[];
}

interface IssueAnalysis {
    totalIssues: number;
    resolvedIssues: number;
    openIssues: number;
    criticalIssues: number;
    averageResolutionTime: number;
    costImpact: number;
    qualityImpact: number;
    safetyImpact: number;
    trend: 'improving' | 'declining' | 'stable';
}

interface SelectionCriteria {
    id: string;
    name: string;
    weight: number;
    description: string;
    evaluationMethod: string;
    minScore: number;
    maxScore: number;
}

interface CompanyComparison {
    companyId: string;
    companyName: string;
    criteriaScores: { [key: string]: number };
    totalScore: number;
    rank: number;
    strengths: string[];
    weaknesses: string[];
    recommendation: 'recommended' | 'acceptable' | 'not_recommended';
}

