                                            <TableCell>
                                                <Typography variant="body2">{company.completedProjects}개</Typography>
                                            </TableCell>
                                            <TableCell>
                                                <Box display="flex" alignItems="center">
                                                    <Typography variant="body2" sx={{ mr: 1 }}>
                                                        {(company.performanceMetrics.overallScore * 100).toFixed(0)}%
                                                    </Typography>
                                                    <LinearProgress
                                                        variant="determinate"
                                                        value={company.performanceMetrics.overallScore * 100}
                                                        sx={{ width: 60, height: 6 }}
                                                        color={company.performanceMetrics.overallScore > 0.8 ? 'success' :
                                                            company.performanceMetrics.overallScore > 0.6 ? 'warning' : 'error'}
                                                    />
                                                </Box>
                                            </TableCell>
                                            <TableCell>
                                                <Chip
                                                    label={company.issues.some(i => i.status === 'open') ? '이슈 있음' : '정상'}
                                                    size="small"
                                                    color={company.issues.some(i => i.status === 'open') ? 'error' : 'success'}
                                                />
                                            </TableCell>
                                            <TableCell>
                                                <Button
                                                    variant="outlined"
                                                    size="small"
                                                    onClick={() => {
                                                        setSelectedCompany(company);
                                                        setCompanyDialogOpen(true);
                                                    }}
                                                >
                                                    상세 보기
                                                </Button>
                                            </TableCell>
                                        </TableRow>
                                    ))}
                                </TableBody>
                            </Table>
                        </TableContainer>
                    </CardContent>
                </Card>
            </Grid>
        </Grid>
    );

    const renderIssueAnalysis = () => (
        <Grid container spacing={3}>
            <Grid item xs={12}>
                <Card>
                    <CardContent>
                        <Typography variant="h6" mb={2}>하자 이슈 분석</Typography>
                        <TableContainer>
                            <Table>
                                <TableHead>
                                    <TableRow>
                                        <TableCell>이슈명</TableCell>
                                        <TableCell>시공사</TableCell>
                                        <TableCell>심각도</TableCell>
                                        <TableCell>카테고리</TableCell>
                                        <TableCell>상태</TableCell>
                                        <TableCell>비용 영향</TableCell>
                                        <TableCell>지연일</TableCell>
                                        <TableCell>작업</TableCell>
                                    </TableRow>
                                </TableHead>
                                <TableBody>
                                    {companies.flatMap(company =>
                                        company.issues.map(issue => (
                                            <TableRow key={issue.id}>
                                                <TableCell>
                                                    <Typography variant="body2" fontWeight="medium">
                                                        {issue.title}
                                                    </Typography>
                                                </TableCell>
                                                <TableCell>
                                                    <Typography variant="body2">{company.name}</Typography>
                                                </TableCell>
                                                <TableCell>
                                                    <Chip
                                                        label={issue.severity === 'critical' ? '긴급' :
                                                            issue.severity === 'high' ? '높음' :
                                                                issue.severity === 'medium' ? '보통' : '낮음'}
                                                        size="small"
                                                        color={getSeverityColor(issue.severity) as any}
                                                    />
                                                </TableCell>
                                                <TableCell>
                                                    <Chip
                                                        label={issue.category === 'quality' ? '품질' :
                                                            issue.category === 'safety' ? '안전' :
                                                                issue.category === 'schedule' ? '일정' :
                                                                    issue.category === 'cost' ? '비용' :
                                                                        issue.category === 'communication' ? '소통' : '관리'}
                                                        size="small"
                                                        color="primary"
                                                    />
                                                </TableCell>
                                                <TableCell>
                                                    <Chip
                                                        label={issue.status === 'open' ? '개방' :
                                                            issue.status === 'in_progress' ? '진행중' :
                                                                issue.status === 'resolved' ? '해결됨' : '종료'}
                                                        size="small"
                                                        color={getStatusColor(issue.status) as any}
                                                    />
                                                </TableCell>
                                                <TableCell>
                                                    <Typography variant="body2">
                                                        {issue.impact.cost.toLocaleString()}원
                                                    </Typography>
                                                </TableCell>
                                                <TableCell>
                                                    <Typography variant="body2">
                                                        {issue.impact.delay}일
                                                    </Typography>
                                                </TableCell>
                                                <TableCell>
                                                    <Button variant="outlined" size="small">
                                                        상세 보기
                                                    </Button>
                                                </TableCell>
                                            </TableRow>
                                        ))
                                    )}
                                </TableBody>
                            </Table>
                        </TableContainer>
                    </CardContent>
                </Card>
            </Grid>
        </Grid>
    );

    const renderPerformanceAnalysis = () => (
        <Grid container spacing={3}>
            <Grid item xs={12} md={6}>
                <Card>
                    <CardContent>
                        <Typography variant="h6" mb={2}>성능 메트릭 비교</Typography>
                        {companies.map((company) => (
                            <Box key={company.id} mb={3}>
                                <Typography variant="subtitle1" mb={1}>{company.name}</Typography>
                                <Box mb={1}>
                                    <Box display="flex" justifyContent="space-between" mb={0.5}>
                                        <Typography variant="body2">품질</Typography>
                                        <Typography variant="body2">
                                            {(company.performanceMetrics.qualityScore * 100).toFixed(0)}%
                                        </Typography>
                                    </Box>
                                    <LinearProgress
                                        variant="determinate"
                                        value={company.performanceMetrics.qualityScore * 100}
                                        color="primary"
                                    />
                                </Box>
                                <Box mb={1}>
                                    <Box display="flex" justifyContent="space-between" mb={0.5}>
                                        <Typography variant="body2">안전</Typography>
                                        <Typography variant="body2">
                                            {(company.performanceMetrics.safetyScore * 100).toFixed(0)}%
                                        </Typography>
                                    </Box>
                                    <LinearProgress
                                        variant="determinate"
                                        value={company.performanceMetrics.safetyScore * 100}
                                        color="success"
                                    />
                                </Box>
                                <Box mb={1}>
                                    <Box display="flex" justifyContent="space-between" mb={0.5}>
                                        <Typography variant="body2">일정</Typography>
                                        <Typography variant="body2">
                                            {(company.performanceMetrics.scheduleScore * 100).toFixed(0)}%
                                        </Typography>
                                    </Box>
                                    <LinearProgress
                                        variant="determinate"
                                        value={company.performanceMetrics.scheduleScore * 100}
                                        color="warning"
                                    />
                                </Box>
                                <Box mb={1}>
                                    <Box display="flex" justifyContent="space-between" mb={0.5}>
                                        <Typography variant="body2">비용</Typography>
                                        <Typography variant="body2">
                                            {(company.performanceMetrics.costScore * 100).toFixed(0)}%
                                        </Typography>
                                    </Box>
                                    <LinearProgress
                                        variant="determinate"
                                        value={company.performanceMetrics.costScore * 100}
                                        color="info"
                                    />
                                </Box>
                            </Box>
                        ))}
                    </CardContent>
                </Card>
            </Grid>

            <Grid item xs={12} md={6}>
                <Card>
                    <CardContent>
                        <Typography variant="h6" mb={2}>재무 건전성</Typography>
                        {companies.map((company) => (
                            <Box key={company.id} mb={3}>
                                <Typography variant="subtitle1" mb={1}>{company.name}</Typography>
                                <Box display="flex" justifyContent="space-between" mb={1}>
                                    <Typography variant="body2">매출액</Typography>
                                    <Typography variant="body2">
                                        {(company.financialHealth.revenue / 1000000000).toFixed(1)}억원
                                    </Typography>
                                </Box>
                                <Box display="flex" justifyContent="space-between" mb={1}>
                                    <Typography variant="body2">영업이익률</Typography>
                                    <Typography variant="body2">
                                        {(company.financialHealth.profitMargin * 100).toFixed(1)}%
                                    </Typography>
                                </Box>
                                <Box display="flex" justifyContent="space-between" mb={1}>
                                    <Typography variant="body2">부채비율</Typography>
                                    <Typography variant="body2">
                                        {(company.financialHealth.debtRatio * 100).toFixed(1)}%
                                    </Typography>
                                </Box>
                                <Box display="flex" justifyContent="space-between">
                                    <Typography variant="body2">신용등급</Typography>
                                    <Typography variant="body2" fontWeight="medium">
                                        {company.financialHealth.creditRating}
                                    </Typography>
                                </Box>
                            </Box>
                        ))}
                    </CardContent>
                </Card>
            </Grid>
        </Grid>
    );

    const renderSelectionCriteria = () => (
        <Grid container spacing={3}>
            <Grid item xs={12}>
                <Card>
                    <CardContent>
                        <Typography variant="h6" mb={2}>선정 기준 관리</Typography>
                        <TableContainer>
                            <Table>
                                <TableHead>
                                    <TableRow>
                                        <TableCell>기준명</TableCell>
                                        <TableCell>가중치</TableCell>
                                        <TableCell>설명</TableCell>
                                        <TableCell>평가 방법</TableCell>
                                        <TableCell>최소 점수</TableCell>
                                        <TableCell>최대 점수</TableCell>
                                        <TableCell>작업</TableCell>
                                    </TableRow>
                                </TableHead>
                                <TableBody>
                                    {selectionCriteria.map((criteria) => (
                                        <TableRow key={criteria.id}>
                                            <TableCell>
                                                <Typography variant="body2" fontWeight="medium">
                                                    {criteria.name}
                                                </Typography>
                                            </TableCell>
                                            <TableCell>
                                                <Typography variant="body2">
                                                    {(criteria.weight * 100).toFixed(0)}%
                                                </Typography>
                                            </TableCell>
                                            <TableCell>
                                                <Typography variant="body2">
                                                    {criteria.description}
                                                </Typography>
                                            </TableCell>
                                            <TableCell>
                                                <Typography variant="body2">
                                                    {criteria.evaluationMethod}
                                                </Typography>
                                            </TableCell>
                                            <TableCell>
                                                <Typography variant="body2">{criteria.minScore}</Typography>
                                            </TableCell>
                                            <TableCell>
                                                <Typography variant="body2">{criteria.maxScore}</Typography>
                                            </TableCell>
                                            <TableCell>
                                                <Box display="flex" gap={1}>
                                                    <Button variant="outlined" size="small">
                                                        편집
                                                    </Button>
                                                    <Button variant="outlined" size="small">
                                                        삭제
                                                    </Button>
                                                </Box>
                                            </TableCell>
                                        </TableRow>
                                    ))}
                                </TableBody>
                            </Table>
                        </TableContainer>
                    </CardContent>
                </Card>
            </Grid>
        </Grid>
    );

    const renderComparisonAnalysis = () => (
        <Grid container spacing={3}>
            <Grid item xs={12}>
                <Card>
                    <CardContent>
                        <Typography variant="h6" mb={2}>시공사 비교 분석</Typography>
                        <TableContainer>
                            <Table>
                                <TableHead>
                                    <TableRow>
                                        <TableCell>순위</TableCell>
                                        <TableCell>시공사명</TableCell>
                                        <TableCell>총점</TableCell>
                                        <TableCell>기술력</TableCell>
                                        <TableCell>재무건전성</TableCell>
                                        <TableCell>품질관리</TableCell>
                                        <TableCell>안전관리</TableCell>
                                        <TableCell>일정관리</TableCell>
                                        <TableCell>비용효율성</TableCell>
                                        <TableCell>추천</TableCell>
                                    </TableRow>
                                </TableHead>
                                <TableBody>
                                    {companyComparisons.map((comparison) => (
                                        <TableRow key={comparison.companyId}>
                                            <TableCell>
                                                <Typography variant="h6" color="primary">
                                                    {comparison.rank}
                                                </Typography>
                                            </TableCell>
                                            <TableCell>
                                                <Typography variant="body2" fontWeight="medium">
                                                    {comparison.companyName}
                                                </Typography>
                                            </TableCell>
                                            <TableCell>
                                                <Typography variant="h6" color="primary">
                                                    {comparison.totalScore.toFixed(1)}
                                                </Typography>
                                            </TableCell>
                                            <TableCell>
                                                <Typography variant="body2">
                                                    {comparison.criteriaScores['criteria-1']}
                                                </Typography>
                                            </TableCell>
                                            <TableCell>
                                                <Typography variant="body2">
                                                    {comparison.criteriaScores['criteria-2']}
                                                </Typography>
                                            </TableCell>
                                            <TableCell>
                                                <Typography variant="body2">
                                                    {comparison.criteriaScores['criteria-3']}
                                                </Typography>
                                            </TableCell>
                                            <TableCell>
                                                <Typography variant="body2">
                                                    {comparison.criteriaScores['criteria-4']}
                                                </Typography>
                                            </TableCell>
                                            <TableCell>
                                                <Typography variant="body2">
                                                    {comparison.criteriaScores['criteria-5']}
                                                </Typography>
                                            </TableCell>
                                            <TableCell>
                                                <Typography variant="body2">
                                                    {comparison.criteriaScores['criteria-6']}
                                                </Typography>
                                            </TableCell>
                                            <TableCell>
                                                <Chip
                                                    label={comparison.recommendation === 'recommended' ? '추천' :
                                                        comparison.recommendation === 'acceptable' ? '수용가능' : '비추천'}
                                                    size="small"
                                                    color={comparison.recommendation === 'recommended' ? 'success' :
                                                        comparison.recommendation === 'acceptable' ? 'warning' : 'error'}
                                                />
                                            </TableCell>
                                        </TableRow>
                                    ))}
                                </TableBody>
                            </Table>
                        </TableContainer>
                    </CardContent>
                </Card>
            </Grid>
        </Grid>
    );

    const renderResponseStrategies = () => (
        <Grid container spacing={3}>
            <Grid item xs={12} md={6}>
                <Card>
                    <CardContent>
                        <Typography variant="h6" mb={2}>하자 대응 전략</Typography>
                        <List>
                            <ListItem>
                                <ListItemIcon><Warning color="error" /></ListItemIcon>
                                <ListItemText
                                    primary="긴급 하자 대응"
                                    secondary="24시간 내 응답 및 임시 조치"
                                />
                            </ListItem>
                            <ListItem>
                                <ListItemIcon><Build color="warning" /></ListItemIcon>
                                <ListItemText
                                    primary="정기 점검 시스템"
                                    secondary="월 1회 정기 점검 및 예방 정비"
                                />
                            </ListItem>
                            <ListItem>
                                <ListItemIcon><AutoFixHigh color="success" /></ListItemIcon>
                                <ListItemText
                                    primary="품질 개선 프로그램"
                                    secondary="시공사별 맞춤형 품질 개선 계획"
                                />
                            </ListItem>
                        </List>
                    </CardContent>
                </Card>
            </Grid>

            <Grid item xs={12} md={6}>
                <Card>
                    <CardContent>
                        <Typography variant="h6" mb={2}>선정 기준 개선</Typography>
                        <List>
                            <ListItem>
                                <ListItemIcon><Assessment color="primary" /></ListItemIcon>
                                <ListItemText
                                    primary="평가 기준 강화"
                                    secondary="하자 이력 및 대응 능력 반영"
                                />
                            </ListItem>
                            <ListItem>
                                <ListItemIcon><Analytics color="info" /></ListItemIcon>
                                <ListItemText
                                    primary="데이터 기반 선정"
                                    secondary="과거 실적 데이터 분석 기반 선정"
                                />
                            </ListItem>
                            <ListItem>
                                <ListItemIcon><CheckCircle color="success" /></ListItemIcon>
                                <ListItemText
                                    primary="인증 시스템 도입"
                                    secondary="품질 인증 및 안전 인증 필수화"
                                />
                            </ListItem>
                        </List>
                    </CardContent>
                </Card>
            </Grid>
        </Grid>
    );

    const renderSettings = () => (
        <Card>
            <CardContent>
                <Typography variant="h6" mb={2}>시공사 분석 설정</Typography>
                <List>
                    <ListItem>
                        <ListItemIcon><Refresh /></ListItemIcon>
                        <ListItemText
                            primary="자동 새로고침"
                            secondary="30초마다 데이터 자동 업데이트"
                        />
                        <Switch
                            checked={autoRefresh}
                            onChange={(e) => setAutoRefresh(e.target.checked)}
                        />
                    </ListItem>
                    <ListItem>
                        <ListItemIcon><Notifications /></ListItemIcon>
                        <ListItemText
                            primary="하자 알림"
                            secondary="새로운 하자 발생 시 즉시 알림"
                        />
                        <Switch defaultChecked />
                    </ListItem>
                    <ListItem>
                        <ListItemIcon><AutoFixHigh /></ListItemIcon>
                        <ListItemText
                            primary="자동 대응 제안"
                            secondary="AI 기반 하자 대응 방안 자동 제안"
                        />
                        <Switch defaultChecked />
                    </ListItem>
                </List>
            </CardContent>
        </Card>
    );

    const renderContent = () => {
        switch (selectedTab) {
            case 0: return renderCompanyOverview();
            case 1: return renderIssueAnalysis();
            case 2: return renderPerformanceAnalysis();
            case 3: return renderSelectionCriteria();
            case 4: return renderComparisonAnalysis();
            case 5: return renderResponseStrategies();
            case 6: return renderSettings();
            default: return renderCompanyOverview();
        }
    };

    return (
        <Box sx={{ p: 3, height: '100vh', overflow: 'auto' }}>
            {/* 헤더 */}
            <Box display="flex" justifyContent="space-between" alignItems="center" mb={3}>
                <Box display="flex" alignItems="center">
                    <Business sx={{ mr: 1, fontSize: 32 }} color="primary" />
                    <Typography variant="h4">시공사 정보 분석 대시보드</Typography>
                </Box>
                <Box display="flex" alignItems="center" gap={1}>
                    <Typography variant="body2" color="textSecondary">
                        마지막 업데이트: {lastUpdate.toLocaleTimeString()}
                    </Typography>
                    <Tooltip title="전체화면">
                        <IconButton onClick={() => setFullscreen(!fullscreen)}>
                            {fullscreen ? <FullscreenExit /> : <Fullscreen />}
                        </IconButton>
                    </Tooltip>
                </Box>
            </Box>

            {/* 탭 네비게이션 */}
            <Paper sx={{ mb: 3 }}>
                <Box display="flex" overflow="auto">
                    {tabs.map((tab, index) => (
                        <Button
                            key={index}
                            variant={selectedTab === index ? "contained" : "text"}
                            startIcon={tab.icon}
                            onClick={() => setSelectedTab(index)}
                            sx={{
                                minWidth: 'auto',
                                px: 2,
                                py: 1.5,
                                borderRadius: 0,
                                borderBottom: selectedTab === index ? 2 : 0,
                                borderColor: 'primary.main'
                            }}
                        >
                            {tab.label}
                        </Button>
                    ))}
                </Box>
            </Paper>

            {/* 메인 콘텐츠 */}
            {renderContent()}

            {/* 시공사 상세 다이얼로그 */}
            <Dialog
                open={companyDialogOpen}
                onClose={() => setCompanyDialogOpen(false)}
                maxWidth="md"
                fullWidth
            >
                <DialogTitle>
                    {selectedCompany?.name} 상세 정보
                </DialogTitle>
                <DialogContent>
                    {selectedCompany && (
                        <Box>
                            <Typography variant="h6" mb={2}>기본 정보</Typography>
                            <Grid container spacing={2} mb={3}>
                                <Grid item xs={6}>
                                    <Typography variant="body2" color="textSecondary">규모</Typography>
                                    <Typography variant="body1">{selectedCompany.type === 'large' ? '대형' :
                                        selectedCompany.type === 'medium' ? '중형' : '소형'}</Typography>
                                </Grid>
                                <Grid item xs={6}>
                                    <Typography variant="body2" color="textSecondary">경험</Typography>
                                    <Typography variant="body1">{selectedCompany.experience}년</Typography>
                                </Grid>
                                <Grid item xs={6}>
                                    <Typography variant="body2" color="textSecondary">완료 프로젝트</Typography>
                                    <Typography variant="body1">{selectedCompany.completedProjects}개</Typography>
                                </Grid>
                                <Grid item xs={6}>
                                    <Typography variant="body2" color="textSecondary">현재 프로젝트</Typography>
                                    <Typography variant="body1">{selectedCompany.currentProjects}개</Typography>
                                </Grid>
                            </Grid>

                            <Typography variant="h6" mb={2}>성능 메트릭</Typography>
                            <Grid container spacing={2} mb={3}>
                                <Grid item xs={6}>
                                    <Typography variant="body2" color="textSecondary">품질 점수</Typography>
                                    <Typography variant="body1">{(selectedCompany.performanceMetrics.qualityScore * 100).toFixed(0)}%</Typography>
                                </Grid>
                                <Grid item xs={6}>
                                    <Typography variant="body2" color="textSecondary">안전 점수</Typography>
                                    <Typography variant="body1">{(selectedCompany.performanceMetrics.safetyScore * 100).toFixed(0)}%</Typography>
                                </Grid>
                                <Grid item xs={6}>
                                    <Typography variant="body2" color="textSecondary">일정 점수</Typography>
                                    <Typography variant="body1">{(selectedCompany.performanceMetrics.scheduleScore * 100).toFixed(0)}%</Typography>
                                </Grid>
                                <Grid item xs={6}>
                                    <Typography variant="body2" color="textSecondary">비용 점수</Typography>
                                    <Typography variant="body1">{(selectedCompany.performanceMetrics.costScore * 100).toFixed(0)}%</Typography>
                                </Grid>
                            </Grid>

                            <Typography variant="h6" mb={2}>하자 이슈</Typography>
                            {selectedCompany.issues.map((issue) => (
                                <Box key={issue.id} mb={2} p={2} border={1} borderColor="divider" borderRadius={1}>
                                    <Typography variant="subtitle1" fontWeight="medium">{issue.title}</Typography>
                                    <Typography variant="body2" color="textSecondary" mb={1}>{issue.description}</Typography>
                                    <Box display="flex" gap={1}>
                                        <Chip label={issue.severity} size="small" color={getSeverityColor(issue.severity) as any} />
                                        <Chip label={issue.status} size="small" color={getStatusColor(issue.status) as any} />
                                    </Box>
                                </Box>
                            ))}
                        </Box>
                    )}
                </DialogContent>
                <DialogActions>
                    <Button onClick={() => setCompanyDialogOpen(false)}>닫기</Button>
                    <Button variant="contained">상세 분석</Button>
                </DialogActions>
            </Dialog>
        </Box>
    );
};

export default ConstructionCompanyAnalysisDashboard;
