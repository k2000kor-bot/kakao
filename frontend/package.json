{
  "name": "corbu-ai",
  "version": "0.1.0",
  "private": true,
  "proxy": "http://localhost:5002",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@heroicons/react": "^2.2.0",
    "@mediapipe/camera_utils": "^0.3.1675466862",
    "@mui/icons-material": "^7.3.1",
    "@mui/lab": "^7.0.0-beta.16",
    "@mui/material": "^7.3.1",
    "@reduxjs/toolkit": "^2.8.2",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/line-clamp": "^0.4.4",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-converter": "^4.22.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/react-router-dom": "^5.3.3",
    "axios": "^1.11.0",
    "chart.js": "^4.5.0",
    "chartjs-adapter-date-fns": "^3.0.0",
    "d3": "^7.9.0",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.534.0",
    "ml-matrix": "^6.12.1",
    "react": "^19.1.0",
    "react-chartjs-2": "^5.3.0",
    "react-datepicker": "^8.4.0",
    "react-dom": "^19.1.0",
    "react-draggable": "^4.5.0",
    "react-dropzone": "^14.3.8",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.8.1",
    "react-scripts": "5.0.1",
    "recharts": "^3.1.2",
    "regression": "^2.0.1",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^3.4.0",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "NODE_OPTIONS=--max-old-space-size=8192 BROWSER=none PORT=3000 DISABLE_ESLINT_PLUGIN=true react-scripts start",
    "build": "NODE_OPTIONS=--max-old-space-size=8192 DISABLE_ESLINT_PLUGIN=true react-scripts build",
    "pretest": "npm run check:test-imports && npm run check:src-frontend-parity",
    "test": "react-scripts test",
    "test:ci": "npm run pretest && CI=true react-scripts test --coverage --watchAll=false",
    "test:chat-merge": "npm run pretest && CI=true react-scripts test --watchAll=false unifiedAPI.chatMerge",
    "test:unified-api": "npm run pretest && CI=true react-scripts test --watchAll=false --testPathPattern='unifiedAPI|generationPromptBuilder\\.test|intelligentKnowledgeProcessor\\.test|enhancedBackendAPI|modernChatContextBuilder|enhancedResponseProcessor\\.test|chatService\\.test|integratedMessageService\\.test|unifiedMessageService\\.test|integratedSystemAPI\\.test|messageResponseAPI\\.test'",
    "test:adaptive-learning": "npm run pretest && CI=true react-scripts test --testPathPattern=adaptiveLearningEngine --watchAll=false",
    "typecheck:adaptive-learning-tests": "npx tsc --noEmit -p src/services/__tests__/tsconfig.json",
    "typecheck:adaptive-learning-tests:all": "npm run typecheck:adaptive-learning-tests && (cd .. && npm run typecheck:adaptive-learning-tests)",
    "check:test-imports": "node scripts/check-broken-test-imports.mjs src ../src",
    "check:src-frontend-parity": "node ../scripts/check-src-frontend-parity.mjs",
    "apply:install-jest-fetch-mock": "node scripts/apply-installJestFetchMock.mjs src ../src",
    "apply:install-jest-fetch-mock:dry": "node scripts/apply-installJestFetchMock.mjs --dry-run src ../src",
    "sync:from-root": "npm run sync:frontend-src --prefix ..",
    "eject": "react-scripts eject"
  },
  "jest": {
    "moduleNameMapper": {
      "^react-router-dom$": "<rootDir>/../node_modules/react-router-dom/dist/index.js",
      "^react-router/dom$": "<rootDir>/../node_modules/react-router/dist/development/dom-export.js",
      "^react-router$": "<rootDir>/../node_modules/react-router/dist/development/index.js"
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.1.0"
  }
}