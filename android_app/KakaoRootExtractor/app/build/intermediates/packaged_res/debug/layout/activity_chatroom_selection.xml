<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#f5f5f5">

    <!-- 헤더 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/primary_blue"
        android:padding="16dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💬 대화방 선택"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:gravity="center"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="모니터링할 대화방을 선택하세요"
            android:textSize="14sp"
            android:textColor="#e0e0e0"
            android:gravity="center" />

    </LinearLayout>

    <!-- 상태 표시 -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="대화방 목록을 불러오는 중..."
        android:textSize="14sp"
        android:textColor="#666666"
        android:background="#ffffff"
        android:padding="12dp"
        android:layout_marginBottom="16dp" />

    <!-- 제어 버튼들 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/selectAllButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="모두 선택"
            android:textSize="14sp"
            android:background="@color/button_select"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📊"
            android:textSize="24sp"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_marginHorizontal="8dp" />

        <Button
            android:id="@+id/confirmButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="확인 (0개 선택)"
            android:textSize="14sp"
            android:background="@color/button_start"
            android:layout_marginStart="8dp"
            android:enabled="false" />

    </LinearLayout>

    <!-- 대화방 목록 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chatRoomsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#ffffff"
        android:padding="8dp" />

    <!-- 하단 버튼 -->
    <Button
        android:id="@+id/cancelButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="❌ 취소"
        android:textSize="16sp"
        android:background="@color/button_stop"
        android:layout_marginTop="16dp" />

</LinearLayout> 