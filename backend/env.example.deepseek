# ============================================================
# 딥시크 설치형(로컬) 연결 — 이 내용을 backend/.env 로 저장 후 사용
# ============================================================
# Ollama에서 deepseek-r1 설치 후 아래만 켜면 이 프로젝트가 딥시크 설치형으로 동작합니다.

# 딥시크 설치형 사용 (API 키 없이 로컬 Ollama 사용)
DEEPSEEK_USE_LOCAL=true
# 사용할 Ollama 모델명 (ollama pull deepseek-r1 한 모델과 맞추기)
DEEPSEEK_LOCAL_MODEL=deepseek-r1
# Ollama 주소 (기본값, 변경한 경우만 설정)
# OLLAMA_BASE_URL=http://localhost:11434

# ============================================================
# API 포트 (프론트 proxy와 맞춤)
# ============================================================
# PORT=5002

# ============================================================
# (선택) 딥시크 API(클라우드) 사용 시 — DEEPSEEK_USE_LOCAL 제거 후
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# ============================================================
