# 프로덕션 빌드 시 사용할 환경 변수 예시
# 복사 후 .env.production 으로 저장하거나, CI/배포 플랫폼에서 설정
# 참고: docs/FRONTEND_DEPLOYMENT.md

# 백엔드 API 베이스 URL (실제 적용 시 필수)
REACT_APP_API_URL=https://api.your-domain.com

# WebSocket 베이스 URL (선택)
# REACT_APP_WS_URL=wss://api.your-domain.com

# 백업 API 베이스 URL (선택, 미설정 시 REACT_APP_API_URL 기반 /api 사용)
# REACT_APP_BACKUP_API_URL=https://api.your-domain.com/api

# LLM 상태 요약 요청 (선택, 백엔드에 /api/chat/llm-status 있을 때만 true 로 설정)
# REACT_APP_LLM_STATUS_ENABLED=true
